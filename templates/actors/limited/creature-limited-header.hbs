<header class='sheet-header row-section'>
  <div class='charname headerInput col fourty'>
    {{formInput fields.name value=document.name placeholder=(localize 'Name') readonly=true}}
    <span class='label name'>{{localize 'Name'}}</span>
  </div>
  <div class='headerInput col fourty'>
    {{formInput systemFields.creatureClass.fields.value value=document.system.creatureClass.value placeholder=(localize 'creatureClass') readonly=true}}
    <span class='label creatureClass'>{{localize 'creatureClass'}}</span>
  </div>
</header>
