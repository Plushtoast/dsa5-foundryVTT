<div class='tab scrollable {{tabs.inventory.cssClass}} gap0px' data-tab='inventory' data-group='{{tabs.inventory.group}}'>
    {{> systems/dsa5/templates/actors/parts/gearSearch.hbs}} {{#each prepare.inventory as |section sid|}} {{#if section.show}}
    <div class="actor-equipment groupbox">
        <div class="row-section table-title lineheight">
            <div class="col eight"></div>
            <div class="title-type col">
                <b>{{localize (concat "Equipment." @key)}}</b>
            </div>
            {{#if (eq @key 'bags')}}
            <div class="col five center">
                <i class="fas fa-weight-hanging" data-tooltip="carrycapacity"></i>
            </div>
            {{/if}}
            <div class="col eight center">
                <i class="fa fa-shield-alt" data-tooltip="equipped"></i>
            </div>
            <div class="col eight center">
                <span data-tooltip="quantity">#</span>
            </div>

            <div class="col eight center">
                <i class="fa fa-anchor" data-tooltip="Weight"></i>
            </div>
            <div class="col ten center flexAlignCenter flexrow">
                <button type="button" data-action="itemCreate" class="icon fas fa-plus noBorder dsadesignbutton very-small" data-tooltip="SHEET.addItem" item-section="{{sid}}" data-type="{{section.dataType}}"></button>
            </div>
        </div>
        <div class="row-section wrap rowtable inventory">
            {{#unless ../prepare.hasAnyItem}}
            <div class="actor-equipment-item-wrapper col item">
                <div class="actor-equipment-item row-section">
                    <div class="col" style="margin:5px;">
                        <p>{{localize 'SHEET.startDraggig'}}</p>
                    </div>
                </div>
            </div>
            {{else}}
                {{#each section.items as |item i|}}
                <div class="actor-equipment-item-wrapper col item" data-item-id="{{item._id}}" data-category="{{item.system.equipmentType.value}}">
                    <div class="actor-equipment-item row-section">
                        <div class="equipment-item-image col eight image {{item.enchantClass}}">
                            <div class="image" style="background-image: url('{{item.img}}')">
                                {{#if item.structureMax}}
                                <div class="item-structure" style="--a: {{item.structureMax}}; --b: {{item.structureCurrent}}">
                                    <div class="inner"></div>
                                </div>
                                {{/if}}
                            </div>
                        </div>
                        <div class="equipment-item-name col withContext">
                            <a data-action="itemEdit">{{item.name}}</a>
                        </div>
                        {{#if (eq item.system.equipmentType.value 'bags')}}
                        <div class="equipment-item-bagweight col five center">
                            {{item.system.bagweight}}
                        </div>
                        {{/if}}
                        <div class="equipment-item-status col eight center" {{#if (eq item.system.equipmentType.value 'bags')}} data-tooltip="SHEET.weightOnActor" {{/if}}>
                            {{#if item.toggle}} {{#if item.toggleValue}}
                            <a data-action="itemToggle" data-tooltip="SHEET.EquipItem"><i class="far fa-check-circle"></i></a> {{else}}
                            <a data-action="itemToggle" data-tooltip="SHEET.EquipItem"><i class="far fa-circle"></i></a> {{/if}} {{/if}}
                        </div>

                        <div class="equipment-item-quantity col eight center">
                            <a data-action="quantityClick" data-tooltip="TT.strgx10" data-tooltip-direction="RIGHT">{{item.system.quantity.value}}</a>
                        </div>
                        <div class="equipment-item-weight col eight center">
                            {{item.system.preparedWeight}}
                        </div>
                        <div class="equipment-item-action col ten very-small center flexrow">
                            {{#if item.OnUseEffect}}
                            <button type="button" data-tooltip="SHEET.onUseEffect" class="icon fas fa-dice-six onUseItem very-small autoFlex noBorder dsadesignbutton" data-action="onUseItem"></button>
                            {{/if}}
                            {{#if item.children}}
                            <button type="button" data-action="itemDropdown" class="icon fas fa-chevron-down very-small noBorder autoFlex dsadesignbutton" data-tooltip="SHEET.Dropdown"></button>
                            {{/if}}
                            <button type="button" data-action="itemContextMenu" class="icon fas fa-ellipsis-vertical very-small autoFlex noBorder dsadesignbutton" data-tooltip="SHEET.EditItem"></button>
                        </div>
                    </div>
                    <div class="row-section lineheight expandDetails {{item.detailed}}">
                        <div class="col">
                            {{#if item.children}} {{> systems/dsa5/templates/actors/parts/containerContent.hbs this}} {{/if}}
                        </div>
                    </div>

                </div>
                {{/each}}
            {{/unless}}
        </div>
    </div>
    {{/if}} {{/each}}

    {{> systems/dsa5/templates/actors/parts/carryandpurse.hbs}}
</div>