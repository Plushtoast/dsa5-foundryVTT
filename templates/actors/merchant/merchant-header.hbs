<header class='sheet-header'>
  <div class='charname headerInput'>
    <input class='input name' name='name' style='width:90%' type='text' value='{{document.name}}' placeholder='{{localize "Name"}}' />
    <a class='actorDrag' data-tooltip='TT.dragLink'><i class='fas fa-link'></i></a>
    <span class='label name'>{{localize 'Name'}}</span>
  </div>
  {{#if (ne merchantType 'loot')}}
    <div class='headerInput'>
      <input
        class='input species'
        name='system.details.species.value'
        type='text'
        value='{{document.system.details.species.value}}'
        readonly
        placeholder='{{localize "TYPES.Item.species"}}'
      />
      <span class='label species'>{{localize 'TYPES.Item.species'}}</span>
    </div>
    <div id='field-careerlevel' class='headerInput'>
      <input class='input-details' name='system.details.career.value' type='text' value='{{document.system.details.career.value}}' placeholder='{{localize "career"}}' />
      <span class='label-details'>{{localize 'TYPES.Item.career'}}</span>
    </div>
  {{/if}}
</header>