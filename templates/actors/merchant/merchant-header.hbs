<header class='sheet-header'>
  <div class='charname headerInput flexrow'>
    <h3 class='headerName ellipsis'>{{formInput fields.name value=document.name placeholder=(localize 'Name')}}</h3>
    <a class='button icon fas fa-minimize flexAlignEnd dsadesignbutton noBorder' data-action='collapseHeader' data-tooltip='TT.collapseHeader'></a>
    <a class='actorDrag button icon fas fa-link flexAlignEnd dsadesignbutton noBorder' data-tooltip='TT.dragLink'></a>
  </div>
  {{#if (ne merchantType 'loot')}}
    <div class='headerbadgeflex headerInput autosizing'>
      {{formInput systemFields.details.fields.species.fields.value value=document.system.details.species.value placeholder=(localize 'TYPES.Item.species') readonly=true}}
      {{formInput systemFields.details.fields.culture.fields.value value=document.system.details.culture.value placeholder=(localize 'TYPES.Item.culture')}}
      {{formInput systemFields.details.fields.career.fields.value value=document.system.details.career.value placeholder=(localize 'TYPES.Item.career')}}
    </div>
  {{/if}}

</header>