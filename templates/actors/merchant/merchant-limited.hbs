<div class='tab scrollable {{tabs.inventory.cssClass}}' data-tab='inventory' data-group='{{tabs.inventory.group}}'
   >
    <div class="row-section">
        <div class="col ten"></div>
        <div class="col fourty center">
            <img src="{{tradeFriend.img}}" class="centerMargin"  style="height: 50px;max-width:40%;border:none;" />
        </div>
        <div class="col ten">{{#if hasOtherTradeFriend}}
            <a data-action="removeOtherTradeFriend"><i class="fas fa-times"></i></a> {{else}}
            <a data-action="choseTradefriend"><i class="fas fa-plus" data-tooltip="MERCHANT.otherTradeFriend"></i></a>
                {{/if}}
        </div>
        <div class="col ten"></div>
        <div class="col fourty center">
            <img src="{{document.img}}" class="centerMargin"  style="height: 50px;max-width:40%;border:none;" />
        </div>
        <div class="col ten"></div>
    </div>
    <div class="row-section">
        <div class="col two">
            <h3 class="center">&zwnj;{{tradeFriend.name}}</h3>
        </div>
        <div class="col two">
            <h3 class="center">{{document.name}}</h3>
        </div>
    </div>
    {{> systems/dsa5/templates/actors/parts/gearSearch.hbs}}
    <fieldset class="noBorder" disabled>
        <div class="row-section">
            <div class="col two">
                    {{#grouped_each 4 tradeFriend.money.coins}}
                <div class="row-section table-title">
                    {{#each this}}
                    <div class="col four center">
                        {{localize name}}
                    </div>
                    {{/each}}
                </div>
                <div class="row-section">
                    {{#each this}}
                    <div class="col four center">
                        {{system.quantity.value}}
                    </div>
                    {{/each}}
                </div>
                {{/grouped_each}}
            </div>
            <div class="col two">
                {{#grouped_each 4 prepare.money.coins}}
                <div class="row-section table-title">
                    {{#each this}}
                    <div class="col four center">
                        {{localize name}}
                    </div>
                    {{/each}}
                </div>
                <div class="row-section">
                    {{#each this}}
                    <div class="col four center">
                        {{#if ../../document.system.merchant.hideMoney}}?{{else}}{{system.quantity.value}}{{/if}}
                    </div>
                    {{/each}}
                </div>
                {{/grouped_each}}
            </div>
        </div>

        <div class="row-section">
            <div class="col two">
                {{#unless tradeFriend.name}}
                <div class="row-section">
                    <div class="col">
                        <p>{{localize 'DSAError.noProperActor'}}</p>
                        <p>{{{localize 'TT.assignCharacter'}}}</p>
                        <p>{{localize 'MERCHANT.otherTradeFriend'}}</p>
                    </div>
                </div>
                {{/unless}}
                {{#each tradeFriend.inventory as |section sid|}} {{#if section.show}}
                <div class="groupbox">
                    <div class="row-section table-title">
                        <div class="col eight"></div>
                        <div class="col">
                            <b>{{localize (concat "Equipment." @key)}}</b>
                        </div>

                        <div class="col four center">
                            <span data-tooltip="UNITS.money"><i class="fas fa-coins"></i></span>
                        </div>
                        <div class="col eight center">
                            <span data-tooltip="quantity">#</span>
                        </div>
                        <div class="col eight center">

                        </div>
                    </div>
                    <div class="row-section wrap rowtable inventory">
                        {{#each section.items as |item i|}}
                        <div class="col item" data-item-id="{{item._id}}">
                            <div class="row-section">
                                <div class="col eight image {{item.enchantClass}}">
                                    <div class="image" style="background-image: url('{{item.img}}')">

                                    </div>
                                </div>
                                <div class="col">
                                    <a data-action="itemExternalEdit">{{item.name}}</a>
                                </div>
                                <div class="col four center">
                                    {{item.calculatedPrice}}
                                </div>
                                <div class="col eight center">
                                    {{item.system.quantity.value}}
                                </div>
                                <div class="col eight center">
                                    <a class="sell-item" data-price="{{item.calculatedPrice}}" data-tooltip="MERCHANT.sell"><i class="fas fa-piggy-bank"></i></a>
                                </div>
                            </div>
                        </div>
                        {{/each}}
                    </div>
                </div>
                {{/if}} {{/each}}
            </div>
            <div class="col two">
                {{#each prepare.inventory as |section sid|}} {{#if section.show}}
                <div class="groupbox">
                    <div class="row-section table-title">
                        <div class="col eight"></div>
                        <div class="col">
                            <b>{{localize (concat "Equipment." @key)}}</b>
                        </div>

                        <div class="col four center">
                            <span data-tooltip="UNITS.money"><i class="fas fa-coins"></i></span>
                        </div>
                        <div class="col eight center">
                            <span data-tooltip="quantity">#</span>
                        </div>
                        <div class="col eight center">

                        </div>
                    </div>
                    <div class="row-section wrap rowtable inventory">
                        {{#each section.items as |item i|}} {{#unless item.system.tradeLocked}}
                        <div class="col item" data-item-id="{{item._id}}">
                            <div class="row-section">
                                <div class="col eight image {{item.enchantClass}}">
                                    <div class="image" style="background-image: url('{{item.img}}')">

                                    </div>
                                </div>
                                <div class="col">
                                    <a data-action="itemEdit">{{item.name}}</a>
                                </div>
                                <div class="col four center">
                                    {{item.calculatedPrice}}
                                </div>
                                <div class="col eight center">
                                    {{item.system.quantity.value}}
                                </div>
                                <div class="col eight center">
                                    <a class="buy-item" data-price="{{item.calculatedPrice}}" data-tooltip="MERCHANT.buy"><i class="fas fa-shopping-cart"></i></a>
                                </div>
                            </div>
                        </div>
                        {{/unless}} {{/each}}
                    </div>
                </div>
                {{/if}} {{/each}}
            </div>
        </div>
    </fieldset>
</div>