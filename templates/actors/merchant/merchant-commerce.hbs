<div class='tab scrollable gap0px {{tabs.inventory.cssClass}}' data-tab='inventory' data-group='{{tabs.inventory.group}}'>
    <div class="row-section">
        {{#if (ne document.system.merchant.merchantType "none")}}
        {{#if isGM}}
        <div class="col morph40">
            <div class="groupbox">
                <legend class="table-title lineheight">{{localize 'TYPES.Item.equipment'}}</legend>
                <div class="flexrow">
                    <button type="button" data-action="randomGoods" class="sheetButton">{{localize
                        "MERCHANT.randomGoods"}}</button>
                    <button type="button" data-action="clearInventory" class="sheetButton">{{localize
                        "MERCHANT.clearInventory"}}</button>
                </div>
            </div>
        </div>

        {{/if}}
        {{/if}}
        <div class="col morph60">
            <div class="groupbox">
                <legend class="table-title lineheight">{{localize 'SHEET.actorConfig'}}</legend>

                {{formGroup systemFields.merchant.fields.merchantType value=document.system.merchant.merchantType localize=true}}

                    {{#if (eq document.system.merchant.merchantType "epic")}}

                    {{formGroup systemFields.merchant.fields.garadan value=document.system.merchant.garadan localize=true}}

                    {{/if}}
                {{#if (eq document.system.merchant.merchantType "merchant")}}
                <div class="form-group">
                    <label>{{localize "MERCHANT.Factor"}}</label>
                    <div class="form-fields">
                        <div class="row-section" data-tooltip="MERCHANT.sellingFactor">
                            <label class="col ten flexrow"><i class="fas fa-piggy-bank"></i></span></label>
                            {{formInput systemFields.merchant.fields.sellingFactor
                            value=document.system.merchant.sellingFactor}}
                        </div>
                        <div class="row-section" data-tooltip="MERCHANT.buyingFactor">
                            <label class="col ten flexrow"><i class="fas fa-coins"></i></label>
                            {{formInput systemFields.merchant.fields.buyingFactor
                            value=document.system.merchant.buyingFactor}}
                        </div>
                    </div>
                </div>
                    {{#if isGM}}
                    <div class="row-section">
                        <div class="col two form-group" data-tooltip="MERCHANT.hidePlayerHint">
                            <label>{{localize 'MERCHANT.hidePlayer'}}</label>

                            {{formInput systemFields.merchant.fields.hidePlayer
                            value=document.system.merchant.hidePlayer}}

                        </div>
                        <div class="col two form-group" data-tooltip="MERCHANT.hideMoneyHint">
                            <label>{{localize 'MERCHANT.hideMoney'}}</label>

                            {{formInput systemFields.merchant.fields.hideMoney
                            value=document.system.merchant.hideMoney}}

                        </div>
                    </div>
                    {{/if}} 
                {{/if}}
                {{#if (eq document.system.merchant.merchantType "loot")}}
                    {{#if isGM}}
                    <div class="row-section">
                        <div class="col two form-group" data-tooltip="MERCHANT.hidePlayerHint">
                            <label>{{localize 'MERCHANT.hidePlayer'}}</label>

                            {{formInput systemFields.merchant.fields.hidePlayer
                            value=document.system.merchant.hidePlayer}}

                        </div>
                        <div class="col two form-group">
                            <label>{{localize 'MERCHANT.locked'}}</label>

                            {{formInput systemFields.merchant.fields.locked value=document.system.merchant.locked}}

                        </div>
                    </div>
                    <div class="row-section">
                        <div class="col two form-group" data-tooltip="MERCHANT.emptyDestroyHint">
                            <label>{{localize 'MERCHANT.emptyDestroy'}}</label>
                            {{formInput systemFields.merchant.fields.temporary
                            value=document.system.merchant.temporary}}
                        </div>
                    </div>
                    <div class="col two">

                    </div>
                    {{/if}}
                {{/if}}
            </div>
        </div>
    </div>
    {{#if (ne document.system.merchant.merchantType "none")}}
    {{> systems/dsa5/templates/actors/merchant/merchant-permission-part.hbs}}
    {{/if}}

    {{> systems/dsa5/templates/actors/parts/gearSearchV2.hbs}}
    {{#each prepare.inventory as |section sid|}} 
        {{#if section.show}}
    <div class="groupbox">
        <div class="row-section table-title lineheight">
            <div class="col eight"></div>
            <div class="col">
                <b>{{localize (concat "Equipment." @key)}}</b>
            </div>
            {{#if (or (eq ../document.system.merchant.merchantType "merchant") (eq
            ../document.system.merchant.merchantType "loot"))}}
            <div class="col eight center">
                <button type="button" class="icon noBorder dsadesignbutton fa fa-lock" data-tooltip="MERCHANT.untradable" data-action="lockTradeSection" data-type="{{section.dataType}}"></button>
            </div>
            {{/if}}
            <div class="col eight center">
                <i class="fa fa-shield-alt" data-tooltip="equipped"></i>
            </div>
            <div class="col four center">
                <span data-tooltip="price"><i class="fas fa-coins"></i></span>
            </div>
            <div class="col eight flexrow flexAlignCenter">
                <button type="button" class="icon noBorder dsadesignbutton" data-action="changeAmountAllItems" data-type="{{section.dataType}}"><span data-tooltip="quantity">#</span></button>
            </div>
            <div class="col eight center">
                <i class="fa fa-anchor" data-tooltip="Weight"></i>
            </div>
            <div class="col ten center flexAlignCenter flexrow">
                <button type="button" data-action="itemCreate" class="icon fas fa-plus noBorder dsadesignbutton very-small"
                    data-tooltip="SHEET.addItem" item-section="{{sid}}" data-type="{{section.dataType}}"></button>
            </div>
        </div>
        <div class="row-section wrap rowtable inventory">
            {{#each section.items as |item i|}}
            <div class="col item" data-item-id="{{item._id}}">
                <div class="row-section">
                    <div class="col eight image {{item.enchantClass}}">
                        <div class="image" style="background-image: url('{{item.img}}')">
                            {{#if item.structureMax}}
                            <div class="item-structure" style="--a: {{item.structureMax}}; --b: {{item.structureCurrent}}">
                                <div class="inner"></div>
                            </div>
                            {{/if}}
                        </div>
                    </div>
                    <div class="col withContext">
                        <a data-action="itemEdit">{{item.name}}</a>
                    </div>
                    {{#if (or (eq ../../document.system.merchant.merchantType "merchant") (eq
                    ../../document.system.merchant.merchantType "loot"))}}
                    <div class="col eight center" data-tooltip="MERCHANT.untradable">
                        <button type="button" class="icon noBorder dsadesignbutton" data-action="toggleTradeLock"><i
                                class="fas fa-{{ifThen item.system.tradeLocked '' 'un'}}lock"></i></button>
                    </div>
                    {{/if}}
                    <div class="col eight flexrow flexAlignCenter">
                        {{#if item.toggle}} 
                        {{#if item.toggleValue}}
                        <button type="button" class="icon noBorder dsadesignbutton far fa-check-circle" data-action="itemToggle" data-tooltip="SHEET.EquipItem"></button>
                        {{else}}
                        <button type="button" class="icon noBorder dsadesignbutton far fa-circle" data-action="itemToggle" data-tooltip="SHEET.EquipItem"></button>
                        {{/if}}
                        {{/if}}
                    </div>
                    <div data-action="setCustomPrice" class="col four center setCustomPrice" data-tooltip="MERCHANT.priceMod">
                        {{item.defaultPrice}}<span class="priceTag">{{item.priceTag}}</span>
                        <input class="customPriceTag" type="number" value="{{item.flags.dsa5.customPriceTag}}" />
                    </div>
                    <div class="col eight flexrow flexAlignCenter">
                        <button type="button" class="noBorder dsadesignbutton" data-action="quantityClick" data-tooltip="TT.strgx10"
                            data-tooltip-direction="RIGHT">{{item.system.quantity.value}}</button>
                    </div>
                    <div class="equipment-item-weight col eight flexrow flexAlignCenter">
                        {{item.system.preparedWeight}}
                    </div>
                    <div class="col ten very-small center flexrow">
                        {{#if item.OnUseEffect}}
                        <button type="button" data-tooltip="SHEET.onUseEffect"
                            class="icon fas fa-dice-six autoFlex very-small noBorder dsadesignbutton"
                            data-action="onUseItem"></button>
                        {{/if}}
                        {{#if item.children}}
                        <button type="button" data-action="itemDropdown"
                            class="icon fas fa-chevron-down autoFlex very-small noBorder dsadesignbutton"
                            data-tooltip="SHEET.Dropdown"></button>
                        {{/if}}
                        <button type="button" data-action="itemContextMenu"
                            class="icon fas fa-ellipsis-vertical autoFlex very-small noBorder dsadesignbutton"
                            data-tooltip="SHEET.EditItem"></button>
                    </div>
                </div>
                <div class="row-section lineheight expandDetails {{item.detailed}}">
                    <div class="col">
                        {{#if item.children}} {{> systems/dsa5/templates/actors/parts/containerContent.hbs this}} {{/if}}
                    </div>
                </div>

            </div>
            {{/each}}
        </div>
    </div>
    {{/if}} 
    {{/each}}
</div>