<div class="row-section wrap skills table-header searchbox">
    <div class="col morph60 lineheight">
        {{> systems/dsa5/templates/actors/parts/carryandpurse.hbs}}
    </div>
    <div class="col morph40 row-section lineheight">
        <div class="col ten center">
            <i class="fas fa-search"></i>
        </div>
        <input type="search" class="gearSearch col {{#if showBulkInventoryActions}}seventy{{else}}eighty{{/if}}" placeholder="{{localize 'gearSearch'}}" />
        {{#if showBulkInventoryActions}}
        <div class="col ten center">
            <button
                type="button"
                class="icon fa-solid fa-box-open noBorder dsadesignbutton inventory-bulk-actions-menu"
                data-action="bulkInventoryContextMenu"
                data-tooltip="INVENTORYBULK.title"></button>
        </div>
        {{/if}}
    </div>
</div>