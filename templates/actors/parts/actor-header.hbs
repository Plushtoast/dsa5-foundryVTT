<div class='sheet-header'>
  
    <div class='charname headerInput row-section'>
      <div class='col ten'></div>
      <div class='col eighty'>
        <h3 class="headerName">{{formInput fields.name value=document.name placeholder=(localize 'Name')}}</h3>
      </div>
      <div class='col ten'>
        <a class='actorDrag' data-tooltip='TT.dragLink'><i class='fas fa-link'></i></a>
      </div>
    </div>
    <div class="headerbadgeflex headerInput flexAlignCenter autosizing">
      {{#if prepare.canBuild}}
        <button type="button" data-action="startCharacterBuilder" data-tooltip='CHARGEN.chargenTT'><i class="fas fa-user-edit"></i> {{localize 'CHARGEN.chargen'}}</button>
      {{else}}
        {{formInput systemFields.details.fields.species.fields.value value=document.system.details.species.value placeholder=(localize 'TYPES.Item.species') readonly=true}}        
      {{/if}}

      {{formInput systemFields.details.fields.culture.fields.value value=document.system.details.culture.value placeholder=(localize 'TYPES.Item.culture')}}
      {{formInput systemFields.details.fields.career.fields.value value=document.system.details.career.value placeholder=(localize 'TYPES.Item.career')}}
    </div>
</header>