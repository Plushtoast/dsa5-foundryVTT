<div class="flexrow" style="width: 100%;margin-bottom: 20px">
    {{#if (ne merchantType 'loot')}}
    <div class="col flexcol">
        <div class="flexrow flexgrow-0 charBtns">
            <div class="col flexrow gap5px flexAlignCenter" style="min-width:190px">
                {{#each document.system.characteristics as |ch c|}}
                <div class="center flexrow attribibcard" data-char="{{c}}" data-action="chValue" data-tooltip="{{attrName c}}">
                    <div>
                        <div class="d20 die-{{c}}">{{ch.value}}</div>
                    </div>
                    <div>
                        {{attrAbbr c}}
                    </div>
                    
                </div>
                {{#if (eq c "ch")}}
                <div class="breaker"></div>
                {{/if}}
                {{/each}}
            </div>
        </div>
        {{> systems/dsa5/templates/actors/parts/schipspart.hbs}}
    </div>
    {{/if}}
</div>