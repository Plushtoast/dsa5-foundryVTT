<div class="flexrow attributesHeader">
    {{#if (ne merchantType 'loot')}}
    <div class="col flexcol">
        <div class="flexrow charBtns">
            <div class="col flexrow" style="min-width:190px;justify-content: space-evenly;">
                {{#each document.system.characteristics as |ch c|}}
                <div class="center flexrow attribibcard" data-char="{{c}}" data-action="chValue" data-tooltip="{{concat 'FORMULA.attr.' c}}">
                    <div>
                        <div class="d20 die-{{c}}">{{ch.value}}</div>
                    </div>
                    <div>
                        {{attrAbbr c}}
                    </div>
                    
                </div>
                {{#if (eq c "ch")}}
                <div class="breaker"></div>
                {{/if}}
                {{/each}}
            </div>
        </div>
    </div>
    {{/if}}
</div>