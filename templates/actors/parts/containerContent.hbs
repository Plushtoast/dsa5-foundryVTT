<ul>
    <li class="main-row">
        <div class="row-section wrap rowtable inventory">
            {{#each children as |item i|}}
            <div class="actor-equipment-item-wrapper col item" data-item-id="{{item._id}}" data-category="{{item.system.equipmentType.value}}">
                <div class="actor-equipment-item row-section">
                    <div class="equipment-item-image col eight image {{item.enchantClass}}">
                        <div class="image" style="background-image: url('{{item.img}}')">
                            {{#if item.structureMax}}
                            <div class="item-structure" style="--a: {{item.structureMax}}; --b: {{item.structureCurrent}}">
                                <div class="inner"></div>
                            </div>
                            {{/if}}
                        </div>
                    </div>
                    <div class="equipment-item-name col withContext">
                        <a data-action="itemEdit">{{item.name}}</a>
                    </div>
                    <div class="col eight"></div>
                    {{#if (eq item.system.equipmentType.value 'bags')}}
                    <div class="equipment-item-bagweight col five center">
                        {{item.system.bagweight}}
                    </div>
                    {{/if}}
                    <div class="equipment-item-status col eight flexrow flexAlignCenter">
                        {{#if item.toggle}} 
                        {{#if item.toggleValue}}
                        <button type="button" class="icon noBorder dsadesignbutton far fa-check-circle" data-action="itemToggle" data-tooltip="SHEET.EquipItem"></button>
                        {{else}}
                        <button type="button" class="icon noBorder dsadesignbutton far fa-circle" data-action="itemToggle" data-tooltip="SHEET.EquipItem"></button>
                        {{/if}}
                        {{/if}}
                    </div>

                    <div class="equipment-item-quantity col eight flexrow flexAlignCenter">
                        <button type="button" class="noBorder dsadesignbutton" data-action="quantityClick" data-tooltip="TT.strgx10"
                            data-tooltip-direction="RIGHT">{{item.system.quantity.value}}</button>
                    </div>
                    <div class="equipment-item-weight col eight flexrow flexAlignCenter">
                        {{item.system.preparedWeight}}
                    </div>
                    <div class="equipment-item-action col ten very-small center flexrow">
                        {{#if item.children}} 
                        <button type="button" data-action="itemDropdown" class="icon autoFlex fas fa-chevron-down very-small noBorder dsadesignbutton" data-tooltip="SHEET.Dropdown"></button>
                        {{/if}}
                        <button type="button" data-action="itemContextMenu" class="icon autoFlex fas fa-ellipsis-vertical very-small noBorder dsadesignbutton" data-tooltip="SHEET.EditItem"></button>
                    </div>
                </div>
                <div class="row-section lineheight expandDetails {{item.detailed}}">
                    <div class="col">
                        {{#if item.children}} {{> systems/dsa5/templates/actors/parts/containerContent.hbs item}} {{/if}}
                    </div>
                </div>

            </div>
            {{/each}}
        </div>
    </li>
</ul>