{{#if isGM}}
{{#if prepare.information}}
<div class="groupbox">
  <legend class="table-title lineheight">{{localize 'TYPES.Item.information'}} <i class="fas fa-mask" data-tooltip="TT.onlyGM"></i></legend>
  <div class='row-section wrap cards'>
    {{#each prepare.information as |item i|}}
    <div class='item' data-item-id='{{item._id}}'>
      <a data-action='itemEdit'>{{item.name}}</a>
    </div>
    {{/each}}
  </div>
</div>
{{/if}}
{{/if}}