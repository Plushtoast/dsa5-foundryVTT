<div class="row-section" style="margin-top:10px;">
   <div class="col flexrow regenContainer {{ifThen (and prepare.magic.hasPrayers prepare.magic.hasSpells) 'third' 'fourty'}}">
        <div class="healthbar bar-wounds barLeft {{ifThen prepare.isSwarm  'swarmcount' ''}} {{ifThen (or prepare.magic.hasPrayers prepare.magic.hasSpells) '' 'soloBar'}}" style="--swarm: {{document.system.swarm.count}};" data-tooltip="wounds">

            <div class="bar decolorizeFilter LeP" style="--a: {{document.system.status.wounds.value}}; --b: {{document.system.status.wounds.max}};">
            </div>

            <div class="barLabel">
                {{formInput systemFields.status.fields.wounds.fields.value value=document.system.status.wounds.value tooltip="Current"}} / 
                <span data-tooltip="max">{{document.system.status.wounds.max}}</span>
            </div>
        </div>
        <button type='button' data-char='regenerate' data-action='chRegenerate' class='fas fa-moon icon item' data-mod='regenerate' data-tooltip='regenerate'></button>
    </div>
    {{#if prepare.magic.hasPrayers}} 
        {{#if prepare.magic.hasSpells}}
        <div class="col third">
            <div class="healthbar bar-karmaenergy barRight middle" data-tooltip="karmaenergy">
                <div class="barLabel">
                    {{formInput systemFields.status.fields.karmaenergy.fields.value value=document.system.status.karmaenergy.value tooltip="Current"}} / 
                    <span data-tooltip="max">{{document.system.status.karmaenergy.max}}</span>
                </div>
                <div class="bar decolorizeFilter KaP" style="--a: {{document.system.status.karmaenergy.value}}; --b: {{document.system.status.karmaenergy.max}}">

                </div>
            </div>
        </div>
        <div class="col third">
            <div class="healthbar bar-astralenergy barRight{{#if prepare.powersourceBar}} powersource-bar{{/if}}" data-tooltip="astralenergy">
                <div class="bar decolorizeFilter AsP" style="--a: {{document.system.status.astralenergy.value}}; --b: {{#if prepare.powersourceBarLayout}}{{prepare.powersourceBarLayout.totalMax}}{{else}}{{document.system.status.astralenergy.max}}{{/if}};">
                </div>
                {{#if prepare.powersourceBarLayout}}
                <div class="powersource-segments">
                    {{#each prepare.powersourceBarLayout.segments}}
                    <div class="powersource-segment color-{{colorIndex}}{{#if @first}} first-segment{{/if}}" style="left: calc(100% * {{offset}}); width: calc(100% * {{width}});" data-tooltip="{{label}}">
                        <div class="powersource-fill" style="width: calc(100% * {{fillRatio}});"></div>
                    </div>
                    {{/each}}
                </div>
                {{/if}}
                <div class="barLabel">
                    {{formInput systemFields.status.fields.astralenergy.fields.value value=document.system.status.astralenergy.value tooltip="Current"}} / 
                    <span data-tooltip="max">{{document.system.status.astralenergy.max}}</span>
                    {{#if prepare.powersourceBar}}
                    <span class="nobr powersource-label" data-action="powersourceEdit" data-tooltip="POWERSOURCE.barTooltip"> + {{prepare.powersource.value}} / {{prepare.powersource.max}}</span>
                    {{/if}}
                </div>
            </div>
        </div>
        {{else}}
        <div class="col fourty">
            <div class="healthbar bar-karmaenergy barRight" data-tooltip="karmaenergy">
                <div class="barLabel">
                    {{formInput systemFields.status.fields.karmaenergy.fields.value value=document.system.status.karmaenergy.value tooltip="Current"}} / 
                    <span data-tooltip="max">{{document.system.status.karmaenergy.max}}</span>
                </div>
                <div class="bar decolorizeFilter KaP" style="--a: {{document.system.status.karmaenergy.value}}; --b: {{document.system.status.karmaenergy.max}}">

                </div>
            </div>
        </div>
        {{/if}} 
    {{else if prepare.magic.hasSpells}}
    <div class="col fourty">
        <div class="healthbar bar-astralenergy barRight{{#if prepare.powersourceBar}} powersource-bar{{/if}}" data-tooltip="astralenergy">
            <div class="bar decolorizeFilter AsP" style="--a: {{document.system.status.astralenergy.value}}; --b: {{#if prepare.powersourceBarLayout}}{{prepare.powersourceBarLayout.totalMax}}{{else}}{{document.system.status.astralenergy.max}}{{/if}};">
            </div>
            {{#if prepare.powersourceBarLayout}}
            <div class="powersource-segments">
                {{#each prepare.powersourceBarLayout.segments}}
                <div class="powersource-segment color-{{colorIndex}}{{#if @first}} first-segment{{/if}}" style="left: calc(100% * {{offset}}); width: calc(100% * {{width}});" data-tooltip="{{label}}">
                    <div class="powersource-fill" style="width: calc(100% * {{fillRatio}});"></div>
                </div>
                {{/each}}
            </div>
            {{/if}}
            <div class="barLabel">
                {{formInput systemFields.status.fields.astralenergy.fields.value value=document.system.status.astralenergy.value tooltip="Current"}} / 
                <span data-tooltip="max">{{document.system.status.astralenergy.max}}</span>
                {{#if prepare.powersourceBar}}
                <span class="nobr powersource-label" data-action="powersourceEdit" data-tooltip="POWERSOURCE.barTooltip"> + {{prepare.powersource.value}} / {{prepare.powersource.max}}</span>
                {{/if}}
            </div>
        </div>
    </div>
    {{else}}
    <div class="col-bar-spacer col two">

    </div>
    {{/if}}

</div>
{{#if document.system.status.temporaryLeP.max}}
<div class="row-section">
    <div class="col fourty">
        <div class="healthbar bar-wounds barLeft{{#if prepare.isSwarm}} swarmcount{{/if}} soloBar" style="--swarm: {{document.system.swarm.count}};" data-tooltip="BRAWLING.temporary">

            <div class="bar decolorizeFilter tempLeP" style="--a: {{document.system.status.temporaryLeP.value}}; --b: {{document.system.status.temporaryLeP.max}};">
            </div>

            <div class="barLabel">
                {{formInput systemFields.status.fields.temporaryLeP.fields.value value=document.system.status.temporaryLeP.value tooltip="Current"}} / 
                /
                {{formInput systemFields.status.fields.temporaryLeP.fields.max value=document.system.status.temporaryLeP.max tooltip="max"}}
            </div>
        </div>
    </div>
    <div class="col-bar-spacer col two">

    </div>
</div>
{{/if}}
