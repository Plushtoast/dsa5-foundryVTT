<div class='tab scrollable gap0px {{tabs.status.cssClass}}' data-tab='status' data-group='{{tabs.status.group}}'>
    <div class="actor-status groupbox">
        <div class="actor-status-header row-section">
            <div class="col ten">

            </div>
            <div class="col eighty header-label lineheight">
                <b>{{localize "statuseffects"}}</b>
            </div>
            <div class="col ten center flexrow flexAlignCenter">
                <button type="button" data-action="statusCreate" class="icon fas fa-plus noBorder dsadesignbutton very-small" data-tooltip="CONDITION.add"></button>
                <div class="statusEffectMenu">
                    <ul>
                        <li class="search">
                            <div class="flexrow">
                                <input type="search" class="conditionSearch" placeholder="{{localize 'Book.search'}}" />
                                <button type="button" data-action="statusAdd" data-id="custom" data-tooltip="CONDITION.custom"><i class="fas fa-plus"></i></button>
                            </div>                            
                        </li>
                        {{#each manualConditions as |item i|}}
                        <li>
                            <button type="button" data-action="statusAdd" data-id="{{item.id}}" data-tooltip="{{item.name}}"><img src="{{item.img}}" /></button>
                        </li>
                        {{/each}}

                    </ul>
                </div>
            </div>
        </div>
        <div class="row-section mainEffects wrap">

            <div class="col morph row-section skills table-title">
                <div class="col ten">

                </div>
                <div class="col sixty">
                    {{localize "condition"}}
                </div>

                <div class="col ten center">
                    {{localize "ABBR.modifiers"}}
                </div>
                <div class="col ten center" data-tooltip="value">
                    {{localize "ABBR.value"}}
                </div>
                <div class="actor-status-action col ten">

                </div>
            </div>
            <div class="col morph row-section skills table-title onlyMultiColumn">
                <div class="col ten">

                </div>
                <div class="col sixty">
                    {{localize "condition"}}
                </div>

                <div class="col ten center">
                    {{localize "ABBR.modifiers"}}
                </div>
                <div class="col ten center" data-tooltip="value">
                    {{localize "ABBR.value"}}
                </div>
                <div class="actor-status-action col ten">

                </div>
            </div>
            {{#each conditions as |item i|}}
            <div class="row-section col morph skills" data-id="{{item._id}}" {{#if item.descriptor}}data-descriptor="{{item.descriptor}}" {{/if}} {{{ifThen item.disabled 'style="opacity:0.5;"' ''}}}>
                <div class="status-img col ten flexcol flexAlignCenter statusEffect effectConfig">
                    <img src="{{item.img}}" />
                </div>
                <div class="col sixty flexcol">
                    <div class="ellipsis">
                        <a data-action="conditionShow" class="gTooltip" data-category="effect" data-id="{{item._id}}">{{localize item.name}}</a>
                    </div>
                    <small class="flexrow gap2px ellipsis">
                        {{#each item.pips as |pip|}}
                        <small class="smallBoxItem flex0">{{{pip}}}</small>
                        {{/each}}
                    </small>
                </div>
                <div class="col ten center flexrow">
                    {{#if item.editable}}{{#unless item.boolean}}
                        <button type="button" class="dsadesignbutton noBorder" data-action="conditionValue">{{item.manual}}</button>
                    {{/unless}}{{/if}}
                </div>
                <div class="col ten center flexrow" data-tooltip="value">
                    <span>{{item.value}}</span>
                </div>
                <div class="actor-status-action col ten right flexrow">
                    <button type="button" data-action="statusContextMenu" class="icon fas fa-ellipsis-vertical very-small autoFlex noBorder dsadesignbutton" data-tooltip="SHEET.EditItem"></button>
                </div>
            </div>
            {{/each}}
            {{#if (oddLength conditions)}}
            <div class="col morph">
            </div>
            {{/if}}
        </div>

    </div>
    <div class="actor-status groupbox">
        <div class="actor-status-header row-section">
            <div class="col ten">

            </div>
            <div class="col eighty header-label lineheight">
                <b>{{localize "cummulativeStatusEffects"}}</b>
            </div>
            <div class="col ten center">

            </div>
        </div>
        <div class="row-section  wrap">

            <div class="col morph row-section skills table-title">
                <div class="col ten">

                </div>
                <div class="col sixty">
                    {{localize "condition"}}
                </div>

                <div class="col ten center">

                </div>
                <div class="col ten center" data-tooltip="value">
                    {{localize "ABBR.value"}}
                </div>
                <div class="actor-status-action col ten">

                </div>
            </div>
            <div class="col morph row-section skills table-title onlyMultiColumn">
                <div class="col ten">

                </div>
                <div class="col sixty">
                    {{localize "condition"}}
                </div>

                <div class="col ten center">

                </div>
                <div class="col ten center" data-tooltip="value">
                    {{localize "ABBR.value"}}
                </div>
                <div class="actor-status-action col ten">

                </div>
            </div>
            {{#each cumulativeConditions as |item i|}}
            <div class="row-section morph skills col statusEffect" data-id="{{item.id}}" data-descriptor="{{item.id}}">
                <div class="status-img col ten effectConfig">
                    <img src="{{item.img}}" />
                </div>
                <div class="col sixty ellipsis">
                    <a data-action="conditionShow" class="gTooltip" data-category="effect" data-id="{{item.id}}">{{localize item.name}}</a>
                </div>
                <div class="col ten center">

                </div>
                <div class="col ten center" data-tooltip="value">
                    <span>{{item.value}}</span>
                </div>
                <div class="actor-status-action col ten right">

                </div>
            </div>
            {{/each}}
            {{#if (oddLength cumulativeConditions)}}
            <div class="col morph">
            </div>
            {{/if}}
        </div>

    </div>
    <div class="actor-status groupbox">
        <div class="actor-status-header row-section" data-tooltip="cummulativeStatusEffectsHint">
            <div class="col ten">

            </div>
            <div class="col eighty header-label lineheight">
                <b>{{localize "transferredStatusEffects"}}</b>
            </div>
            <div class="col ten center">

            </div>
        </div>

        <div class="row-section  wrap">

            <div class="col morph row-section skills table-title">
                <div class="col ten">

                </div>
                <div class="col sixty">
                    {{localize "condition"}}
                </div>

                <div class="col five center">
                    {{localize 'source'}}
                </div>
                <div class="actor-status-action col ten">

                </div>
            </div>
            <div class="col morph row-section skills table-title onlyMultiColumn">
                <div class="col ten">

                </div>
                <div class="col sixty">
                    {{localize "condition"}}
                </div>

                <div class="col five center">
                    {{localize 'source'}}
                </div>
                <div class="actor-status-action col ten">

                </div>
            </div>
            {{#each transferedConditions as |item i|}}
            <div class="row-section morph skills col statusEffect" data-item-id="{{item.parent.id}}" data-origin="{{item.uuid}}" data-id="{{item._id}}" {{#if item.descriptor}}data-descriptor="{{item.descriptor}}"{{/if}} {{{ifThen item.disabled 'style="opacity:0.5;"' ''}}}>
                <div class="status-img col ten effectConfig">
                    <img src="{{item.img}}" /> 
                </div>
                <div class="col sixty ellipsis">
                    <a data-action="conditionEdit" class="gTooltip" data-category="effect" data-uuid="{{item.uuid}}" data-locked="true" data-id="{{item._id}}">{{localize item.name}}</a>
                </div>
                <div class="col five center">
                    <a data-action="conditionEdit" class="condition-edit" data-uuid="{{item.parent.uuid}}"><i class="fas fa-info" data-tooltip="{{item.parent.name}}"></i></a>
                </div>
                <div class="actor-status-action col ten right flexrow">
                    <button type="button" data-action="statusContextMenu" class="icon fas fa-ellipsis-vertical very-small autoFlex noBorder dsadesignbutton" data-tooltip="SHEET.EditItem"></button>
                </div>
            </div>
            {{/each}}
            {{#if (oddLength transferedConditions)}}
            <div class="col morph">
            </div>
            {{/if}}
        </div>

    </div>

    {{#if prepare.demonmarks}}
    <div class="groupbox">
        <div class="row-section table-title lineheight">
            <div class="col third">
                {{localize "demonmark"}}
            </div>
            <div class="col ten"></div>
            <div class="col ten center">{{localize "circle"}}</div>
            <div class="col third center">{{localize "domains"}}</div>
            <div class="col ten center">
            </div>
        </div>
        <div class="row-section wrap inventory diseases">
            {{#each prepare.demonmarks as |item i|}}
            <div class="col item" data-item-id="{{item._id}}">
                <div class="row-section skills lineheight">
                    <div class="col ten image">
                        <div class="image" style="background-image: url('{{item.img}}')">
                        </div>
                    </div>
                    <div class="col third withContext">
                        <a data-action="itemEdit">{{item.name}}</a>
                    </div>
                    <div class="col ten center">
                        {{item.system.circle}}
                    </div>
                    <div class="col third center">
                        {{item.system.domain}}
                    </div>

                    <div class="col ten very-small center flexrow">
                        <button type="button" data-action="itemContextMenu" class="icon fas fa-ellipsis-vertical very-small noBorder dsadesignbutton" data-tooltip="SHEET.EditItem"></button>
                    </div>
                </div>
            </div>
            {{/each}}
        </div>
    </div>
    {{/if}} {{#if isGM}}
    <div class="groupbox">
        <div class="row-section table-title lineheight">
            <div class="col third">
                {{localize "disease"}}
            </div>
            <div class="col ten center">{{localize "stepValue"}}</div>
            <div class="col five center onlyMultiColumn">{{localize 'incubation'}}</div>
            <div class="col five center onlyMultiColumn">{{localize "duration"}}</div>
            <div class="col fifteen center"></div>
            <div class="col ten center"></div>
            <div class="col ten center">
                <i class="fas fa-mask" data-tooltip="TT.onlyGM"></i>
            </div>
        </div>
        <div class="row-section wrap inventory diseases">
            {{#each prepare.diseases as |item i|}}
            <div class="col item" data-item-id="{{item._id}}">
                <div class="row-section skills lineheight">
                    <div class="col third withContext">
                        <a data-action="itemEdit">{{item.name}}</a>
                    </div>
                    <div class="col ten center">
                        {{item.system.step.value}}
                    </div>
                    <div class="col five center onlyMultiColumn">
                        {{item.system.incubation.value}}
                    </div>
                    <div class="col five center onlyMultiColumn">
                        {{item.system.duration.resolved}}
                    </div>
                    <div class="col fifteen center">
                        <a data-action="rollDisease"><div class="d20 die-attack"></div></a>
                    </div>
                    <div class="col ten center statusEffect">
                        <a class="statusAdd" data-id="sick" data-tooltip="CONDITION.sick"><img src="icons/svg/biohazard.svg" /></a>
                    </div>
                    <div class="col ten very-small center flexrow">
                        <button type="button" data-action="itemContextMenu" class="icon fas fa-ellipsis-vertical very-small noBorder dsadesignbutton" data-tooltip="SHEET.EditItem"></button>
                    </div>
                </div>
            </div>
            {{/each}}
        </div>
    </div>
    {{/if}}

    <div class="actor-status groupbox">
        <div class="row-section">
            <div class="col header-label lineheight">
                <b>{{localize "Modifiers"}}</b>
            </div>
        </div>
        <div class="row-section wrap">
            <div class="col morph row-section skills table-title">
                <div class="col five">
                    {{localize 'target'}}
                </div>
                <div class="col five">
                    {{localize "ABBR.value"}}
                </div>
                <div class="col sixty seventy">
                    {{localize "source"}}
                </div>
            </div>
            <div class="col morph row-section skills table-title onlyMultiColumn">
                <div class="col five">
                    {{localize 'target'}}
                </div>
                <div class="col five">
                    {{localize "ABBR.value"}}
                </div>
                <div class="col sixty seventy">
                    {{localize "source"}}
                </div>
            </div>
            {{#each prepare.itemModifiers as |item i|}}
            <div class="status-modifier row-section skills col morph">
                <div class="col five">
                    {{@key}}
                </div>
                <div class="col five">
                    {{item.value}}
                </div>
                <div class="col sixty">
                    {{joinStr ", " item.sources}}
                </div>

            </div>
            {{/each}}
            {{#if (oddLength prepare.itemModifiers)}}
            <div class="col morph">
            </div>
            {{/if}}
        </div>


    </div>

    <div class="groupbox">
        <div class="row-section">
            <div class="col header-label lineheight">
                <b>{{localize "SHEET.actorConfig"}}</b>
            </div>
        </div>
        <div class="row-section wrap">
            {{#if document.system.repeatingEffects.startOfRound.wounds}}
            <div class="row-section skills col morph">
                <div class="col nintey">
                    {{localize 'regenerate'}} {{localize 'CHARAbbrev.CR'}} ({{localize 'wounds'}})
                </div>
                <div class="col five">

                </div>
                <div class="col ten">
                    <a data-action="disableRegeneration" data-type="wounds">{{#if document.system.repeatingEffects.disabled.wounds}}<i class="far fa-circle"></i>{{else}}<i class="far fa-check-circle"></i>{{/if}}</a>
                </div>
            </div>
            {{/if}}

            {{#if document.system.repeatingEffects.startOfRound.astralenergy}}
            <div class="row-section skills col morph">
                <div class="col nintey">
                    {{localize 'regenerate'}} {{localize 'CHARAbbrev.CR'}} ({{localize 'astralenergy'}})
                </div>
                <div class="col ten">
                    <a data-action="disableRegeneration" data-type="astralenergy">{{#if document.system.repeatingEffects.disabled.astralenergy}}<i class="far fa-circle"></i>{{else}}<i class="far fa-check-circle"></i>{{/if}}</a>
                </div>
            </div>
            {{/if}}
            {{#if document.system.repeatingEffects.startOfRound.karmaenergy}}
            <div class="row-section skills col morph">
                <div class="col nintey">
                    {{localize 'regenerate'}} {{localize 'CHARAbbrev.CR'}} ({{localize 'karmaenergy'}})
                </div>
                <div class="col ten">
                    <a class="disableRegeneration" data-type="karmaenergy">{{#if document.system.repeatingEffects.disabled.karmaenergy}}<i class="far fa-circle"></i>{{else}}<i class="far fa-check-circle"></i>{{/if}}</a>
                </div>
            </div>
            {{/if}}
        </div>
    </div>
</div>