{{#if (and prepare.schips.length prepare.groupschips.length)}}
<div class='row-schips center flexrow'>
  <div class='flexrow stackedSchips'>
    {{#each prepare.schips as |item i|}}
    <button type="button" data-action='schipUpdate' data-tooltip='fatePoints'
      class='ownSchips noBorder dsadesignbutton schip {{item.cssClass}}' data-val='{{item.value}}'></button>
    {{/each}}
  </div>

  <div class='flexrow flexAlignEnd stackedSchips'>
    {{#each prepare.groupschips as |item i|}}
    <button type="button" data-tooltip='CHARAbbrev.groupFatePoints'
      class='noBorder dsadesignbutton schip {{item.cssClass}}' data-val='{{item.value}}'></button>
    {{/each}}
  </div>
</div>
{{else if prepare.schips.length}}
<div class='row-schips flexrow flexAlignCenter stackedSchips' data-tooltip='fatePoints'>
  {{#each prepare.schips as |item i|}}
  <button type="button" data-action='schipUpdate' class='ownSchips noBorder dsadesignbutton schip {{item.cssClass}}'
    data-val='{{item.value}}'></button>
  {{/each}}
</div>
{{else if prepare.groupschips.length}}
<div class='row-schips flexrow flexAlignCenter stackedSchips' data-tooltip='CHARAbbrev.groupFatePoints'>
  {{#each prepare.groupschips as |item i|}}
  <button type="button" class='noBorder dsadesignbutton schip {{item.cssClass}}' data-val='{{item.value}}'></button>
  {{/each}}
</div>
{{/if}}