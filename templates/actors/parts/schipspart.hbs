{{#if (and prepare.schips.length prepare.groupschips.length)}}
  <div class='row-schips row-section'>
    
    <div class='col two center' data-tooltip='fatePoints'>
      {{localize 'CHARAbbrev.fatePoints'}}
      {{#each prepare.schips as |item i|}}
        <a data-action='schipUpdate' class='schip {{item.cssClass}}' data-val='{{item.value}}'></a>
      {{/each}}
    </div>
    <div class='col two center' data-tooltip='CHARAbbrev.groupFatePoints'>
      {{localize 'CHARAbbrev.gfatePoints'}}
      {{#each prepare.groupschips as |item i|}}
        <a class='schip {{item.cssClass}}' data-val='{{item.value}}'></a>
      {{/each}}
    </div>
  </div>
{{else if prepare.schips.length}}
  <div class='row-schips row-section'>
    <div class='col center' data-tooltip='fatePoints'>
      {{#each prepare.schips as |item i|}}
        <a data-action='schipUpdate' class='schip {{item.cssClass}}' data-val='{{item.value}}'></a>
      {{/each}}
    </div>
  </div>
{{else if prepare.groupschips.length}}
  <div class='row-schips row-section'>
    <div class='col center' data-tooltip='CHARAbbrev.groupFatePoints'>
      {{#each prepare.groupschips as |item i|}}
        <a class='schip {{item.cssClass}}' data-val='{{item.value}}'></a>
      {{/each}}
    </div>
  </div>
{{/if}}