<div class="actor-main row-section wrap">
    <div class="characteristics-table char-block-mental char-row-header" cellpadding="0">
        <div class="table-row">
            <div class="table-header"></div>
            {{#each prepare.mentalAttrs as |ch|}}
            <div data-tooltip="{{attrName ch}}" class="table-header">
                <div class="header-label">
                    {{#if ../prepare.canAdvance}}<a data-attr="{{ch}}" class="advance" data-action="advanceWrapper" data-fct="_refundAttributeAdvance"><i class="fas fa-minus"></i></a> <b>{{attrAbbr ch}}</b> <a data-attr="{{ch}}" class="advance" data-action="advanceWrapper" data-fct="_advanceAttribute"><i class="fas fa-plus"></i></a>
                    {{else}}
                    <b>{{attrAbbr ch}}</b>
                    {{/if}}
                </div>
            </div>
            {{/each}}
        </div>
    </div>
    <div class="characteristics-table ctab2 char-block-body char-row-header" cellpadding="0">
        <div class="table-row">
            <div class="table-header onlySingleColumn"></div>
            {{#each prepare.bodyAttrs as |ch|}}
            <div data-tooltip="{{attrName ch}}" class="table-header">
                <div class="header-label">
                    {{#if ../prepare.canAdvance}}<a data-attr="{{ch}}" class="advance" data-action="advanceWrapper" data-fct="_refundAttributeAdvance"><i class="fas fa-minus"></i></a>{{/if}}
                    <b>{{attrAbbr ch}}</b> {{#if ../prepare.canAdvance}}<a data-attr="{{ch}}" class="advance" data-action="advanceWrapper" data-fct="_advanceAttribute"><i class="fas fa-plus"></i></a>{{/if}}
                </div>
            </div>
            {{/each}}
        </div>
    </div>
    <div class="characteristics-table char-block-mental char-row-initial" cellpadding="0">
        <div class="table-row">
            <div class="row-type table-data">
                <div class="header-block lineheight">
                    {{localize "Initial"}}
                </div>
            </div>
            {{#each prepare.mentalAttrs as |ch|}}
            <div class="table-data">
                <input name="system.characteristics.{{ch}}.initial" type="number" value="{{getAttr ../document ch 'initial'}}">
            </div>
            {{/each}}
        </div>
    </div>
    <div class="characteristics-table ctab2 char-block-body char-row-initial" cellpadding="0">
        <div class="table-row">
            <div class="row-type table-data onlySingleColumn">
                <div class="header-block lineheight">
                    {{localize "Initial"}}
                </div>
            </div>
            {{#each prepare.bodyAttrs as |ch|}}
            <div class="table-data">
                <input name="system.characteristics.{{ch}}.initial" type="number" value="{{getAttr ../document ch 'initial'}}">
            </div>
            {{/each}}
        </div>
    </div>
    {{#if prepare.canAdvance}}
    <div class="characteristics-table char-block-mental char-row-advances" cellpadding="0">
        <div class="table-row">
            <div class="row-type table-data">
                <div class="header-block lineheight">
                    {{localize "Advances"}}
                </div>
            </div>
            {{#each prepare.mentalAttrs as |ch|}}
            <div class="table-data">
                <input name="system.characteristics.{{ch}}.advances" type="number" value="{{getAttr ../document ch 'advances'}}">
            </div>
            {{/each}}
        </div>
    </div>
    <div class="characteristics-table ctab2 char-block-body char-row-advances" cellpadding="0">
        <div class="table-row">
            <div class="row-type table-data onlySingleColumn">
                <div class="header-block lineheight">
                    {{localize "Advances"}}
                </div>
            </div>
            {{#each prepare.bodyAttrs as |ch|}}
            <div class="table-data">
                <input name="system.characteristics.{{ch}}.advances" type="number" value="{{getAttr ../document ch 'advances'}}">
            </div>
            {{/each}}
        </div>
    </div>
    {{/if}}
    <div class="characteristics-table char-block-mental char-row-modifiers" cellpadding="0">
        <div class="actor-main-attr-modifier table-row">
            <div class="row-type table-data">
                <div class="header-block lineheight">
                    {{localize "Modifiers"}}
                </div>
            </div>
            {{#each prepare.mentalAttrs as |ch|}}
            <div class="number-input table-data">
                <input name="system.characteristics.{{ch}}.modifier" type="number" value="{{getAttr ../document ch 'modifier'}}">
            </div>
            {{/each}}
        </div>
    </div>
    <div class="characteristics-table ctab2 char-block-body char-row-modifiers" cellpadding="0">
        <div class="actor-main-attr-modifier table-row">
            <div class="row-type table-data onlySingleColumn">
                <div class="header-block lineheight">
                    {{localize "Modifiers"}}
                </div>
            </div>
            {{#each prepare.bodyAttrs as |ch|}}
            <div class="number-input table-data">
                <input name="system.characteristics.{{ch}}.modifier" type="number" value="{{getAttr ../document ch 'modifier'}}">
            </div>
            {{/each}}
        </div>
    </div>
</div>