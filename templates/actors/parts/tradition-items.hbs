<div class="actor-tradition-artefacts groupbox">
    <div class="row-section wrap inverseRowtable">
        <div class="col">
            <div class="row-section skills table-title lineheight">
                <div class="title-type col third">{{localize titleKey}}</div>
                <div class="col third center">{{localize "Category"}}</div>
                {{#if showVolume}}
                <div class="title-volume col third center">{{localize "volume"}}</div>
                {{else}}
                <div class="col third center"></div>
                {{/if}}
                <div class='col ten center flexAlignCenter flexrow'>
                    <button type="button" data-action='selectTraditionItem' data-tradition-kind="{{kind}}" class='icon fas fa-plus noBorder dsadesignbutton very-small' data-tooltip='{{localize pickerTitle}}'></button>
                </div>
            </div>
        </div>
        {{#each items as |item i|}}
        <div class="actor-tradition-artefact-item-wrapper col spells item" data-item-id="{{item._id}}">
            <div class="actor-tradition-artefact-item row-section skills lineheight">
                <div class="actor-tradition-artefact-name col third"><a data-action="itemEdit">{{item.name}}</a></div>
                <div class="actor-tradition-artefact-type col third center">
                    {{#if (lookup item.system ../typeField)}}
                    {{localize (concat ../i18nPrefix '.' (lookup item.system ../typeField))}}
                    {{else}}
                    -
                    {{/if}}
                </div>
                {{#if ../showVolume}}
                <div class="actor-tradition-artefact-volume col third center">{{item.volumeFinal}} / {{item.volume}}</div>
                {{else}}
                <div class="col third center"></div>
                {{/if}}
                <div class="actor-tradition-artefact-action col ten very-small flexrow flexAlignCenter">
                    <button type="button" class="icon fas fa-trash noBorder dsadesignbutton" data-action="traditionItemDelete" data-tradition-kind="{{../kind}}" data-tooltip="SHEET.DeleteItem"></button>
                </div>
            </div>
            {{#if item.abilities}}
            <div class="row-section expandDetails shown">
                <div class="row-section wrap cards col">
                {{#each item.abilities as |ab i|}}
                <div class="item flexrow" data-item-id="{{ab._id}}">
                    {{#if ab.AEpayable}}
                    <button type="button" data-tooltip="SHEET.payAECost" data-action="traditionPayCost" class="noBorder dsadesignbutton icon fas fa-wand-magic-sparkles"></button>{{/if}}
                    {{#if ab.OnUseEffect}}
                    <button type="button" data-tooltip="SHEET.onUseEffect" class="icon fas fa-dice-six noBorder dsadesignbutton" data-action="onUseItem"></button>
                    {{/if}}
                    <a data-action="itemEdit">{{ab.name}}{{roman ab.system.step.value ab.system.maxRank.value}}</a>
                </div>
                {{/each}}
                </div>
            </div>
            {{/if}}
        </div>
        {{/each}}
    </div>
</div>
