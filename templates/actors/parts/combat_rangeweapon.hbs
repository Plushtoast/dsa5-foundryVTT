<div class="combat-weapon-wrapper {{ifThen isSub 'subweapon' ''}} col item" data-item-id="{{item._id}}" data-subweapon="{{isSub}}">
    <div class="combat-weapon row-section">
        <div class="combat-item-image col zerofive image  {{item.system.damageToolTip.css}}" data-tooltip="{{item.system.damageToolTip.msg}}" style="background-image: url('{{item.img}}')">
            {{#if (and item.structureMax (not isSub))}}
            <div class="item-structure" style="--a: {{item.structureMax}}; --b: {{item.structureCurrent}}">
                <div class="inner"></div>
            </div>
            {{/if}}
        </div>
        <div class="combat-item-name three col">
            <a data-action="itemEdit" class="gTooltip" data-category="rangeweaponDetails" data-id="{{item._id}}" data-subweapon="{{isSub}}">{{item.name}}</a>
        </div>

        <div class="combat-item-skill col five center small onlyMultiColumn">
            {{localize item.system.combatskill.value}}
        </div>

        <div class="combat-item-attack col zerofive center item" data-item-id="{{item._id}}" data-mod="attack">
            <a data-mode="attack" data-action="chRollCombat" class="d20 die-attack" data-tooltip="FORMULA.weaponRanged">{{item.attack}}</a>
        </div>
        <div class="combat-item-damage col ten center">
            <a data-mode="damage" data-action="chRollCombat" class="d6 die-damage">{{item.damagedie}}</a><span data-tooltip="{{localize 'damageOverThreshold'}}{{item.damageBonusDescription}}">{{item.damageAdd}}</span>
        </div>

        <div class="combat-item-range col five center max20">
            {{#if (ne item.system.ammunitiongroup.value "-")}}
            <div class="row-section flexAlignCenter">

                <div class="magazinContainer">
                    {{#if item.ammoMax}}
                    <div class="item-structure" style="--a: {{item.ammoMax}}; --b: {{item.ammoCurrent}}">
                        <div class="inner"></div>
                    </div>
                    {{/if}}
                </div>
                {{> systems/dsa5/templates/actors/parts/combat_ammo_button.hbs ammo=item.selectedAmmo action="pickAmmo"}}
                {{> systems/dsa5/templates/actors/parts/combat_ammo_menu.hbs ammo=item.ammo clearAmmo=item.clearAmmo}}
                {{#if (and (ne item.LZ 0) (not (gt item.system.aimTime.progress 0)))}}
                <a data-action="loadWeapon" data-tooltip="{{item.title}}">
                    <div class="progress-dsa5 blue">
                        <span class="progress-left" style="--transformLeft:{{item.transformLeft}}">
                            <span class="progress-bar"></span>
                        </span>
                        <span class="progress-right" style="--transformRight:{{item.transformRight}}">
                            <span class="progress-bar"></span>
                        </span>
                        <div class="progress-value">{{item.progress}}</div>
                    </div>
                </a> {{/if}}

                {{#if (gt item.system.aimTime.progress 0)}}
                <div class="progress-dsa5 blue" data-tooltip="{{item.aimTitle}}">
                    <span class="progress-left" style="--transformLeft:{{item.aimTransformLeft}}">
                        <span class="progress-bar"></span>
                    </span>
                    <span class="progress-right" style="--transformRight:{{item.aimTransformRight}}">
                        <span class="progress-bar"></span>
                    </span>
                    <div class="progress-value">{{item.aimProgress}}</div>
                </div>
                {{/if}}
            </div>
            {{else}}
            <div class="no-ammo">
                - {{#if (and (ne item.LZ 0) (not (gt item.system.aimTime.progress 0)))}}
                <a data-action="loadWeapon" data-tooltip="{{item.title}}">
                    <div class="progress-dsa5 blue">
                        <span class="progress-left" style="--transformLeft:{{item.transformLeft}}">
                            <span class="progress-bar"></span>
                        </span>
                        <span class="progress-right" style="--transformRight:{{item.transformRight}}">
                            <span class="progress-bar"></span>
                        </span>
                        <div class="progress-value">{{item.progress}}</div>
                    </div>
                </a> {{/if}}

                {{#if (gt item.system.aimTime.progress 0)}}
                <div class="progress-dsa5 blue" data-tooltip="{{item.aimTitle}}">
                    <span class="progress-left" style="--transformLeft:{{item.aimTransformLeft}}">
                        <span class="progress-bar"></span>
                    </span>
                    <span class="progress-right" style="--transformRight:{{item.aimTransformRight}}">
                        <span class="progress-bar"></span>
                    </span>
                    <div class="progress-value">{{item.aimProgress}}</div>
                </div>
                {{/if}}
            </div>
            {{/if}}
        </div>
        <div class="combat-item-grip col ten center small">
            <div class="combatGripControls flexrow flexAlignCenter">
                {{#if item.ammoMax}}
                <button type="button" data-action="item-swapMag" class="icon fas autoFlex fa-chevron-down very-small noBorder dsadesignbutton" data-tooltip="SHEET.swapMag"></button>
                {{/if}}

                <div class="combatGripHands flexrow flexAlignCenter {{ifThen item.system.worn.requiresBothHands 'oneButton' 'twoButtons'}}">
                    {{#if item.system.worn.requiresBothHands}}
                    <button type="button"
                        class="combatHandButton dsadesignbutton very-small active"
                        data-tooltip="wrongGrip.twoHanded">
                        <i class="fas fa-hands-helping"></i>
                    </button>
                    {{else}}
                    <button type="button"
                        data-action="swapWeaponHandSlot"
                        data-hand="main"
                        class="combatHandButton dsadesignbutton very-small {{ifThen (not item.system.worn.offHand) 'active' ''}}"
                        data-tooltip="mainHand">
                        <i class="fas fa-hand-paper"></i>
                    </button>
                    <button type="button"
                        data-action="swapWeaponHandSlot"
                        data-hand="offhand"
                        class="combatHandButton dsadesignbutton very-small {{ifThen item.system.worn.offHand 'active' ''}}"
                        data-tooltip="offHand">
                        <i class="fas fa-hand-paper combatHandIconOffhand"></i>
                    </button>
                    {{/if}}
                </div>

                <button type="button" data-action="weaponContextMenu" class="noBorder combatGripMenu combatHandButton dsadesignbutton very-small onlyMultiColumn" data-tooltip="SHEET.EditItem"><i class="fas fa-ellipsis-vertical"></i></button>
            </div>
        </div>
    </div>
</div>
{{#each item.subweapons as |sub key|}}
    {{> systems/dsa5/templates/actors/parts/combat_rangeweapon.hbs item=sub isSub=key}}
{{/each}}