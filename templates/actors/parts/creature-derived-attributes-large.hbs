<div>
    
    <div class="derivedAttrs row-section">
        <div class="col two">
        </div>
        <div class="col eight very-small center" data-tooltip="value">
            {{localize "ABBR.value"}}
        </div>
        <div class="col eight very-small center" data-tooltip="Modifiers">
            {{localize "ABBR.modifiers"}}
        </div>
        <div class="col eight very-small center" data-tooltip="Advances">
            {{localize "ABBR.advances"}}
        </div>
        <div class="col eight very-small center" data-tooltip="max">
            {{localize "ABBR.max"}}
        </div>
    </div>
    <div class="derivedAttrs row-section">
        <div class="col two lineheight">
            <span data-tooltip="FORMULA.creature.wounds">{{localize "wounds"}}</span>
            {{#if prepare.canAdvance}}
            <a data-attr="wounds" class="advance" data-action="advanceWrapper" data-fct="_refundPointsAdvance"><i class="fas fa-minus"></i></a>
            <a data-attr="wounds" class="advance" data-action="advanceWrapper" data-fct="_advancePoints"><i class="fas fa-plus"></i></a>
            {{/if}}
        </div>
        <div class="col eight lineheight center">
            {{formInput systemFields.status.fields.wounds.fields.initial value=document.system.status.wounds.initial}}
        </div>
        <div class="col eight center">
            {{formInput systemFields.status.fields.wounds.fields.modifier value=document.system.status.wounds.modifier}}
        </div>
        <div class="col eight center">
            {{formInput systemFields.status.fields.wounds.fields.advances value=document.system.status.wounds.advances}}
        </div>
        <div class="col eight lineheight center">
            {{document.system.status.wounds.max}}
        </div>
    </div>
    {{#if prepare.magic.hasSpells}}
    <div class="derivedAttrs row-section">
        <div class="col two lineheight">
            <span data-tooltip="FORMULA.creature.astralenergy">{{localize "astralenergy"}}</span>
            {{#if prepare.canAdvance}}
            <a data-attr="astralenergy" class="advance" data-action="advanceWrapper" data-fct="_refundPointsAdvance"><i class="fas fa-minus"></i></a>
            <a data-attr="astralenergy" class="advance" data-action="advanceWrapper" data-fct="_advancePoints"><i class="fas fa-plus"></i></a>
            {{/if}}
        </div>
        <div class="col eight lineheight center">
            {{document.system.status.astralenergy.current}}
        </div>
        <div class="col eight center">
            {{formInput systemFields.status.fields.astralenergy.fields.modifier value=document.system.status.astralenergy.modifier}}
        </div>
        <div class="col eight center">
            {{formInput systemFields.status.fields.astralenergy.fields.advances value=document.system.status.astralenergy.advances}}
        </div>
        <div class="col eight lineheight center">
            {{document.system.status.astralenergy.max}}

        </div>
    </div>
    {{/if}} {{#if prepare.magic.hasPrayers}}
    <div class="derivedAttrs row-section">
        <div class="col two lineheight">
            <span data-tooltip="FORMULA.creature.karmaenergy">{{localize "karmaenergy"}}</span>
            {{#if prepare.canAdvance}}
            <a data-attr="karmaenergy" class="advance" data-action="advanceWrapper" data-fct="_refundPointsAdvance"><i class="fas fa-minus"></i></a>
            <a data-attr="karmaenergy" class="advance" data-action="advanceWrapper" data-fct="_advancePoints"><i class="fas fa-plus"></i></a>
            {{/if}}
        </div>
        <div class="col eight lineheight center">
            {{document.system.status.karmaenergy.current}}
        </div>
        <div class="col eight center">
            {{formInput systemFields.status.fields.karmaenergy.fields.modifier value=document.system.status.karmaenergy.modifier}}
        </div>
        <div class="col eight center">
            {{formInput systemFields.status.fields.karmaenergy.fields.advances value=document.system.status.karmaenergy.advances}}
        </div>
        <div class="col eight lineheight center">
            {{document.system.status.karmaenergy.max}}
        </div>
    </div>
    {{/if}}
    <div class="derivedAttrs row-section">
        <div class="col two lineheight">
            <span data-tooltip="FORMULA.creature.soulpower">{{localize "soulpower"}}</span>
        </div>
        <div class="col eight lineheight center">
            {{formInput systemFields.status.fields.soulpower.fields.value value=document.system.status.soulpower.value}}
        </div>
        <div class="col eight center">
            {{formInput systemFields.status.fields.soulpower.fields.modifier value=document.system.status.soulpower.modifier}}
        </div>
        <div class="col eight"></div>
        <div class="col eight lineheight center">
            {{document.system.status.soulpower.max}}

        </div>
    </div>
    <div class="derivedAttrs row-section">
        <div class="col two lineheight">
            <span data-tooltip="FORMULA.creature.toughness">{{localize "toughness"}}</span>
        </div>
        <div class="col eight lineheight center">
            {{formInput systemFields.status.fields.toughness.fields.value value=document.system.status.toughness.value}}
        </div>
        <div class="col eight center">
            {{formInput systemFields.status.fields.toughness.fields.modifier value=document.system.status.toughness.modifier}}
        </div>
        <div class="col eight"></div>
        <div class="col eight lineheight center">
            {{document.system.status.toughness.max}}
        </div>
    </div>
    <div class="derivedAttrs row-section">
        <div class="col two lineheight flexrow">
            <span data-tooltip="{{ifThen document.system.config.defense 'FORMULA.creature.defense' 'FORMULA.dodge'}}">{{localize (ifThen document.system.config.defense "defense" "dodge")}}</span> <button type="button" data-action="defenseToggle" class="defenseToggle icon dsadesignbutton noBorder"><i class="fas fa-shield-alt {{#unless document.system.config.defense}}off{{/unless}}"></i></button>
        </div>
        <div class="col eight lineheight center">
            {{document.system.status.dodge.value}}
        </div>
        <div class="col eight center">
            {{formInput systemFields.status.fields.dodge.fields.modifier value=document.system.status.dodge.modifier}}
        </div>
        <div class="col eight"></div>
        <div class="col eight lineheight center">
            {{document.system.status.dodge.max}}
        </div>
    </div>
    <div class="derivedAttrs row-section">
        <div class="col two lineheight">
            <span data-tooltip="FORMULA.creature.actionCount">{{localize "actionCount"}}</span>
        </div>
        <div class="col eight lineheight center">
        </div>
        <div class="col eight center">
        </div>
        <div class="col eight"></div>
        <div class="col eight lineheight center">
            {{formInput systemFields.actionCount.fields.value value=document.system.actionCount.value}}
        </div>
    </div>
    <div class="derivedAttrs row-section">
        <div class="col two lineheight">
            <span data-tooltip="FORMULA.creature.conjuringDifficulty">{{localize "conjuringDifficulty"}}</span>
        </div>
        <div class="col eight lineheight center">
        </div>
        <div class="col eight center">
        </div>
        <div class="col eight"></div>
        <div class="col eight lineheight center">
            {{formInput systemFields.conjuringDifficulty.fields.value value=document.system.conjuringDifficulty.value}}
        </div>
    </div>
    <div class="derivedAttrs row-section">
        <div class="col two lineheight">
            <span data-tooltip="FORMULA.creature.count">{{localize "count"}}</span>
        </div>
        <div class="col two lineheight center">
            {{formInput systemFields.count.fields.value value=document.system.count.value}}
        </div>
    </div>
    <div class="derivedAttrs row-section">
        <div class="col two lineheight">
            <span data-tooltip="FORMULA.sizeCategory">{{localize "sizeCategory"}}</span>
        </div>
        <div class="col two lineheight center">
            {{formInput systemFields.status.fields.size.fields.value value=document.system.status.size.value localize=true}}
        </div>
    </div>
    <div class="derivedAttrs row-section">
        <div class="col two lineheight flexrow">
            <span data-tooltip="FORMULA.creature.speed">{{localize "speed"}}</span> <button type="button" class="icon dsadesignbutton noBorder fas fa-plus very-small" data-tooltip="TT.addSpeedCategory" data-action="addSpeedCategory"></button>
        </div>
        <div class="col eight lineheight center">
            {{formInput systemFields.status.fields.speed.fields.initial value=document.system.status.speed.initial}}
        </div>
        <div class="col eight center">
            {{formInput systemFields.status.fields.speed.fields.modifier value=document.system.status.speed.modifier}}
        </div>
        <div class="col eight">
        </div>
        <div class="col eight lineheight center">
            {{document.system.status.speed.max}}
        </div>
    </div>
    {{#if document.system.status.speed.air}}
    <div class="derivedAttrs row-section">
        <div class="col two lineheight flexrow">
            <span>&nbsp;&nbsp;&nbsp;{{localize "SPEEDSELECTOR.air"}}</span>
        </div>
        <div class="col eight lineheight center">
            {{formInput systemFields.status.fields.speed.fields.air value=document.system.status.speed.air}}
        </div>
        <div class="col eight center">
        </div>
        <div class="col eight">
        </div>
        <div class="col eight lineheight center">
            {{document.system.status.speed.air}}
        </div>
    </div>
    {{/if}}
    {{#if document.system.status.speed.water}}
    <div class="derivedAttrs row-section">
        <div class="col two lineheight flexrow">
            <span>&nbsp;&nbsp;&nbsp;{{localize "SPEEDSELECTOR.water"}}</span>
        </div>
        <div class="col eight lineheight center">
            {{formInput systemFields.status.fields.speed.fields.water value=document.system.status.speed.water}}
        </div>
        <div class="col eight center">
        </div>
        <div class="col eight">
        </div>
        <div class="col eight lineheight center">
            {{document.system.status.speed.water}}
        </div>
    </div>
    {{/if}}
    <div class="derivedAttrs row-section">
        <div class="col two lineheight" data-tooltip="FORMULA.creature.initiative">
            {{localize "initiative"}}
        </div>
        <div class="col eight lineheight center">
            {{formInput systemFields.status.fields.initiative.fields.current value=document.system.status.initiative.current}}
        </div>
        <div class="col eight center">
            {{formInput systemFields.status.fields.initiative.fields.modifier value=document.system.status.initiative.modifier}}
        </div>
        <div class="col eight">
        </div>
        <div class="col eight lineheight center">
            {{floor document.system.status.initiative.value}}
        </div>
    </div>
    <div class="derivedAttrs row-section">
        <div class="col two lineheight">
            <span data-tooltip="FORMULA.initDie">{{localize "initDie"}}</span>
        </div>
        <div class="col two lineheight center">
            {{formInput systemFields.status.fields.initiative.fields.die value=document.system.status.initiative.die}}
        </div>
    </div>
    <div class="derivedAttrs row-section">
        <div class="col two lineheight">
            <span data-tooltip="FORMULA.initDieMod">{{localize "initDieMod"}}</span>
        </div>

        <div class="col two lineheight center">
            {{formInput systemFields.status.fields.initiative.fields.diemodifier value=document.system.status.initiative.diemodifier}}
        </div>
    </div>
    <div class="derivedAttrs row-section">
        <div class="col two lineheight">
            <span data-tooltip="FORMULA.fatePoints">{{localize "fatePoints"}}</span>
        </div>
        <div class="col eight lineheight center">
            {{formInput systemFields.status.fields.fatePoints.fields.current value=document.system.status.fatePoints.current}}
        </div>
        <div class="col eight center">
            {{formInput systemFields.status.fields.fatePoints.fields.modifier value=document.system.status.fatePoints.modifier}}
        </div>
        <div class="col eight">

        </div>
        <div class="col eight lineheight center">
            {{document.system.status.fatePoints.max}}
        </div>
    </div>
    {{> systems/dsa5/templates/actors/parts/temperature.hbs}}
</div>