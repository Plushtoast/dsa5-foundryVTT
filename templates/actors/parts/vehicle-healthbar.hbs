<div class="row-section vehicle-healthbars" style="margin-top:10px;">
  <div class="col flexrow regenContainer fourty">
    <div class="healthbar vehicle-stp-bar barLeft soloBar" data-tooltip="VEHICLE.structurePoints">
      <i class="fas fa-ship vehicle-bar-icon" aria-hidden="true"></i>
      <div class="bar decolorizeFilter vehicleStP" style="--a: {{document.system.status.structurePoints.value}}; --b: {{document.system.status.structurePoints.max}};"></div>
      <div class="barLabel">
        {{formInput systemFields.status.fields.structurePoints.fields.value value=document.system.status.structurePoints.value tooltip="Current"}} /
        <span data-tooltip="max">{{document.system.status.structurePoints.max}}</span>
      </div>
    </div>
  </div>
  <div class="col flexrow regenContainer fourty">
    <div class="healthbar vehicle-crew-bar barRight soloBar" data-tooltip="VEHICLE.crewCurrent">
      <i class="fas fa-users vehicle-bar-icon" aria-hidden="true"></i>
      <div class="bar decolorizeFilter vehicleCrew" style="--a: {{document.system.status.crew.value}}; --b: {{document.system.status.crew.max}};"></div>
      <div class="barLabel">
        {{formInput systemFields.status.fields.crew.fields.value value=document.system.status.crew.value tooltip="VEHICLE.crewCurrent"}} /
        <span data-tooltip="VEHICLE.crewCapacity">{{document.system.status.crew.max}}</span>
      </div>
    </div>
  </div>
</div>
