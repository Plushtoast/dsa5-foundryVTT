<div class="groupbox">
    <legend class="table-title lineheight">{{localize "advantages"}}</legend>
    <div class="row-section wrap cards">
        {{#each prepare.advantages as |item i|}}
        <div class="item" data-item-id="{{item._id}}">
            <a data-action="itemEdit">{{item.name}}{{roman item.system.step.value item.system.max.value}}</a>
        </div>
        {{/each}}
    </div>
</div>

<div class="groupbox">
    <legend class="table-title lineheight">{{localize "disadvantages"}}</legend>
    <div class="row-section wrap cards">
        {{#each prepare.disadvantages as |item i|}}
        <div class="item" data-item-id="{{item._id}}">
            <a data-action="itemEdit">{{item.name}}{{roman item.system.step.value item.system.max.value}}</a>
        </div>
        {{/each}}
    </div>
</div>

{{> systems/dsa5/templates/actors/parts/specblock.hbs currentCat="general"}}

{{#if prepare.imprint}}
<div class="groupbox">
    <legend class="table-title lineheight">{{localize "TYPES.Item.imprint"}}</legend>
    <div class="row-section wrap cards">
        {{#each prepare.imprint as |item i|}}
        <div class="item" data-item-id="{{item._id}}">
            <a data-action="itemEdit">{{item.name}}</a>
        </div>
        {{/each}}
    </div>
</div>
{{/if}}

{{#if (or (eq document.type "creature") prepare.hasTrait)}}
<div class="groupbox">
    <legend class="table-title lineheight flexrow">
        <b>{{localize "traits"}}</b>
        <button type="button" data-action="itemCreate" class="icon dsadesignbutton noBorder fas fa-plus very-small"
            data-tooltip="SHEET.addItem" item-section="trait" data-type="trait"></button>        
        {{#if (eq document.type "creature")}}
        <button type="button" data-action="traitCompanionContextMenu"
            class="icon dsadesignbutton noBorder fas fa-ellipsis-vertical very-small"
            data-tooltip="COMPANIONS.TraitMenu.tooltip"></button>
        {{/if}}
    </legend>
    <div class="row-section wrap cards">
        {{#each prepare.traits as |trait i|}}
        {{#each trait as |item i|}}
        <div class="item flexrow" data-item-id="{{item._id}}">
            {{#if item.OnUseEffect}}
            <button type="button" data-tooltip="SHEET.onUseEffect" class="icon noBorder dsadesignbutton fas fa-dice-six"
                data-action="onUseItem"></button>
            {{/if}}
            <a data-action="itemEdit">{{item.name}}{{roman
                item.system.step.value item.system.at.value}}</a>
        </div>
        {{/each}}
        {{/each}}
    </div>
</div>
{{/if}}