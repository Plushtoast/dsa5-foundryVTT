<div class="actor-combat-skill groupbox">
    <div class="row-section">
        <div class="col nintey header-label lineheight">
            <b>{{localize "TYPES.Item.combatskill"}}</b>
        </div>
        <div class="combat-skills-collapse col lineheight ten center">
            <a data-action="chCollapse" class="ch-collapse"><i class="fas fa-angle-up" data-tooltip="SHEET.collapse"></i></a>
        </div>
    </div>
    <div class="row-section wrap">
        <div class="col morph">
            <div class="row-section skills table-title">
                <div class="col fourty">
                    {{localize "TYPES.Item.combatskill"}}
                </div>
                <div class="col five center">
                    {{{localize "guidevalue_small"}}}
                </div>

                <div class="col fifteen center" data-tooltip="KTW">
                    {{localize "CHARAbbrev.KTW"}}
                </div>
                <div class="col eight center" data-tooltip="FORMULA.attack">
                    {{localize "CHARAbbrev.ATFK"}}
                </div>
                <div class="col eight center" data-tooltip="FORMULA.parry">
                    {{localize "CHARAbbrev.PA"}}
                </div>
            </div>
        </div>
        <div class="col morph onlyMultiColumn">
            <div class="row-section skills table-title">
                <div class="col fourty">
                    {{localize "TYPES.Item.combatskill"}}
                </div>
                <div class="col five center">
                    {{{localize "guidevalue_small"}}}
                </div>

                <div class="col fifteen center" data-tooltip="KTW">
                    {{localize "CHARAbbrev.KTW"}}
                </div>
                <div class="col eight center" data-tooltip="FORMULA.attack">
                    {{localize "CHARAbbrev.ATFK"}}
                </div>
                <div class="col eight center" data-tooltip="FORMULA.parry">
                    {{localize "CHARAbbrev.PA"}}
                </div>
            </div>
        </div>
        {{#each prepare.combatskills as |item i|}}
        <div class="actor-combat-skill-item col morph">
            <div class="row-section col item skills lineheight" data-item-id="{{item._id}}">
                <div class="col fourty">
                    <a data-action="itemEdit">{{item.name}}</a>
                </div>
                <div class="col five center">
                    {{localize (concatUp "CHARAbbrev." item.system.guidevalue.value)}}
                </div>

                <div class="col fifteen center flexrow advanceOntop">
                    {{#if ../prepare.canAdvance}}
                    <a class="advance icon fas fa-minus flex0" data-action="advanceWrapper" data-fct="_refundItemAdvance" data-attr="{{item._id}}"></a>
                    {{/if}}
                    <input class="skill-advances" type="number" value="{{item.system.talentValue.value}}" />
                    {{#if ../prepare.canAdvance}}
                    <a class="advance icon fas fa-plus flex0" data-action="advanceWrapper" data-fct="_advanceItem" data-attr="{{item._id}}"></a>
                    {{/if}}
                </div>
                <div class="col eight center item" data-item-id="{{item._id}}" data-mod="attack">
                    <a data-mode="attack" data-action="chRollCombat" class="d20 diet-mu" data-tooltip="{{ifThen (eq item.system.weapontype.value 0) 'FORMULA.attackMelee' 'FORMULA.ranged'}}">{{item.system.attack.value}}</a>
                </div>
                <div class="col eight center item" data-item-id="{{item._id}}" data-mod="parry">
                    {{#if (eq item.system.weapontype.value 0)}} <a data-mode="parry" data-action="chRollCombat" class="d20 diet-in" data-tooltip="FORMULA.parry">{{item.system.parry.value}}</a> {{else}}- {{/if}}
                </div>
            </div>
        </div>
        {{/each}}
        {{#if (oddLength prepare.combatskills)}}
        <div class="col morph">
        </div>
        {{/if}}
    </div>
</div>