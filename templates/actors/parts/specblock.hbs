{{#each (lookup prepare.sortedSpecs currentCat) as |cat|}}
{{#if (lookup ../prepare.specAbs cat)}}
<div class="groupbox">
    <legend class="table-title lineheight flexrow">
        <span>{{localize (concat "SpecCategory." cat)}}{{#if (eq cat 'language')}}
        {{{../prepare.languagePoints}}}{{/if}}</span>
        <button class="icon noBorder dsadesignbutton flex0 fas fa-circle-info flexAlignEnd" data-tooltip-html="{{specCategoryHelp cat}}"></button>
    </legend>
    <div class="row-section wrap cards">
        {{#each (lookup ../prepare.specAbs cat) as |item i|}}
        <div class="item flexrow" data-item-id="{{item._id}}">
            {{#if item.OnUseEffect}}
            <button type="button" data-tooltip="SHEET.onUseEffect" class="icon noBorder dsadesignbutton fas fa-dice-six"
                data-action="onUseItem"></button>
            {{/if}}
            <a data-action="itemEdit">{{item.name}}{{roman item.system.step.value item.system.maxRank.value}}</a>
        </div>
        {{/each}}
    </div>
</div>
{{/if}}
{{/each}}