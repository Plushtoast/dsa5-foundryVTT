<div class="combat-weapon {{ifThen isSub 'subweapon' ''}} col item row-section" data-item-id="{{item._id}}" data-subweapon="{{isSub}}">
    <div class="combat-item-image col zerofive image {{item.system.damageToolTip.css}}" data-tooltip="{{item.system.damageToolTip.msg}}" style="background-image: url('{{item.img}}')">
        {{#if (and item.structureMax (not isSub))}}
        <div class="item-structure" style="--a: {{item.structureMax}}; --b: {{item.structureCurrent}}">
            <div class="inner"></div>
        </div>
        {{/if}}
    </div>
    <div class="combat-item-name three col ellipsis">
        <a data-action="itemEdit">{{item.name}}</a>
    </div>

    <div class="combat-item-skill col ellipsis fifteen center small onlyMultiColumn">
       {{localize item.system.combatskill.value}}
    </div>
    <div class="combat-item-attack col zerofive center item" data-item-id="{{item._id}}" data-subweapon="{{isSub}}" data-mod="attack">
        <a data-mode="attack" data-action="chRollCombat" class="d20 die-attack">{{item.attack}}</a>
    </div>
    <div class="combat-item-parry col zerofive center item" data-item-id="{{item._id}}" data-subweapon="{{isSub}}" data-mod="parry">
        <a data-mode="parry" data-action="chRollCombat" class="d20 die-parry">{{item.parry}}</a>
    </div>

    <div class="combat-item-damage col ten center">
        <a data-mode="damage" data-action="chRollCombat" class="d6 die-damage"><span>{{item.damagedie}}</span></a><span data-tooltip="{{localize 'damageOverThreshold'}}{{item.gripDamageText}}">{{item.damageAdd}}</span>
    </div>
    <div class="combat-item-range col row-section ten center small notOnMinimum">
        <div class="col hundred center">
            {{localize (concat "Range-" item.system.reach.value)}}
        </div>
    </div>

    <div class="combat-item-grip col ten center small">
        <div class="combatGripControls flexrow flexAlignCenter">
            <div class="combatGripHands flexrow flexAlignCenter {{ifThen item.wieldedTwoHand 'oneButton' 'twoButtons'}}">
                {{#if item.wieldedTwoHand}}
                <button type="button"
                    data-action="swapWeaponHand"
                    class="combatHandButton dsadesignbutton very-small active"
                    data-tooltip="{{ifThen item.wieldedTwoHand 'wrongGrip.twoHanded' 'wrongGrip.oneHanded'}}">
                    <i class="fas {{ifThen item.wieldedTwoHand 'fa-hands-helping' 'fa-hand-paper'}}"></i>
                </button>
                {{else}}
                <button type="button"
                    data-action="swapWeaponHandSlot"
                    data-hand="main"
                    class="combatHandButton dsadesignbutton very-small {{ifThen (not item.system.worn.offHand) 'active' ''}}"
                    data-tooltip="mainHand">
                    <i class="fas fa-hand-paper"></i>
                </button>
                <button type="button"
                    data-action="swapWeaponHandSlot"
                    data-hand="offhand"
                    class="combatHandButton dsadesignbutton very-small {{ifThen item.system.worn.offHand 'active' ''}}"
                    data-tooltip="offHand">
                    <i class="fas fa-hand-paper combatHandIconOffhand"></i>
                </button>
                {{/if}}
            </div>

            <button type="button" data-action="weaponContextMenu" class="noBorder combatGripMenu combatHandButton dsadesignbutton very-small onlyMultiColumn" data-tooltip="SHEET.EditItem"><i class="fas fa-ellipsis-vertical"></i></button>
        </div>
    </div>
</div>
{{#each item.subweapons as |sub key|}}
    {{> systems/dsa5/templates/actors/parts/combat_weapon.hbs item=sub isSub=key}}
{{/each}}