<div class="actor-carry-box row-section wrap">
    {{#if prepare.canAdvance}}
    <div class="col morph">
        <fieldset>
            <legend>{{localize "carrycapacity"}}</legend>
            <div class="row-section table-title">
                <div class="col three center">
                    {{localize "carrycapacity"}}
                </div>
                <div class="col three center">
                    {{localize "Current"}}
                </div>
                <div class="col three center">
                    {{localize "encumbrance"}}
                </div>
            </div>
            <div class="actor-carry row-section">
                <div class="col three center lineheight">
                    {{prepare.carrycapacity}}
                </div>
                <div class="col three center lineheight">
                    {{prepare.totalWeight}}
                </div>
                <div class="col three center lineheight">
                    {{prepare.encumbrance}}
                </div>
            </div>
        </fieldset>
    </div>
    {{/if}}
    <div class="col morph">
        {{> systems/dsa5/templates/actors/parts/purse.hbs}}
    </div>
</div>