<fieldset class='actor-purse gap0px'>
  <legend>{{localize 'purse'}} {{#if prepare.moneyWeight}}<small>{{numberFormat prepare.moneyWeight decimals=2}} <i class='fas fa-anchor'></i></small>{{/if}}</legend>
  {{#grouped_each 4 prepare.money.coins}}
    <div class='row-section table-title'>
      {{#each this}}
        <div class='col four center item lineheight' data-item-id='{{_id}}'>
          <a data-action='itemEdit' class='withContext'>{{localize name}}</a>
        </div>
      {{/each}}
    </div>
    <div class='actor-purse-content row-section'>
      {{#each this}}
        <div class='number-input col four center item' data-item-id='{{_id}}'>
          <input class='col-{{name}} money-change' type='number' value='{{system.quantity.value}}' />
        </div>
      {{/each}}
    </div>
  {{/grouped_each}}
</fieldset>