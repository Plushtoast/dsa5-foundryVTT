<div class='tab scrollable gap0px {{tabs.magic.cssClass}}' data-tab='magic' data-group='{{tabs.magic.group}}'>
    {{> systems/dsa5/templates/actors/parts/spells.hbs}}

    {{> systems/dsa5/templates/actors/parts/specblock.hbs currentCat="magical"}}

    <div class="row-section">

        <div class="col ">
            <div class="groupbox">
                <legend class="table-title lineheight flexrow">
                    <span>{{localize "magictricks"}}</span>
                    <button type="button" class="icon noBorder dsadesignbutton flex0 fas fa-circle-info flexAlignEnd" data-tooltip-html="{{spellCategoryHelp 'magictrick'}}"></button>
                </legend>
                <div class="row-section wrap cards">
                    {{#each prepare.magic.magictrick as |item i|}}
                    <div class="item" data-item-id="{{item._id}}">
                        <a data-action="itemEdit">{{item.name}}</a>
                    </div>
                    {{/each}}
                </div>

            </div>
            {{> systems/dsa5/templates/actors/parts/magicalSigns.hbs}}
            {{> systems/dsa5/templates/actors/parts/patrons.hbs}}
        </div>
    </div>
</div>