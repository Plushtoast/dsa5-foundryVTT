<header class="sheet-header">

    <div class="headerInput">
        <input class="input name" name="name" style="width:90%" type="text" value="{{document.name}}"
            placeholder="{{localize 'Name'}}" />
        <a class="actorDrag" data-tooltip="TT.dragLink"><i class="fas fa-link"></i></a>
        <span class="label name">{{localize "Name"}}</span>
    </div>
    <div class="headerInput">
        <input class="input creatureClass" data-dtype="String" name="system.creatureClass.value" type="text"
            value="{{document.system.creatureClass.value}}" placeholder="{{localize 'creatureClass'}}" />
        <span class="label creatureClass ">{{localize "creatureClass"}}</span>
    </div>

</header>