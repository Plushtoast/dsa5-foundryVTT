<header class='sheet-header'>
  <div class='row-section'>
    <div class='charname headerInput col sixty row-section'>
      <div class='col eighty'>
        {{formInput fields.name value=document.name placeholder=(localize 'Name')}}
        <span class='label name'>{{localize 'Name'}}</span>
      </div>
      <div class='col ten'>
        <a class='actorDrag' data-tooltip='TT.dragLink'><i class='fas fa-link'></i></a>
      </div>
    </div>
    <div class="headerInput col fourty">
        {{formInput systemFields.creatureClass.fields.value value=document.system.creatureClass.value placeholder=(localize 'creatureClass')}}
        <span class="label creatureClass ">{{localize "creatureClass"}}</span>
    </div>
  </div>
</header>