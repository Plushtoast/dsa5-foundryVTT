<div class='tab scrollable {{tabs.religion.cssClass}}' data-tab='religion'
    data-group='{{tabs.religion.group}}'>

    {{> systems/dsa5/templates/actors/parts/liturgies.hbs}}

    {{> systems/dsa5/templates/actors/parts/specblock.hbs currentCat="clerical"}}

    <div class="row-section">

        <div class="col ">
            <fieldset>
                <legend>{{localize "blessings"}}</legend>
                <div class="row-section wrap cards">
                    {{#each prepare.magic.blessing as |item i|}}
                    <div class="item" data-item-id="{{item._id}}">
                        <a data-action="itemEdit">{{item.name}}</a>
                    </div>
                    {{/each}}
                </div>

            </fieldset>
        </div>
    </div>
</div>