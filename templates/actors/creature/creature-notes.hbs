<div class='tab scrollable gap0px {{tabs.notes.cssClass}} width100' data-tab='notes' data-group='{{tabs.notes.group}}'>
    {{> systems/dsa5/templates/actors/parts/information.hbs}}
    {{> systems/dsa5/templates/actors/parts/personaltrait.hbs}}

    <div class="groupbox">
        <legend class="table-title lineheight">{{localize "Description"}} <a data-action="chCollapse" class="ch-collapse"><i class="fas fa-angle-up"
                    data-tooltip="SHEET.collapse"></i></a></legend>

        <div class="row-section">
            <div class="col notes-box">
                {{formInput systemFields.description.fields.value value=document.system.description.value toggled=true enriched=enrichedDescription disabled=(not owner)}}
            </div>
        </div>
    </div>
    <div class="groupbox">
        <legend class="table-title lineheight">{{localize "behaviour"}} <a data-action="chCollapse" class="ch-collapse"><i class="fas fa-angle-up"
                    data-tooltip="SHEET.collapse"></i></a></legend>

        <div class="row-section">
            <div class="col notes-box">
                {{formInput systemFields.behaviour.fields.value value=document.system.behaviour.value toggled=true enriched=enrichedBehaviour disabled=(not owner)}}
            </div>
        </div>
    </div>
    <div class="groupbox">
        <legend class="table-title lineheight">{{localize "flight"}} <a data-action="chCollapse" class="ch-collapse"><i class="fas fa-angle-up"
                    data-tooltip="SHEET.collapse"></i></a></legend>

        <div class="row-section">
            <div class="col notes-box">
                {{formInput systemFields.flight.fields.value value=document.system.flight.value toggled=true enriched=enrichedFlight disabled=(not owner)}}
            </div>
        </div>
    </div>
    <div class="groupbox">
        <legend class="table-title lineheight">{{localize "specialRules"}} <a data-action="chCollapse" class="ch-collapse"><i class="fas fa-angle-up"
                    data-tooltip="SHEET.collapse"></i></a></legend>

        <div class="row-section">
            <div class="col notes-box">
                {{formInput systemFields.specialRules.fields.value value=document.system.specialRules.value toggled=true enriched=enrichedSpecialrules disabled=(not owner)}}
            </div>
        </div>
    </div>
    <div class="groupbox keepFieldsEnabled" data-attr="system.details.notes.value" data-name="Notes">
        <legend class="table-title lineheight flexrow">{{localize "Notes"}}
            {{#unless notesInlineEditable}}
            <button type="button" class="icon fas fa-edit noBorder dsadesignbutton keep-field-edit" data-action="editKeepField" data-tooltip="{{localize 'Edit'}}"></button>
            {{/unless}}
            <a data-action="chCollapse" class="ch-collapse"><i class="fas fa-angle-up"
                    data-tooltip="SHEET.collapse"></i></a></legend>
        <div class="row-section">
            <div class="col notes-box">
                {{#if notesInlineEditable}}
                {{formInput systemFields.details.fields.notes.fields.value value=document.system.details.notes.value toggled=true enriched=enrichedNotes}}
                {{else}}
                {{formInput systemFields.details.fields.notes.fields.value value=document.system.details.notes.value toggled=true disabled=true enriched=enrichedNotes}}
                {{/if}}
            </div>
        </div>
    </div>
    {{#if owner}}
    <div class="groupbox">
        <legend class="table-title lineheight">{{localize "ownerNotes"}} <a data-action="chCollapse" class="ch-collapse"><i class="fas fa-angle-up"
                    data-tooltip="SHEET.collapse"></i></a></legend>

        <div class="row-section">
            <div class="col notes-box">
                {{formInput systemFields.details.fields.notes.fields.ownerdescription value=document.system.details.notes.ownerdescription toggled=true enriched=enrichedOwnerdescription disabled=notesReadOnly}}
            </div>
        </div>
    </div>
    {{/if}}
</div>
