<div class='tab scrollable gap0px {{tabs.notes.cssClass}} width100' data-tab='notes' data-group='{{tabs.notes.group}}'>
    {{> systems/dsa5/templates/actors/parts/information.hbs}}
    {{> systems/dsa5/templates/actors/parts/personaltrait.hbs}}

    <div class="groupbox">
        <legend class="table-title lineheight">{{localize "Description"}} <a data-action="chCollapse" class="ch-collapse"><i class="fas fa-angle-up"
                    data-tooltip="SHEET.collapse"></i></a></legend>

        <div class="row-section">
            <div class="col notes-box">
                {{formInput systemFields.description.fields.value value=document.system.description.value toggled=true enriched=enrichedDescription}}
            </div>
        </div>
    </div>
    <div class="groupbox">
        <legend class="table-title lineheight">{{localize "behaviour"}} <a data-action="chCollapse" class="ch-collapse"><i class="fas fa-angle-up"
                    data-tooltip="SHEET.collapse"></i></a></legend>

        <div class="row-section">
            <div class="col notes-box">
                {{formInput systemFields.behaviour.fields.value value=document.system.behaviour.value toggled=true enriched=enrichedBehaviour}}
            </div>
        </div>
    </div>
    <div class="groupbox">
        <legend class="table-title lineheight">{{localize "flight"}} <a data-action="chCollapse" class="ch-collapse"><i class="fas fa-angle-up"
                    data-tooltip="SHEET.collapse"></i></a></legend>

        <div class="row-section">
            <div class="col notes-box">
                {{formInput systemFields.flight.fields.value value=document.system.flight.value toggled=true enriched=enrichedFlight}}
            </div>
        </div>
    </div>
    <div class="groupbox">
        <legend class="table-title lineheight">{{localize "specialRules"}} <a data-action="chCollapse" class="ch-collapse"><i class="fas fa-angle-up"
                    data-tooltip="SHEET.collapse"></i></a></legend>

        <div class="row-section">
            <div class="col notes-box">
                {{formInput systemFields.specialRules.fields.value value=document.system.specialRules.value toggled=true enriched=enrichedSpecialrules}}
            </div>
        </div>
    </div>
    {{#if document.isOwner}}
    <div class="groupbox">
        <legend class="table-title lineheight">{{localize "ownerNotes"}} <a data-action="chCollapse" class="ch-collapse"><i class="fas fa-angle-up"
                    data-tooltip="SHEET.collapse"></i></a></legend>

        <div class="row-section">
            <div class="col notes-box">
                {{formInput systemFields.details.fields.notes.fields.ownerdescription value=document.system.details.notes.ownerdescription toggled=true enriched=enrichedOwnerdescription}}
            </div>
        </div>
    </div>
    {{/if}}
</div>