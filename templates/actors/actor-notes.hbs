<div class='tab scrollable {{tabs.notes.cssClass}}' data-tab='notes' data-group='{{tabs.notes.group}}'
    class='tab'>
    <fieldset class="actor-notes">
        <legend>{{localize "personalDetails"}}</legend>
        <div class="row-section">
            <section class="general col">
                <div class="row-section wrap">
                    <div class="col morph">
                        <div class="col row-section">
                            <div class="headerInput col two">
                                {{formInput systemFields.details.fields.gender.fields.value value=document.system.details.gender.value placeholder=(localize 'Gender')}}
                                <span class="label-details">{{localize "Gender"}}</span>
                            </div>

                            <div class="headerInput col two">
                                {{formInput systemFields.details.fields.culture.fields.value value=document.system.details.culture.value placeholder=(localize 'TYPES.Item.culture')}}
                                <span class="label-details">{{localize "TYPES.Item.culture"}}</span>
                            </div>
                        </div>
                        <div class="col row-section">
                            <div class="headerInput col two">
                                {{formInput systemFields.details.fields.family.fields.value value=document.system.details.family.value placeholder=(localize 'Family')}}
                                <span class="label-details">{{localize "Family"}}</span>
                            </div>

                            <div class="headerInput col two">
                                {{formInput systemFields.details.fields.age.fields.value value=document.system.details.age.value placeholder=(localize 'Age')}}
                                <span class="label-details">{{localize "Age"}}</span>
                            </div>
                        </div>
                        <div class="col row-section">

                            <div class="headerInput col two">
                                {{formInput systemFields.details.fields.height.fields.value value=document.system.details.height.value placeholder=(localize 'Height')}}
                                <span class="label-details">{{localize "Height"}}</span>
                            </div>

                            <div class="headerInput col two">
                                {{formInput systemFields.details.fields.weight.fields.value value=document.system.details.weight.value placeholder=(localize 'Weight')}}
                                <span class="label-details">{{localize "Weight"}}</span>
                            </div>
                        </div>
                    </div>
                    <div class="col morph">
                        <div class="col row-section">
                            <div class="headerInput col two">
                                {{formInput systemFields.details.fields.socialstate.fields.value value=document.system.details.socialstate.value placeholder=(localize 'Socialstate')}}
                                <span class="label-details">{{localize "Socialstate"}}</span>
                            </div>
                            <div class="headerInput col two">
                                {{formInput systemFields.details.fields.Home.fields.value value=document.system.details.Home.value placeholder=(localize 'Home')}}
                                <span class="label-details">{{localize "Home"}}</span>
                            </div>
                        </div>
                        <div class="col row-section">
                            <div class="headerInput col two">
                                {{formInput systemFields.details.fields.haircolor.fields.value value=document.system.details.haircolor.value placeholder=(localize 'Hair_color')}}
                                <span class="label-details">{{localize "Hair_color"}}</span>
                            </div>
                            <div class="headerInput col two">
                                {{formInput systemFields.details.fields.eyecolor.fields.value value=document.system.details.eyecolor.value placeholder=(localize 'Eye_color')}}
                                <span class="label-details">{{localize "Eye_color"}}</span>
                            </div>
                        </div>
                        <div class="col row-section">
                            <div class="headerInput col">
                                {{formInput systemFields.details.fields.distinguishingmark.fields.value value=document.system.details.distinguishingmark.value placeholder=(localize 'Distinguishing_mark')}}
                                <span class="label-details">{{localize "Distinguishing_mark"}}</span>
                            </div>

                        </div>
                    </div>

                </div>

            </section>
        </div>
    </fieldset>

    {{> systems/dsa5/templates/actors/parts/information.hbs}}
    {{> systems/dsa5/templates/actors/parts/personaltrait.hbs}}

    <fieldset>
        <legend>{{localize 'biography'}} <a data-action="chCollapse" class="ch-collapse"><i class="fas fa-angle-up"
                    data-tooltip="SHEET.collapse"></i></a></legend>
        <div class="row-section">
            <div class="col notes-box">
                {{formInput systemFields.details.fields.biography.fields.value value=document.system.details.biography.value toggled=true enriched=enrichedBiography}}
            </div>
        </div>
    </fieldset>
    <fieldset class="keepFieldsEnabled" data-attr="system.details.notes.value" data-name="Notes">
        <legend>{{localize "Notes"}} <a data-action="chCollapse" class="ch-collapse"><i class="fas fa-angle-up"
                    data-tooltip="SHEET.collapse"></i></a></legend>
        <div class="row-section">
            <div class="col notes-box">
                {{formInput systemFields.details.fields.notes.fields.value value=document.system.details.notes.value toggled=true enriched=enrichedNotes}}
            </div>
        </div>
    </fieldset>
    {{#if document.isOwner}}
    <fieldset>
        <legend>{{localize "ownerNotes"}} <a data-action="chCollapse" class="ch-collapse"><i class="fas fa-angle-up"
                    data-tooltip="SHEET.collapse"></i></a></legend>
        <div class="row-section">
            <div class="col notes-box">
                {{formInput systemFields.details.fields.notes.fields.ownerdescription value=document.system.details.notes.ownerdescription toggled=true enriched=enrichedOwnerdescription}}
            </div>
        </div>
    </fieldset>
    {{/if}} {{#if isGM}}
    <fieldset>
        <legend>{{localize "GM Notes"}} <a data-action="chCollapse" class="ch-collapse"><i class="fas fa-angle-up"
                    data-tooltip="SHEET.collapse"></i></a></legend>
        <div class="row-section">
            <div class="col notes-box">
                {{formInput systemFields.details.fields.notes.fields.gmdescription value=document.system.details.notes.gmdescription toggled=true enriched=enrichedGmdescription}}
            </div>
        </div>
    </fieldset>
    {{/if}}
</div>