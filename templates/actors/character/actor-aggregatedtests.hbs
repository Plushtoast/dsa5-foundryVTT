<div class='actor-aggregated-tests groupbox'>
  <div class='row-section table-title lineheight'>
    <div class='title-type col third' data-tooltip="FORMULA.aggregatedTests">
      {{localize 'aggregatedTests'}}
    </div>
    <div class='col third center'>{{localize 'probe'}}</div>
    <div class='col fifteen center'>{{localize 'interval'}}</div>
    <div class='col fifteen center'>{{localize 'probes'}}</div>
    <div class='col fifteen center'>{{localize 'status'}}</div>
    <div class='col ten center flexAlignCenter flexrow'>
      <button type="button" data-action='itemCreate' class='icon fas fa-plus noBorder dsadesignbutton very-small' data-tooltip='SHEET.addItem' item-section='aggregatedTest' data-type='aggregatedTest'></button>
    </div>
  </div>
  <div class='row-section wrap inventory'>
    {{#each prepare.aggregatedtests as |item i|}}
      <div class='actor-aggregated-test-item-wrapper col item' data-item-id='{{item._id}}'>
        <div class='actor-aggregated-test-item row-section skills lineheight'>
          <div class='actor-aggregated-test-name col third centerCell withContext'>
            <a data-action='itemEdit'>{{item.name}}</a>
          </div>
          <div class='actor-aggregated-test col third center row-section wrap centerCell'>
            {{#if item.system.talent.value}}<a class='talent-1-name col eighty' data-action='rollAggregatedProbe' data-which=''>{{item.system.talent.value}}</a><a
                class='talent-1-roll col ten'
                data-action='rollAggregatedProbe'
                data-which=''
              ><div class='d20 die-attack'></div></a>{{/if}}
            {{#if item.system.talent.value2}}<a class='talent-2-name col eighty' data-action='rollAggregatedProbe' data-which='2'>{{item.system.talent.value2}}</a><a
                class='talent-2-roll col ten'
                data-action='rollAggregatedProbe'
                data-which='2'
              ><div class='d20 die-attack'></div></a>{{/if}}
            {{#if item.system.talent.value3}}<a class='talent-3-name col eighty' data-action='rollAggregatedProbe' data-which='3'>{{item.system.talent.value3}}</a><a
                class='talent-3-roll col ten'
                data-action='rollAggregatedProbe'
                data-which='3'
              ><div class='d20 die-attack'></div></a>{{/if}}
          </div>
          <div class='actor-aggregated-test-intervall col fifteen center centerCell'>
            <div class='centerMargin'>{{item.system.interval.value}}</div>
          </div>
          <div class='actor-aggregated-tests-used col fifteen center centerCell'>
            <div class='centerMargin'>{{item.system.usedTestCount.value}} / {{item.system.allowedTestCount.value}}</div>
          </div>
          <div class='actor-aggregated-test-qs col fifteen center centerCell'>
            <div class='centerMargin'>{{item.system.cummulatedQS.value}} / 10</div>
          </div>
          <div class='actor-aggregated-test-action col ten very-small center centerCell flexrow'>
              <button type="button" data-action="itemContextMenu" class="icon fas fa-ellipsis-vertical very-small noBorder dsadesignbutton" data-tooltip="SHEET.EditItem"></button>
          </div>
        </div>
      </div>
    {{/each}}
  </div>
</div>