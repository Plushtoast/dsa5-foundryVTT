<div class='tab scrollable gap0px {{tabs.religion.cssClass}}' data-tab='religion' data-group='{{tabs.religion.group}}'>
    {{> systems/dsa5/templates/actors/parts/liturgies.hbs}}

    {{> systems/dsa5/templates/actors/parts/specblock.hbs currentCat="clerical"}}

    <div class="row-section wrap reverseFlex">
        <div class="col morph">
            <div class="groupbox">
                <legend class="table-title lineheight">{{localize "blessings"}}</legend>
                <div class="row-section wrap cards">
                    {{#each prepare.magic.blessing as |item i|}}
                    <div class="item" data-item-id="{{item._id}}">
                        <a data-action="itemEdit">{{item.name}}</a>
                    </div>
                    {{/each}}
                </div>

            </div>
        </div>
        <div class="col morph">
            <div class="groupbox actor-tradition">
                <legend class="table-title lineheight autosizing">{{formInput systemFields.tradition.fields.clerical value=document.system.tradition.clerical placeholder=(localize 'tradition')}}</legend>

                <div class="actor-tradition-item ">
                    {{formGroup systemFields.guidevalue.fields.clerical value=document.system.guidevalue.clerical
                    localize=true}}
                </div>
                <div class="actor-tradition-item">
                    {{formGroup systemFields.feature.fields.clerical value=document.system.feature.clerical
                    localize=true}}
                </div>
                <div class="actor-tradition-item">
                    {{formGroup systemFields.energyfactor.fields.clerical value=document.system.energyfactor.clerical
                    localize=true}}
                </div>
                <div class="actor-tradition-item">
                    {{formGroup systemFields.happyTalents.fields.value value=document.system.happyTalents.value rows=8
                    localize=true elementType='textarea'}}
                </div>
            </div>
        </div>

    </div>
</div