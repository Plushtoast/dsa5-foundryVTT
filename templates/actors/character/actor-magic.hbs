<div class='tab scrollable gap0px {{tabs.magic.cssClass}}' data-tab='magic' data-group='{{tabs.magic.group}}'>
    {{> systems/dsa5/templates/actors/parts/spells.hbs}}

    {{> systems/dsa5/templates/actors/parts/tradition-items.hbs kind="magical" items=prepare.traditionArtifacts showVolume=true titleKey="SpecCategory.staff" typeField="artifact" i18nPrefix="traditionArtifacts" pickerTitle="SHEET.selectTraditionartifact"}}

    {{> systems/dsa5/templates/actors/parts/specblock.hbs currentCat="magical"}}

    <div class="row-section wrap reverseFlex">
        <div class="col morph">
            <div class="groupbox">
                <legend class="table-title lineheight">{{localize "magictricks"}}</legend>
                <div class="row-section wrap cards">
                    {{#each prepare.magic.magictrick as |item i|}}
                    <div class="item" data-item-id="{{item._id}}">
                        <a data-action="itemEdit">{{item.name}}</a>
                    </div>
                    {{/each}}
                </div>
            </div>
            {{> systems/dsa5/templates/actors/parts/magicalSigns.hbs}}
        </div>
        <div class="col morph">
            <div class="groupbox actor-tradition">
                <legend class="table-title lineheight autosizing" data-tooltip="FORMULA.traditionMagical">{{formInput systemFields.tradition.fields.magical value=document.system.tradition.magical placeholder=(localize 'tradition')}}</legend>
                <div class="actor-tradition-item" data-tooltip="FORMULA.guidevalueMagical">
                    {{formGroup systemFields.guidevalue.fields.magical value=document.system.guidevalue.magical localize=true}}
                </div>
                <div class="actor-tradition-item" data-tooltip="FORMULA.featureMagical">
                    {{formGroup systemFields.feature.fields.magical value=document.system.feature.magical localize=true}}
                </div>
                <div class="actor-tradition-item" data-tooltip="FORMULA.energyfactor">
                    {{formGroup systemFields.energyfactor.fields.magical value=document.system.energyfactor.magical localize=true}}
                </div>
            </div>
        </div>
    </div>
</div>