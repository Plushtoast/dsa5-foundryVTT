<div class='tab scrollable gap0px {{tabs.magic.cssClass}}' data-tab='magic' data-group='{{tabs.magic.group}}'>
    {{> systems/dsa5/templates/actors/parts/spells.hbs}}

    <div class="actor-tradition-artefacts groupbox">
        <div class="row-section wrap inverseRowtable">
            <div class="col">
                <div class="row-section skills table-title lineheight">
                    <div class="title-type col third">{{localize "SpecCategory.staff"}}</div>
                    <div class="col third center">{{localize "Category"}}</div>
                    <div class="title-volume col third center">{{localize "volume"}}</div>
                    <div class='col ten center flexAlignCenter flexrow'>
                        <button type="button" data-action='selectTraditionartifact' class='icon fas fa-plus noBorder dsadesignbutton very-small' data-tooltip='SHEET.selectTraditionartifact'></button>
                    </div>
                </div>
            </div>
            {{#each prepare.traditionArtifacts as |item i|}}
            <div class="actor-tradition-artefact-item-wrapper col spells item" data-item-id="{{item._id}}">
                <div class="actor-tradition-artefact-item row-section skills lineheight">
                    <div class="actor-tradition-artefact-name col third"><a data-action="itemEdit">{{item.name}}</a></div>
                    <div class="actor-tradition-artefact-type col third center">{{item.system.artifact}}</div>
                    <div class="actor-tradition-artefact-volume col third center">{{item.volumeFinal}} / {{item.volume}}</div>
                    <div class="actor-tradition-artefact-action col ten very-small center">
                        <a data-action="tradition-delete" data-tooltip="SHEET.DeleteItem"><i class="fas fa-trash"></i></a>
                    </div>
                </div>
                {{#if item.abilities}}
                <div class="row-section expandDetails shown">
                    <div class="row-section wrap cards col">
                    {{#each item.abilities as |ab i|}}
                    <div class="item" data-item-id="{{ab._id}}">
                        {{#if ab.AEpayable}}<a data-tooltip="SHEET.payAECost" data-action="traditionPayCost" class="traditionPayCost"><i class="fas fa-wand-magic-sparkles"></i></a>{{/if}}{{#if ab.OnUseEffect}}<a data-tooltip="SHEET.onUseEffect" class="onUseItem" data-action="onUseItem"><i class="fas fa-dice-six"></i></a>{{/if}}<a data-action="itemEdit">{{ab.name}}{{roman ab.system.step.value ab.system.maxRank.value}}</a>
                    </div>
                    {{/each}}
                    </div>
                </div>
                {{/if}}
            </div>
            {{/each}}
        </div>
    </div>

    {{> systems/dsa5/templates/actors/parts/specblock.hbs currentCat="magical"}}

    <div class="row-section wrap reverseFlex">
        <div class="col morph">
            <div class="groupbox">
                <legend class="table-title lineheight">{{localize "magictricks"}}</legend>
                <div class="row-section wrap cards">
                    {{#each prepare.magic.magictrick as |item i|}}
                    <div class="item" data-item-id="{{item._id}}">
                        <a data-action="itemEdit">{{item.name}}</a>
                    </div>
                    {{/each}}
                </div>
            </div>
            {{> systems/dsa5/templates/actors/parts/magicalSigns.hbs}}
        </div>
        <div class="col morph">
            <div class="groupbox actor-tradition">
                <legend class="table-title lineheight autosizing">{{formInput systemFields.tradition.fields.magical value=document.system.tradition.magical placeholder=(localize 'tradition')}}</legend>
                <div class="actor-tradition-item">
                    {{formGroup systemFields.guidevalue.fields.magical value=document.system.guidevalue.magical localize=true}}
                </div>
                <div class="actor-tradition-item">
                    {{formGroup systemFields.feature.fields.magical value=document.system.feature.magical localize=true}}
                </div>
                <div class="actor-tradition-item">
                    {{formGroup systemFields.energyfactor.fields.magical value=document.system.energyfactor.magical localize=true}}
                </div>
            </div>
        </div>
    </div>
</div>