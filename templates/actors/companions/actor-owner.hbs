<div class="tab scrollable gap0px dsa5-companion {{tabs.companion.cssClass}}" data-tab="companion" data-group="{{tabs.companion.group}}" data-application-part="companion">
    <div class="groupbox">
        <legend class="table-title lineheight">{{localize "COMPANIONS.Owner"}}</legend>
        <div class="row-section wrap cards">
            {{#each petOwners}}
            <div class="companion-header-ui owner-card" data-action="openLinkedSheet" data-uuid="{{this.uuid}}" data-tab="companion">
                <img src="{{this.img}}" alt="{{this.name}}" width="50" height="50" class="owner-card-img">
                <h3 class="owner-card-title">
                    {{this.name}}
                </h3>
                {{#if this.loyalty}}
                <div class="item skills flexrow owner-card-loyalty" data-item-id="{{this.loyalty._id}}">
                    <button type="button" class="dsadesignbutton noBorder" data-action="itemEdit"
                        data-tooltip="{{localize 'COMPANIONS.Loyalty.label'}}">
                        {{localize "CHARAbbrev.FW"}} {{this.loyalty.system.talentValue.value}}
                    </button>
                    {{> systems/dsa5/templates/actors/parts/skillselect.hbs item=this.loyalty}}
                </div>
                {{/if}}
            </div>
            {{/each}}
        </div>
    </div>
</div>
