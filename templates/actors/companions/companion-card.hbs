<div class="smallHeader item companion-header-ui" data-uuid="{{this.uuid}}" draggable="true">

    {{#> "systems/dsa5/templates/actors/parts/member-card-header.hbs" img=this.img name=this.name uuid=this.uuid
    status=this.system.status isMage=this.prepareCompanion.hasSpells isPriest=this.prepareCompanion.hasPrayers
    showContextMenu=true regenAction="companionRegeneration"}}
    {{!-- Anzeige des Icons für Domestiziert/Wild mit Wechsel-Funktion --}}
    {{#if this.prepareCompanion.showNatureIcon}}
    <div class="nature-toggle-container companion-nature-container" data-uuid="{{this.uuid}}"
        data-is-domesticated="{{this.prepareCompanion.isDomesticated}}">
        <i class="fa-solid {{this.prepareCompanion.natureIcon}} companion-icon-black"
            data-tooltip="{{localize this.prepareCompanion.natureTooltip}}"></i>
        <i class="fa-solid fa-chevron-right toggle-nature-arrow companion-nature-arrow"
            data-action="toggleNatureOptions"></i>
        <div class="nature-options companion-nature-options">
            <i class="fa-solid {{this.prepareCompanion.otherNatureIcon}} change-nature-btn companion-nature-change"
                data-action="changeCompanionNature"
                data-tooltip="{{localize this.prepareCompanion.otherNatureTooltip}}"></i>
        </div>
    </div>
    {{/if}}

    {{!-- Anzeige des Flask-Icons für Homunculi --}}
    {{#if this.prepareCompanion.isHomunculus}}
    <i class="fa-solid fa-flask companion-icon-black" data-tooltip="{{localize 'COMPANIONS.Homunculus'}}"></i>
    {{/if}}

    {{!-- Anzeige des Besen-Icons für Vertraute --}}
    {{#if this.prepareCompanion.isFamiliar}}
    <i class="fa-solid fa-broom companion-icon-black" data-tooltip="{{localize 'familiar'}}"></i>
    {{/if}}
    {{/"systems/dsa5/templates/actors/parts/member-card-header.hbs"}}

    {{!-- Effekte --}}
    <div class="companion-details companion-details-wrapper">        
        <div class="flexrow flexAlignCenter">
            {{#if this.prepareCompanion.hasEffects}}
                {{#each this.prepareCompanion.effects}}
                <button type="button" class="companion-effect-icon dsadesignbutton noBorder" data-action="companionEffect"
                    data-effect-id="{{this.id}}" data-tooltip="{{this.name}}">
                    <div class="companion-effect-img" style="background-image:url('{{this.img}}');"></div>
                    {{#if this.value}}
                    <div class="companion-effect-badge">
                        {{this.value}}
                    </div>
                    {{/if}}
                </button>
                {{/each}}
            {{/if}}
        </div>
    </div>

    {{!-- Loyalität und Ausbildung --}}
    <div class="companion-details companion-details-bottom">
        {{#if this.prepareCompanion.loyalty}}
        <div class="row-section item companion-loyalty-row" data-item-id="{{this.prepareCompanion.loyalty.id}}"
            draggable="true">

            {{!-- LINKE SEITE: WÜRFELSTYLING --}}
            <div class="skills companion-loyalty-skills">

                {{!-- Obere Reihe (Kompaktes Eingabefeld) --}}
                <div class="companion-loyalty-top-row">
                    {{#if this.prepareCompanion.isHomunculus}}
                    <button type="button" class="talentName" data-action="companionItemEdit"
                        data-actor-uuid="{{this.prepareCompanion.loyalty.actorUuid}}">{{localize
                        "LocalizedIDs.Fast-Talk"}}</button>
                    {{else}}
                    <button type="button" class="talentName companion-talent-name" data-action="companionItemEdit"
                        data-actor-uuid="{{this.prepareCompanion.loyalty.actorUuid}}">{{localize
                        "COMPANIONS.Loyalty.label"}}</button>
                    {{/if}}
                    <input class="companion-skill-advances" type="number"
                        value="{{this.prepareCompanion.loyalty.value}}"
                        data-item-id="{{this.prepareCompanion.loyalty.id}}"
                        data-actor-uuid="{{this.prepareCompanion.loyalty.actorUuid}}" />
                </div>

                {{!-- Untere Reihe (Großer Würfel-Button 45px) --}}
                <div class="companion-loyalty-bottom-row">
                    <button type="button" data-action="companionSkillSelect"
                        class="noBorder dsadesignbutton skill-props companion-dice-btn"
                        data-actor-uuid="{{this.prepareCompanion.loyalty.actorUuid}}">
                        {{#if this.prepareCompanion.isHomunculus}}
                        <span class="d20 diet-mu">{{localize 'CHARAbbrev.MU'}}</span>
                        <span class="d20 diet-in">{{localize 'CHARAbbrev.IN'}}</span>
                        <span class="d20 diet-ch">{{localize 'CHARAbbrev.CH'}}</span>
                        {{else}}
                        <span
                            class="d20 diet-{{this.prepareCompanion.loyalty.char1}}">{{this.prepareCompanion.loyalty.char1}}</span>
                        <span
                            class="d20 diet-{{this.prepareCompanion.loyalty.char2}}">{{this.prepareCompanion.loyalty.char2}}</span>
                        <span
                            class="d20 diet-{{this.prepareCompanion.loyalty.char3}}">{{this.prepareCompanion.loyalty.char3}}</span>
                        {{/if}}
                    </button>
                </div>
            </div>

            {{!-- MITTE: DIE NEUE HOTBAR (14 Slots in 2 Reihen) --}}
            <div class="companion-hotbar">

                {{!-- Obere Reihe (7 Slots) --}}
                <div class="companion-hotbar-row">
                    {{#each this.prepareCompanion.hotbarRow1 as |slot|}}
                    <div class="slot primary companion-slot" {{#if slot}}data-action="executeCompanionSkill"
                        data-item-id="{{slot.id}}" data-tooltip="{{slot.tooltip}}" data-tooltip-class="dsa5 dsatooltip"
                        {{/if}}
                        style="background: {{#if slot}}url('{{slot.img}}') center/cover{{else}}rgba(0,0,0,0.1){{/if}}; cursor: {{#if slot}}pointer{{else}}default{{/if}};">
                    </div>
                    {{/each}}
                </div>

                {{!-- Untere Reihe (7 Slots) --}}
                <div class="companion-hotbar-row">
                    {{#each this.prepareCompanion.hotbarRow2 as |slot|}}
                    <div class="slot primary companion-slot" {{#if slot}}data-action="executeCompanionSkill"
                        data-item-id="{{slot.id}}" data-tooltip="{{slot.tooltip}}" data-tooltip-class="dsa5 dsatooltip"
                        {{/if}}
                        style="background: {{#if slot}}url('{{slot.img}}') center/cover{{else}}rgba(0,0,0,0.1){{/if}}; cursor: {{#if slot}}pointer{{else}}default{{/if}};">
                    </div>
                    {{/each}}
                </div>

            </div>

            {{!-- RECHTE SEITE: Icons (35x35) --}}
            <div class="flexcol gap5px">

                {{!-- Obere Reihe --}}
                <div class="flexrow flexAlignCenter gap5px">
                    <button type="button" class="dsadesignbutton noBorder icon fa-solid fa-book-bookmark"
                        data-action="openSkillSelection" data-tooltip="COMPANIONS.SkillSelection.label">
                    </button>

                    <button type="button" class="dsadesignbutton noBorder icon {{#if this.prepareCompanion.isHotbarControlled}}fa-solid{{else}}fa-regular{{/if}} fa-eye"
                        data-action="toggleHotbarControl" data-tooltip="{{localize 'COMPANIONS.controlViaHotbar'}}">
                    </button>
                </div>

                {{!-- Untere Reihe (Knochen / Pferd) --}}
                <div class="flexrow flexAlignCenter">
                    {{#if this.prepareCompanion.isTrainable}}
                    <button type="button" class="icon fa-solid fa-bone dsadesignbutton noBorder"
                        data-action="trainCompanion" data-tooltip="{{localize 'COMPANIONS.train'}}">
                    </button>

                    {{#if this.prepareCompanion.isMountPossible}}
                    <button type="button" class="dsadesignbutton noBorder icon fa-solid fa-horse  {{#if this.prepareCompanion.isMountActive}}fa-rotate-180{{/if}}" data-action="toggleMount"
                        data-tooltip="{{#if this.prepareCompanion.isMountActive}}{{localize 'COMPANIONS.removeMount'}}{{else}}{{localize 'COMPANIONS.useAsMount'}}{{/if}}">
                    </button>
                    {{/if}}
                    {{/if}}
                </div>
            </div>
        </div>
        {{else}}
        <div class="droparea">{{localize "COMPANIONS.Loyalty.missingHint"}}</div>
        {{/if}}

        {{#if this.prepareCompanion.trainingTests.length}}
        <div class="actor-aggregated-tests groupbox">

            <div class="row-section table-title lineheight">
                <div class="title-type col third">
                    {{localize "COMPANIONS.Training.label"}}
                </div>
                <div class="col ten center">{{localize "probe"}}</div>
                <div class="col ten center">{{localize "interval"}}</div>
                <div class="col ten center">{{localize "probes"}}</div>
                <div class="col ten center">{{localize "status"}}</div>
                <div class="col center fifteen">{{localize "APValue"}}</div>
                <div class="col fifteen center flexAlignCenter flexrow"></div>
            </div>

            <div class="row-section wrap inventory" style="margin-bottom: 0;">
                {{#each this.prepareCompanion.trainingTests as |test|}}
                <div class="actor-aggregated-test-item-wrapper col item" data-item-id="{{test.item._id}}">
                    <div class="actor-aggregated-test-item row-section skills lineheight noBorder">

                        <div class="actor-aggregated-test-name col third withContext flexrow">
                            <button type="button" data-action="editAggregatedTest"
                                data-item-id="{{test.item._id}}">{{test.shortName}}</button>
                        </div>

                        <div class="actor-aggregated-test col ten flexrow flexAlignCenter">
                            {{#if test.item.system.talent.value}}
                            <button type="button" class="flex0" data-action="rollAggregatedProbe"
                                data-item-id="{{test.item._id}}" data-which="">
                                <div class="d20 die-attack"></div>
                            </button>
                            {{/if}}
                        </div>

                        <div class="actor-aggregated-test-intervall col ten flexAlignCenter flexrow">
                            {{test.item.system.interval.value}}
                        </div>

                        <div class="actor-aggregated-tests-used col ten flexAlignCenter flexrow">
                            {{test.item.system.usedTestCount.value}} /
                            {{test.item.system.allowedTestCount.value}}
                        </div>

                        <div class="actor-aggregated-test-qs col ten flexAlignCenter flexrow">
                            {{test.item.system.cummulatedQS.value}} / 10
                        </div>

                        <div class="actor-aggregated-test-ap col fifteen flexAlignCenter flexrow">
                            {{test.apCost}}
                        </div>

                        <div class="actor-aggregated-test-action col fifteen center centerCell flexrow">
                            <div class="flexrow gap5px flexAlignEnd">

                                {{#if test.isCompleted}}
                                <button type="button" class="dsadesignbutton icon fas fa-check"
                                    data-action="finishTrickTraining" data-item-id="{{test.item._id}}"
                                    data-companion-uuid="{{../uuid}}" data-tooltip="COMPANIONS.Finish">
                                </button>
                                {{else}}
                                <button type="button" class="dsadesignbutton icon fas fa-hourglass-half" disabled
                                    data-tooltip="COMPANIONS.Finish">
                                </button>
                                {{/if}}

                                <button type="button" class="dsadesignbutton noBorder icon fa-solid fa-trash"
                                    data-action="deleteItem" data-item-id="{{test.item._id}}"
                                    data-tooltip="{{localize 'cancel'}}">
                                </button>

                            </div>
                        </div>

                    </div>
                </div>
                {{/each}}
            </div>
        </div>
        {{/if}}
    </div>
</div>