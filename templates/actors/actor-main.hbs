<div class='tab scrollable {{tabs.main.cssClass}}' data-tab='main' data-group='{{tabs.main.group}}'>
    {{> systems/dsa5/templates/actors/parts/characteristics-large.hbs}}

    <div class="actor-main row-section wrap reverseFlex">
        <div class="col morph40">
            <div class="groupbox gap5px derivedStatsContainer">
                <legend class="table-title lineheight">{{localize "derivedStats"}}</legend>
                <div class="derivedAttrs row-section">
                    <div class="col two"></div>
                    <div class="col eight very-small center" data-tooltip="value">
                        {{localize "ABBR.value"}}
                    </div>
                    <div class="col eight very-small center" data-tooltip="Modifiers">
                        {{localize "ABBR.modifiers"}}
                    </div>
                    <div class="col eight very-small center" data-tooltip="Advances">
                        {{localize "ABBR.advances"}}
                    </div>
                    <div class="col eight very-small center" data-tooltip="max">
                        {{localize "ABBR.max"}}
                    </div>
                </div>
                <div class="derivedAttrs row-section">
                    <div class="col two lineheight">
                        <span data-tooltip="FORMULA.wounds">{{localize "wounds"}}</span> {{#if prepare.canAdvance}}<a data-attr="wounds" class="advance" data-action="advanceWrapper" data-fct="_refundPointsAdvance"><i class="fas fa-minus"></i></a>
                        <a data-attr="wounds" class="advance" data-action="advanceWrapper" data-fct="_advancePoints"><i class="fas fa-plus"></i></a>{{/if}}
                    </div>
                    <div class="col eight lineheight center">
                        {{document.system.status.wounds.current}}
                    </div>
                    <div class="col eight center">
                        {{formInput systemFields.status.fields.wounds.fields.modifier value=document.system.status.wounds.modifier}}
                    </div>
                    <div class="col eight center">
                        {{formInput systemFields.status.fields.wounds.fields.advances value=document.system.status.wounds.advances}}
                    </div>
                    <div class="col eight lineheight center">
                        {{document.system.status.wounds.max}}
                    </div>
                </div>

                <div class="derivedAttrs row-section">
                    <div class="col two lineheight">
                        <span data-tooltip="FORMULA.regenerationLeP">{{localize "CHARAbbrev.LeP"}} {{localize 'regenerate'}}</span>
                    </div>
                    <div class="col eight lineheight center">

                    </div>
                    <div class="col eight center inputTooltipAvailable">
                        {{formInput systemFields.status.fields.regeneration.fields.LePMod value=document.system.status.regeneration.LePMod tooltip="SHEET.permRegeneration"}}
                    </div>
                    <div class="col eight center inputTooltipAvailable">
                        {{formInput systemFields.status.fields.regeneration.fields.LePTemp value=document.system.status.regeneration.LePTemp tooltip="SHEET.tempRegeneration"}}
                    </div>
                    <div class="col eight lineheight center">
                        {{document.system.status.regeneration.LePmax}}
                    </div>
                </div>

                {{#if prepare.magic.hasSpells}}
                <div class="derivedAttrs row-section">
                    <div class="col two lineheight">
                        <span data-tooltip="FORMULA.astralenergy">{{localize "astralenergy"}}</span> {{#if prepare.canAdvance}}<a data-attr="astralenergy"
                            class="advance" data-action="advanceWrapper" data-fct="_refundPointsAdvance"><i class="fas fa-minus"></i></a>
                        <a data-attr="astralenergy" class="advance" data-action="advanceWrapper" data-fct="_advancePoints"><i class="fas fa-plus"></i></a>{{/if}}
                    </div>
                    <div class="col eight lineheight center">
                        {{document.system.status.astralenergy.current}}
                    </div>
                    <div class="col eight center">
                        {{formInput systemFields.status.fields.astralenergy.fields.modifier value=document.system.status.astralenergy.modifier}}
                    </div>
                    <div class="col eight center">
                        {{formInput systemFields.status.fields.astralenergy.fields.advances value=document.system.status.astralenergy.advances}}
                    </div>
                    <div class="col eight lineheight center">
                        {{document.system.status.astralenergy.max}}
                    </div>
                </div>

                <div class="derivedAttrs row-section">
                    <div class="col two lineheight">
                        <span data-tooltip="FORMULA.regenerationAsP">{{localize "CHARAbbrev.AsP"}} {{localize 'regenerate'}}</span>
                    </div>
                    <div class="col eight lineheight center">

                    </div>
                    <div class="col eight center inputTooltipAvailable">
                        {{formInput systemFields.status.fields.regeneration.fields.AsPMod value=document.system.status.regeneration.AsPMod tooltip="SHEET.permRegeneration"}}
                    </div>
                    <div class="col eight center inputTooltipAvailable">
                        {{formInput systemFields.status.fields.regeneration.fields.AsPTemp value=document.system.status.regeneration.AsPTemp tooltip="SHEET.tempRegeneration"}}
                    </div>
                    <div class="col eight lineheight center">
                        {{document.system.status.regeneration.AsPmax}}
                    </div>
                </div>
                <div class="derivedAttrs row-section">
                    <div class="col two lineheight">
                        <span data-tooltip="FORMULA.permanentAsP">{{localize "CHARAbbrev.pAsP"}}</span> {{#if prepare.canAdvance}}<a data-attr="astralenergy"
                            class="advance" data-action="advanceWrapper" data-fct="_refundPC"><i data-tooltip="rebuyRevertCost" class="fas fa-minus"></i></a>
                        <a data-attr="astralenergy" class="advance" data-action="advanceWrapper" data-fct="_rebuyPC"><i data-tooltip="rebuyCost"
                                class="fas fa-plus"></i></a>{{/if}}
                    </div>
                    <div class="col eight lineheight center">

                    </div>
                    <div class="col eight center inputTooltipAvailable">
                        {{formInput systemFields.status.fields.astralenergy.fields.permanentLoss value=document.system.status.astralenergy.permanentLoss tooltip="SHEET.paidPAsP"}}
                    </div>
                    <div class="col eight center inputTooltipAvailable">
                        {{formInput systemFields.status.fields.astralenergy.fields.rebuy value=document.system.status.astralenergy.rebuy tooltip="SHEET.rebuyPAsP"}}
                    </div>
                    <div class="col eight lineheight center">
                        {{document.system.status.astralenergy.permanentLossSum}}
                    </div>
                </div>

                {{/if}} {{#if prepare.magic.hasPrayers}}
                <div class="derivedAttrs row-section">
                    <div class="col two lineheight">
                        <span data-tooltip="FORMULA.karmaenergy">{{localize "karmaenergy"}}</span> {{#if prepare.canAdvance}} <a data-attr="karmaenergy"
                            class="advance" data-action="advanceWrapper" data-fct="_refundPointsAdvance"><i class="fas fa-minus"></i></a>
                        <a data-attr="karmaenergy" class="advance" data-action="advanceWrapper" data-fct="_advancePoints"><i class="fas fa-plus"></i></a>{{/if}}
                    </div>
                    <div class="col eight lineheight center">
                        {{document.system.status.karmaenergy.current}}
                    </div>
                    <div class="col eight center">
                        {{formInput systemFields.status.fields.karmaenergy.fields.modifier value=document.system.status.karmaenergy.modifier}}
                    </div>
                    <div class="col eight center">
                        {{formInput systemFields.status.fields.karmaenergy.fields.advances value=document.system.status.karmaenergy.advances}}
                    </div>
                    <div class="col eight lineheight center">
                        {{document.system.status.karmaenergy.max}}
                    </div>
                </div>

                <div class="derivedAttrs row-section">
                    <div class="col two lineheight">
                        <span data-tooltip="FORMULA.regenerationKaP">{{localize "CHARAbbrev.KaP"}} {{localize 'regenerate'}}</span>
                    </div>
                    <div class="col eight lineheight center">

                    </div>
                    <div class="col eight center inputTooltipAvailable">
                        {{formInput systemFields.status.fields.regeneration.fields.KaPMod value=document.system.status.regeneration.KaPMod tooltip="SHEET.permRegeneration"}}
                    </div>
                    <div class="col eight center inputTooltipAvailable">
                        {{formInput systemFields.status.fields.regeneration.fields.KaPTemp value=document.system.status.regeneration.KaPTemp tooltip="SHEET.tempRegeneration"}}
                    </div>
                    <div class="col eight lineheight center">
                        {{document.system.status.regeneration.KaPmax}}
                    </div>
                </div>
                <div class="derivedAttrs row-section">
                    <div class="col two lineheight">
                        <span data-tooltip="FORMULA.permanentKaP">{{localize "CHARAbbrev.pKaP"}}</span> {{#if prepare.canAdvance}}<a data-attr="karmaenergy"
                            class="advance" data-action="advanceWrapper" data-fct="_refundPC"><i data-tooltip="rebuyRevertCost" class="fas fa-minus"></i></a>
                        <a data-attr="karmaenergy" class="advance" data-action="advanceWrapper" data-fct="_rebuyPC"><i data-tooltip="rebuyCost"
                                class="fas fa-plus"></i></a>{{/if}}
                    </div>
                    <div class="col eight lineheight center">

                    </div>

                    <div class="col eight center inputTooltipAvailable">
                        {{formInput systemFields.status.fields.karmaenergy.fields.permanentLoss value=document.system.status.karmaenergy.permanentLoss tooltip="SHEET.paidPAsP"}}
                    </div>
                    <div class="col eight center inputTooltipAvailable">
                        {{formInput systemFields.status.fields.karmaenergy.fields.rebuy value=document.system.status.karmaenergy.rebuy tooltip="SHEET.rebuyPAsP"}}
                    </div>
                    <div class="col eight lineheight center">
                        {{document.system.status.karmaenergy.permanentLossSum}}
                    </div>
                </div>

                {{/if}}
                <div class="derivedAttrs row-section">
                    <div class="col two lineheight">
                        <span data-tooltip="FORMULA.soulpower">{{localize "soulpower"}}</span>
                    </div>
                    <div class="col eight lineheight center">
                        {{document.system.status.soulpower.value}}
                    </div>
                    <div class="col eight center">
                        {{formInput systemFields.status.fields.soulpower.fields.modifier value=document.system.status.soulpower.modifier}}
                    </div>
                    <div class="col eight">

                    </div>
                    <div class="col eight lineheight center">
                        {{document.system.status.soulpower.max}}
                    </div>
                </div>
                <div class="derivedAttrs row-section">
                    <div class="col two lineheight">
                        <span data-tooltip="FORMULA.toughness">{{localize "toughness"}}</span>
                    </div>
                    <div class="col eight lineheight center">
                        {{document.system.status.toughness.value}}
                    </div>
                    <div class="col eight center">
                        {{formInput systemFields.status.fields.toughness.fields.modifier value=document.system.status.toughness.modifier}}
                    </div>
                    <div class="col eight">

                    </div>
                    <div class="col eight lineheight center">
                        {{document.system.status.toughness.max}}
                    </div>
                </div>
                <div class="derivedAttrs row-section">
                    <div class="col two lineheight">
                        <span data-tooltip="FORMULA.dodge">{{localize "dodge"}}</span>
                    </div>
                    <div class="col eight lineheight center">
                        {{document.system.status.dodge.value}}
                    </div>
                    <div class="col eight center">
                        {{formInput systemFields.status.fields.dodge.fields.modifier value=document.system.status.dodge.modifier}}
                    </div>
                    <div class="col eight">

                    </div>
                    <div class="col eight lineheight center">
                        {{document.system.status.dodge.max}}
                    </div>
                </div>
                <div class="derivedAttrs row-section">
                    <div class="col two lineheight">
                        <span data-tooltip="FORMULA.speed">{{localize "speed"}}</span>
                    </div>
                    <div class="col eight lineheight center">
                        {{document.system.status.speed.initial}}
                    </div>
                    <div class="col eight center">
                        {{formInput systemFields.status.fields.speed.fields.modifier value=document.system.status.speed.modifier}}
                    </div>
                    <div class="col eight">

                    </div>
                    <div class="col eight lineheight center">
                        {{document.system.status.speed.max}}
                    </div>
                </div>

                <div class="derivedAttrs row-section">
                    <div class="col two lineheight">
                        <span data-tooltip="FORMULA.initiative">{{localize "initiative"}}</span>
                    </div>
                    <div class="col eight lineheight center">
                    </div>
                    <div class="col eight center">
                        {{formInput systemFields.status.fields.initiative.fields.modifier value=document.system.status.initiative.modifier}}
                    </div>
                    <div class="col eight">

                    </div>
                    <div class="col eight lineheight center">
                        {{floor document.system.status.initiative.value}}
                    </div>
                </div>
                <div class="derivedAttrs row-section">
                    <div class="col two lineheight">
                        <span data-tooltip="FORMULA.initDie">{{localize "initDie"}}</span>
                    </div>
                    <div class="col two lineheight center">
                        {{formInput systemFields.status.fields.initiative.fields.die value=document.system.status.initiative.die}}
                    </div>
                </div>
                <div class="derivedAttrs row-section">
                    <div class="col two lineheight">
                        <span data-tooltip="FORMULA.initDieMod">{{localize "initDieMod"}}</span>
                    </div>

                    <div class="col two lineheight center">
                        {{formInput systemFields.status.fields.initiative.fields.diemodifier value=document.system.status.initiative.diemodifier}}
                    </div>
                </div>
                <div class="derivedAttrs row-section">
                    <div class="col two lineheight">
                        <span data-tooltip="FORMULA.sizeCategory">{{localize "sizeCategory"}}</span>
                    </div>
                    <div class="col two lineheight center">
                        {{formInput systemFields.status.fields.size.fields.value value=document.system.status.size.value localize=true}}
                    </div>
                </div>
                <div class="derivedAttrs row-section">
                    <div class="col two lineheight">
                        <span data-tooltip="FORMULA.fatePoints">{{localize "fatePoints"}}</span>
                    </div>
                    <div class="col eight lineheight center">
                        {{formInput systemFields.status.fields.fatePoints.fields.current value=document.system.status.fatePoints.current}}
                    </div>
                    <div class="col eight center">
                        {{formInput systemFields.status.fields.fatePoints.fields.modifier value=document.system.status.fatePoints.modifier}}
                    </div>
                    <div class="col eight">

                    </div>
                    <div class="col eight lineheight center">
                        {{document.system.status.fatePoints.max}}
                    </div>
                </div>
                {{> systems/dsa5/templates/actors/parts/temperature.hbs}}
            </div>

            {{> systems/dsa5/templates/actors/parts/experienceBox.hbs}}
        </div>
        <div class="col morph60 gap0px flexcol">
            {{> systems/dsa5/templates/actors/parts/specialabilities.hbs}}
        </div>
    </div>
</div>