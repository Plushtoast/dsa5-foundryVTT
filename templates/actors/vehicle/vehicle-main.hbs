<div class='tab scrollable gap0px {{tabs.main.cssClass}} width100' data-tab='main' data-group='{{tabs.main.group}}'>
  <div class="groupbox">
    <legend class="table-title lineheight">{{localize "Description"}} <a data-action="chCollapse" class="ch-collapse"><i class="fas fa-angle-up"
          data-tooltip="SHEET.collapse"></i></a></legend>
    <div class="row-section">
      <div class="col notes-box">
        {{formInput systemFields.description.fields.value value=document.system.description.value toggled=true enriched=enrichedDescription disabled=(not owner)}}
      </div>
    </div>
  </div>
</div>
