<div class="combat-weapon-wrapper col item" data-item-id="{{item._id}}">
  <div class="combat-weapon row-section">
    <div class="combat-item-image col zerofive image {{item.system.damageToolTip.css}}" data-tooltip="{{item.system.damageToolTip.msg}}" style="background-image: url('{{item.img}}')"></div>
    <div class="combat-item-name col four ellipsis">
      <a data-action="itemEdit">{{item.name}}</a>
      {{#if item.boardWeaponReloadLabel}}
      <span class="vehicle-reload-badge small" data-tooltip="{{item.boardWeaponShotsLabel}}">{{item.boardWeaponReloadLabel}}</span>
      {{/if}}
    </div>
    <div class="combat-item-skill col fifteen center small ellipsis" data-tooltip="{{item.combatskillLabel}}">
      {{item.combatskillLabel}}
    </div>
    <div class="combat-item-attack col ten center item" data-item-id="{{item._id}}" data-mod="attack">
      <a data-mode="attack" data-action="chRollCombat" class="d20 die-attack {{#unless item.isBoardWeaponLoaded}}board-weapon-unloaded{{/unless}}" data-tooltip-html="{{{item.boardWeaponFireTooltip}}}">{{item.attack}}</a>
    </div>
    <div class="combat-item-damage col ten center flexcol" data-tooltip="{{item.damageTooltip}}">
      {{#if item.damageStp}}
      <span class="board-weapon-damage board-weapon-damage-tp">{{item.damageTp}}</span>
      <span class="board-weapon-damage board-weapon-damage-stp small">{{item.damageStp}}</span>
      {{else}}
      <a data-mode="damage" data-action="chRollCombat" class="d6 die-damage">{{item.damagedie}}</a><span data-tooltip="{{localize 'damageOverThreshold'}}{{item.damageBonusDescription}}">{{item.damageAdd}}</span>
      {{/if}}
    </div>
    {{#if showAmmoColumn}}
    <div class="col ten flexrow flexAlignCenter vehicle-ammo-cell">
      {{#if item.hasAmmunition}}
      {{> systems/dsa5/templates/actors/parts/combat_ammo_button.hbs ammo=item.selectedAmmo action="pickAmmo"}}
      {{> systems/dsa5/templates/actors/parts/combat_ammo_menu.hbs ammo=item.ammo clearAmmo=item.clearAmmo}}
      {{else if item.ammoInfinite}}
      <span class="vehicle-ammo-infinite center" data-tooltip="{{item.ammoTooltip}}">
        <i class="fas fa-infinity" aria-hidden="true"></i>
      </span>
      {{/if}}
    </div>
    {{/if}}
    <div class="col five center small vehicle-crew-cell">
      {{#if item.crewOperatorImg}}
      <a data-action="assignWeaponCrew" data-item-id="{{item._id}}" class="vehicle-crew-operator"
         data-tooltip-text="{{item.crewOperatorName}}">
        <img class="vehicle-crew-avatar" src="{{item.crewOperatorImg}}" alt="{{item.crewOperatorName}}" />
      </a>
      <button type="button" data-action="clearWeaponCrew" data-item-id="{{item._id}}" class="icon fas fa-times noBorder dsadesignbutton very-small vehicle-crew-clear" data-tooltip="VEHICLE.clearCrew"></button>
      {{else}}
      <button type="button" data-action="assignWeaponCrew" data-item-id="{{item._id}}" class="icon fas fa-user-plus noBorder dsadesignbutton very-small" data-tooltip="VEHICLE.assignCrew"></button>
      {{/if}}
    </div>
    <div class="col zerofive center flexrow">
      <button type="button" data-action="weaponContextMenu" class="icon fas fa-ellipsis-vertical very-small noBorder dsadesignbutton" data-tooltip="SHEET.EditItem"></button>
    </div>
  </div>
</div>
