<div class="companion-training-container training-container">
    
    {{!-- NEU: Der interaktive Header mit Tierart-Anzeige (ersetzt das statische Bild+Name) --}}
    <div class="species-header">
        <img src="{{currentSpeciesImg}}" data-action="toggleSpeciesSelector" class="species-img" title="{{localize 'SHEET.SpeciesChangeHint'}}">
        <div>
            <span class="species-title">{{speciesText}}</span><br>
            <span class="species-hint">{{localize 'SHEET.SpeciesChangeHint'}}</span>
        </div>
    </div>

    {{!-- Versteckter Bereich zur Tierart-Auswahl (klappt unter dem Header auf) --}}
    <div id="speciesSelector" class="species-selector-box" style="display: none;">
        {{#each speciesData as |speciesList groupName|}}
            <h4 class="species-group-name">{{groupName}}</h4>
            <div class="species-grid">
                {{#each speciesList}}
                    <div data-action="selectSpecies" data-species="{{this.name}}" class="species-item" title="{{this.name}}">
                        <img src="{{this.img}}" class="species-item-img">
                        <span class="species-item-name">
                            {{this.name}}
                        </span>
                    </div>
                {{/each}}
            </div>
        {{/each}}
    </div>

    {{!-- Navigation (Tabs) --}}
    <nav class="sheet-tabs tabs training-tabs-nav">
        <a class="item active training-tab-item" data-tab="loyalty">{{localize 'SHEET.Loyalty'}}</a>
        <a class="item training-tab-item" data-tab="tricks">{{localize 'SHEET.Tricks'}}</a>
        <a class="item training-tab-item" data-tab="training">{{localize 'SHEET.TrainingTabName'}}</a>
    </nav>

    {{!-- Content Body --}}
    <section class="content training-content-body">
        
        {{!-- Tab: Loyalität --}}
        <div class="tab-content active" data-tab="loyalty">
            <div class="training-info-box">
                <p class="training-info-text">
                    {{localize 'SHEET.LoyaltyImprovementText'}}
                </p>
            </div>

            <div class="loyalty-center-box">
                {{#if loyaltyUnlocked}}
                    <div class="skills loyalty-skill-box">
                        <a class="talentName loyalty-name" data-action="itemEdit" data-item-id="{{loyaltyItem.id}}">{{localize 'LocalizedIDs.loyalty'}}</a>
                        <div class="loyalty-input-row">
                            <a class="advance icon fas fa-minus flex0 loyalty-advance-btn" data-action="refundLoyalty"></a>
                            <input class="companion-skill-advances loyalty-input" type="number" value="{{loyaltyItem.system.talentValue.value}}" readonly>
                            <a class="advance icon fas fa-plus flex0 loyalty-advance-btn" data-action="advanceLoyalty"></a>
                        </div>
                    </div>
                {{else}}
                    <button type="button" class="dsadesignbutton loyalty-roll-btn" data-action="rollTierkunde">
                        <i class="fas fa-dice-d20 loyalty-roll-icon"></i> {{localize buttonLabel}}
                    </button>
                {{/if}}
            </div>
        </div>

        {{!-- Tab: Tricks --}}
    <div class="tab-content" data-tab="tricks" style="display: none;">
        
        {{!-- Limit-Prüfung --}}
        {{#if isMaxReached}}
            <div class="training-info-box">
                
                <p class="training-info-text small margin-bottom">
                    {{{trickLimitText}}}
                </p>

                {{!-- Die bereits erlernten Tricks --}}
                {{#if knownTricks.length}}
                    <div class="known-tricks-box">
                        <p class="known-tricks-title">{{localize 'SHEET.KnownTricks' name=companionName}}</p>
                        <div class="known-tricks-grid">
                            {{#each knownTricks}}
                                <div class="known-tricks-item">{{{this.link}}}</div>
                            {{/each}}
                        </div>
                    </div>
                {{/if}}

                <p class="training-info-text darkred center">
                    {{localize 'SHEET.MaxTricksReached' name=companionName}}
                </p>
            </div>
        {{else}}
            {{!-- Infotexte --}}
            <div class="training-info-box">
                
                <p class="training-info-text small margin-bottom">
                    {{{trickLimitText}}}
                </p>

                {{!-- Die bereits erlernten Tricks --}}
                {{#if knownTricks.length}}
                    <div class="known-tricks-box">
                        <p class="known-tricks-title">{{localize 'SHEET.KnownTricks' name=companionName}}</p>
                        <div class="known-tricks-grid">
                            {{#each knownTricks}}
                                <div class="known-tricks-item">{{{this.link}}}</div>
                            {{/each}}
                        </div>
                    </div>
                    <hr class="training-divider">
                {{/if}}

                <p class="training-info-text margin-bottom">
                    {{localize 'SHEET.TrickIntro'}}
                </p>
                
                <p class="training-info-text margin-bottom">
                    {{#if isWild}}
                        {{localize 'SHEET.TrickWild'}}
                    {{else}}
                        {{localize 'SHEET.TrickDomesticated'}}
                    {{/if}}
                </p>

                <p class="training-info-text">
                    {{localize 'SHEET.TrickModifier'}}
                </p>
            </div>

            {{!-- Das Zweispalten-Layout für die Tricks --}}
            <div class="training-grid-wrapper">
                <div class="training-grid-2col">
                    
                    {{!-- LINKE SPALTE: Mögliche Tricks --}}
                    <div>
                        <h4 class="training-col-header">
                            {{localize 'SHEET.AvailableTricks'}}
                        </h4>
                        <div class="training-list-container">
                            {{#each availableTricks}}
                                <div class="trick-container training-item-container">
                                    <div class="training-item-header">
                                        <div class="training-item-left">
                                            <i class="fas fa-chevron-right training-item-arrow" data-action="toggleTrickDetails"></i>
                                            <a class="content-link training-item-link" data-action="openTrick" data-uuid="{{this.uuid}}"><i class="fas fa-suitcase"></i> {{this.name}}</a>
                                        </div>
                                        {{#if this.isTraining}}
                                            <button type="button" class="dsadesignbutton training-btn-disabled" disabled title="{{localize 'SHEET.InTrainingTooltip'}}">
                                                <i class="fas fa-hourglass-half training-btn-icon"></i> {{localize 'SHEET.InTraining'}}
                                            </button>
                                        {{else}}
                                        <button type="button" class="dsadesignbutton training-btn-action" data-action="teachTrick" data-trick="{{this.name}}">
                                            <i class="fas fa-paw training-btn-icon"></i> {{localize 'SHEET.TeachTrickBtn'}}
                                        </button>
                                        {{/if}}
                                    </div>
                                    <div class="trick-details training-item-details">
                                        {{../reqsLabel}}: {{this.reqText}}
                                    </div>
                                </div>
                            {{/each}}
                            {{#unless availableTricks.length}}
                                <p class="training-empty-state">{{localize 'SHEET.NoTricksAvailable'}}</p>
                            {{/unless}}
                        </div>
                    </div>

                    {{!-- RECHTE SPALTE: Nicht mögliche Tricks --}}
                    <div>
                        <h4 class="training-col-header">
                            {{localize 'SHEET.UnavailableTricks'}}
                        </h4>
                        <div class="training-list-container">
                            {{#each unavailableTricks}}
                                <div class="trick-container training-item-container unavailable">
                                    <div class="training-item-header">
                                        <div class="training-item-left">
                                            <i class="fas fa-chevron-right training-item-arrow" data-action="toggleTrickDetails"></i>
                                            <a class="content-link training-item-link unavailable" data-action="openTrick" data-uuid="{{this.uuid}}"><i class="fas fa-suitcase"></i> {{this.name}}</a>
                                        </div>
                                    </div>
                                    <div class="trick-details training-item-details unavailable">
                                        {{../reqsLabel}}: {{this.reqText}}
                                    </div>
                                </div>
                            {{/each}}
                            {{#unless unavailableTricks.length}}
                                <p class="training-empty-state">Keine Tricks in dieser Kategorie.</p>
                            {{/unless}}
                        </div>
                    </div>

                </div>
            </div>
        {{/if}}
    </div>

        {{!-- TAB: AUSBILDUNG --}}
    <div class="tab-content training-tab-wrapper" data-tab="training">
        
        {{#if hasReachedMaxTraining}}
            {{!-- ANSICHT WENN LIMIT ERREICHT IST --}}
            <div class="max-training-box">
                {{localize 'SHEET.MaxTrainingReached' petName=petName}}
            </div>
            
            {{!-- Erlernte Ausbildungsaufsätze mittig platzieren --}}
            <div class="known-training-center-box">
                <h4 class="training-col-header center">
                    {{localize 'SHEET.KnownTrainings'}}
                </h4>
                <div class="training-list-container center">
                    {{#each knownTrainings}}
                        <div class="trick-container training-item-container center">
                            <a class="content-link training-item-link" data-action="openTrick" data-uuid="{{this.uuid}}">
                                <i class="fas fa-graduation-cap"></i> {{this.name}}
                            </a>
                        </div>
                    {{/each}}
                </div>
            </div>

        {{else}}
            {{!-- STANDARD-ANSICHT (Noch Platz für Ausbildungen) --}}
            <div class="training-info-box">
                <p class="training-info-text margin-bottom">
                    {{#if isWild}}
                        {{localize 'SHEET.TrainingWildRule'}}
                    {{else}}
                        {{localize 'SHEET.TrainingDomRule'}}
                    {{/if}}
                </p>
                
                <p class="training-info-text margin-bottom">
                    {{localize 'SHEET.TrainingProbeRule'}}
                </p>

                {{#if isMountPossible}}
                <p class="training-info-text margin-bottom">
                    {{localize 'SHEET.MountRule'}}
                </p>
                {{/if}}

                {{#if isFamiliar}}
                <p class="training-info-text">
                    {{localize 'SHEET.FamiliarRule'}}
                </p>
                {{/if}}
            </div>

            <div class="training-grid-wrapper">
                <div class="training-grid-2col">
                    
                    {{!-- LINKE SPALTE: Erlernte Ausbildungsaufsätze --}}
                    <div>
                        <h4 class="training-col-header">
                            {{localize 'SHEET.KnownTrainings'}}
                        </h4>
                        <div class="training-list-container">
                            {{#each knownTrainings}}
                                <div class="trick-container training-item-container">
                                    <div class="training-item-header">
                                        <div class="training-item-left">
                                            <a class="content-link training-item-link pad-left" data-action="openTrick" data-uuid="{{this.uuid}}">
                                                <i class="fas fa-graduation-cap"></i> {{this.name}}
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            {{/each}}
                            {{#unless knownTrainings.length}}
                                <p class="training-empty-state">{{localize 'SHEET.NoTrainingLearned'}}</p>
                            {{/unless}}
                        </div>
                    </div>

                    {{!-- RECHTE SPALTE: Mögliche Ausbildungsaufsätze --}}
                    <div>
                        <h4 class="training-col-header">
                            {{localize 'SHEET.AvailableTrainings'}}
                        </h4>
                        <div class="training-list-container">
                            {{#each availableTrainings}}
                                <div class="trick-container training-item-container">
                                    <div class="training-item-header">
                                        <div class="training-item-left">
                                            <a class="content-link training-item-link pad-left" data-action="openTrick" data-uuid="{{this.uuid}}">
                                                <i class="fas fa-graduation-cap"></i> {{this.name}}
                                            </a>
                                        </div>
                                        {{#if this.isTraining}}
                                            <button type="button" class="dsadesignbutton training-btn-disabled" disabled>
                                                <i class="fas fa-hourglass-half training-btn-icon"></i> {{localize 'SHEET.InTraining'}}
                                            </button>
                                        {{else}}
                                            <button type="button" class="dsadesignbutton training-btn-action" data-action="teachTraining" data-training="{{this.name}}">
                                                <i class="fas fa-paw training-btn-icon"></i> {{localize 'SHEET.TeachTrainingBtn'}}
                                            </button>
                                        {{/if}}
                                    </div>
                                </div>
                            {{/each}}
                            {{#unless availableTrainings.length}}
                                <p class="training-empty-state">{{localize 'SHEET.NoAvailableTrainings'}}</p>
                            {{/unless}}
                        </div>
                    </div>
                </div>
            </div>
        {{/if}}
    </div>

    </section>
</div>
