<div class='tab scrollable {{tabs.inventory.cssClass}}' data-tab='inventory' data-group='{{tabs.inventory.group}}'>
  <div class="row-section wrap skills table-header searchbox">
    <div class="col morph lineheight searchbox-spacer">
    </div>
    <div class="col morph row-section lineheight">
      <div class="col ten center">
        <i class="fas fa-search"></i>
      </div>
      <div class="col eighty lineheight searchbox-input">
        <input type="search" class="inventorySearch" placeholder="{{localize 'gearSearch'}}" />
      </div>
      {{#if isGM}}
        <div class="col ten center flexAlignCenter flexrow">
          <button type="button" class="icon fas fa-plus noBorder dsadesignbutton" data-action="addLocation" data-tooltip="GROUP.addLocation"></button>
        </div>
      {{/if}}
    </div>
  </div>

  <div class="allLocations">
    {{#each locations as |loc|}}
      <div class="groupbox group-location" data-location-key="{{loc.key}}">
        <legend class="table-title lineheight flexrow">
          <div class="flexrow gap10px">
            <img src="{{loc.img}}" class="flex0" width="24" height="24" />
            <span class="flexgrow">{{loc.name}}</span>
          </div>
          
          <div class="flexrow flexAlignEnd">
            {{#unless loc.locked}}
              <button class="icon fas fa-exchange-alt noBorder dsadesignbutton" type="button"
                data-action="tradeWithDepot" data-location-key="{{loc.key}}"
                data-tooltip="{{localize 'GROUP.tradeWithDepot'}}"></button>
            {{/unless}}
            {{#if @root.isGM}}
              <button class="icon fas {{#if loc.locked}}fa-lock{{else}}fa-lock-open{{/if}} noBorder dsadesignbutton" type="button"
                data-action="toggleLocationLock" data-location-key="{{loc.key}}"
                data-tooltip="{{#if loc.locked}}{{localize 'GROUP.locked'}}{{else}}{{localize 'GROUP.unlocked'}}{{/if}}"></button>
            {{else if loc.locked}}
              <i class="fas fa-lock" style="opacity:0.5" data-tooltip="{{localize 'GROUP.locked'}}"></i>
            {{/if}}
            <button class="icon fas fa-external-link-alt noBorder dsadesignbutton" type="button" data-action="openLocationSheet" data-tooltip="{{localize 'GROUP.openFullSheet'}}"></button>
            {{#if @root.isGM}}
              <button class="icon fas fa-times noBorder dsadesignbutton" type="button" data-action="removeLocation" data-tooltip="{{localize 'GROUP.removeLocation'}}"></button>
            {{/if}}
          </div>          
        </legend>
        {{#if loc.coins.length}}
        <div class="flexrow lineheight flexAlignCenter gap5px">
          {{#each loc.coins as |coin|}}
            <div data-tooltip="{{coin.name}}" class="flex0" style="min-width:50px"><img src="{{coin.img}}" style="display:inline-block" width="14" height="14" /> {{coin.quantity}}</div>
          {{/each}}
        </div>
        {{/if}}
        <div class="row-section table-title">
          <div class="col eight"></div>
          <div class="col">
            <b>{{localize 'Name'}}</b>
          </div>
          <div class="col four center">
            <span data-tooltip="UNITS.money"><i class="fas fa-coins"></i></span>
          </div>
          <div class="col ten center">
            <span data-tooltip="quantity">#</span>
          </div>
          <div class="col ten"></div>
        </div>
        <div class="row-section wrap rowtable inventory">
          {{#each loc.items as |item|}}
              <div class="col item location-item-row" data-item-id="{{item._id}}" data-location-key="{{../loc.key}}"
                   draggable="true">
                <div class="row-section">
                  <div class="col eight image {{item.enchantClass}}">
                    <div class="image" style="background-image: url('{{item.img}}')"></div>
                  </div>
                  <div class="col">
                    <a class="ellipsis" data-action="openLocationItem" data-uuid="{{item.uuid}}" data-location-key="{{../loc.key}}">{{item.name}}</a>
                  </div>
                  <div class="col four flexrow flexAlignCenter">
                    {{item.calculatedPrice}}
                  </div>
                  <div class="col ten flexrow flexAlignCenter">
                    {{#if item.system.quantity}}
                      {{item.system.quantity.value}}
                    {{/if}}
                  </div>
                  <div class="col ten flexrow">
                    <button type="button" class="icon fas fa-ellipsis-vertical very-small noBorder dsadesignbutton locationItemContext"
                      data-action="locationItemContextMenu" data-location-key="{{../loc.key}}" data-item-id="{{item._id}}"></button>
                  </div>
                </div>
              </div>
          {{/each}}
        </div>
      </div>
    {{/each}}
  </div>

  {{#unless locations.length}}
    <div class="droparea">
      {{localize 'GROUP.dropLocationsHint'}}
    </div>
  {{/unless}}
</div>
