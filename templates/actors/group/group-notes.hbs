<div class='tab scrollable gap0px {{tabs.notes.cssClass}}' data-tab='notes' data-group='{{tabs.notes.group}}'>
  <div class="row-section table-title lineheight">
    <div class="col">
    </div>
    <div class="col ten center flexAlignEnd flexrow">
      {{#if isGM}}
        <button type="button" class="icon fas fa-book-open noBorder dsadesignbutton lineheight" data-action="createEventsJournal" data-tooltip="GROUP.createEventsJournal"></button>
      {{/if}}
    </div>
  </div>

  <div class="groupbox">
    <legend class="table-title lineheight">{{localize 'biography'}} <a data-action="chCollapse" class="ch-collapse"><i class="fas fa-angle-up" data-tooltip="SHEET.collapse"></i></a></legend>
    <div class="row-section">
      <div class="col notes-box">
        {{formInput systemFields.details.fields.biography value=document.system.details.biography toggled=true enriched=enrichedBiography}}
      </div>
    </div>
  </div>

  <div class="groupbox">
    <legend class="table-title lineheight">{{localize 'Notes'}} <a data-action="chCollapse" class="ch-collapse"><i class="fas fa-angle-up" data-tooltip="SHEET.collapse"></i></a></legend>
    <div class="row-section">
      <div class="col notes-box">
        {{formInput systemFields.details.fields.notes value=document.system.details.notes toggled=true enriched=enrichedNotes}}
      </div>
    </div>
  </div>
</div>
