<div class='tab {{tabs.gmTools.cssClass}}' data-tab='gmTools' data-group='{{tabs.gmTools.group}}'>
  <div class="scrollable">
    <div class="groupbox group-gm-tools{{#if gmTools.expanded}} is-expanded{{/if}}">
      {{#if gmTools.expanded}}
      <div class="dsa-helper-overlay">
        <div class="dsa-helper-overlay__bar dsa-sticky-top flexrow">
          <h3 class="dsa-helper-overlay__title underlined-header flex1">{{localize gmTools.expanded.label}}</h3>
          <button type="button" class="icon noBorder dsadesignbutton fas fa-times" data-action="collapseGroupHelper" data-tooltip="GROUP.closeHelper" aria-label="{{localize 'GROUP.closeHelper'}}"></button>
        </div>
        <div class="dsa-helper-overlay__body group-helper-panel" data-group-helper-panel="{{gmTools.expanded.id}}" data-group-helper="{{gmTools.expanded.id}}">
          {{{gmTools.expanded.html}}}
        </div>
      </div>
      {{else}}
      <legend class="table-title lineheight">
        {{#if isGM}}
          {{localize 'GROUP.gmTools'}} <i class="fas fa-mask" data-tooltip="TT.onlyGM"></i>
        {{else}}
          {{localize 'GROUP.camp'}}
        {{/if}}
      </legend>
      {{> systems/dsa5/templates/actors/group/parts/group-helpers.hbs helpers=gmTools.cards}}
      {{/if}}
    </div>
  </div>
</div>
