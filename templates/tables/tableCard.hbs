<div class='card-content test-data' data-actor-id='{{actorId}}'>
  <b><i class='fas fa-dice'></i> {{title}}</b>
  <div class='card-content hideAnchor'>
    <b>{{localize 'Description'}}</b>:
    {{{result}}}
  </div>
  {{#if hasEffect}}
    <div class='row-section' style='margin-top:10px'>
      <div class='col center'>
        <button class='applyTableEffect selfButton' data-target='self'>{{localize 'ActiveEffects.apply'}}</button>
      </div>
    </div>
  {{/if}}
</div>