<div class="dsa5 chat-card">
  <p><b>{{localize 'botchCritEffect'}}</b>: {{localize 'Defense'}} {{defendable}}</p>
  <p>{{sourceActorName}}: {{sourceName}} &rarr; {{targetName}}</p>
  <div class="flexrow">
    <button class="tableSelfAttackDefense small-button chat-button" data-tooltip="{{localize 'dodge'}}">
      <i class="fas fa-shield-alt"></i> {{localize 'dodge'}}
    </button>
    <button class="tableSelfAttackDamage small-button chat-button">
      <i class="fas fa-tint"></i> {{localize 'damage'}}
    </button>
  </div>
</div>
