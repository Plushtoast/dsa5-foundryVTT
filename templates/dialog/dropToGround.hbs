<p>{{name}}</p>
<div class="form-group">
  <label>{{localize 'count'}}</label>
  <div class="form-fields">
    <range-picker name="count" value='{{count}}' min='{{min}}' max='{{max}}' step='1'></range-picker>
  </div>
</div>
{{#if isBag}}
<div class="form-group">
  <label>{{localize 'dropWithContents'}}</label>
  <input type="checkbox" name="isBag">
</div>
{{/if}}