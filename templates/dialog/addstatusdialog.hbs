<div class="selection">
    <div class="row-section skills searchbox" style="color: var(--color-text-primary)">

        <div class="col third lineheight">
            <button class="reactClick" data-action="reactClick" data-value="custom" data-tooltip="CONDITION.custom"><i class="fas fa-plus"></i> <b>{{localize "CONDITION.add"}}</b></a>
        </div>
        <div class="col third"></div>
        <div class="col third lineheight">
            <i class="fas fa-search"></i>
            <input type="search" class="conditionSearch" placeholder="{{localize 'Library.search'}}" />
        </div>
    </div>
    <div class="row-section wrap statusEffect" style="height: auto;">
        {{#each effects as |itm i|}}    
            <div class="col third filterable row-section">
                <button class="col eighty reactClick onebuttonleft" data-action="reactClick" data-value="{{itm.id}}" data-tooltip="{{itm.description}}"><img src="{{itm.img}}" /><span>{{itm.name}}</span></button>
                <button type="button" class="col five reactClick reactCustom onebuttonright" data-action="reactCustom" data-value="{{itm.id}}" data-tooltip="ActiveEffects.custom">
                    <i class="fas fa-cogs"></i>
                </button> 
            </div>    
                 
        {{/each}}
    </div>
</div>