<form class="skill-test">
    <div>
        <div class="form-group">
            <label></label>
            <div class="row-section col sixty">
                <div class="col">

                </div>
                <div class="col center" data-tooltip="CHAR.LEP">
                    <b>{{localize 'CHARAbbrev.LeP'}}</b>
                </div>
                {{#if showAspModifier}}
                <div class="col center" data-tooltip="CHAR.ASP">
                    <b>{{localize 'CHARAbbrev.AsP'}}</b>
                </div>
                {{/if}}{{#if showKapModifier}}
                <div class="col center" data-tooltip="CHAR.KAP">
                    <b>{{localize 'CHARAbbrev.KaP'}}</b>
                </div>
                {{/if}}
            </div>
        </div>

        <div class="form-group">
            <label>{{localize "Modifier"}}</label>
            <div class="row-section">
                <div class="col">
                    <input class="quantity-click" data-tooltip="TT.strgx10" data-tooltip-direction="RIGHT" type="number"
                        name="testModifier" value="{{testModifier}}" />
                </div>
                <div class="col">
                    <input class="quantity-click" data-tooltip="TT.strgx10" data-tooltip-direction="RIGHT" type="number"
                        name="LePModifier" value="0" />
                </div>
                {{#if showAspModifier}}
                <div class="col">
                    <input class="quantity-click" data-tooltip="TT.strgx10" data-tooltip-direction="RIGHT" type="number"
                        name="AsPModifier" value="0" />
                </div>
                {{/if}} {{#if showKapModifier}}
                <div class="col">
                    <input class="quantity-click" data-tooltip="TT.strgx10" data-tooltip-direction="RIGHT" type="number"
                        name="KaPModifier" value="0" />
                </div>
                {{/if}}
            </div>

        </div>

        <div class="talent-test-modifier-row form-group">
            <label>{{localize "DIALOG.MessageMode"}}</label>
            {{> systems/dsa5/templates/dialog/parts/message-mode.hbs messageMode=messageMode}}
        </div>

        <div class="form-group">
            <label>{{localize "camplocation"}}</label>
            <select name="regnerationCampLocations">
                {{selectOptions regnerationCampLocations selected=0 localize=true}}
            </select>
        </div>

        <div class="form-group">
            <label>{{localize "interruption"}}</label>
            <select name="regenerationInterruptOptions">
                {{selectOptions regenerationInterruptOptions selected=0 localize=true}}
            </select>
        </div>

        <div class="form-group">
            <label>{{localize "badEnvironment"}} (x 0.5)</label>
            <input type="checkbox" name="badEnvironment" value="1">
        </div>
        {{> systems/dsa5/templates/dialog/parts/situational-modifiers-widget.hbs}}

        {{#if (or showAspModifier showKapModifier)}}
        <div class="form-group">
            <label>{{localize 'CHAR.LEP'}}</label>
            <input type="checkbox" name="regenerateLeP" value="1" checked="checked">
        </div>
        {{else}}
        <div class="form-group" hidden>
            <label hidden>nur LeP</label>
            <input type="checkbox" name="regenerateLeP" value="1" checked="checked" hidden>
        </div>
        {{/if}}

        {{#if showAspModifier}}
        <div class="form-group">
            <label>{{localize 'CHAR.ASP'}}</label>
            <input type="checkbox" name="regenerateAsP" value="1" checked="checked">
        </div>
        {{/if}}

        {{#if showKapModifier}}
        <div class="form-group">
            <label>{{localize 'CHAR.KAP'}}</label>
            <input type="checkbox" name="regenerateKaP" value="1" checked="checked">
        </div>
        {{/if}}

    </div>
</form>
