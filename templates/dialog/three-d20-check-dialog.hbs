<div class="standard-form">
  <div class="row-section lineheight">
    <div class="col fourty table-title"><label>{{localize "skill"}}</label></div>
    <div class="col sixty">
      <select name="skill" class="select2" style="width:100%;">
        <option value="">{{localize "HELP.threeD20Generic"}}</option>
        {{#each skills as |skillName|}}
          <option value="{{skillName}}" {{#if (eq skillName ../selectedSkill)}}selected{{/if}}>{{skillName}}</option>
        {{/each}}
      </select>
    </div>
  </div>
  <div class="row-section lineheight">
    <div class="col fourty table-title"><label>{{localize "HELP.threeD20Alias"}}</label></div>
    <div class="col sixty">
      <input name="alias" type="text" value="{{alias}}" placeholder="{{localize "HELP.threeD20Alias"}}" />
    </div>
  </div>
  <p class="hint">{{localize "HELP.threeD20AliasHint"}}</p>
</div>
