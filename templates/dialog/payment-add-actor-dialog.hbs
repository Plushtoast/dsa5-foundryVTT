<div class='directory targetChoser payment-actor-picker'>
  <div class='form-group'>
    <div class='form-fields'>
      <input type='search' class='search-input actorsearch' placeholder='{{localize "Book.search"}}' autofocus />
    </div>
  </div>

  <ul class='directory-list payment-actor-list scrollable'>
    {{#each actors as |actor|}}
      <li
        class='combatant actor directory-item row-section payment-actor-row{{#if actor.isUserCharacter}} user-character{{/if}}'
        data-actor-id='{{actor.id}}'
        data-actor-name='{{actor.name}}'
        data-actor-meta='{{actor.meta}}'
      >
        <div class='combatant-advanced col five'>
          <img class='token-image' data-tooltip='{{actor.name}}' src='{{actor.img}}' style='height:100%' />
        </div>
        <div class='token-name flexrow flexAlignCenter col seventy'>
          <div>
            <h4>{{actor.name}}</h4>
            {{#if actor.meta}}
              <div class='very-small'>{{actor.meta}}</div>
            {{/if}}
          </div>
        </div>
        <div class='col ten center'>
          <input type='checkbox' class='payment-actor-selector' name='paymentActor' value='{{actor.id}}' />
        </div>
      </li>
    {{/each}}
  </ul>
</div>