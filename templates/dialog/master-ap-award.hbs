<div class="selection">
    <p>{{{text}}}</p>

    <div class="form-group">
        <div class="form-fields">
            <input class="input-text quantity-click" data-tooltip="TT.strgx10" data-tooltip-direction="RIGHT" data-quantityfocus="1" type="number" name="entryselection" value="{{amount}}" />
        </div>
    </div>
    
    {{#each tracked as |hero|}}       
        <div class="form-group">
            <label for="award_{{hero.id}}">{{hero.name}}</label>    
            <div class="form-fields">
                <input type="checkbox" id="award_{{hero.id}}" class="smallBox heroSelector" value="{{hero.id}}" {{checked (hasElem ../selected hero.id)}}>
            </div>
        </div>
    {{/each}}
</div>