<form>
    <div class="row-section skill-test height100">
        <div class="talent-test-modifier col sixty flexcol columnFlex" style="max-width:60%">
            {{> systems/dsa5/templates/dialog/enhanced-default-dialog.hbs}}
        </div>
        <div class="talent-test-targets col fourty">
            <div class="targets row-section wrap item">
                {{> systems/dsa5/templates/dialog/parts/targets.hbs}}
            </div>
            {{#if focusRuleModifiers.length}}
            <div class="flexcol specAbsContainer">
                {{#each focusRuleModifiers}}
                <div>
                    <a class="button dsadesignbutton noBorder" data-toggle="{{group}}" data-action="toggleSection" data-tooltip="Book.focusRule">
                        <div class="fokusregel f1 tiny"></div>
                        <div class="flexrow"><b>{{localize group}}</b></div>
                    </a>
                    <div data-section="{{group}}" class="dsahidden">
                        {{#each modifiers}}
                        <div class="flexrow focusMods active" data-tooltip="{{label}}.tooltip">
                            <div class="ellipsis">{{localize (concat label ".label")}}</div>
                            <div class="vwidget flex0" data-min="{{min}}" data-max="{{max}}" data-name="{{label}}.label"></div>
                        </div>
                        {{/each}}
                    </div>
                </div>
                {{/each}}
            </div>
            {{/if}}
        </div>
    </div>
</form>