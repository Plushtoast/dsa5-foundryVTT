<div class="flexcol">
  <div class='form-group'>
    <label>{{localize 'Modifier'}}</label>
    <div class="form-fields">
      <input class='quantity-click' data-tooltip='TT.strgx10' data-tooltip-direction='RIGHT' type='number' name='testModifier' value='{{testModifier}}' />
    </div>
  </div>
  {{#if difficultyLabels}}
    <div class='form-group'>
      <label>{{localize 'Difficulty'}}</label>
      <div class="form-fields">
      <select name='testDifficulty'>
        {{selectOptions difficultyLabels selected=testDifficulty localize=true}}
      </select>
      </div>
    </div>
  {{/if}}
  <div class='talent-test-modifier-row form-group'>
    <label>{{localize 'DIALOG.RollMode'}}</label>
    <div class='form-fields gap0px dsaRollMode'>
      <label class='checkbox' data-tooltip='CHAT.RollPublic'><input type='radio' name='rollMode' value='publicroll' {{checked (eq rollMode 'publicroll')}} /><i
          class='fas fa-globe'
        ></i></label>
      <label class='checkbox' data-tooltip='CHAT.RollPrivate'><input type='radio' name='rollMode' value='gmroll' {{checked (eq rollMode 'gmroll')}} /><i
          class='fas fa-user-secret'
        ></i></label>
      <label class='checkbox' data-tooltip='CHAT.RollBlind'><input type='radio' name='rollMode' value='blindroll' {{checked (eq rollMode 'blindroll')}} /><i
          class='fas fa-eye-slash'
        ></i></label>
      <label class='checkbox' data-tooltip='CHAT.RollSelf'><input type='radio' name='rollMode' value='selfroll' {{checked (eq rollMode 'selfroll')}} /><i
          class='fas fa-user'
        ></i></label>
    </div>
  </div>
  {{#if hasSituationalModifiers}}
    <div class='modifiers form-group'>
      <label>{{localize 'DIALOG.SituationalModifiers'}}</label>
      <div class="form-fields">
        <select name='situationalModifiers' multiple>
          {{#each situationalModifiers as |mod t|}}
          <option data-tooltip="{{situationalTooltip mod}}" data-type="{{mod.type}}" value="{{mod.value}}" {{#if mod.selected}}selected{{/if}} data-consumable-id="{{mod.consumableId}}">
          {{localize mod.name}} [{{mod.value}}]
          </option>
          {{/each}}
        </select>
      </div>
    </div>
  {{/if}}
</div>
