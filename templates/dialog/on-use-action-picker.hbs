<div class="selection on-use-action-picker">
    <div class="row-section wrap">
        {{#each actions as |action|}}
        <div class="col two flexrow">
            <button type="button" class="reactClick row-section" data-action-id="{{action.id}}" data-tooltip="{{action.name}}">
                <img class="col ten" src="{{action.img}}" />
                <div class="col eighty">{{action.name}}</div>
            </button>
        </div>
        {{/each}}
    </div>
</div>