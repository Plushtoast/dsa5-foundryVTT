<div class="form-group">
    <label></label>
    <div class="form-fields gap0px">
        <div>&nbsp;</div>
        {{#each characteristics as |item i|}}
        <div class="center" style="max-width: 16.66%;" data-tooltip="{{concatUp 'CHAR.' item}}">
            <select class="noAppearance" name="characteristics{{i}}">
                {{selectOptions ../attributesList selected=item}}
            </select>
        </div>
        {{/each}}
        <div class="center" data-tooltip="Fw">
            {{localize 'CHARAbbrev.FW'}}
        </div>
        <div class="center" data-tooltip="qualityStep">
            {{localize 'CHARAbbrev.QS'}}
        </div>
    </div>
</div>
<div class="talent-test-modifier-row form-group">
    <label>{{localize "Modifier"}}</label>
    <div class="form-fields gap0px">
        <input class="quantity-click center" data-tooltip="TT.strgx10" data-tooltip-direction="RIGHT" type="number" name="testModifier" value="{{testModifier}}" />
        {{#each characteristics as |item i|}}
        <input class="quantity-click center" data-tooltip="TT.strgx10" data-tooltip-direction="RIGHT" type="number" name="ch{{i}}" value="0" />
        {{/each}}
        <input class="quantity-click center" data-tooltip="TT.strgx10" data-tooltip-direction="RIGHT" type="number" name="fw" value="0" />
        <input class="quantity-click center" data-tooltip="TT.strgx10" data-tooltip-direction="RIGHT" type="number" name="qs" value="0" />
    </div>
</div>
{{#if difficultyLabels}}
<div class="form-group">
    <label>{{localize "Difficulty"}}</label>
    <div class="form-fields">
        <select name="testDifficulty">
            {{selectOptions difficultyLabels selected=testDifficulty localize=true}}  
        </select>
    </div>
</div>
{{/if}}
<div class="talent-test-modifier-row form-group">
    <label>{{localize "DIALOG.RollMode"}}</label>
    <div class="form-fields gap0px dsaRollMode">
        <label class="checkbox" data-tooltip="CHAT.RollPublic"><input type="radio" name="rollMode" value="publicroll" {{checked (eq rollMode "publicroll")}}><i class="fas fa-globe"></i></label>
        <label class="checkbox" data-tooltip="CHAT.RollPrivate"><input type="radio" name="rollMode" value="gmroll" {{checked (eq rollMode "gmroll")}}><i class="fas fa-user-secret"></i></label>
        <label class="checkbox" data-tooltip="CHAT.RollBlind"><input type="radio" name="rollMode" value="blindroll" {{checked (eq rollMode "blindroll")}}><i class="fas fa-eye-slash"></i></label>
        <label class="checkbox" data-tooltip="CHAT.RollSelf"><input type="radio" name="rollMode" value="selfroll" {{checked (eq rollMode "selfroll")}}><i class="fas fa-user"></i></label>
    </div>
</div>
{{#if hasSituationalModifiers}}
<div class="modifiers form-group" style="flex-grow: 1;">
    <label>{{localize "DIALOG.SituationalModifiers"}}</label>
    <div class="form-fields height100">
        <select name="situationalModifiers" multiple class="height100">
            {{#each situationalModifiers as |mod t|}}
            <option data-tooltip="{{situationalTooltip mod}}" data-type="{{mod.type}}" {{#if mod.armorPen}}data-armor-pen="{{mod.armorPen}}"{{/if}} data-effect-id="{{mod.effectId}}" data-effect-uuid="{{mod.effectUuid}}" value="{{mod.value}}" {{#if mod.selected}}selected{{/if}}>
                {{localize mod.name}} [{{mod.value}} {{mod.type}}]
            </option>
            {{/each}}
        </select>
    </div>
</div>
{{/if}}
{{#if visionOptions}}
<div class='form-group'>
  <label>{{localize 'sight'}}</label>
  <div class="form-fields">
    <select name='vision'>
      {{selectOptions visionOptions selected='0' localize=true}}
    </select>
  </div>
</div>
{{/if}}