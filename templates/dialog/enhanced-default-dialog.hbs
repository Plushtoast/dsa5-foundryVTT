<div class="form-group">
    <label></label>
    <div class="form-fields gap0px">
        <div>&nbsp;</div>
        {{#each characteristics as |item i|}}
        <div class="center" style="max-width: 16.66%;" data-tooltip="{{concatUp 'CHAR.' item}}">
            <select class="noAppearance" name="characteristics{{i}}">
                {{selectOptions ../attributesList selected=item}}
            </select>
        </div>
        {{/each}}
        <div class="center" data-tooltip="Fw">
            {{localize 'CHARAbbrev.FW'}}
        </div>
        <div class="center" data-tooltip="qualityStep">
            {{localize 'CHARAbbrev.QS'}}
        </div>
    </div>
</div>
<div class="talent-test-modifier-row form-group">
    <label>{{localize "Modifier"}}</label>
    <div class="form-fields gap0px">
        <input class="quantity-click center" data-tooltip="TT.strgx10" data-tooltip-direction="RIGHT" type="number" name="testModifier" value="{{testModifier}}" />
        {{#each characteristics as |item i|}}
        <input class="quantity-click center" data-tooltip="TT.strgx10" data-tooltip-direction="RIGHT" type="number" name="ch{{i}}" value="0" />
        {{/each}}
        <input class="quantity-click center" data-tooltip="TT.strgx10" data-tooltip-direction="RIGHT" type="number" name="fw" value="0" />
        <input class="quantity-click center" data-tooltip="TT.strgx10" data-tooltip-direction="RIGHT" type="number" name="qs" value="0" />
    </div>
</div>
{{#if difficultyLabels}}
<div class="form-group">
    <label>{{localize "Difficulty"}}</label>
    <div class="form-fields">
        <select name="testDifficulty">
            {{selectOptions difficultyLabels selected=testDifficulty localize=true}}  
        </select>
    </div>
</div>
{{/if}}
<div class="talent-test-modifier-row form-group">
    <label>{{localize "DIALOG.MessageMode"}}</label>
    {{> systems/dsa5/templates/dialog/parts/message-mode.hbs messageMode=messageMode}}
</div>
{{> systems/dsa5/templates/dialog/parts/situational-modifiers-widget.hbs}}
{{#if visionOptions}}
<div class='form-group'>
  <label>{{localize 'sight'}}</label>
  <div class="form-fields">
    <select name='vision'>
      {{selectOptions visionOptions selected='0' localize=true}}
    </select>
  </div>
</div>
{{/if}}
