<div class="standard-form scrollable">
    <p class="hint">{{localize 'SHEET.afterUseEffectsHint'}}</p>

    <div class="form-group">
        <label>{{localize 'SHEET.afterUseEffectName'}}</label>
        <div class="form-fields">
            <input type="text" name="name" value="{{followup.name}}">
        </div>
    </div>

    <div class="form-group">
        <label>{{localize 'SHEET.afterUseDurationSeconds'}}</label>
        <div class="form-fields">
            <input type="number" name="seconds" value="{{followup.seconds}}" min="0" step="1">
        </div>
    </div>

    <section class="changes">
        {{> systems/dsa5/templates/status/parts/change-list-advanced.hbs changes=followup.changes changePath="changes"}}
    </section>

    <div class="form-footer flexrow">
        <button type="button" data-action="save">
            <i class="fa-solid fa-save"></i> {{localize 'save'}}
        </button>
        <button type="button" data-action="cancel">
            <i class="fa-solid fa-xmark"></i> {{localize 'cancel'}}
        </button>
    </div>
</div>