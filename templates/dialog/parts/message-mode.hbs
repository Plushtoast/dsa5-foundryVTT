<div class='form-fields gap0px dsaMessageMode'>
  <label class='checkbox' data-tooltip='CHAT.MODES.public'><input type='radio' name='messageMode' value='public' {{checked (eq messageMode 'public')}} /><i class='fas fa-globe'></i></label>
  <label class='checkbox' data-tooltip='CHAT.MODES.ic'><input type='radio' name='messageMode' value='ic' {{checked (eq messageMode 'ic')}} /><i class='fas fa-hat-wizard'></i></label>
  <label class='checkbox' data-tooltip='CHAT.MODES.gm'><input type='radio' name='messageMode' value='gm' {{checked (eq messageMode 'gm')}} /><i class='fas fa-user-secret'></i></label>
  <label class='checkbox' data-tooltip='CHAT.MODES.blind'><input type='radio' name='messageMode' value='blind' {{checked (eq messageMode 'blind')}} /><i class='fas fa-eye-slash'></i></label>
  <label class='checkbox' data-tooltip='CHAT.MODES.self'><input type='radio' name='messageMode' value='self' {{checked (eq messageMode 'self')}} /><i class='fas fa-user'></i></label>
</div>