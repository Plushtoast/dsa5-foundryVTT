<div class='form-fields gap0px dsaMessageMode' role='group' aria-label='{{ariaLabel}}' aria-describedby='{{describedBy}}'>
  {{#each dispositions as |disp|}}
  <button type='button' class='disposition-mode' data-action='setDisposition' data-disposition='{{disp.value}}'
    data-tooltip='{{disp.label}}' aria-label='{{disp.label}}'><i class='{{disp.icon}}'></i></button>
  {{/each}}
</div>
