<div class='row-section'>
  <div class='col fourty'></div>
  <div class='row-section col sixty'>
    <div class='col five'>
    </div>
    {{#if (or showAttack rangeOptions)}}
    <div class='col five center' data-tooltip='MODS.damage'>
      {{localize 'CHARAbbrev.damage'}}
    </div>
    {{/if}}
  </div>
</div>
<div class='form-group'>
  <label>{{localize 'Modifier'}}</label>
  <div class='row-section'>
    <div class='col five'>
      <input class='quantity-click' data-tooltip='TT.strgx10' data-tooltip-direction='RIGHT' type='number'
        name='testModifier' value='{{testModifier}}' />
    </div>
    {{#if (or showAttack rangeOptions)}}
    <div class='col five'>
      <input type='text' name='damageModifier' value='0' />
    </div>
    {{/if}}
  </div>
</div>
<div class='talent-test-modifier-row form-group'>
  <label>{{localize 'DIALOG.MessageMode'}}</label>
  {{> systems/dsa5/templates/dialog/parts/message-mode.hbs messageMode=messageMode}}
</div>
{{#if hasSituationalModifiers}}
<div class='modifiers form-group'>
  <label>{{localize 'DIALOG.SituationalModifiers'}}</label>
  <div class="form-fields">
    <select name='situationalModifiers' multiple>
      {{#each situationalModifiers as |mod t|}}
      <option data-tooltip="{{situationalTooltip mod}}" data-type="{{mod.type}}" {{#if
        mod.specAbId}}data-spec-ab-id="{{mod.specAbId}}" {{/if}} {{#if mod.armorPen}}data-armor-pen="{{mod.armorPen}}"
        {{/if}} data-effect-id="{{mod.effectId}}" data-effect-uuid="{{mod.effectUuid}}" value="{{mod.value}}" {{#if mod.selected}}selected{{/if}}>
        {{localize mod.name}} [{{mod.value}}]
      </option>
      {{/each}}
    </select>
  </div>
</div>
{{/if}}
{{#if visionOptions}}
<div class='form-group'>
  <label>{{localize 'sight'}}</label>
  <div class="form-fields">
    <select name='vision'>
      {{selectOptions visionOptions selected='0' localize=true}}
    </select>
  </div>
</div>
{{/if}}