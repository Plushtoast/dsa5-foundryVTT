<div class='selection'>
  <p>{{localize 'DIALOG.ItemRequiresAdoptionDescription'}}.</p>
  <h2>{{original.name}}</h2>
  <p>{{{original.description.value}}}</p>
  <div class='form-group'>
    <label>{{localize 'entry'}}</label>
    <div class='form-fields'>
      <select name='entryselection' class='select2'>
        {{selectOptions items selected='-' valueAttr='name' labelAttr='name'}}
      </select>
    </div>
  </div>

  {{#if area}}
    <div class='form-group'>
      <label>{{localize 'specialisation'}}</label>

      <div class='form-fields'>
        <input type='text' name='custom' />
      </div>
    </div>
  {{/if}}
</div>