<form class='skill-test'>

  <div class='form-group'>
    <label>{{localize 'fallingHeight'}}</label>
    <div class='row-section'>
      <div class='col'>
        <input class='quantity-click' type='number' name='testModifier' value='{{testModifier}}'
          data-tooltip='gridUnits' />
      </div>
      <div class='col center'>
        <label class='resultDamage'>x <span data-tooltip='Trefferpunkte'
            class='display-toggle fail die-damage d6'>6</span></label>
      </div>
      <div class='col center lineheight' data-tooltip='fallingHorses'>
        <i class='fas fa-horse'></i>
      </div>
    </div>
  </div>

  <div class='talent-test-modifier-row form-group'>
    <label>{{localize 'DIALOG.MessageMode'}}</label>
    {{> systems/dsa5/templates/dialog/parts/message-mode.hbs messageMode=messageMode}}
  </div>

  <div class='form-group'>
    <label>{{localize 'fallingFloor'}}</label>
    <select name='fallingFloor'>
      {{selectOptions fallingFloorOptions selected=0 localize=true}}
    </select>
  </div>

  {{#if hasSituationalModifiers}}
  <div class='modifiers form-group'>
    <label>{{localize 'DIALOG.SituationalModifiers'}}</label>
    <div class="form-fields">
      <select name='situationalModifiers' multiple>
        {{#each situationalModifiers as |mod t|}}
        <option data-tooltip="{{situationalTooltip mod}}" data-type="{{mod.type}}" data-effect-id="{{mod.effectId}}" data-effect-uuid="{{mod.effectUuid}}" value="{{mod.value}}" {{#if
          mod.selected}}selected{{/if}}>
          {{localize mod.name}} [{{mod.value}} {{mod.type}}]
        </option>
        {{/each}}
      </select>
    </div>
  </div>
  {{/if}}
</form>