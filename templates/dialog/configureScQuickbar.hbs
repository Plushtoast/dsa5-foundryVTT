<div class="scrollable standard-form">
    <div class="form-group" data-setting-id="dsa5.enableScQuickbar">
        <label>{{localize 'SCQUICKBAR.enable'}}</label>
        <div class="form-fields">
            <input type="checkbox" name="dsa5.enableScQuickbar" {{checked enableScQuickbar}}>
        </div>
        <p class="hint">{{localize 'SCQUICKBAR.enableHint'}}</p>
    </div>
    {{#if enableScQuickbar}}
    <hr>
    <div class="form-group submenu">
        <label>{{localize 'SCQUICKBAR.reset'}}</label>
        <div class="form-fields">
            <button type="button" data-action="resetScQuickbar">
                <label>{{localize 'SCQUICKBAR.reset'}}</label>
            </button>
        </div>
        <p class="hint">{{localize 'SCQUICKBAR.resetHint'}}</p>
    </div>
    <div class="form-group" data-setting-id="dsa5.scQuickbarConfig.size">
        <label>{{localize 'SCQUICKBAR.size'}}</label>
        <div class="form-fields">
            <range-picker id="{{rootId}}-scQuickbarSize" name="config.size" value='{{config.size}}' min="48" max="120" step="4"></range-picker>
        </div>
        <p class="hint">{{localize 'SCQUICKBAR.sizeHint'}}</p>
    </div>
    <div class="form-group" data-setting-id="dsa5.scQuickbarConfig.layout">
        <label>{{localize 'SCQUICKBAR.layout'}}</label>
        <div class="form-fields">
            <select name="config.layout">
                {{selectOptions layoutChoices selected=config.layout localize=true}}
            </select>
        </div>
        <p class="hint">{{localize 'SCQUICKBAR.layoutHint'}}</p>
    </div>
    <div class="form-group" data-setting-id="dsa5.scQuickbarConfig.showName">
        <label>{{localize 'SCQUICKBAR.showName'}}</label>
        <div class="form-fields">
            <input type="checkbox" name="config.showName" {{checked config.showName}}>
        </div>
        <p class="hint">{{localize 'SCQUICKBAR.showNameHint'}}</p>
    </div>
    <div class="form-group" data-setting-id="dsa5.scQuickbarConfig.compactResources">
        <label>{{localize 'SCQUICKBAR.compactResources'}}</label>
        <div class="form-fields">
            <input type="checkbox" name="config.compactResources" {{checked config.compactResources}}>
        </div>
        <p class="hint">{{localize 'SCQUICKBAR.compactResourcesHint'}}</p>
    </div>
    <div class="form-group" data-setting-id="dsa5.scQuickbarConfig.sideInfo">
        <label>{{localize 'SCQUICKBAR.sideInfo'}}</label>
        <div class="form-fields">
            <input type="checkbox" name="config.sideInfo" {{checked config.sideInfo}}>
        </div>
        <p class="hint">{{localize 'SCQUICKBAR.sideInfoHint'}}</p>
    </div>
    <div class="form-group" data-setting-id="dsa5.scQuickbarConfig.fadedUi">
        <label>{{localize 'SCQUICKBAR.fadedUi'}}</label>
        <div class="form-fields">
            <input type="checkbox" name="config.fadedUi" {{checked config.fadedUi}}>
        </div>
        <p class="hint">{{localize 'SCQUICKBAR.fadedUiHint'}}</p>
    </div>
    {{/if}}
</div>
