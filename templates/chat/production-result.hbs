<div>
  <div class='opposed-message'>
    <b>{{actor.name}}</b>
    {{localize 'PRODUCTION.success'}}
    <b>{{item.name}}</b>
  </div>
  <div class='opposed-tokens row-section'>
    <div class='col two attacker'>{{{actorImg}}}</div>

    <div class='col two chatImgPreview'>
      <a class="img-entity-link cursor-drag embeddedItemDrag" draggable="true"
        data-tooltip="{{localize 'PRODUCTION.dragElem'}}">
        <div class='image' style='background-image:url({{item.img}})'></div>
      </a>
    </div>
  </div>

  {{#if showDragHint}}
  <div class="center small">
    <i class="fas fa-hand-pointer"></i> {{localize "PRODUCTION.dragToActor"}}
  </div>
  {{/if}}
</div>
