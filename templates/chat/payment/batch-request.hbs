<div class="dsa5 payment-request-card">
  <h4>{{title}}</h4>
  <p><b>{{{amount}}}</b></p>
  {{#if description}}
    <p><i>{{description}}</i></p>
  {{/if}}

  {{#if recipients.length}}
    {{#each recipients}}
      <div class="row-section tableOdd payment-request-row" data-actor-id="{{actorId}}" data-status="{{status}}">
        <div class="col two">
          <div class="flexrow flexAlignCenter">
            <b class="ellipsis">{{actorName}}</b>
          </div>
          {{#if designatedUserName}}
            <div class="very-small">{{designatedUserName}}</div>
          {{/if}}
        </div>
        <div class="col five flexrow flexAlignEnd gap2px">
          <span class="button icon noBorder payment-request-indicator {{colorClass}}" data-tooltip="{{label}}" aria-label="{{label}}">
            <i class="fas {{icon}}"></i>
          </span>
          {{#if hasResultDetails}}
            <span class="button icon noBorder payment-request-indicator icon-gray" data-tooltip-html="{{resultTooltipHtml}}" aria-label="{{resultTooltip}}">
              <i class="fas fa-info-circle"></i>
            </span>
          {{/if}}
        </div>
      </div>
    {{/each}}
  {{else}}
    <p class="very-small">{{localize "DSAQUERIES.NOTIFICATIONS.noActors"}}</p>
  {{/if}}

  {{#unless finalized}}
    <div class="payment-request-gm flexrow gap5px margin-top">
      <button type="button" class="payment-request-action" data-action="add" data-tooltip="{{localize "DSAQUERIES.COMMANDS.addActor"}}" aria-label="{{localize "DSAQUERIES.COMMANDS.addActor"}}"><i class="fas fa-plus"></i></button>
      <button type="button" class="payment-request-action" data-action="finalize" data-tooltip="{{localize "DSAQUERIES.COMMANDS.finalize"}}" aria-label="{{localize "DSAQUERIES.COMMANDS.finalize"}}"><i class="fas fa-check"></i></button>
    </div>
  {{/unless}}
</div>