<div class="dsa5 transaction-summary-card">
  <div class="row-section flexAlignCenter">
    <div class="col ninety">
      <h2>{{title}}</h2>
      <p><b>{{{participantsHtml}}}</b></p>
    </div>
  </div>

  {{#each transfers}}
    <div>
        <b>{{heading}}</b>
    </div>
    
    {{#if items.length}}
    {{#each items}}
        <div class="row-section tableOdd">
            <div class="col ten">
                {{quantity}}x
            </div>
            <div class="col sixty ellipsis">
                {{{linkHtml}}}
            </div>
            <div class="col third flexrow dsaflex-no-wrap nobr">
                {{{priceHtml}}}
            </div>
        </div>
    {{/each}}
    {{else}}
    <div class="row-section tableOdd">
        <div class="col">
            -
        </div>
    </div>
    {{/if}}
  {{/each}}
</div>
