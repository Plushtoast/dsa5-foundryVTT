<div class="dsa5 trap-announce-card">
    <div class="flexrow">
        <img class="flex0" src="{{trapImg}}" width="42" height="42" style="margin-right:6px"/>
        <p>{{{localize "REGIONBEHAVIOR_DSATrap.trapstart" name=tokenAnchor trap=trapName}}}</p>
    </div>
    {{#if showNarration}}
    <div class="dsa-info-box">
        <p class="dsa-info-text small"><b>{{localize "REGIONBEHAVIOR_DSATrap.narrateDetected"}}</b></p>
        <p class="dsa-info-text">{{{enrichedDescription}}}</p>
    </div>
    {{else}}
    {{#unless behaviour.gmdescription}}
    <p>{{{enrichedDescription}}}</p>
    {{/unless}}
    {{/if}}
    <div class="flexcol gap5px">
        <div class="flexrow gap2px">
            <span class="dsa-pip pip-neutral" data-tooltip="REGIONBEHAVIOR_DSATrap.FIELDS.difficulty.label"><i class="fas fa-unlock"></i> {{behaviour.difficulty}}</span>
            <span class="dsa-pip pip-neutral" data-tooltip="REGIONBEHAVIOR_DSATrap.FIELDS.stealth.label"><i class="fas fa-eye-slash"></i> {{behaviour.stealth}}</span>
            {{#each damageBadges as |badge|}}
            <span class="dsa-pip pip-neutral trap-announce-formula" data-tooltip="{{badge.tooltip}}"><i class="{{badge.icon}}"></i> {{badge.text}}</span>
            {{/each}}
            {{#if detected}}<span class="dsa-pip pip-positive">{{localize "REGIONBEHAVIOR_DSATrap.FIELDS.detected.label"}}</span>{{/if}}
            {{#if disarmed}}<span class="dsa-pip pip-positive">{{localize "REGIONBEHAVIOR_DSATrap.FIELDS.disarmed.label"}}</span>{{/if}}
            {{#if triggered}}<span class="dsa-pip pip-negative">{{localize "REGIONBEHAVIOR_DSATrap.triggered"}}</span>{{/if}}
            {{#unless disarmed}}<span class="dsa-pip pip-neutral" data-tooltip="{{localize 'REGIONBEHAVIOR_DSATrap.disarmMessage' duration=disarmDuration}}"><i class="fas fa-clock"></i> {{disarmDuration}} min</span>{{/unless}}
            {{#if countdown.remaining}}<span class="dsa-pip pip-negative">{{localize "REGIONBEHAVIOR_DSATrap.timerRemaining" rounds=countdown.remaining modifier=countdown.escapeModifier}}{{#if countdown.interval}} · {{countdown.interval}}{{/if}}</span>{{/if}}
            {{#if countdown.timedOut}}<span class="dsa-pip pip-negative">{{localize "REGIONBEHAVIOR_DSATrap.timerTimedOut"}}</span>{{/if}}
        </div>
        <div class="flexrow">
            <button type="button" class="trap-handling" data-action="searchTrap" data-tooltip="REGIONBEHAVIOR_DSATrap.searchHint"><i class="fas fa-eye"></i></button>
            <button type="button" class="trap-handling" data-action="disarmTrap" data-tooltip="REGIONBEHAVIOR_DSATrap.disarmHint"><i class="fas fa-lock-open"></i></button>
            <button type="button" class="trap-handling" data-action="manualDisarm" data-tooltip="REGIONBEHAVIOR_DSATrap.manualDisarmHint"><i class="fas fa-wrench"></i></button>
            <button type="button" class="trap-handling" data-action="triggerTrap" data-tooltip="REGIONBEHAVIOR_DSATrap.triggerHint"><i class="fas fa-bolt"></i></button>
            <button type="button" class="trap-handling" data-action="showTrap" data-tooltip="REGIONBEHAVIOR_DSATrap.showTrapHint"><i class="fas fa-mask"></i></button>
        </div>
    </div>
    {{#if damageLines.length}}
    <div class="roll-request-card">
        {{#each damageLines as |line|}}
        <div class="flexrow gap5px flexAlignCenter">
            <span class="col sixty">{{line.label}}</span>
            <span class="flex0">{{#if line.total}}{{line.total}}{{else if line.chanceLabel}}{{line.chanceLabel}}{{else}}{{line.formula}}{{/if}}</span>
            {{#if line.needsChance}}
            <button type="button" class="trap-handling" data-action="applyTrapChance" data-line="{{line.id}}" data-tooltip="{{line.chanceLabel}}">{{line.label}}</button>
            {{/if}}
            {{#if line.hasAreaTemplate}}
            <button type="button" class="trap-handling" data-action="placeTrapTemplate" data-label="{{line.label}}" data-tooltip="TT.placeTemplate">{{localize "AoE"}}</button>
            {{/if}}
        </div>
        {{/each}}
    </div>
    {{/if}}
    {{#if outcomes.length}}
    <div class="roll-request-card">
        <div class="roll-request-rows">
            {{#each outcomes as |entry|}}
            <div class="flexcol gap2px roll-request-row {{entry.resultRowClass}}"{{#if entry.resultTooltip}} data-tooltip="{{entry.resultTooltip}}"{{else if entry.consequence}} data-tooltip="{{entry.consequence}}"{{/if}}>
                <span>{{entry.actorName}} — {{entry.modeLabel}}</span>
                {{#unless (eq entry.consequence (localize "REGIONBEHAVIOR_DSATrap.consequenceNotHit"))}}
                {{#if entry.consequence}}
                <span class="roll-request-result-sublabel">{{entry.consequence}}</span>
                {{else if entry.resultSubLabel}}
                <span class="roll-request-result-sublabel">{{entry.resultSubLabel}}</span>
                {{/if}}
                {{/unless}}
            </div>
            {{/each}}
        </div>
    </div>
    {{/if}}
    {{#if offers.length}}
    <div class="flexcol dsamt-2 gap5px">
        {{#each offers as |offer|}}
        <div class="flexcol gap2px">
            <button type="button" class="trap-handling" data-action="defendTrap" data-defense="{{offer.id}}">{{#if offer.usesReactionDialog}}{{localize "Unopposed"}}{{else}}{{offer.label}}{{/if}}</button>
            {{#if offer.hasMeta}}
            <span class="small">
                {{#if offer.skill}}{{offer.skill}}{{/if}}{{#if offer.applications}} ({{offer.applications}}){{/if}}
                {{#if offer.modifierLabel}} {{offer.modifierLabel}}{{/if}}
                {{#if offer.rangeMalus}} {{localize "MODS.defenseMalus"}} {{offer.rangeMalus}}{{/if}}
                {{#if offer.interval}} · {{offer.interval}}{{/if}}
                {{#if offer.targetQs}} · QS {{offer.targetQs}}{{/if}}
                {{#if offer.maxRollsLabel}} · {{offer.maxRollsLabel}}{{/if}}
                {{#if offer.gs}} · GS {{offer.gs}}{{/if}}
                {{#if offer.fw}} · FW {{offer.fw}}{{/if}}
                {{#if offer.distanceFormula}} · {{offer.distanceFormula}}{{/if}}
                {{#if offer.catchFormula}} · {{offer.catchFormula}}{{/if}}
            </span>
            {{/if}}
        </div>
        {{/each}}
        {{#each fallActions as |line|}}
        <button type="button" class="trap-handling" data-action="fallTrap" data-height="{{line.height}}" data-line="{{line.id}}" data-tooltip="{{line.formula}}">{{line.label}}</button>
        {{/each}}
    </div>
    {{else if fallActions.length}}
    <div class="flexcol dsamt-2 gap5px">
        {{#each fallActions as |line|}}
        <button type="button" class="trap-handling" data-action="fallTrap" data-height="{{line.height}}" data-line="{{line.id}}" data-tooltip="{{line.formula}}">{{line.label}}</button>
        {{/each}}
    </div>
    {{/if}}
    <details class="trap-announce-details dsamt-2">
        <summary>{{localize "REGIONBEHAVIOR_DSATrap.details"}}</summary>
        {{#if isGM}}
        {{#if behaviour.gmdescription}}
        <p>{{{enrichedGmdescription}}}</p>
        {{/if}}
        {{/if}}
        {{#if behaviour.tools}}
        <div class="row-section flexrow">
            <div class="col two"><b>{{localize "REGIONBEHAVIOR_DSATrap.FIELDS.tools.label"}}</b></div>
            <div class="col two right">{{behaviour.tools}}</div>
        </div>
        {{/if}}
        <div class="row-section flexrow">
            <div class="col third"><b>{{localize "REGIONBEHAVIOR_DSATrap.FIELDS.trigger.label"}}</b></div>
            <div class="col seventy right">{{localize (concat 'REGIONBEHAVIOR_DSATrap.TRIGGERS.' behaviour.trigger)}}</div>
        </div>
        <div class="row-section flexrow">
            <div class="col two"><b>{{localize "REGIONBEHAVIOR_DSATrap.FIELDS.complexity.label"}}</b></div>
            <div class="col two right">{{localize (concat 'REGIONBEHAVIOR_DSATrap.COMPLEXITIES.' behaviour.complexity)}}</div>
        </div>
        {{#if charges}}
        <div class="row-section flexrow">
            <div class="col two"><b>{{localize "REGIONBEHAVIOR_DSATrap.FIELDS.remainingCharges.label"}}</b></div>
            <div class="col two right">{{remainingCharges}}</div>
        </div>
        {{/if}}
        {{#if passwordRequired}}
        <p class="small">{{localize "REGIONBEHAVIOR_DSATrap.passwordRequired" trap=trapName}}</p>
        {{/if}}
        {{#if payloadHint}}
        <div>{{{payloadHint}}}</div>
        {{/if}}
    </details>
</div>
