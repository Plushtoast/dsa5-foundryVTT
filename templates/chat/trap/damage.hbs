<div class="dsa5 chat-card trap-damage-card">
    <div class="hideAnchor">
    {{#if trapName}}
    <div class="card-content test-data">
        <b>{{trapName}}</b>
    </div>
    {{/if}}
    <div class="card-content hide-option roll-result">
        <b>{{localize 'Roll'}}</b>:
        {{#each dice as |die|}}
        <span data-tooltip="CHAR.DAMAGE" class="die-damage d{{die.faces}}">{{die.result}}</span>
        {{/each}}
    </div>
    <div class="card-content" data-tooltip="{{formula}}">
        <b>{{localize 'damage'}}</b>{{#if strikeName}} ({{strikeName}}){{/if}}: {{total}}
    </div>
    {{#if applyDamageInChat}}
    <div class="row-section center" style="margin-top:10px">
        <div class="col two center">
            <button type="button" class="applyDamage selfButton smallChatButton" data-mode="value" data-tooltip="CHATCONTEXT.ApplyDamage"><i class="fas fa-shield-alt"></i>{{localize 'CHARAbbrev.damage'}}</button>
        </div>
        <div class="col two center">
            <button type="button" class="applyDamage selfButton smallChatButton" data-mode="sp" data-tooltip="CHATCONTEXT.ApplyDamageSP"><i class="fas fa-hand-fist"></i>{{localize 'CHARAbbrev.damageSP'}}</button>
        </div>
    </div>
    {{/if}}
    </div>
</div>
