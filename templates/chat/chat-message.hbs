<li class="chat-message message flexcol {{cssClass}}" data-message-id="{{message._id}}"
    {{#if borderColor}}style="border-color:{{borderColor}}"{{/if}}>
    <header class="message-header flexrow">
        {{#if message.flags.img.src}} 
            {{#if (isWEBM message.flags.img.src)}}
            <video class="sender-image" src="{{message.flags.img.src}}" autoplay loop></video> 
            {{else}}
            <img class="sender-image" src="{{message.flags.img.src}}" /> 
            {{/if}}
            <h4 class="message-sender with-image" data-tooltip="{{{alias}}}">{{alias}}</h4>
        {{else}}
            <h4 class="message-sender" data-tooltip="{{{alias}}}">{{alias}}</h4>
        {{/if}}
        <span class="message-metadata">
            <time class="message-timestamp ellipsis nobr">{{timeSince message.timestamp}}</time>
            <span class="chatIndicator"><i data-tooltip="CHATNOTIFICATION.BlindRoll" class="fas fa-eye-slash"></i></span>
            <span class="privateMessageIndicator"><i data-tooltip="CHATNOTIFICATION.whisper" class="fas fa-mask"></i></span> 
            {{#if canDelete}}
            <a aria-label="{{localize 'Delete'}}" class="message-delete" data-action="deleteMessage">
                <i class="fas fa-trash"></i>
            </a>
            {{/if}}
            {{#if canClose}}
            <a aria-label="{{ localize "CHAT.Dismiss" }}" class="message-dismiss" data-action="dismissMessage">
                <i class="fas fa-xmark"></i>
            </a>
            {{/if}}
        </span> 
        {{#if isWhisper}}
        <span class="whisper-to">{{localize 'CHAT.To'}}: {{whisperTo}}</span> 
        {{/if}} 
        
        {{#if message.flavor}}
        <span class="flavor-text">{{{message.flavor}}}</span> 
        {{/if}}
    </header>
    <div class="message-content">
        {{{message.content}}}
    </div>
</li>