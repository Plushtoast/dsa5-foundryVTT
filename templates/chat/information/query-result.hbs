<div class="information-query-result">
  <div class="hideData row-section">
    <div class="col ninety">
      <b>{{itemName}}</b>
    </div>
  </div>
  {{#if (eq status "pending")}}
  <p><i class="fas fa-spinner fa-spin"></i> {{localize "DSAQUERIES.INFORMATIONREQUEST.pending"}}</p>
  {{else if (eq status "approved")}}
  <p><i class="fas fa-check icon-green"></i> {{localize "DSAQUERIES.INFORMATIONREQUEST.approved"}}</p>
  {{else if (eq status "rejected")}}
  <p><i class="fas fa-times icon-red"></i> {{localize "DSAQUERIES.INFORMATIONREQUEST.rejected"}}</p>
  {{/if}}
  <div class="information-query-result-roll{{#if resultRowClass}} {{resultRowClass}}{{/if}}"{{#if resultTooltip}} data-tooltip="{{resultTooltip}}" aria-label="{{resultTooltip}}"{{/if}}>
    <span>{{actorName}} — {{skillName}} ({{localize "CHARAbbrev.QS"}} {{rolledQS}})</span>
    {{#if resultSubLabel}}
      <span class="roll-request-result-sublabel">{{resultSubLabel}}</span>
    {{/if}}
  </div>
</div>
