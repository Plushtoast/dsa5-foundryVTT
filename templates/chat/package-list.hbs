<div class="package-list">
  <p class="very-small">{{localize 'ITEMPACKAGE.chatDragHint'}}</p>
  {{#each packages}}
    <div class="flexrow gap2px lineheight">
      <button type="button" draggable="true" class="package-drag showPackage chatButton ellipsis dsadesignbutton" data-uuid="{{uuid}}" data-tooltip="{{name}}"><i class="lineheight fas fa-box"></i>{{name}}</button>
      <button class="payButton flex0 nobr" data-pay="0" data-amount="{{price}}" data-tooltip="{{localize 'PAYMENT.payButton'}} ({{localize 'Money-S'}})">{{numberFormat price decimals=1}}</button>
    </div>
  {{/each}}
</div>
