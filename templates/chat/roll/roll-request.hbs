<div class="dsa5 roll-request-card" data-category="{{category}}">
  {{#if headerHtml}}
    <div class="trap-roll-request-header">{{{headerHtml}}}</div>
  {{/if}}
  <p class="flexrow flexAlignCenter gap5px roll-request-header">
    {{#if skillIcon}}
      <img src="{{skillIcon}}" alt="{{skillName}}" class="roll-request-skill-icon">
    {{/if}}
    <b>{{skillName}}</b>{{#if modifierLabel}} ({{modifierLabel}}){{/if}}
  </p>

  {{#if recipients.length}}
    <div class="roll-request-rows">
      {{#each recipients}}
        <div class="flexrow flexAlignCenter roll-request-row gap5px {{resultRowClass}}" data-actor-id="{{actorId}}" data-status="{{status}}"{{#if resultTooltip}} data-tooltip="{{resultTooltip}}" aria-label="{{resultTooltip}}"{{/if}}>
          {{> systems/dsa5/templates/chat/roll/parts/roll-request-row-identity.hbs}}
          {{#if resultIcon}}
            <span class="roll-request-result-label icon noBorder flexrow flex0 flexAlignRight {{resultIconClass}}" data-tooltip="{{resultTooltip}}" aria-label="{{resultTooltip}}"><i class="fas {{resultIcon}}"></i></span>
          {{else if resultLabel}}
            <div class="roll-request-result-stack flex0">
              <b class="roll-request-result-label">{{resultLabel}}</b>
              {{#if resultSubLabel}}
                <span class="roll-request-result-sublabel">{{resultSubLabel}}</span>
              {{/if}}
            </div>
          {{/if}}
          <div class="roll-request-row-side flexrow flex0 flexAlignEnd gap2px">
            {{#if canRoll}}
              <button type="button" class="roll-request-action icon fas fa-dice" data-action="roll" data-actor-id="{{actorId}}" data-tooltip="{{localize "ROLLREQUEST.rollAction"}}" aria-label="{{localize "ROLLREQUEST.rollAction"}}"></button>
            {{/if}}
            {{#if canSkip}}
              <button type="button" class="roll-request-action icon fas fa-forward" data-action="skip" data-actor-id="{{actorId}}" data-tooltip="{{localize "DSAQUERIES.COMMANDS.skip"}}" aria-label="{{localize "DSAQUERIES.COMMANDS.skip"}}"></button>
            {{/if}}
            {{#if canGMRoll}}
              <button type="button" class="roll-request-action icon fas fa-dice roll-request-gm" data-action="rollOnBehalf" data-actor-id="{{actorId}}" data-tooltip="{{localize "DSAQUERIES.COMMANDS.rollOnBehalf"}}" aria-label="{{localize "DSAQUERIES.COMMANDS.rollOnBehalf"}}"></button>
            {{/if}}
            {{#if canGMAction}}
              <button type="button" class="roll-request-menu icon fas fa-ellipsis-vertical roll-request-gm" data-actor-id="{{actorId}}" data-tooltip="{{localize "DSAQUERIES.COMMANDS.more"}}" aria-label="{{localize "DSAQUERIES.COMMANDS.more"}}"></button>
            {{/if}}
          </div>
        </div>
      {{/each}}
    </div>
  {{else}}
    <p class="very-small">{{localize "DSAQUERIES.NOTIFICATIONS.noActors"}}</p>
  {{/if}}

  {{#unless finalized}}
    <div class="roll-request-gm flexrow gap5px margin-top">
      <button type="button" class="roll-request-action" data-action="finalize" data-tooltip="{{localize "DSAQUERIES.COMMANDS.finalize"}}" aria-label="{{localize "DSAQUERIES.COMMANDS.finalize"}}"><i class="fas fa-check"></i></button>
    </div>
  {{/unless}}
</div>
