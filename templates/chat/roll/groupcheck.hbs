<div class='chat-card group-check-card'>
  <div>
    <b>{{localize 'HELP.groupcheck'}}</b>
    <div class='chat-buttons'>
      <a class='edit-gc-config chat-button-gm' data-tooltip='{{localize "CHATNOTIFICATION.editRoll"}}'><i class='fas fa-edit'></i></a>
    </div>
  </div>
  {{#if (eq openRolls 0)}}

    {{target}}
    -
    {{localize 'Aggregated.noMoreAllowed'}}

  {{else}}

    {{name}}{{localize 'CHATNOTIFICATION.requestGroupCheck'}}
    <div class='row-section'>
      <div class='col sixty'>
        <b>{{localize 'skill'}}</b>
      </div>
      <div class='col fifteen center' data-tooltip='Modifier'>
        <b>{{localize 'ABBR.modifiers'}}</b>
      </div>
    </div>
    {{#each rollOptions as |optn|}}
      <div class='row-section lineheight'>
        <div class='col sixty flexrow'>
          <button class='request-gc' data-type='{{optn.type}}' data-modifier='{{optn.calculatedModifier}}' data-name='{{optn.target}}'><i
              class='fas fa-dice'
            ></i>{{optn.target}}</button>
        </div>
        <div class='col fifteen flexrow flexAlignCenter center'>
          {{optn.calculatedModifier}}
        </div>
      </div>
    {{/each}}
  {{/if}}

  {{#if results.length}}
    <ul class='group-check-results'>
      {{#each results as |item|}}
        <li class='flexrow flexAlignCenter group-check-result-row gap5px {{item.resultRowClass}}' data-tooltip='{{item.resultTooltip}}' aria-label='{{item.resultTooltip}}'>
          <div class='group-check-result-name flex1'><b>{{item.actor}}</b></div>
          <div class='group-check-result-skill flex1'>{{item.target}}</div>
          <div class='group-check-result-qs flex0'>
            <span>{{item.qs}}</span>
            {{#if item.resultSubLabel}}
              <span class='roll-request-result-sublabel'>{{item.resultSubLabel}}</span>
            {{/if}}
          </div>
        </li>
      {{/each}}
    </ul>
  {{/if}}

  <div>
    <b>{{localize 'failedTests'}}</b>:
    {{failed}}
  </div>
  <div>
    <b>{{localize 'probes'}}</b>:
    {{doneRolls}}
    /
    {{maxRolls}}
  </div>
  <div>
    <b>{{localize 'cummulatedQS'}}</b>:
    {{qs}}
    /
    {{targetQs}}
  </div>
  {{#if (gt qs 5)}}
    {{{enrichedpartsuccess}}}
  {{/if}}
  {{#if (gt qs 9)}}
    {{{enrichedsuccess}}}
  {{/if}}
</div>
