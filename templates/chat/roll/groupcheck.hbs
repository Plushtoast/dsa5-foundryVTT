<div class='chat-card group-check-card'>
  <div>
    <b>{{localize 'HELP.groupcheck'}}</b>
    <div class='chat-buttons'>
      <a class='edit-gc-config chat-button-gm' data-tooltip='{{localize "CHATNOTIFICATION.editRoll"}}'><i class='fas fa-edit'></i></a>
    </div>
  </div>
  {{#if (eq openRolls 0)}}

    {{target}}
    -
    {{localize 'Aggregated.noMoreAllowed'}}

  {{else}}

    {{name}}{{localize 'CHATNOTIFICATION.requestGroupCheck'}}
    <div class='row-section'>
      <div class='col sixty'>
        <b>{{localize 'skill'}}</b>
      </div>
      <div class='col fifteen center' data-tooltip='modifier'>
        <b>{{localize 'ABBR.modifiers'}}</b>
      </div>
    </div>
    {{#each rollOptions as |optn|}}
      <div class='row-section lineheight'>
        <div class='col sixty flexrow'>
          <button
            type='button'
            class='request-gc group-check-skill-button flexrow flexAlignCenter gap5px'
            data-gc-type='{{optn.type}}'
            data-gc-name='{{optn.target}}'
            data-type='{{optn.type}}'
            data-modifier='{{optn.calculatedModifier}}'
            data-name='{{optn.target}}'
            data-tooltip='{{optn.target}}'
            aria-label='{{optn.target}}'
          >
            {{#if optn.skillIcon}}
              <img src='{{optn.skillIcon}}' alt='' class='group-check-skill-icon' draggable='false'>
            {{/if}}
            <span class='ellipsis'>{{optn.target}}</span>
          </button>
        </div>
        <div class='col fifteen flexrow flexAlignCenter center'>
          {{optn.calculatedModifier}}
        </div>
      </div>
    {{/each}}
  {{/if}}

  {{#if resultSections.length}}
    <div class='group-check-sections'>
      {{#each resultSections as |section|}}
        <div class='group-check-section'>
          <p class='flexrow flexAlignCenter gap5px group-check-section-header'>
            {{#if section.skillIcon}}
              <img src='{{section.skillIcon}}' alt='{{section.target}}' class='group-check-skill-icon'>
            {{/if}}
            <b>{{section.target}}</b>
          </p>
          <div class='group-check-results'>
            {{#each section.results as |item|}}
              <div
                class='flexrow flexAlignCenter group-check-result-row gap5px {{item.resultRowClass}}'
                data-tooltip='{{item.resultTooltip}}'
                aria-label='{{item.resultTooltip}}'
              >
                {{> systems/dsa5/templates/chat/roll/parts/roll-request-row-identity.hbs
                  actorImg=item.actorImg
                  actorName=item.actorName
                }}
                <div class='group-check-result-qs flex0'>
                  <span class='group-check-result-label'>{{item.qs}}</span>
                  {{#if item.resultSubLabel}}
                    <span class='roll-request-result-sublabel'>{{item.resultSubLabel}}</span>
                  {{/if}}
                </div>
              </div>
            {{/each}}
          </div>
        </div>
      {{/each}}
    </div>
  {{/if}}

  <div>
    <b>{{localize 'failedTests'}}</b>:
    {{failed}}
  </div>
  <div>
    <b>{{localize 'probes'}}</b>:
    {{doneRolls}}
    /
    {{maxRolls}}
  </div>
  <div>
    <b>{{localize 'cummulatedQS'}}</b>:
    {{qs}}
    /
    {{targetQs}}
  </div>
  {{#if (gt qs 5)}}
    {{{enrichedpartsuccess}}}
  {{/if}}
  {{#if (gt qs 9)}}
    {{{enrichedsuccess}}}
  {{/if}}
</div>
