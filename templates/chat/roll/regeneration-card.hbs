<div class="dsa5 chat-card" data-actor-id="{{actorId}}" data-hide={{hideData.value}}>
    {{> systems/dsa5/templates/chat/roll/test-card.hbs}} 
    {{#if (ne preData.regenerationFactor 1)}}
    <div class="card-content">
        <b>{{localize "badEnvironment"}}</b>: x 0.5
    </div>
    {{/if}}
    {{#if testData.homunculusSelfRest}}
    <div class="card-content" data-tooltip="COMPANIONS.Notification.HomunculusNoSleepRegen">
        {{localize "COMPANIONS.Notification.HomunculusNoSleepRegen"}}
    </div>
    {{/if}}
    {{#if testData.LeP}}
    <div class="card-content">
        <b>{{localize "wounds"}}</b>: {{testData.LeP}}
    </div>
    {{/if}}
    {{#if testData.AsP}}
    <div class="card-content">
        <b>{{localize "astralenergy"}}</b>: {{testData.AsP}}
    </div>
    {{/if}} {{#if testData.KaP}}
    <div class="card-content">
        <b>{{localize "karmaenergy"}}</b>: {{testData.KaP}}
    </div>
    {{/if}}
    {{#each testData.homunculusBloodBath}}
    <div class="card-content">
        <b>{{localize "bloodBathHeal" name=name lep=lep}}</b>
        {{#if usedBloodReserve}}
        — {{localize "bloodReserveUsed" name=name}}
        {{else}}
        — {{localize "bloodBathCost" cost=cost}}
        {{/if}}
    </div>
    {{/each}}
    {{#if testData.homunculusBloodBath.length}}
    <div class="card-content">
        <b>{{localize "bloodBathCost" cost=testData.homunculusBloodCost}}</b>
    </div>
    {{/if}}
</div>