<div style="--iniTrackerSize:{{itemWidth}}px" class="initracker-root tooltipConnector">
    <div class="initracker-main">
        <div class="initracker-controls initracker-controls-left">
            {{#if user.isGM}}
            <button type="button" class="icon plain combat-control combat-mode-control fas {{combatModeIcon}}" data-tooltip="{{combatModeTooltip}}" {{#unless combats.length}}disabled{{/unless}} aria-label="{{ localize combatModeTooltip }}"></button>
            {{/if}}
            {{#if (and user.isGM combat.round)}}
            <button type="button" class="icon plain combat-control fa-solid fa-step-backward"
            data-action="previousRound" data-tooltip="COMBAT.RoundPrev"
            aria-label="{{ localize "COMBAT.RoundPrev" }}"></button>
            <button type="button" class="icon plain combat-control fa-solid fa-arrow-left" data-action="previousTurn"
            data-tooltip-text="{{tooltipWithKeybinding 'COMBAT.TurnPrev' 'combatTrackerPrevious'}}" aria-label="{{ localize "COMBAT.TurnPrev" }}"></button>
            {{else if control}}
            <button type="button" class="icon plain combat-control fa-solid fa-arrow-left" data-action="previousTurn"
            data-tooltip-text="{{tooltipWithKeybinding 'COMBAT.TurnPrev' 'combatTrackerPrevious'}}" aria-label="{{ localize "COMBAT.TurnPrev" }}"></button>
            {{/if}}
        </div>
        <ul class="iniTrackerList">
            {{#each turns}}
            {{#if newRound}}
            <li class="iniRoundSeparator" role="separator" data-tooltip="{{localize 'COMBATTRACKER.newRound'}}" aria-label="{{localize 'COMBATTRACKER.newRound'}}"></li>
            {{/if}}
            <li data-combatant-id="{{id}}" data-action="activateCombatant" data-category="actorSummary" class="combatant betterTooltip iniItem dsa-hud-portrait {{newRound}} {{css}}" style="background-image:url('{{img}}');{{dispositionBorderStyle}}">
                <div class="combatant-advanced">
                    {{#if defenseCount}}
                    <i class="fas def fa-shield-alt" data-defense-count="{{defenseCount}}" data-tooltip="COMBATTRACKER.noDefenses"></i>
                    <i class="fas fa-shield-alt reversed"></i> {{/if}}
                    {{#if ongoing}}
                    <div class="ongoing" data-tooltip="{{ongoings}}">{{ongoing}}</div>
                    {{/if}}
                    {{#if (and isOwner (gt actionCount 1))}}
                    <div class="actions" data-tooltip="{{actionCounts}}">{{actionCount}}</div>
                    {{/if}}
                    {{#if (eq chaseRole "chasing")}}
                    <div class="chase-distance-overlay{{#if chaseDistance includeZero=true}}{{else}} unset{{/if}}" data-tooltip="{{chaseDistanceLabel}}">
                      {{#if chaseDistance includeZero=true}}{{chaseDistance}}{{#if chaseDistanceUnit}}&nbsp;{{chaseDistanceUnit}}{{/if}}{{else}}—{{/if}}
                    </div>
                    {{/if}}
                    {{#if chaseRolled}}
                    <i class="fas fa-check chase-rolled-mark" data-tooltip="CHASE.rolledTooltip"></i>
                    {{/if}}
                </div>
                {{#if isOwner}}
                {{#if showVehicleBars}}
                <div class="item-structure vehicle-stp" style="--a: {{maxLP}}; --b: {{currentLP}}" data-tooltip="VEHICLE.structurePoints">
                    <div class="inner"></div>
                </div>
                <div class="item-structure vehicle-crew" style="--a: {{maxCrew}}; --b: {{currentCrew}}" data-tooltip="VEHICLE.crewCurrent">
                    <div class="inner"></div>
                </div>
                {{else}}
                <div class="item-structure" style="--a: {{maxLP}}; --b: {{currentLP}}">
                    <div class="inner"></div>
                </div>
                {{/if}}
                {{/if}}
                <div class="hoverbuttons">
                    <div class="combatant-controls flexrow">
                        {{#if ../user.isGM}}
                        <button type="button" class="dsa-hud-icon-button combatant-control icon fa-solid fa-eye-slash {{#if hidden}}active{{/if}}"
                        data-action="toggleHidden" data-tooltip
                        aria-label="{{ localize (ifThen hidden "COMBATANT.Show" "COMBATANT.Hide") }}"></button>
                    </div>
                    <div class="combatant-controls flexrow">
                        <button type="button" class="dsa-hud-icon-button combatant-control icon fa-solid fa-skull {{#if isDefeated}}active{{/if}}"
                        data-action="toggleDefeated" data-tooltip
                        aria-label="{{ localize (ifThen isDefeated "COMBATANT.UnmarkDefeated" "COMBATANT.MarkDefeated") }}"></button>
                        {{/if}}
                    </div>
                </div>
                <div class="token-initiative">
                    {{#if (and isOwner (or initiative @root.isChase showNavalAggro))}}
                    <a class="aggroButton specImg{{#if @root.isChase}} chaseAction{{else if @root.isNavalMkr}} navalAction{{/if}}" data-action="aggroButton"
                       data-tooltip-text="{{#if @root.isChase}}{{localize "CHASE.actionTooltip"}}{{else if (and @root.isNavalMkr (eq @root.mkr.phase "heroActions"))}}{{localize "VEHICLE.mkr.heroActionTooltip"}}{{else}}{{tooltipWithKeybinding 'attacktest' 'attacktest'}}{{/if}}"></a>
                    {{else if isOwner}}
                    {{#unless (or @root.isChase @root.isNavalMkr)}}
                    <button type="button" class="combatant-control roll" data-action="rollInitiative"
                    data-tooltip="COMBAT.InitiativeRoll" aria-label="{{ localize "COMBAT.InitiativeRoll" }}"
                    style="--initiative-icon: url('{{ @root.initiativeIcon.icon }}'); --initiative-icon-hover: url('{{ @root.initiativeIcon.hover }}');"></button>
                    {{/unless}}
                    {{/if}}
                </div>
            </li>{{/each}}
        </ul>
        {{#if waitingTurns}}
        <ul class="waitingTackerList iniTrackerList">
            <li class="waitTitle dsa-hud-portrait" data-tooltip="COMBATTRACKER.waitInit"><i class="far fa-hourglass" ></i></li>
            {{#each waitingTurns}}
            <li data-tooltip="{{localize 'waitingInfo' name=name}}" data-combatant-id="{{id}}" class="combatant iniItem dsa-hud-portrait {{css}}" data-action="restoreInit" style="background-image:url('{{img}}');{{dispositionBorderStyle}}"></li>
            {{/each}}
        </ul>
        {{/if}}
        <div class="initracker-controls initracker-controls-right">
            {{#if user.isGM}}
            <button type="button" class="icon plain combat-control fa-solid fa-trash" data-action="endCombat"
                data-tooltip="COMBAT.End" aria-label="{{ localize "COMBAT.End" }}"></button>
            {{#if combat.round}}
            <button type="button" class="icon plain combat-control fa-solid fa-step-forward" data-action="nextRound"
            data-tooltip="COMBAT.RoundNext" aria-label="{{ localize "COMBAT.RoundNext" }}"></button>
            <button type="button" class="icon plain combat-control fa-solid fa-arrow-right" data-action="nextTurn"
            data-tooltip-text="{{tooltipWithKeybinding 'COMBAT.TurnNext' 'combatTrackerNext'}}" aria-label="{{ localize "COMBAT.TurnNext" }}"></button>
            {{else if control}}
            <button type="button" class="icon plain combat-control fa-solid fa-arrow-right" data-action="nextTurn"
            data-tooltip-text="{{tooltipWithKeybinding 'COMBAT.TurnNext' 'combatTrackerNext'}}" aria-label="{{ localize "COMBAT.TurnNext" }}"></button>
            {{/if}}
            {{/if}}
        </div>
        <section class="dragHandler" data-tooltip="TT.resizer">
            <i class="fas fa-grip-vertical"></i>
        </section>
    </div>

    {{#if unRolled}}
    <div class="row-section initracker-actions">
        <button type="button" class="col dsa-hud-action-button rollMine" data-action="rollMine">{{localize 'COMBAT.InitiativeRoll'}}</button>
    </div>
    {{/if}}
    {{#unless combat.round}}
    {{#if user.isGM}}
    <div class="row-section initracker-actions">
        <button type="button" class="col dsa-hud-action-button combat-control" data-action="startCombat">{{localize 'COMBAT.Begin'}}</button>
    </div>
    {{/if}}
    {{else}}
    {{#if (or control user.isGM)}}
    <div class="row-section initracker-actions">
        {{#if mkrEndTurnLabel}}
        <button type="button" class="col dsa-hud-action-button {{ifThen isDamageReportPhase 'combat-control' 'two combat-control'}} {{ifThen isLastRound 'lastRound' ''}}" data-action="nextTurn" data-tooltip-text="{{tooltipWithKeybinding mkrEndTurnLabel 'combatTrackerNext'}}">{{localize mkrEndTurnLabel}}</button>
        {{else}}
        <button type="button" class="col two dsa-hud-action-button combat-control {{ifThen isLastRound 'lastRound' ''}}" data-action="nextTurn" data-tooltip-text="{{tooltipWithKeybinding (ifThen isLastRound 'COMBAT.RoundNext' 'COMBAT.TurnEnd') 'combatTrackerNext'}}">{{localize (ifThen isLastRound 'COMBAT.RoundNext' 'COMBAT.TurnEnd')}}</button>
        {{/if}}
        {{#unless isDamageReportPhase}}
        {{#if isChase}}
        <button type="button" class="col two dsa-hud-action-button combat-control chase-roll-current" data-action="aggroButton" data-tooltip="CHASE.actionTooltip">{{localize 'CHASE.action'}}</button>
        {{else if (and isNavalMkr (eq mkr.phase "heroActions"))}}
        <button type="button" class="col two dsa-hud-action-button combat-control naval-hero-action" data-action="aggroButton" data-tooltip="VEHICLE.mkr.heroActionTooltip">{{localize 'VEHICLE.mkr.heroAction'}}</button>
        {{else}}
        <button type="button" class="col two dsa-hud-action-button combat-control" data-action="waitInit">{{localize 'COMBATTRACKER.waitInit'}}</button>
        {{/if}}
        {{/unless}}
    </div>
    {{#if isNavalMkr}}
    <div class="row-section mkr-phase-badge-row">
      {{#if user.isGM}}
      <button type="button" class="mkr-phase-step icon fa-solid fa-chevron-left" data-action="retreatMkrPhase"
              data-tooltip="VEHICLE.mkr.previousPhase" aria-label="{{ localize 'VEHICLE.mkr.previousPhase' }}"
              {{#unless mkr.canRetreatPhase}}disabled{{/unless}}></button>
      <button type="button" class="mkr-phase-badge mkr-phase-control" data-action="cycleMkrPhase"
              data-tooltip-html='{{{localize "VEHICLE.mkr.phaseControlTooltip" phaseTooltip=mkr.phaseTooltip cyclePhase=(localize "VEHICLE.mkr.cyclePhase") previousPhase=(localize "VEHICLE.mkr.previousPhase")}}}'
              aria-label="{{mkr.phaseLabel}} — {{ localize 'VEHICLE.mkr.cyclePhase' }}">
        {{mkr.phaseRoman}} · {{mkr.phaseLabel}}
      </button>
      <button type="button" class="mkr-phase-step icon fa-solid fa-chevron-right" data-action="advanceMkrPhase"
              data-tooltip="VEHICLE.mkr.cyclePhase" aria-label="{{ localize 'VEHICLE.mkr.cyclePhase' }}"
              {{#unless mkr.canAdvancePhase}}disabled{{/unless}}></button>
      {{else}}
      <span class="mkr-phase-badge" data-tooltip-text="{{mkr.phaseTooltip}}">{{mkr.phaseRoman}} · {{mkr.phaseLabel}}</span>
      {{/if}}
    </div>
    {{/if}}
    {{/if}}
    {{#if isChase}}
    <div class="row-section chase-badge-row">
        {{#if chase.caught}}
        <div class="chase-outcome-banner caught">{{localize "CHASE.caught"}}</div>
        {{else if chase.escaped}}
        <div class="chase-outcome-banner escaped">{{localize "CHASE.escaped"}}</div>
        {{/if}}
        <span class="chase-status-badge" data-tooltip="CHASE.escapeTooltip">
          {{localize "CHASE.roundPrefix"}} {{chase.elapsed}}/
          {{#if user.isGM}}
          <input type="number" class="chase-max-rounds-input" name="chaseMaxRounds" min="1" step="1"
                 value="{{chase.maxRounds}}"
                 data-tooltip="CHASE.maxRoundsTooltip" aria-label="{{localize "CHASE.maxRounds"}}">
          {{else}}
          {{chase.maxRounds}}
          {{/if}}
        </span>
        <span class="chase-terrain-chip{{#if user.isGM}} context{{/if}}"
              data-tooltip="CHASE.terrainDropdownTooltip"
              {{#if user.isGM}}data-action="chaseTerrainMenu"{{/if}}>{{chaseTerrainLabel}}</span>
        <span class="chase-default-skill-group">
          <button type="button" class="chase-default-skill-badge" data-action="rollChaseDefaultSkill"
                  data-tooltip="CHASE.rollDefaultSkillTooltip">{{chaseDefaultSkillLabel}}</button>
          {{#if user.isGM}}
          <button type="button" class="chase-default-skill-menu icon fas fa-ellipsis-v noBorder dsadesignbutton"
                  data-action="chaseDefaultSkillMenu" data-tooltip="CHASE.defaultSkillMenuTooltip"
                  aria-label="{{localize "CHASE.defaultSkillMenuTooltip"}}"></button>
          {{/if}}
        </span>
    </div>
    {{/if}}
    {{/unless}}
</div>
