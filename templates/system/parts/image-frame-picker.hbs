<div class="dsa-image-frame {{frameClass}}">
  {{#if layerModel}}
  <div class="dsa-image-frame__preview dsa-media-frame {{#if interactive}}interactive{{/if}}" style="{{frameVars}}">
    <img class="dsa-media-frame__img" src="{{imageSrc}}" alt="" draggable="false" />
  </div>
  {{else}}
  <div class="dsa-image-frame__preview {{#if interactive}}interactive{{/if}}">
    <img class="dsa-image-frame__img" src="{{imageSrc}}" alt="" draggable="false" style="{{imgStyle}}" />
  </div>
  {{/if}}
  {{#if interactive}}
  <p class="dsa-image-frame__hint">
    <i class="fas fa-arrows-alt"></i> {{localize 'DSA5HOTBARCONFIG.avatarDragHint'}}
  </p>
  <div class="dsa-image-frame__controls flexcol gap4px">
    <div class="flexrow flexAlignCenter gap4px">
      <label class="flex0">X</label>
      <div class="dsa-image-frame__slider-wrap flex1" style="--tick: {{offsetTick}};">
        <input type="range" class="dsa-image-frame__slider" data-prop="offsetX"
          min="{{offsetXMin}}" max="{{offsetXMax}}" step="{{offsetStep}}" value="{{frame.offsetX}}" />
      </div>
      <button type="button" class="dsadesignbutton noBorder icon fas fa-arrows-left-right-to-line"
        data-frame-reset="offsetX" data-tooltip="IMAGEFRAME.centerX"></button>
    </div>
    <div class="flexrow flexAlignCenter gap4px">
      <label class="flex0">Y</label>
      <div class="dsa-image-frame__slider-wrap flex1" style="--tick: {{offsetTick}};">
        <input type="range" class="dsa-image-frame__slider" data-prop="offsetY"
          min="{{offsetYMin}}" max="{{offsetYMax}}" step="{{offsetStep}}" value="{{frame.offsetY}}" />
      </div>
      <button type="button" class="dsadesignbutton noBorder icon fas fa-arrows-left-right-to-line"
        data-frame-reset="offsetY" data-tooltip="IMAGEFRAME.centerY"></button>
    </div>
    <div class="flexrow flexAlignCenter gap4px">
      <label class="flex0">{{localize 'DSA5HOTBARCONFIG.avatarZoom'}}</label>
      <div class="dsa-image-frame__slider-wrap flex1" style="--tick: {{zoomTick}};">
        <input type="range" class="dsa-image-frame__slider" data-prop="zoom"
          min="{{zoomMin}}" max="{{zoomMax}}" value="{{frame.zoom}}" />
      </div>
      <button type="button" class="dsadesignbutton noBorder icon fas fa-undo"
        data-frame-reset="zoom" data-tooltip="IMAGEFRAME.resetZoom"></button>
    </div>
    {{#if layerModel}}
    <div class="flexrow flexAlignCenter gap4px">
      <label class="flex0">{{localize 'IMAGEFRAME.flipHorizontal'}}</label>
      <div class="flex1"></div>
      <button type="button" class="dsadesignbutton noBorder icon fas fa-left-right{{#if flipX}} active{{/if}}"
        data-frame-flip="1" data-tooltip="IMAGEFRAME.flipHorizontalHint"></button>
    </div>
    {{/if}}
  </div>
  {{/if}}
</div>
