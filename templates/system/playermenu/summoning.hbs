<div class="tab scrollable summoning-tab {{tab.cssClass}}" data-tab="elementals" data-group="sheet">

    {{#if actor.system}}

    {{> systems/dsa5/templates/system/conjuration/parts/type-picker.hbs}}

    {{> systems/dsa5/templates/system/conjuration/parts/summary.hbs}}

    {{#unless summary.creature.uuid}}
    {{#if favoriteCreatures.length}}
    <div class="bags flexrow flexAlignCenter gap2px wrap conjuration-favorites-list">
        {{#each favoriteCreatures as |fav|}}
        <div class="slot conjuration-favorite-slot" data-action="selectFavoriteCreature" data-uuid="{{fav.uuid}}"
            style="background-image:url('{{fav.img}}')" data-tooltip="{{fav.name}}"></div>
        {{/each}}
    </div>
    {{/if}}
    {{/unless}}

    <nav class="summoning-phases" aria-label="{{localize 'PLAYER.conjuration'}}">
        {{#each summoningPhases as |phase|}}
        <button type="button" class="summoning-phases__btn {{#if phase.active}}active{{/if}}"
            data-action="setSummoningPhase" data-phase="{{phase.id}}"
            aria-pressed="{{phase.active}}">
            <i class="{{phase.icon}}" aria-hidden="true"></i>
            <span>{{localize phase.label}}</span>
        </button>
        {{/each}}
    </nav>

    {{#if showRitualPhase}}
    <div class="summoning-phase">
        {{> systems/dsa5/templates/system/conjuration/parts/rituals.hbs}}
    </div>
    {{/if}}

    {{#if showExtensionsPhase}}
    <div class="summoning-phase">
        {{> systems/dsa5/templates/system/conjuration/parts/extensions.hbs}}
    </div>
    {{/if}}

    {{else}}

    <div class="droparea">
        <i class="fas fa-hat-wizard"></i> {{localize "CONJURATION.dragActor"}}
    </div>

    {{/if}}
</div>
