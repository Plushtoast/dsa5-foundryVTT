<div class="navWrapper">
    <i class="fas fa-angle-left left-btn"></i>
    <i class="fas fa-angle-right right-btn"></i>
    <nav class="sheet-tabs tabs" aria-roledescription="Form Tab Navigation">
        {{#each tabs as |tab|}}
        <a class="item {{tab.cssClass}}" data-action="tab" data-group="{{tab.group}}" data-tab="{{tab.id}}">                
            <label>{{#if tab.icon}}<i class="{{tab.icon}}"></i> {{/if}}{{localize tab.label}}</label>
        </a>
        {{/each}}
    </nav>
</div>