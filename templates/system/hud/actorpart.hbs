<div class="flex0 actorPart collapsibleBarPart tooltipConnector" data-tooltip-direction="UP">
    <div class="flexrow resources">
        <div class="flex0 LeP" data-tooltip-html="{{resources.LeP.label}} {{resources.LeP.value}}/{{resources.LeP.max}}">
            {{resources.LeP.value}}/{{resources.LeP.max}}
        </div>
        {{#if resources.AsP.max}}
        <div class="flex0 AsP" data-tooltip-html="{{resources.AsP.label}} {{resources.AsP.value}}/{{resources.AsP.max}}">
            {{resources.AsP.value}}/{{resources.AsP.max}}
        </div>
        {{/if}}
        {{#if resources.KaP.max}}
        <div class="flex0 KaP" data-tooltip-html="{{resources.KaP.label}} {{resources.KaP.value}}/{{resources.KaP.max}}">
            {{resources.KaP.value}}/{{resources.KaP.max}}
        </div>
        {{/if}}
    </div>
    <div class="hotbar-avatar-container flexrow">
        <img class="hotbar-avatar flex0 {{turnClass}}" data-category="plain" data-better-tooltip="{{defenseTooltip}}" src="{{actorImg}}" />
        {{#each weapons}}
        <div data-action="weapon" data-skip-hint="true" data-name="{{weapon.name}}" data-category="weapon" data-id="{{weapon.id}}" class="weapon {{#if isEmpty}}empty-slot{{/if}}" data-mode="{{mode}}" style="{{style}}">
            {{#if weapon.img}}
            <img src="{{weapon.img}}" />
            {{else if isEmpty}}
            <i class="fas fa-plus"></i>
            {{else}}
            <i class="fas fa-hand"></i>
            {{/if}}
        </div>
        {{/each}}
    </div>
</div>