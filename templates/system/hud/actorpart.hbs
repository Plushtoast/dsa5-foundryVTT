<div class="flex0 actorPart collapsibleBarPart tooltipConnector" data-tooltip-direction="UP">
    {{#if resources}}
    <div class="flexrow resources">
        <div class="flex0 LeP" data-tooltip-html="{{resources.LeP.label}} {{resources.LeP.value}}/{{resources.LeP.max}}">
            {{resources.LeP.value}}/{{resources.LeP.max}}
        </div>
        {{#if resources.AsP.max}}
        <div class="flex0 AsP" data-tooltip-html="{{resources.AsP.label}} {{resources.AsP.value}}/{{resources.AsP.max}}">
            {{resources.AsP.value}}/{{resources.AsP.max}}
        </div>
        {{/if}}
        {{#if resources.KaP.max}}
        <div class="flex0 KaP" data-tooltip-html="{{resources.KaP.label}} {{resources.KaP.value}}/{{resources.KaP.max}}">
            {{resources.KaP.value}}/{{resources.KaP.max}}
        </div>
        {{/if}}
    </div>
    {{/if}}
    {{#if actionPips}}
    <div class="action-pips flexrow">
        <div class="pip free-action {{#if actionPips.freeAction.used}}depleted{{/if}}"
            data-action="toggleFreeAction"
            data-tooltip-html="{{actionPips.freeAction.tooltip}}">
        </div>
        {{#each actionPips.baseActions}}
        <div class="pip base-action {{#if used}}depleted{{/if}} {{#if overuse}}overuse{{/if}}"
            data-tooltip-html="{{tooltip}}">
        </div>
        {{/each}}
        <div class="pip movement-pip {{#if actionPips.movement.exceeded}}exceeded{{/if}} {{#if actionPips.movement.costsBaseAction}}costs-action{{/if}}"
            data-tooltip-html="{{actionPips.movement.tooltip}}"
            style="--move-pct: {{actionPips.movement.percent}}%">
        </div>
    </div>
    {{/if}}
    <div class="hotbar-avatar-container flexrow">
        <img class="hotbar-avatar flex0 {{turnClass}}" data-action="panToActorToken" data-category="actorSummary" src="{{actorImg}}" style="{{avatarStyle}}" />
        {{> "systems/dsa5/templates/system/hud/companion-hotbar.hbs"}}
        {{#each weapons}}
        <div data-action="weapon" data-skip-hint="true" data-name="{{weapon.name}}" data-category="weapon" data-id="{{weapon.id}}" class="weapon {{#if isEmpty}}empty-slot{{/if}}" data-mode="{{mode}}" style="{{style}}">
            {{#if weapon.img}}
            <img src="{{weapon.img}}" />
            {{else if isEmpty}}
            <i class="fas fa-plus"></i>
            {{else}}
            <i class="fas fa-hand"></i>
            {{/if}}
        </div>
        {{/each}}
    </div>
</div>