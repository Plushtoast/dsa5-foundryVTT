<div>
  <div class="opposed-message">
    <b>{{summoner.name}}</b> {{localize "CONJURATION.conjurs"}} <b>{{actor.name}}</b>
  </div>
  <div class="opposed-tokens row-section">
    <div class="col two attacker">{{{summonerImg}}}</div>

    <div class="col two defender">
      <a class="content-link img-entity-link cursor-drag" draggable="true" data-link="" data-uuid="{{actor.uuid}}"
        data-type="Actor" data-tooltip="{{localize 'CONJURATION.dragToMapHint'}}">{{{conjureImg}}}</a>
    </div>
  </div>

  <div class="center small">
    <i class="fas fa-hand-pointer"></i> {{localize "CONJURATION.dragToMap"}}
  </div>

  {{#if modifiers}}
  <div class="dsamt-1">
    <b>{{localize 'extensions'}}</b>
  </div>
  <div>
    {{#each modifiers as |item|}}
    <span class="dsa-pip pip-neutral">{{localize item.name}}</span>
    {{/each}}
  </div>
  {{/if}}

  {{#if showServiceCounter}}
  <div class="dsa-stat-row dsamt-1">
    <span class="dsa-stat-row__label">
      {{localize serviceLabel}}
      <i class="fas fa-info" data-tooltip="{{controlModeHintKey}}"></i>
    </span>
    <span class="dsa-stat-row__value">{{services}}</span>
  </div>
  {{/if}}
</div>
