<div>
  <p>{{{localize 'CONJURATION.requestDescr'}}}</p>

  <div class='row-section'>
    <div class='col two'>
      <fieldset class="gap0px">
        <legend>{{localize 'probe'}}</legend>
        <div class='row-section'>
          <div class='col sixty table-title'>
            <label class=''>{{localize 'CHARAbbrev.QS'}}:</label>
          </div>
          <div class='col fourty'>
            <input class='conjurationData' data-refresh='true' type='text' name='qs' value='{{creationData.qs}}' />
          </div>
        </div>
        <div class='row-section'>
          <div class='col sixty table-title'>
            <label class=''>{{localize 'extensions'}}:</label>
          </div>
          <div class='col fourty'>
            {{creationData.consumedQS}}
          </div>
        </div>
        <div class='row-section'>
          <div class='col sixty table-title'>
            <label class=''>{{localize 'PLAYER.services'}}:</label>
          </div>
          <div class='col fourty'>
            {{services}}
          </div>
        </div>
      </fieldset>
      <fieldset class="gap0px">
        <legend>{{localize 'PLAYER.conjuration'}}</legend>
        <div class='row-section'>
          <div class='col center'>
            <img style='width:70px;height:70px' class='profile' src='{{conjuration.img}}' data-tooltip='{{actor.name}}' />
          </div>
        </div>
        <div class='row-section'>
          <div class='col fourty table-title'>
            <label class=''>{{localize 'Name'}}:</label>
          </div>
          <div class='col sixty'>
            <a data-action='openChar'>{{conjuration.name}}</a>
          </div>
        </div>
        <div class='row-section'>
          <div class='col fourty table-title'>
            <label class=''>{{localize 'creatureClass'}}:</label>
          </div>
          <div class='col sixty'>
            {{conjuration.system.creatureClass.value}}
          </div>
        </div>
        <div class='row-section'>
          <div class='col fourty table-title'>
            <label class=''>{{localize 'conjuringDifficulty'}}:</label>
          </div>
          <div class='col sixty'>
            {{conjuration.system.conjuringDifficulty.value}}
          </div>
        </div>
      </fieldset>
    </div>
    <div class='col two'>
      <fieldset class="gap0px">
        <legend>{{localize 'extensions'}}</legend>

        {{#each conjurationModifiers as |item i|}}
          <div class='row-section wrap tableOdd' data-id='{{item.id}}'>
            <div class='col lineheight'>
              {{localize item.name}}
            </div>
            <div class='col'>
              <span class='small'>{{localize item.descr}}</span>
            </div>
          </div>
        {{/each}}
      </fieldset>

      <fieldset class="gap0px">
        <legend>{{localize 'entityAbility'}}</legend>
        {{#each entityModifiers as |item i|}}
          <div class='row-section col wrap tableOdd' data-id='{{item.uuid}}'>
            <div class='col eighty lineheight'>
              {{item.name}}{{roman item.count item.system.at.value}}
            </div>
            <div class='col ten'>
              <span class='small' data-tooltip='CHARAbbrev.QL'>{{item.cost}}</span>
            </div>
            <div class='col ten'>
              <a class='showEntity small' data-uuid='{{item.uuid}}'><i class='fas fa-info'></i></a>
            </div>
          </div>
        {{/each}}
      </fieldset>
      <fieldset class="gap0px">
        <legend>{{localize 'summoningPackage'}}</legend>
        {{#each packageModifiers as |item i|}}
          <div class='row-section col wrap tableOdd' data-id='{{item.uuid}}'>
            <div class='col eighty lineheight'>
              {{item.name}}
            </div>
            <div class='col ten'>
              <span class='small'>{{item.system.at.value}}</span>
            </div>
            <div class='col ten'>
              <a class='showEntity small' data-uuid='{{item.uuid}}'><i class='fas fa-info'></i></a>
            </div>
          </div>
        {{/each}}
      </fieldset>
    </div>
  </div>
  {{#if confirmed}}

    <div class='center bags' style="margin-top:20px;">
      <div
        class='slot newNPC'
        draggable='true'
        style="margin:0 auto;background-image:url('{{actor.img}}')"
        data-id='{{actor.id}}'
        data-uuid='{{actor.uuid}}'
        data-tooltip='{{actor.name}}'
      ></div>
    </div>

  {{else}}
    <div style='height:60px;' class="flexrow">
      <button class='createActor'>{{localize 'PLAYER.finalize'}}</button>
    </div>
  {{/if}}
</div>