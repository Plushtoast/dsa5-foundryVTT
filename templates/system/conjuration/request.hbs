<div class="summoning-request">

    <div class="dsa-card-panel dsap-3">
        <div class="row-section flexAlignCenter gap5px">
            <div class="col ten center">
                <img class="profile" style="width:48px;height:48px" src="{{summonerImg}}" alt=""
                    data-tooltip="{{summoner.name}}" />
            </div>
            <div class="col">
                <h3 class="dmargin0"><b>{{summoner.name}}</b> {{localize "CONJURATION.conjurs"}}
                    <b>{{conjuration.name}}</b></h3>
                <span class="dsa-pip pip-neutral">{{summary.typeName}}</span>
                <span class="dsa-pip pip-neutral">{{localize summary.controlModeLabel}}</span>
            </div>
            <div class="col ten center">
                <img class="profile" style="width:48px;height:48px" src="{{conjuration.img}}" alt=""
                    data-tooltip="{{conjuration.name}}" />
            </div>
        </div>
        <p class="dsa-info-text small dsamt-2">{{{localize 'CONJURATION.requestDescr'}}}</p>
    </div>

    {{> systems/dsa5/templates/system/conjuration/parts/summary.hbs}}

    <div class="summoning-columns">
        <div>
            {{> systems/dsa5/templates/system/conjuration/parts/selection-list.hbs title="extensions"
            entries=extensionEntries}}
        </div>
        <div>
            {{> systems/dsa5/templates/system/conjuration/parts/selection-list.hbs title="entityAbility"
            entries=entityEntries}}
            {{> systems/dsa5/templates/system/conjuration/parts/selection-list.hbs title="summoningPackage"
            entries=packageEntries}}
        </div>
    </div>

    {{#if confirmed}}

    <div class="dsa-card-panel dsap-3 center">
        <div class="underlined-header">{{localize "CONJURATION.dragToMap"}}</div>
        <div class="bags flexrow flexAlignCenter gap5px">
            <div data-action="newNPC" class="slot newNPC cursor-drag dsamx-auto" draggable="true"
                style="background-image:url('{{actor.img}}')" data-id="{{actor.id}}" data-uuid="{{actor.uuid}}"
                data-tooltip="{{actor.name}}"></div>
        </div>
        <p class="dsa-info-text small dsamt-2">{{localize "CONJURATION.dragToMapHint"}}</p>
    </div>

    {{else}}

    <div class="dsa-card-panel__actions dsa-card-panel__actions--end dialog-buttons">
        <button type="button" data-action="declineConjuration" class="dsadesignbutton">
            <i class="fas fa-ban"></i> {{localize 'CONJURATION.decline'}}
        </button>
        <button type="button" data-action="createActor" class="sheetButton">
            <i class="fas fa-check"></i> {{localize 'PLAYER.finalize'}}
        </button>
    </div>

    {{/if}}
</div>
