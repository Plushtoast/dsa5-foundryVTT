<div class="patchviewer scrollable" style="padding:20px">
    <div class="row-section table-title">
        <div class="col eighty">
            <h1 style="border:none;text-decoration:none;line-height:90px">{{{patchName}}}</h1>
        </div>
        <div class="col five">
            <img style="margin:0;float:right;height:90px" src="systems/dsa5/lazy/patchimages/UlissesDigital.png" />
        </div>
    </div>

    {{> systems/dsa5/templates/system/dsatabs.hbs}}
    
    <section class="content">
        <section >
        <div class="tab {{tabs.newcontent.cssClass}}" data-tab="newcontent" data-group="{{tabs.newcontent.group}}">
            <div class="newssection">
                {{{news}}} {{#each prevNews as |item i|}}
                <hr style="margin-top:100px" /> {{{item}}} {{/each}}
            </div>
            <button class="showMore">More..</button>
        </div>
        <div class="tab {{tabs.changelog.cssClass}}" data-tab="changelog" data-group="{{tabs.changelog.group}}">
            <div class="changelogsection">
                {{{changelog}}} {{#each prevChangeLogs as |item i|}}
                <hr style="margin-top:100px" /> {{{item}}} {{/each}}
            </div>
            <button class="showMore">More..</button>
        </div>
        <div class="tab {{tabs.content.cssClass}}" data-tab="content" data-group="{{tabs.content.group}}">
            {{{modules}}}
        </div>
    </section>
</div>