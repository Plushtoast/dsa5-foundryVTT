<div class='welcome-app-header'>
  <div class='welcome-app-header__bar'>
    <img class='welcome-app-header__logo' src='systems/dsa5/lazy/patchimages/UlissesDigital.png' />
    <i class='welcome-app-header__icon'></i>
    <span class='welcome-app-header__version'>{{{patchName}}}</span>
    <label class='welcome-app-header__dismiss'>
      <input type='checkbox' data-action='toggleDismiss' {{#if isDismissed}}checked{{/if}} />
      {{localize 'DSA5.welcomeApp.dontShowAgain'}}
    </label>
  </div>
</div>