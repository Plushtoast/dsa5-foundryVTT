<div class='tab scrollable {{tabs.content.cssClass}}' data-tab='content' data-group='{{tabs.content.group}}'>
  <section class='modules-hero darkbox'>
    <div class='modules-hero__grid'>
      <div class='modules-hero__text'>
        <h1>{{modules.title}}</h1>
        <p>{{localize 'DSA5.patchViewer.modules.hero.subtitle'}}</p>
        {{#if storeCTAUrl}}
          <a class='modules-hero__cta' href='{{storeCTAUrl}}' target='_blank' rel='noopener'>
            {{localize 'DSA5.patchViewer.modules.hero.cta'}}
          </a>
        {{/if}}
        <a class='modules-hero__cta' href='https://www.foundryvtt.store/search?q=s:dsa5' target='_blank' rel='noopener'>
          Foundry Marketplace
        </a>
      </div>
      <div class='modules-hero__aside darkbox'>
        <h2>{{localize 'DSA5.patchViewer.modules.gettingStarted.title'}}</h2>
        <p>{{localize 'DSA5.patchViewer.modules.gettingStarted.text'}}</p>
        <div class='modules-hero__links'>
          <a href='{{storeCTAUrl}}' target='_blank' rel='noopener'>{{localize 'DSA5.patchViewer.modules.gettingStarted.coreCta'}}</a>
          <a href='https://plushtoast.github.io/dsa5-foundryVTT-wiki/' target='_blank' rel='noopener'>{{localize 'DSA5.patchViewer.modules.gettingStarted.wiki'}}</a>
          <a href='https://www.youtube.com/channel/UCgVzSn5NkMaO-PDxhCiAAjA' target='_blank' rel='noopener'>{{localize 'DSA5.patchViewer.modules.gettingStarted.videos'}}</a>
        </div>
      </div>
    </div>
  </section>

  {{#if isEnglish}}
    <div class='modules-note darkbox'>
      {{{localize 'DSA5.patchViewer.modules.enNote' deUrl=storeDeUrl enUrl=storeEnUrl}}}
    </div>
  {{/if}}

  <div class='flexrow gap10px modules-layout'>
    <aside class='modules-toc darkbox'>
      <div class='modules-toc__search'>
        <input type="search" placeholder="{{localize 'Book.search'}}"/>
      </div>
      <h3>{{localize 'DSA5.patchViewer.modules.tocTitle'}}</h3>
      <nav>
        {{#each modules.categories}}
          <button type='button' class='modules-toc__link' data-action='scrollToCategory' data-target='category-{{slug}}'>{{name}}</button>
        {{/each}}
      </nav>

      {{#if moduleFilters.length}}
        <div class='modules-toc__filters'>
          <h3>{{localize 'DSA5.patchViewer.modules.filtersTitle'}}</h3>
          <div class='modules-filters__chips'>
            <button type='button' class='modules-filter-chip' data-action='toggleFilter' data-filter='not-owned'>
              {{localize 'DSA5.patchViewer.modules.filtersNotOwned'}}
            </button>
            {{#each moduleFilters}}
              <button type='button' class='modules-filter-chip' data-action='toggleFilter' data-filter='{{value}}'>
                {{label}}
                <span class='modules-filter-chip__count'>{{count}}</span>
              </button>
            {{/each}}
          </div>
          <button type='button' class='modules-filters__clear' data-action='clearFilters'>{{localize 'DSA5.patchViewer.modules.filtersClear'}}</button>
        </div>
      {{/if}}

      <div class='modules-hero__links modules-toc__scriptorium'>
        <a href='{{scriptoriumUrl}}' target='_blank' rel='noopener' data-tooltip="{{localize 'DSA5.patchViewer.modules.scriptorium.tooltip'}}">{{localize 'DSA5.patchViewer.modules.scriptorium.title'}}</a>
      </div>
    </aside>

    <div class='modules-content'>
      <div class="module-grids">
        {{#each modules.categories}}
          {{#unless @first}}
            <hr class='module-category__divider' data-divider-for='category-{{slug}}' />
          {{/unless}}
          <section class='module-category' id='category-{{slug}}'>
            <header class='module-category__header'>
              <h2>{{name}}</h2>
            </header>
            <div class='module-grid'>
              {{#each items}}
                <article class='module-card {{#if available}}module-card--owned{{/if}}' data-original-index='{{@index}}' data-sort-label='{{label}}' data-filters='{{filterString}}' data-module-id='{{id}}'>
                  {{#if badges.length}}
                    <ul class='module-card__badges'>
                      {{#each badges}}
                        <li>{{this}}</li>
                      {{/each}}
                    </ul>
                  {{/if}}
                  <a class='module-card__cover' href='{{href}}' target='_blank' rel='noopener' data-tooltip='{{label}}'>
                    {{#if image.src}}
                      <img src='{{image.src}}' alt='{{label}}' />
                    {{/if}}
                    {{#if available}}
                      <span class='module-card__owned'>{{localize 'DSA5.patchViewer.modules.owned'}}</span>
                    {{/if}}
                  </a>
                  <div class='module-card__body'>
                    <h3>{{label}}</h3>
                    {{#if description}}
                      <p>{{description}}</p>
                    {{/if}}
                    {{#if tags.length}}
                      <div class='module-card__tags'>
                        {{#each tags}}
                          <span>{{this}}</span>
                        {{/each}}
                      </div>
                    {{/if}}
                    <div class='flexrow gap5px'>
                      {{#if (and id (not isScriptorium))}}
                        <a class='module-card__cta' data-action='openModuleDetails' data-module-id='{{id}}'>
                          {{localize 'DSA5.patchViewer.modules.details'}}
                        </a>
                      {{/if}}
                      {{#unless available}}
                        <a class='module-card__cta' href='{{href}}' target='_blank' rel='noopener' data-tooltip='{{label}}'>
                          {{localize 'DSA5.patchViewer.modules.cta'}}
                        </a>
                      {{/unless}}
                    </div>
                  </div>
                </article>
              {{/each}}
            </div>
          </section>
        {{/each}}
      </div>
    </div>
  </div>
</div>
