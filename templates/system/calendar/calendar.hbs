<div class='tab scrollable {{tabs.calendar.cssClass}}' data-tab='calendar' data-group='{{tabs.calendar.group}}'>
    {{> 'systems/dsa5/templates/system/calendar/picker.hbs'}}


    <div class="flexrow">
        <div class="flexAlignCenter flexcol position-relative">
            <div class="tooltipBox itemLibraryTooltip dsahidden flexAlignCenter flexcol"></div>
            <div class="calendar-img"></div>
        </div>
        <div class="center circular-calendar-container flex0 flexAlignStart">
            <div class="circular-calendar" width="{{calendarSize}}" height="{{calendarSize}}" style="width:{{calendarSize}}px;height:{{calendarSize}}px; margin:0 auto;"></div>
        </div>
        
        
        <div class="flexAlignCenter flexcol position-relative">
            <div class="calendar-details"></div>
        </div>  
    </div>
</div>