<div class='tab scrollable standard-form {{tabs.personae.cssClass}}' data-tab='personae' data-group='{{tabs.personae.group}}'>
    <div class="fullScreenPadded dark-theme personae-container">
        <div class="personae-two-column">
            <div class="personae-list-column">
                <div class="personae-list-header">
                    <div class="list-type-switch">
                        <button type="button" class="list-switch-btn{{ifThen (eq lastActiveListType '0') ' active' ''}}" data-list-type="0" data-action="switchList">
                            {{localize "PERSONAE.ImportantPersons"}}
                        </button>
                        <button type="button" class="list-switch-btn{{ifThen (eq lastActiveListType '1') ' active' ''}}" data-list-type="1" data-action="switchList">
                            {{localize "PERSONAE.bestiary"}}
                        </button>
                    </div>
                    <div class="personae-list-toolbar flexrow">
                        <div class="list-search flex1">
                            <input type="search" class="search-input actorsearch" placeholder="{{localize 'Book.search'}}" />
                            <i class="fas fa-search"></i>
                        </div>
                        <button type="button" class="icon fas fa-bars list-context-menu noBorder dsadesignbutton" data-action="personaeListMenu" data-tooltip="{{localize 'JOURNAL.ActionShow'}}"></button>
                    </div>
                </div>
                
                <div class="personae-list" data-active-list="{{lastActiveListType}}">
                    <!-- Personae Dramatis List -->
                    <div class="list-content{{#unless (eq lastActiveListType '0')}} hidden{{/unless}}" data-list-type="0">
                        {{#each personae.personae0 as |factionGroup|}}
                        <div class="faction-group{{ifThen factionGroup.isCollapsed ' collapsed' ''}}" data-group-key="{{factionGroup.collapseKey}}">
                            <div class="faction-header" data-action="togglePersonaGroup" role="button" tabindex="0" aria-expanded="{{ifThen factionGroup.isCollapsed 'false' 'true'}}">
                                <div class="faction-title flexrow flexAlignCenter">
                                    <i class="fas fa-chevron-down faction-collapse-indicator flex0"></i>
                                    <h4 class="faction-name">{{factionGroup.faction}}</h4>
                                </div>
                                <span class="faction-count">{{factionGroup.members.length}}</span>
                            </div>
                            <div class="faction-body">
                            {{#each factionGroup.members as |persona|}}
                            <div class="persona-list-item{{ifThen persona.visible '' ' invisible'}}" data-persona-uuid="{{uuid}}" data-persona-juuid="{{juuid}}" data-key="{{dramatisKey}}" data-persona-factions="{{persona.faction}}" data-persona-tags="{{persona.tags}}" data-persona-important="{{persona.important}}" data-persona-visible="{{persona.visible}}" data-actor-uuid="{{persona.actor_uuid}}" data-action='selectActor' tabindex="0">
                                <div class="persona-list-image{{ifThen important ' persona-important' ''}}">
                                    <img src="{{img}}" alt="{{name}}" />
                                    {{#if garadanVisible}}
                                    <div class='persona-status garjourn {{garadanClass}}' data-tooltip="GARADAN.{{garadan}}"></div>
                                    {{/if}}
                                </div>
                                <div class="persona-list-info">
                                    <h5 class="persona-list-name">{{name}}</h5>
                                    {{#if subtitle}}
                                    <div class="persona-list-meta">
                                        <span class="persona-type">{{subtitle}}</span>
                                        {{#unless persona.visible}}
                                        <span class="persona-type persona-hidden"><i class="fas fa-eye-slash"></i></span>
                                        {{/unless}}
                                    </div>
                                    {{else}}
                                        {{#unless persona.visible}}
                                        <div class="persona-list-meta">
                                            <span class="persona-type persona-hidden"><i class="fas fa-eye-slash"></i></span>
                                        </div>
                                        {{/unless}}
                                    {{/if}}
                                </div>
                                <div class="persona-list-status">
                                    <i class="fas fa-chevron-right"></i>
                                </div>
                            </div>
                            {{/each}}
                            </div>
                        </div>
                        {{else}}
                        <div class="no-personae-list">
                            <div class="empty-state-small">
                                <i class="fas fa-users"></i>
                                <p>{{localize "PERSONAE.NoPersonsInList"}}</p>
                                {{#if ../isGM}}
                                <button type="button" class="flexrow add-persona-small" data-action="newPersona">
                                    <div class="flex0"><i class="fas fa-plus"></i></div><div>{{localize "PERSONAE.Add"}}</div>
                                </button>
                                {{/if}}
                            </div>
                        </div>
                        {{/each}}
                    </div>

                    <!-- Beasts List -->
                    <div class="list-content{{#unless (eq lastActiveListType '1')}} hidden{{/unless}}" data-list-type="1">
                        {{#each personae.personae1 as |factionGroup|}}
                        <div class="faction-group{{ifThen factionGroup.isCollapsed ' collapsed' ''}}" data-group-key="{{factionGroup.collapseKey}}">
                            <div class="faction-header" data-action="togglePersonaGroup" role="button" tabindex="0" aria-expanded="{{ifThen factionGroup.isCollapsed 'false' 'true'}}">
                                <div class="faction-title flexrow flexAlignCenter">
                                    <i class="flex0 fas fa-chevron-down faction-collapse-indicator"></i>
                                    <h4 class="faction-name">{{factionGroup.faction}}</h4>
                                </div>
                                <span class="faction-count">{{factionGroup.members.length}}</span>
                            </div>
                            <div class="faction-body">
                            {{#each factionGroup.members as |persona|}}
                            <div class="persona-list-item{{ifThen persona.visible '' ' invisible'}}" data-persona-uuid="{{uuid}}" data-persona-juuid="{{juuid}}" data-key="{{dramatisKey}}" data-persona-factions="{{persona.faction}}" data-persona-tags="{{persona.tags}}" data-persona-important="{{persona.important}}" data-persona-visible="{{persona.visible}}" data-actor-uuid="{{persona.actor_uuid}}" data-action='selectActor' tabindex="0">
                                <div class="persona-list-image{{ifThen important ' persona-important' ''}}">
                                    <img src="{{img}}" alt="{{name}}" />
                                </div>
                                <div class="persona-list-info">
                                    <h5 class="persona-list-name">{{name}}</h5>
                                    {{#if subtitle}}
                                    <div class="persona-list-meta">
                                        <span class="persona-type">{{subtitle}}</span>
                                        {{#unless persona.visible}}
                                        <span class="persona-type persona-hidden"><i class="fas fa-eye-slash"></i></span>
                                        {{/unless}}
                                    </div>
                                    {{else}}
                                        {{#unless persona.visible}}
                                        <div class="persona-list-meta">
                                            <span class="persona-type persona-hidden"><i class="fas fa-eye-slash"></i></span>
                                        </div>
                                        {{/unless}}
                                    {{/if}}
                                </div>
                                <div class="persona-list-status">
                                    <i class="fas fa-chevron-right"></i>
                                </div>
                            </div>
                            {{/each}}
                            </div>
                        </div>
                        {{else}}
                        <div class="no-personae-list">
                            <div class="empty-state-small">
                                <i class="fas fa-dragon"></i>
                                <p>{{localize "PERSONAE.NoBeasts"}}</p>
                                {{#if ../isGM}}
                                <button type="button" class="flexrow add-persona-small" data-action="newPersona">
                                    <div class="flex0"><i class="fas fa-plus"></i></div><div>{{localize "PERSONAE.Add"}}</div>
                                </button>
                                {{/if}}
                            </div>
                        </div>
                        {{/each}}
                    </div>
                </div>
            </div>

            <div class="personae-details-column">
                <div class="persona-details-container">
                    {{#if detailData}}
                        {{#with detailData}}
                            {{> "systems/dsa5/templates/system/calendar/persona-detail.hbs"}}
                        {{/with}}
                    {{else}}
                    <div class="no-selection">
                        <div class="no-selection-content">
                            <i class="fas fa-user-circle"></i>
                            <h3>{{localize "PERSONAE.SelectPersona"}}</h3>
                            <p>{{localize "PERSONAE.SelectPersonaHint"}}</p>
                        </div>
                    </div>
                    {{/if}}
                </div>
            </div>
        </div>
    </div>
</div>