<button type="button" class="event-compact" data-action="selectEvent" data-juuid="{{juuid}}" data-key="{{calendarKey}}" data-uuid="{{juuid}}" data-category="{{category}}" style="--event-color: {{chipColor}};">
    <i class="event-compact__icon {{categoryIcon}}"></i>
    <span class="event-compact__title">{{title}}</span>
</button>
