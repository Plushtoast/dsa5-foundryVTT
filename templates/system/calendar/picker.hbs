<div>
  <fieldset class="margin-top noBorder calendarDateChange" {{#unless isGM}}disabled{{/unless}}>



    <!--div class='flexrow col five'>
        <select name='day' class='dateChange' data-dtype='Number'>
          {{selectOptions dayOptions selected=components.dayOfMonth localize=true labelAttr='name' valueAttr='value'}}
        </select>
      </div>
      <div class='flexrow col third'>
        <select name='month' class='dateChange' data-dtype='Number'>
          {{selectOptions monthOptions selected=components.month localize=true labelAttr='name' valueAttr='value'}}
        </select>
      </div-->
    <div class="flexrow">
      <h3 class="flexrow"><input data-tooltip="CALENDAR.DSA.year" type='number' class='flexgrow-0 dateChange'
          name='year' value='{{components.year}}' /><span>{{localize (concat calendar.translationPrefix '.'
          worldCalendarConfig.years.yearSuffix)}}</span></h3>

      <div class="flexAlignEnd flexrow">
        <div></div>
        <div>
          <i class="fas fa-hourglass-half"></i>
          <input data-tooltip="CALENDAR.DSA.hour" type='number' class='flexgrow-0 hourInput dateChange' name='hour'
            value='{{components.hour}}' min='0' max='23' step='1' />
          <span>:</span>
          <input data-tooltip="CALENDAR.DSA.minute" type='number' class='flexgrow-0 hourInput dateChange' name='minute'
            value='{{components.minute}}' min='0' max='59' step='1' />
          <span>:</span>
          <input data-tooltip="CALENDAR.DSA.second" type='number' class='flexgrow-0 hourInput dateChange' name='second'
            value='{{components.second}}' min='0' max='59' step='1' />
        </div>
      </div>
    </div>
  </fieldset>
</div>