<div class="persona-detail-view">
    <div class="persona-detail-header">
        <div class="persona-detail-image">
            <img src="{{img}}" alt="{{name}}" />
            {{#if garadanVisible}}
            <div class="persona-status garjourn {{garadanClass}}" data-tooltip="GARADAN.{{garadan}}"></div>
            {{/if}}
        </div>
        <div class="persona-detail-title">
            <h1 class="persona-detail-name">{{name}}</h1>
            <p class="persona-detail-subtitle">{{faction}}</p>
            {{#each preparedTags}}
            <span class="persona-detail-type">{{this}}</span>
            {{/each}}
        </div>
        {{#if isGM}}
        <div class="persona-detail-actions">
            <button type="button" class="detail-action-btn edit-btn" data-tooltip="SHEET.EditItem"
                data-action="editActor" data-persona-uuid="{{uuid}}" data-persona-dramatis-key="{{dramatisKey}}">
                <i class="fas fa-edit"></i>
            </button>
            <button type="button" class="detail-action-btn sheet-btn"
                data-tooltip="PERSONAE.FIELDS.personae.showActorDescription.label" data-action="showSheet"
                data-uuid="{{actor.uuid}}">
                <i class="fas fa-user"></i>
            </button>
            <button type="button" class="detail-action-btn delete-btn"
                data-tooltip="PERSONAE.FIELDS.personae.visible.label" data-action="toggleVisibility"
                data-persona-uuid="{{uuid}}" data-persona-dramatis-key="{{dramatisKey}}">
                <i class="fas fa-eye{{ifThen visible '' '-slash'}}"></i>
            </button>
        </div>
        {{/if}}
    </div>

    <div class="persona-detail-content">
        {{#unless noTabs}}
        <nav class="sheet-tabs tabs detail-section" aria-roledescription="Form Tab Navigation">
            {{#each tabs as |tab|}}
            <h3 class="tabelement {{tab.cssClass}} section-title" data-action="tab" data-group="{{tab.group}}" data-tab="{{tab.id}}">
                {{localize tab.label}}
            </h3>
            {{/each}}
        </nav>
        {{/unless}}
        <div class='tab {{tabs.description.cssClass}} {{ifThen noTabs 'active' ''}}' data-tab='description' data-group='{{tabs.description.group}}'>
            <div class="detail-section">
                {{#if noTabs}}<h3 class="section-title">{{localize 'Description'}}</h3>{{/if}}
                <div class="section-content">
                    <div class="description-text">{{{preparedDescription}}}</div>
                </div>
            </div>
        </div>
        {{#if isGM}}
        <div class='tab {{tabs.slnotes.cssClass}} {{ifThen noTabs 'active' ''}}' data-tab='slnotes' data-group='{{tabs.slnotes.group}}'>
            <div class="detail-section">
                {{#if noTabs}}<h3 class="section-title">{{localize 'GM Notes'}}</h3>{{/if}}
                <div class="section-content">
                    <div class="description-text">{{{actor.system.details.notes.gmdescription}}}</div>
                </div>
            </div>
        </div>
        {{/if}}

        <div class='tab {{tabs.notes.cssClass}} {{ifThen noTabs 'active' ''}}' data-tab='notes' data-group='{{tabs.notes.group}}'>
            <div class="detail-section">
                {{#if noTabs}}<h3 class="section-title">{{localize 'Notes'}}</h3>{{/if}}
                <div class="section-content">
                    <div class="description-text">
                        {{#if noTabs}}
                            {{{preparedNotes}}}
                        {{else}}
                            <prose-mirror toggled class="notes-edit" value="{{notes}}" collaborate name="system.personae.{{dramatisKey}}.notes" data-document-uuid="{{uuid}}">
                                {{{preparedNotes}}}
                            </prose-mirror>
                        {{/if}}
                    </div>
                </div>
            </div>
        </div>

        {{#if contacts}}
        <div class='tab {{tabs.contacts.cssClass}} {{ifThen noTabs 'active' ''}}' data-tab='contacts' data-group='{{tabs.contacts.group}}'>
            <div class="detail-section">
                {{#if noTabs}}<h3 class="section-title">{{localize 'PERSONAE.FIELDS.personae.socialContact.label'}}</h3>{{/if}}
                <div class="section-content">
                    {{#each contacts}}
                    <div class="persona-list-item" data-persona-uuid="{{../uuid}}" data-persona-dramatis-key="{{../dramatisKey}}">
                        <div class="persona-list-image">
                            <img src="{{img}}" alt="{{name}}" />
                        </div>
                        <div class="persona-list-info">
                            <h5 class="persona-list-name">{{name}}</h5>
                            {{#if subtitle}}
                            <div class="persona-list-meta">
                                <span class="persona-type">{{subtitle}}</span>
                            </div>
                            {{/if}}
                        </div>
                        <div class="relationship-section">
                            <div class="relationship-header">
                                <span class="relationship-label">{{localize (concat 'PERSONAE.FIELDS.personae.socialContact.level.choices.' level)}}</span>
                                <span class="relationship-value">{{level}}/9</span>
                            </div>
                            <div class="relationship-slider-container">
                                <input data-contact-uuid="{{uuid}}" type="range" value='{{level}}' {{ifThen ../canChangeRelation '' 'disabled'}} class="relationship-slider level-{{level}}" min="1" max="9" step="1"/>
                                <div class="slider-track-labels">
                                    <span class="track-label start">1</span>
                                    <span class="track-label mid">5</span>
                                    <span class="track-label end">9</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    {{/each}}
                </div>
            </div>
        </div>
        {{/if}}
    </div>
</div>