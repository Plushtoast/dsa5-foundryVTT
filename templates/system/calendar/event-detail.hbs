<article class="event-detail" aria-labelledby="event-detail-{{juuid}}-{{calendarKey}}-title">
    <div class="event-card__body">
        <div class="flexrow">
            <h3 id="event-detail-{{juuid}}-{{calendarKey}}-title" class="event-card__title">{{title}} {{#unless visible}}<i class="fas fa-eye-slash"
                data-tooltip="dsacalendar.FIELDS.calendarentries.visible.label"></i>{{/unless}}</h3>
            {{#if isOwner}}
            <div class="event-card-controls flex0">
                <button type="button" class="smallBtn fa-solid fa-edit icon" data-action="editEvent" data-uuid="{{uuid}}" data-key="{{calendarKey}}"></button>
            </div>
            {{/if}}
        </div>

        <div class="event-card__meta">
            <span class="event-chip">
                <i class="far fa-clock"></i>
                <span>{{from.dayOfMonth}}.</span>
                {{#if to.dayOfMonth}}
                <span aria-hidden="true">–</span>
                <span>{{to.dayOfMonth}}.</span>
                {{/if}}
                <span>{{from.monthLong}} {{#if displayYear}}{{displayYear}}{{else}}{{from.year}}{{/if}} {{yearSuffix}}</span>
            </span>

            {{#if location}}
            <span class="event-chip">
                <i class="fas fa-location-pin"></i>
                <span class="eventlocation">{{location}}</span>
            </span>
            {{/if}}

            {{#if gods}}
            <span class="event-chip" data-tooltip="dsacalendar.gods">
                <i class="fas fa-person-praying"></i>
                {{gods}}
            </span>
            {{/if}}

            {{#if recurring}}
            <span class="event-chip">
                <span><i class="fas fa-redo" data-tooltip="dsacalendar.FIELDS.calendarentries.recurring.label"></i></span>
            </span>
            {{/if}}
        </div>

        {{#if enriched}}
        <div class="event-card__desc">
            {{{enriched}}}
        </div>
        {{/if}}
    </div>
</article>
