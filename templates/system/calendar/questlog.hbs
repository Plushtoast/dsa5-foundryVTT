<div class='tab scrollable standard-form {{tabs.questlog.cssClass}}' data-tab='questlog' data-group='{{tabs.questlog.group}}'>
    <div class='fullScreenPadded dark-theme personae-container'>
        <div class='personae-two-column'>
            <div class='personae-list-column'>
                <div class='personae-list-header'>
                    <div class='flexrow'>
                        <div class='list-search flex1'>
                            <input type='search' class='search-input questSearch' placeholder='{{localize "Book.search"}}' />
                            <i class='fas fa-search'></i>
                        </div>
                        {{#if isGM}}
                            <button type='button' class='icon fas fa-plus list-add-button' data-action='newQuest' data-tooltip='{{localize "DSAQUESTLOG.createQuest"}}'></button>
                        {{/if}}
                        <button type='button' class='icon fas fa-bars list-context-menu noBorder dsadesignbutton' data-action='questlogListMenu' data-tooltip='{{localize "JOURNAL.ActionShow"}}'></button>
                    </div>
                </div>

                <div class='personae-list questlog-list scrollable'>
                    {{#if questGroups.length}}
                        {{#each questGroups as |group|}}
                            <div class='faction-group quest-group{{ifThen group.isCollapsed " collapsed" ""}}' data-group-key='{{group.group}}'>
                                <div class='faction-header' data-action='toggleQuestGroup' role='button' tabindex='0' aria-expanded='{{ifThen group.isCollapsed "false" "true"}}'>
                                    <div class='faction-title flexrow flexAlignCenter'>
                                        <i class='fas fa-chevron-down faction-collapse-indicator'></i>
                                        <h4 class='faction-name'>{{group.group}}</h4>
                                    </div>
                                    <span class='faction-count'>{{group.quests.length}}</span>
                                </div>
                                <div class='faction-body'>
                                {{#each group.quests as |quest|}}
                                    <div class='persona-list-item{{ifThen quest.isVisibleToPlayers "" " invisible"}} {{ifThen (and @root.detailData (eq @root.detailData.questKey quest.questKey) (eq @root.detailData.uuid quest.uuid)) "selected" ""}}' data-quest-uuid='{{quest.uuid}}' data-quest-key='{{quest.questKey}}' data-quest-status='{{quest.status}}' data-action='selectQuest' tabindex='0'>
                                        <div class='persona-list-image center flexAlignCenter'>
                                            <i class='fas {{ifThen quest.pinToTop "fa-star" "fa-scroll"}}'></i>
                                        </div>
                                        <div class='persona-list-info'>
                                            <h5 class='persona-list-name'>{{quest.title}}</h5>
                                            <div class='persona-list-meta'>
                                                <span class='persona-type'>{{quest.statusName}}</span>
                                                {{#if quest.totalObjectives}}
                                                    <span class='persona-type'>{{quest.progressText}}</span>
                                                {{/if}}
                                                {{#each quest.preparedAudienceBadges}}
                                                    <span class='persona-type questlog-badge-{{cssClass}}'>{{label}}</span>
                                                {{/each}}
                                            </div>
                                            {{#if quest.preparedSummary}}
                                                <div class='questlog-summary small'>{{quest.preparedSummary}}</div>
                                            {{/if}}
                                        </div>
                                    </div>
                                {{/each}}
                                </div>
                            </div>
                        {{/each}}
                    {{else}}
                        <div class='no-personae-list'>
                            <div class='empty-state-small'>
                                <i class='fas fa-scroll'></i>
                                <h3>{{localize 'DSAQUESTLOG.emptyTitle'}}</h3>
                                <p>{{localize 'DSAQUESTLOG.emptyHint'}}</p>
                            </div>
                        </div>
                    {{/if}}
                </div>
            </div>

            <div class='personae-details-column'>
                <div class='persona-details-container'>
                    {{#if detailData}}
                        {{> "systems/dsa5/templates/system/calendar/questlog-detail.hbs" detailData}}
                    {{else}}
                        <div class='no-selection'>
                            <div class='no-selection-content'>
                                <i class='fas fa-scroll'></i>
                                <h3>{{localize 'DSAQUESTLOG.SelectQuest'}}</h3>
                                <p>{{localize 'DSAQUESTLOG.SelectQuestHint'}}</p>
                            </div>
                        </div>
                    {{/if}}
                </div>
            </div>
        </div>
    </div>
</div>