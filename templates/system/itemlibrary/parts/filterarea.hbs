<div class="row-section itemlibrary-body{{#if embedded}} itemlibrary-body--stacked{{/if}}">
    {{#if categories.length}}
    {{#if embedded}}
    <details class="advancedSearch itemlibrary-sidebar itemlibrary-advanced-panel" {{#if advancedFilter}}open{{/if}} {{#unless advancedFilter}}hidden{{/unless}}>
        <summary class="itemlibrary-advanced-panel__summary">{{localize 'Library.advanced'}}</summary>
        <div class="advancedSearchContent itemlibrary-advanced-panel__content">
            {{{advancedFilter}}}
        </div>
    </details>
    {{else}}
    <div class="col third advancedSearch itemlibrary-sidebar" {{#unless advancedFilter}}hidden{{/unless}}>
        <fieldset>
            <legend>{{localize 'Library.advanced'}}</legend>
            <div class="advancedSearchContent">
                {{{advancedFilter}}}
            </div>
        </fieldset>
    </div>
    {{/if}}
    {{/if}}
    <div class="col {{#if embedded}}hundred{{else if categories.length}}seventy{{else}}hundred{{/if}} itemlibrary-main">
        <div class="dsa-choice-browser itemlibrary-browser">
            <div class="dsa-choice-browser__toolbar">
                {{#if categories.length}}
                <div class="library-filter-chips filterCategories flex1">
                    {{#each categories as |val|}}
                    <div class="library-filter-chip browser-item {{#if val.selected}}active{{/if}}" data-tooltip="{{val.label}}">
                        <input class="filter" id="filter_{{../category}}_{{val.key}}" type="checkbox"
                            data-category="{{../category}}" data-type="{{val.key}}" {{checked val.selected}} />
                        <label for="filter_{{../category}}_{{val.key}}">{{val.label}}</label>
                    </div>
                    {{/each}}
                </div>
                {{/if}}
                <span class="dsa-choice-browser__toolbar-count library-result-count" data-result-count></span>
            </div>
            <div class="dsa-choice-browser__results scrollable">
                <div class="searchResult libcontainer libraryImg" data-view-mode="{{viewMode}}">
                    <ul class="item-list"></ul>
                </div>
            </div>
        </div>
    </div>
</div>
