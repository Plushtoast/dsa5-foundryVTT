<div class="detailFilters dsa-attr-filter" data-subc="{{subcategory}}">
    {{#each fields as |field|}}
        {{#if (eq field.type 'prerendered')}}
        <div class="dsa-attr-filter__field dsa-attr-filter__field--wide">
            {{{field.content}}}
        </div>
        {{else if (eq field.type 'select')}}
        <div class="dsa-attr-filter__field flexcol{{#if field.value}} dsa-attr-filter__field--set{{/if}}">
            <label>{{localize field.label}}</label>
            <select name="{{field.attr}}" data-notstrict="{{field.notStrict}}">
                {{selectOptions options selected=field.value blank='Library.noFilter' localize=true}}
            </select>
        </div>
        {{else if (eq field.type 'text')}}
        <div class="dsa-attr-filter__field flexcol{{#if field.value}} dsa-attr-filter__field--set{{/if}}">
            <label>{{localize field.label}}</label>
            <input type="text" name="{{field.attr}}" placeholder="{{localize field.placeholder}}" value="{{field.value}}" />
        </div>
        {{else if (eq field.type 'checkbox')}}
        <div class="dsa-attr-filter__field dsa-attr-filter__field--check{{#if field.value}} dsa-attr-filter__field--set{{/if}}">
            <label class="dsa-attr-filter__check">
                <input type="checkbox" name="{{field.attr}}" value="true" {{checked field.value}}/>
                <span>{{localize field.label}}</span>
            </label>
        </div>
        {{/if}}
    {{/each}}
    <div class="dsa-attr-filter__field flexcol{{#if moduleSelected}} dsa-attr-filter__field--set{{/if}}">
        <label>{{localize 'Module'}}</label>
        <select name="compendium" data-notstrict="true">
            {{selectOptions moduleOptions selected=moduleSelected blank=(localize 'Library.noFilter')}}
        </select>
    </div>
</div>
