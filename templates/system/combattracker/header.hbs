<header class="combat-tracker-header">

    {{!-- Encounter Controls --}}
    {{#if user.isGM}}
    {{#if (or displayCycle combats.length)}}
    <nav class="encounters {{ css }}" aria-label="{{ localize "COMBAT.NavLabel" }}">

        {{!-- Cycle Display --}}
        {{#if displayCycle}}
        <button type="button" class="inline-control icon fa-solid fa-plus" data-action="createCombat"
                data-tooltip="COMBAT.Create" aria-label="{{ localize "COMBAT.Create" }}"></button>

        <div class="cycle-combats">
            <button type="button" class="inline-control icon fa-solid fa-caret-left" data-action="cycleCombat"
                    {{#if previousId}}data-combat-id="{{ previousId }}" {{else}}disabled{{/if}}
                    data-tooltip="COMBAT.EncounterPrevious"
                    aria-label="{{ localize "COMBAT.EncounterPrevious" }}"></button>
            <div class="encounter-count">
                <span class="value">{{ currentIndex }}</span>
                <span class="separator">&sol;</span>
                <span class="max">{{ combats.length }}</span>
            </div>
            <button type="button" class="inline-control icon fa-solid fa-caret-right" data-action="cycleCombat"
                    {{#if nextId}}data-combat-id="{{ nextId }}" {{else}}disabled{{/if}}
                    data-tooltip="COMBAT.EncounterNext" aria-label="{{ localize "COMBAT.EncounterNext" }}"></button>
        </div>
        
        <button type="button" class="inline-control icon fa-solid fa-gear" data-action="trackerSettings"
                data-tooltip="COMBAT.Settings" aria-label="{{ localize "COMBAT.Settings" }}"></button>
        <button type="button" class="inline-control combat-control icon combat-mode-control fas {{combatModeIcon}}" data-tooltip="{{combatModeTooltip}}" {{#unless combats.length}}disabled{{/unless}} aria-label="{{ localize combatModeTooltip }}"></button>
        {{!-- Tabbed Display --}}
        {{else}}
        <button type="button" class="inline-control icon fa-solid fa-plus" data-action="createCombat"
                data-tooltip="COMBAT.Create" aria-label="{{ localize "COMBAT.Create" }}"></button>
        {{#each combats}}
        <button type="button" class="inline-control {{#if active}}active{{/if}}" data-action="cycleCombat"
                data-combat-id="{{ id }}">
            {{ label }}
        </button>
        {{/each}}
        
        <button type="button" class="inline-control icon fa-solid fa-gear" data-action="trackerSettings"
                data-tooltip="COMBAT.Settings" aria-label="{{ localize "COMBAT.Settings" }}"></button>
        <button type="button" class="inline-control combat-control icon combat-mode-control fas {{combatModeIcon}}" data-tooltip="{{combatModeTooltip}}" {{#unless combats.length}}disabled{{/unless}} aria-label="{{ localize combatModeTooltip }}"></button>
        <button type="button" class="inline-control icon fa-solid fa-info" data-action="combatRules"
                data-tooltip="{{combatRulesTooltip}}" aria-label="{{ localize combatRulesTooltip }}"></button>
        {{/if}}
    </nav>
    {{else}}
    <div class="combat-mode-start-panel">
        <strong class="combat-mode-start-title">{{ localize "COMBAT.MODE.startTitle" }}</strong>
        {{#each combatModeStarts}}
        <div class="combat-mode-start">
            <button type="button" class="combat-control-lg combat-mode-start-btn" data-action="createCombatMode" data-mode="{{id}}">
                <i class="fas {{icon}}" inert></i>
                <span>{{ localize label }}</span>
            </button>
            <p class="hint combat-mode-start-hint">{{ localize hint }}</p>
        </div>
        {{/each}}
    </div>
    {{/if}}
    {{/if}}

    {{#if combats.length}}
    <div class="encounter-controls {{#if hasCombat}}combat{{/if}}">

        {{!-- Combat Status --}}
        <strong class="encounter-title">
            {{#if combat.round}}
            {{#if isNavalMkr}}
            {{ localize "COMBAT.Round" round=combat.round }} · MKR {{mkr.mkrRound}}
            {{else if isChase}}
            {{ localize "COMBAT.Round" round=combat.round }} · {{localize (ifThen isVehicleChase "COMBAT.MODE.vehicleChase" "COMBAT.MODE.chase")}}
            {{else}}
            {{ localize "COMBAT.Round" round=combat.round }}
            {{/if}}
            {{else}}
            {{ localize "COMBAT.NotStarted" }}
            {{/if}}
        </strong>

        {{!-- Combat Controls --}}
        <button type="button" class="encounter-context-menu inline-control combat-control icon fa-solid fa-ellipsis-vertical"
                {{#unless (and user.isGM hasCombat)}}disabled{{/unless}}></button>

    </div>
    {{else}}
    {{#unless user.isGM}}
    <div class="encounter-controls">
        <strong class="encounter-title">{{ localize "COMBAT.None" }}</strong>
    </div>
    {{/unless}}
    {{/if}}

    {{> systems/dsa5/templates/system/combattracker/mkr-bar.hbs}}
    {{> systems/dsa5/templates/system/combattracker/chase-bar.hbs}}

</header>
