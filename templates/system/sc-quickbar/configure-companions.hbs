<div class="tab scrollable standard-form {{tabs.companions.cssClass}}" data-tab="companions" data-group="{{tabs.companions.group}}">
    <p class="hint">{{localize 'SCQUICKBAR.companionDisplayHint'}}</p>
    <div class="form-group" data-setting-id="dsa5.scQuickbarConfig.preferActorImg">
        <label>{{localize 'SCQUICKBAR.preferActorImg'}}</label>
        <div class="form-fields">
            <input type="checkbox" name="config.preferActorImg" {{checked config.preferActorImg}}>
        </div>
        <p class="hint">{{localize 'SCQUICKBAR.preferActorImgHint'}}</p>
    </div>
    <div class="form-group" data-setting-id="dsa5.scQuickbarConfig.companionDisplay">
        <label>{{localize 'SCQUICKBAR.companionDisplay'}}</label>
        <div class="form-fields">
            <select name="config.companionDisplay">
                {{selectOptions companionChoices selected=config.companionDisplay localize=true}}
            </select>
        </div>
    </div>
</div>
