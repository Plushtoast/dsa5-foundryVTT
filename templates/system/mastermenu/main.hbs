<div class="tab scrollable {{tabs.main.cssClass}}" data-tab="main" data-group="{{tabs.main.group}}">
    <div class="row-section">
        <div class="col third lineheight center" data-tooltip="groupFatePoints">
            <b>{{{localize 'CHARAbbrev.groupFatePoints'}}}</b>
        </div>
        <div class="col sixty center" data-tooltip="fatePoints">
            {{#each groupschips as |item i|}}
            <a class="schip groupschip {{item.cssClass}}" data-action="groupschip" data-val="{{item.value}}"></a>
            {{/each}}
        </div>
        <div class="col ten center">
            <a data-action="addGroupSchip" data-value="-1"><i class="fas fa-minus"></i></a>
            <a data-action="addGroupSchip" data-value="1"><i class="fas fa-plus"></i></a>
        </div>
    </div>
    <div class="row-section">
        
        
        <div class="col third lineheight center">
            <b>{{localize "TYPES.Item.skill"}}</b>
        </div>
        <div class="col sixty">
            <select name="data.skill" class="skillSelektor select2" style="width:90%">
                {{selectOptions abilities selected=lastSkill valueAttr="key" labelAttr="name" sort=true}}
            </select>
        </div>
    
        <div class="col ten lineheight center">
            <a data-action="requestRoll" data-tooltip="HELP.request"><i class="fas fa-dice-two"></i></a>
        </div>
    </div>
    <div class="row-section skills table-title">
        <div class="col ten">
            <a class="dragEveryone" data-tooltip="MASTER.dragEveryone"><i class="fas fa-grip-vertical"></i></a>
        </div>
        <div class="col fourty">
            {{localize 'Name'}} <a data-action="randomPlayer" data-tooltip="MASTER.randomPlayer"><i
                    class="fas fa-dice-six"></i></a>
        </div>
        <div class="col fifteen">
        </div>
        <div class="col ten">
            <input type="checkbox" class="selectAll" name="selectAll" value="1">
        </div>
        <div class="col four">
            <a data-action="rollAll" data-tooltip="CHAT.RollBlind"><i class="fas fa-dice"></i></a>
            <a data-action="getPaidAll" data-tooltip="PAYMENT.wage"><i class="fas fa-piggy-bank"></i></a>
            <a data-action="payAll" data-tooltip="MASTER.payTT"><i class="fas fa-coins"></i></a>
            <a data-action="expAll" data-tooltip="MASTER.awardXP"><i class="fas fa-trophy"></i></a>
            <a data-action="groupcheck" data-tooltip="HELP.groupcheck"><i class="fas fa-users-cog"></i></a>
            <a data-action="addFolder" data-mode="create" data-tooltip="FOLDER.Create"><i class="fas fa-folder"></i></a>
        </div>
    </div>
    <div class="heros">
        {{#if hasHeros}}
            {{> systems/dsa5/templates/system/mastermenu/master_heros.hbs heros=heros}}
            {{#each folders as |folder|}}
            <div class="row-section skills lineheight table-title isFolder" data-id="{{folder.id}}">
                
                <div class="col ten">
                    <a class="dragEveryone" data-folder="{{folder.id}}" data-tooltip="MASTER.dragEveryone"><i class="fas fa-grip-vertical"></i></a>
                </div>
                <div class="row-section col">
                    
                    <div class="col two">
                        <input type="text" data-id="{{folder.id}}" class="editFolder" style="border:none;margin:0;padding:0" value="{{folder.name}}"/>
                    </div>
                    <div class="col fifteen">
                    </div>
                    <div class="col ten">
                        <input type="checkbox" data-folder="{{folder.id}}" class="selectAll" name="selectAll" value="1">
                    </div>
                    <div class="col four center">
                        <a data-action="addFolder" data-id="{{folder.id}}" data-mode="delete" data-tooltip="FOLDER.Remove"><i class="fas fa-trash"></i></a>
                    </div>
                </div>
            </div>
            <div class="row-section col isFolder" data-id="{{folder.id}}">
                <div class="col ten"></div>
                <div class="col">                            
                    {{> systems/dsa5/templates/system/mastermenu/master_heros.hbs heros=folder.contents}}                                              
                </div>                        
            </div>                    
            {{/each}}
            
        {{else}}
        <div class="row-section">
            <div class="col ten"></div>
            <div class="col eighty center">
                <p>{{localize "MASTER.noHeros"}}</p>
            </div>
            <div class="col ten"></div>
        </div>
        {{/if}}
    </div>
</div>