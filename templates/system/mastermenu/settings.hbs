<div class='tab standard-form scrollable {{tabs.sceneConfig.cssClass}}' data-tab='sceneConfig' data-group='{{tabs.sceneConfig.group}}'>
  <fieldset>
    <legend>{{localize 'MASTER.globalMods'}}</legend>
    <div class='row-section table-title'>
      <div class='col sixty'>
        
      </div>
      <div class='col ten center lineheight'>
        {{localize 'Book.active'}}
      </div>
      <div class='col five center'>

      </div>
      <div class='col ten flexrow' data-tooltip='MASTER.globalModsHint'>
        <button type="button" class="dsadesignbutton noBorder icon fas fa-plus" data-action='addGlobalMod'></button>
      </div>
    </div>
    <div class='col morph'>
      {{#each masterSettings.globalMods as |item i|}}
        <div class='tableOdd skills'>
          <div class='row-section'>
            <div class='col sixty flexrow flexAlignCenter'>
              <a data-action='editGlobalMod' data-key='{{i}}' data-tooltip='SHEET.EditItem'>{{item.name}}</a>
            </div>
            <div class='col ten center flexrow flexAlignCenter'>
              <input type='checkbox' class='globalModEnable' data-key='{{i}}' {{checked item.enabled}} />
            </div>
            <div class='col ten center flexrow flexAlignCenter'>
              {{item.value}}
            </div>
            <div class='col five flexrow flexAlignCenter'>
              <button type="button" class='dsadesignbutton noBorder icon fas fa-edit' data-action='editGlobalMod' data-key='{{i}}' data-tooltip='SHEET.EditItem'></button>
              <button type="button" class='dsadesignbutton noBorder icon fas fa-trash' data-action='removeGlobalMod' data-key='{{i}}' data-tooltip='SHEET.DeleteItem'></button>
            </div>
          </div>
          <div class='row-section wrap'>
            {{#each item.target as |value key|}}
              {{#if value}}
                <small class='smallBoxItem'>{{itemCategory key}}</small>
              {{/if}}
            {{/each}}
            {{#if item.victim.player}}
              <small class='smallBoxItem emphasize2'>{{localize 'TYPES.Actor.character'}}</small>
            {{/if}}
            {{#if item.victim.npc}}
              <small class='smallBoxItem emphasize'>{{localize 'TYPES.Actor.npc'}}</small>
            {{/if}}
          </div>
        </div>
      {{/each}}
    </div>
  </fieldset>
  <fieldset>
    <legend>{{localize 'sight'}}</legend>

    <div class='form-group'>
      <label>{{localize 'MASTER.darkness'}}</label>
      <div class='form-fields'>
        <range-picker class="updateDarkness" name="updateDarkness" value='{{sceneConfig.darkness}}' min="0" max="1" step="0.05"></range-picker>
      </div>
    </div>
    <div class='form-group'>
      <label for='set_sightAutomationEnabled'>{{localize 'MASTER.sightautomation'}}</label>
      <input type='checkbox' id='set_sightAutomationEnabled' class='changeSetting' name='sightAutomationEnabled' value='1' {{checked sceneConfig.sceneAutomationEnabled}} />

      <p class='hint'>{{localize 'MASTER.sightautomationTooltip'}}</p>
    </div>
    <div class='form-group'>
      <label for='set_lightSightCompensationEnabled'>{{localize 'MASTER.lightSightCompensationEnabled'}}</label>
      <input
        type='checkbox'
        class='changeSetting'
        id='set_lightSightCompensationEnabled'
        name='lightSightCompensationEnabled'
        value='1'
        {{checked sceneConfig.lightSightCompensationEnabled}}
      />
      <p class='hint'>{{localize 'MASTER.lightSightCompensationEnabledTooltip'}}</p>
    </div>
    <fieldset>
      <legend>{{localize 'MASTER.threshold'}} <a class='icon fas fa-undo' data-action='resetSightThresholds' data-tooltip='MERCHANT.clearInventory'></a></legend>

      {{#each sceneConfig.visions as |item i|}}
        <div class='form-group'>
          <label>{{item.label}}</label>
          <div class='form-fields'>
            <range-picker class="changeSightTreshold" name="changeSightTreshold_{{i}}" value='{{item.value}}' data-index='{{i}}' min="0" max="1.05" step="0.05"></range-picker>
          </div>
        </div>
      {{/each}}
      
      <p class='hint'>{{localize 'MASTER.sightautomationTooltip'}}</p>
    </fieldset>
    
    {{{lightButton}}}
  </fieldset>
  <fieldset>
    <legend>{{localize 'MASTER.automation'}}</legend>

    <div class='form-group'>
      <label>{{localize 'DSASETTINGS.enableDPS'}}</label>
      <div class='form-fields'>
        <input type='checkbox' class='changeSetting' name='enableDPS' value='1' {{checked sceneConfig.enableDPS}} />
      </div>
      <p class='hint'>{{localize 'DSASETTINGS.enableDPSHint'}}</p>
    </div>
    <div class='form-group'>
      <label>{{localize 'DSASETTINGS.attackFromBehindAngle'}}</label>
      <div class='form-fields'>
        <range-picker name="attackFromBehindAngle" value='{{sceneConfig.attackFromBehindAngle}}' min="0" max="360" step="5"></range-picker>
      </div>
      <p class='hint'>{{localize 'DSASETTINGS.attackFromBehindAngleHint'}}</p>
    </div>

  </fieldset>

</div>