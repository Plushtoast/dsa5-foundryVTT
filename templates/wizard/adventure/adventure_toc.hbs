<div class="sheet journal-entry flexcol book-toc" style="min-width:unset">
    <div style="flex:none">
        {{#if book.id}}
        <h2 class="center" style="margin-top:0px;">
            <a data-action="loadBook">{{book.id}}</a>
        </h2>
        <div class="flexrow dsamx-2 gap5px dsamb-4">
            <i class="fas fa-search flex0"></i>
            
            <input type="search" class="filterJournals" placeholder="{{localize 'Book.search'}}" value="{{searchString}}"/>
            <button type="button" data-action="fulltextsearch" class="icon noBorder dsadesignbutton {{#if (eq fulltextsearch 'on')}}on active{{/if}}" data-tooltip="{{localize 'Book.fulltextsearch'}}" aria-pressed="{{#if (eq fulltextsearch 'on')}}true{{else}}false{{/if}}" aria-label="{{localize 'Book.fulltextsearch'}}">
                <i class="fas {{#if (eq fulltextsearch 'on')}}fa-toggle-on{{else}}fa-toggle-off{{/if}}"></i>
            </button>
        </div>
        {{/if}}
    </div>
    <div class="toc">
        <div class="scrollableoff">

            <div class="tocContent">

                {{#each chapters as |category i|}}
                <b>{{category.name}}</b>
                <ul class="tocList" data-type="{{category.name}}">
                    {{#each category.content as |item i|}}
                    <li class="page flexcol {{ifThen item.selected 'active' ''}}">
                        <button type="button" data-id="{{item.id}}" data-action="getChapter" class="{{item.cssClass}} getChapter">{{item.name}}</button>
                        {{#if item.subChapters}}
                        <ul>
                            {{#each item.subChapters as |item i|}}
                            <li class="page flexcol">
                                <button type="button" data-jid="{{item.id}}" data-action="subChapter" class="subChapter {{item.cssClass}}"><i class="fas fa-caret-right"></i> {{item.name}}</button>
                                
                                {{#if item.selected}}
                                {{{../../../pageTocs}}}
                                {{/if}}
                            </li>
                            {{/each}}
                        </ul>
                        {{/if}}
                    </li>
                    {{/each}}
                </ul>
                {{/each}}
            </div>
        </div>
    </div>
    
</div>