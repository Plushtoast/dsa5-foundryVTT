<section class='content adventureWizard'>
  <div class='row-section columnFlex' style='max-height:100%;height:calc(100% - 10px);'>
    {{{breadcrumbs}}}
    <div class='tocCollapserBox'>
      <a data-action='tocCollapser' class='tocCollapser'><i class='fas fa-chevron-left'></i></a>
    </div>
    <div class='row-section tocCollapsing position-relative' style='min-height: 100%;'>
      <div class='col three flexcol' style="max-width:30%">
        <div class='col tocList scrollable flex1'>
          {{{toc}}}
        </div>
        <footer class='action-buttons flexrow flexAlignCenter'>
          <button class='button_30px' data-action='movePage' type='button' data-direction='previous' data-tooltip='Previous Page'>
            <i class='fa-solid fa-chevron-left'></i>
          </button>
          <button class='button_30px' data-action='movePage' type='button' data-direction='next' data-tooltip='Next Page'>
            <i class='fa-solid fa-chevron-right'></i>
          </button>
        </footer>
      </div>

      <div class='col seventy chapter scrollable' style='font-size: {{fontSize}}px;'>
        {{{currentChapter}}}
      </div>
    </div>
  </div>
</section>