<li class="book-entry" data-book-id="{{item.id}}" data-book-type="{{section.type}}">
    <div class="row-section book-entry-row">
        <div class="col {{#if (and section.allowRemove isGM)}}eighty{{else}}ninety{{/if}}">
            <button type="button" class="noBorder dsadesignbutton book-list-link" data-action="loadBook" data-type="{{section.type}}">{{item.displayName}}</button>
        </div>
        <div class="col ten">
            {{#if isGM}}<button type="button" class="icon noBorder dsadesignbutton" data-tooltip="Book.playerVisibility" data-action="toggleVisibility" data-type="{{section.type}}" data-itemid="{{item.id}}"><i class="fas {{#if item.visible}}fa-toggle-on{{else}}fa-toggle-off{{/if}}"></i></button>{{/if}}
        </div>
        {{#if (and section.allowRemove isGM)}}
        <div class="col ten">
            <button type="button" class="icon noBorder dsadesignbutton fa-solid fa-trash" data-tooltip="{{localize 'Book.removeCustomBook'}}" data-action="removeCustomBook" data-itemid="{{item.id}}" aria-label="{{localize 'Book.removeCustomBook'}}"></button>
        </div>
        {{/if}}
    </div>
</li>
