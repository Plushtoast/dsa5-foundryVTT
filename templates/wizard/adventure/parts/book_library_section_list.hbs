<section class="book-section">
    {{#if section.labelKey}}
        {{#if (or section.allowAdd section.allowHide)}}
        <div class="book-section-header">
            <h2>{{localize section.labelKey}}</h2>
            {{#if (and section.allowAdd isGM)}}<button type="button" class="book-section-header__action dsadesignbutton icon noBorder fa-solid fa-plus" data-action="addCustomBook" data-tooltip="{{localize 'Book.addCustomBook'}}" aria-label="{{localize 'Book.addCustomBook'}}"></button>{{/if}}
            {{#if (and section.allowHide isGM)}}<button type="button" class="book-section-header__action dsadesignbutton icon noBorder fa-solid fa-eye-slash" data-action="hideFreeModules" data-tooltip="{{localize 'Book.hideFreeModules'}}" aria-label="{{localize 'Book.hideFreeModules'}}"></button>{{/if}}
        </div>
        {{else}}
        <h2>{{localize section.labelKey}}</h2>
        {{/if}}
    {{/if}}
    <ul class="book-list">
        {{#if section.hasBooks}}
            {{#each section.books as |item|}}
            {{> systems/dsa5/templates/wizard/adventure/parts/book_library_entry_list.hbs section=../section item=item isGM=../isGM}}
            {{/each}}
        {{else if section.showEmpty}}
        <li>{{localize 'Book.nothing'}}</li>
        {{/if}}
    </ul>
</section>
