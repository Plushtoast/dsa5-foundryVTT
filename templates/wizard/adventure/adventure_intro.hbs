<div class="book-library view-{{libraryViewMode}}">
    <h1>{{localize 'Book.Wizard'}}</h1>
    <p>{{localize 'Book.Description'}}</p>
    <p class="book-search-empty" hidden>{{localize 'Book.searchEmpty'}}</p>

    <div class="book-library-list">
        {{#each bookSections as |section|}}
        {{#if section.show}}
        {{> systems/dsa5/templates/wizard/adventure/parts/book_library_section_list.hbs section=section isGM=../isGM}}
        {{/if}}
        {{/each}}
    </div>

    <div class="book-library-cards patchviewer">
        {{#each bookSections as |section|}}
        {{#if section.show}}
        {{> systems/dsa5/templates/wizard/adventure/parts/book_library_section_cards.hbs section=section isGM=../isGM}}
        {{/if}}
        {{/each}}
    </div>
</div>
