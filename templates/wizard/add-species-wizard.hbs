<div class="scrollable dsa-card-page">
    <section class="dsa-card-panel dsap-4" data-cost="{{baseCost}}">
        <div class="dsa-card-panel__body">
            <div class="dsa-card-content">
                <p>{{{description}}}</p>
            </div>

            {{> systems/dsa5/templates/system/dsatabs.hbs}}

            <div class="tab {{tabs.description.cssClass}}" data-tab="description" data-group="{{tabs.description.group}}">
                {{> systems/dsa5/templates/items/browse/species.hbs document=species hasLocalization=hasLocalization}}
            </div>

            {{#if vantagesToChose}}
            <div class="tab {{tabs.vantagesToChose.cssClass}}" data-tab="vantagesToChose" data-group="{{tabs.vantagesToChose.group}}">

                <p>{{localize 'WIZARD.vantageDescriptionSpecies'}}</p>
                {{#if missingVantagesToChose}}
                <h2>{{localize 'WIZARD.missingVantages'}}</h2>
                <div class="row-section wrap">
                    {{#each missingVantages as |item i|}}
                    <div class="col two flexrow">
                        <input type="checkbox" id="missingvantage_{{i}}" class="flex0 optional" data-cost="{{item.apCost}}" name="{{item.replaceName}}" data-step="{{item.step}}" value="{{item.uuid}}" disabled checked>
                        <label for="missingvantage_{{i}}">{{item.replaceName}} {{roman item.step (or item.system.max.value item.system.maxRank.value)}} ({{item.apCost}} AP)</label>
                        <button type="button" class="icon fas fa-info noBorder dsadesignbutton show-item" data-uuid="{{item.uuid}}" data-tooltip="{{item.tooltip}}"></button>
                    </div>
                    {{/each}}
                </div>
                {{/if}} {{#if advantagesToChose}}
                <h2>{{localize 'recommendedAdvantages'}}</h2>
                {{#each advantagegroups as |group j|}}
                {{#if group.name}}<h3>{{group.name}}</h3>{{/if}}
                <div class="row-section wrap">
                    {{#each group.res as |item i|}}
                    <div class="col two flexrow">
                        <input type="checkbox" id="advantage_{{i}}_{{j}}" class="flex0 optional" data-cost="{{item.apCost}}" name="{{item.replaceName}}" data-step="{{item.step}}" value="{{item.uuid}}" {{#if item.disabled}}disabled{{/if}}>
                        <label for="advantage_{{i}}_{{j}}">{{item.replaceName}} {{roman item.step item.system.max.value}} ({{item.apCost}} AP)</label>
                        <button type="button" class="icon fas fa-info noBorder dsadesignbutton show-item" data-uuid="{{item.uuid}}" data-tooltip="{{item.tooltip}}"></button>
                    </div>
                    {{/each}}
                </div>
                {{/each }} {{/if}} {{#if disadvantagesToChose}}
                <h2>{{localize 'recommendedDisadvantages'}}</h2>
                {{#each disadvantagegroups as |group j|}}
                {{#if group.name}}<h3>{{group.name}}</h3>{{/if}}
                <div class="row-section wrap">
                    {{#each group.res as |item i|}}
                    <div class="col two flexrow">
                        <input type="checkbox" id="disadvantage_{{i}}_{{j}}" class="flex0 optional" data-cost="{{item.apCost}}" name="{{item.replaceName}}" data-step="{{item.step}}" value="{{item.uuid}}" {{#if item.disabled}}disabled{{/if}}>
                        <label for="disadvantage_{{i}}_{{j}}">{{item.replaceName}} {{roman item.step item.system.max.value}} ({{item.apCost}} AP)</label>
                        <button type="button" class="icon fas fa-info noBorder dsadesignbutton show-item" data-uuid="{{item.uuid}}" data-tooltip="{{item.tooltip}}"></button>
                    </div>
                    {{/each}}
                </div>
                {{/each}} {{/if}}
            </div>
            {{/if}} {{#if generalToChose}}
            <div class="tab {{tabs.generalToChose.cssClass}}" data-tab="generalToChose" data-group="{{tabs.generalToChose.group}}">
                {{#if anyAttributeRequirements}}
                <h2>{{localize 'WIZARD.attributesToChose'}}</h2>
                <p>{{localize 'WIZARD.attributesToChoseHint'}}</p>
                {{#each attributeRequirements as |item i|}}
                    <p class="allowedCount_{{i}}" data-count="{{item.allowedCount}}">{{localize 'WIZARD.chose'}} {{item.allowedCount}}.</p>
                    <div class="row-section wrap">
                        {{#each item.choices as |choice j|}}
                        <div class="col two flexrow">
                            <input type="checkbox" id="exclusive_{{i}}_{{j}}" class="flex0 exclusive exclusive_{{i}}" data-sel="{{i}}" name="{{choice.name}}" value="{{choice.name}}"/>
                            <label for="exclusive_{{i}}_{{j}}">{{choice.label}}</label>
                        </div>
                        {{/each}}
                    </div>
                    <hr /> 
                {{/each}} 
                {{/if}}

                {{#if generatorsToChose}}
                <h2>{{localize 'personalDetails'}}</h2>
                {{#each generatorFields as |generatorField|}}
                <div class="groupbox species-generator-field" data-field="{{generatorField.field}}">
                    <legend class="table-title lineheight">{{generatorField.label}}</legend>
                    <div class="row-section wrap">
                        {{#each generatorField.entries as |entry|}}
                        <div class="col">
                            <div class="row-section">
                               
                                <div class="col ten">
                                    {{#if ../hasMultipleEntries}}
                                    <input
                                        type="radio"
                                        class="species-generator-choice"
                                        name="selectedGenerator.{{../field}}"
                                        value="{{entry.id}}"
                                        data-field="{{../field}}"
                                        {{#if entry.selected}}checked{{/if}}
                                    />
                                    {{/if}}
                                </div>
                                <div class="col sixty">
                                    <b>{{entry.name}}</b>
                                    {{#if entry.outcomeDisplay}}
                                    <div><small>{{entry.outcomeDisplay}}</small></div>
                                    {{/if}}
                                    {{#unless entry.rollable}}
                                    <div><small>{{entry.error}}</small></div>
                                    {{/unless}}
                                </div>
                                <div class="col third">
                                    <div class="form-fields">
                                        <input
                                            type="text"
                                            class="species-generator-result"
                                            data-field="{{../field}}"
                                            data-entry="{{entry.id}}"
                                            value="{{entry.resultDisplay}}"
                                            placeholder="-"
                                            readonly
                                        />
                                    </div>
                                </div>
                                
                                <div class="col ten">
                                    {{#if entry.rollable}}
                                    <button
                                        type="button"
                                        class="icon fas fa-dice-d20 noBorder dsadesignbutton species-generator-roll"
                                        data-field="{{../field}}"
                                        data-entry="{{entry.id}}"
                                    ></button>
                                    {{/if}}
                                </div>
                            </div>
                        </div>
                        {{/each}}
                    </div>
                </div>
                {{/each}}
                {{/if}}
            </div>
            {{/if}}
        </div>
    </section>
    <section class="dsa-card-panel dsap-3">
        <div class="dsa-card-panel__actions dsa-card-panel__actions--end dialog-buttons">
            <button class="dialog-button ok default" data-button="ok">
                <i class="fas fa-check"></i> {{localize 'ok'}}
            </button>
            <button class="dialog-button default" data-action="close">
                <i class="fas fa-close"></i> {{localize 'cancel'}}
            </button>
        </div>
    </section>
</div>