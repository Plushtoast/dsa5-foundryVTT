<div class="scrollable">
    <section class="content" data-cost="{{baseCost}}">
        <p style="margin-bottom:10px;">{{{description}}}</p>

        {{> systems/dsa5/templates/system/dsatabs.hbs}}

        <div class="tab {{tabs.description.cssClass}}" data-tab="description" data-group="{{tabs.description.group}}">
            {{> systems/dsa5/templates/items/browse/career.hbs document=career}}
        </div>

        {{#if vantagesToChose}}
        <div class="tab {{tabs.vantagesToChose.cssClass}}" data-tab="vantagesToChose" data-group="{{tabs.vantagesToChose.group}}">
            <p>{{localize 'WIZARD.vantageDescription'}}</p>
            {{#if missingVantagesToChose}}
            <h2>{{localize 'WIZARD.missingVantages'}}</h2>
            <div class="row-section wrap">
                {{#each missingVantages as |item i|}}
                <div class="col two flexrow">
                    <input type="checkbox" id="missingvantage_{{i}}" class="optional" data-cost="{{item.apCost}}" name="{{item.replaceName}}" data-step="{{item.step}}" value="{{item.uuid}}" disabled checked>
                    <label for="missingvantage_{{i}}">{{item.replaceName}} {{roman item.step}} ({{item.apCost}} AP)</label>
                    <button type="button" class="icon fas fa-info show-item" data-uuid="{{item.uuid}}" data-tooltip="{{item.tooltip}}"></button>
                </div>
                {{/each}}
            </div>
            {{/if}} 
            {{#if advantagesToChose}}
            <h2>{{localize 'recommendedAdvantages'}}</h2>
            <div class="row-section wrap">
                {{#each advantages as |item i|}}
                <div class="col two flexrow">
                    <input type="checkbox" id="advantage_{{i}}" class="flex0 optional" data-cost="{{item.apCost}}" name="{{item.replaceName}}" data-step="{{item.step}}" value="{{item.uuid}}" {{#if item.disabled}}disabled{{/if}}>
                    <label for="advantage_{{i}}">{{item.replaceName}} {{roman item.step}} ({{item.apCost}} AP)</label>
                    <button type="button" class="icon fas fa-info show-item" data-uuid="{{item.uuid}}" data-tooltip="{{item.tooltip}}"></button>
                </div>
                {{/each}}
            </div>
            {{/if}} 
            {{#if disadvantagesToChose}}
            <h2>{{localize 'recommendedDisadvantages'}}</h2>
            <div class="row-section wrap">
                {{#each disadvantages as |item i|}}
                <div class="col two flexrow">
                    <input type="checkbox" id="disadvantage_{{i}}" class="flex0 optional" data-cost="{{item.apCost}}" name="{{item.replaceName}}" data-step="{{item.step}}" value="{{item.uuid}}" {{#if item.disabled}}disabled{{/if}}>
                    <label for="disadvantage_{{i}}">{{item.replaceName}} {{roman item.step}} ({{item.apCost}} AP)</label>
                    <button type="button" class="icon fas fa-info show-item" data-uuid="{{item.uuid}}" data-tooltip="{{item.tooltip}}"></button>
                </div>
                {{/each}}
            </div>
            {{/if}}
        </div>
        {{/if}} 
        {{#if generalToChose}}
        <div class="tab {{tabs.generalToChose.cssClass}}" data-tab="generalToChose" data-group="{{tabs.generalToChose.group}}">
            {{#if anyAttributeRequirements}}
            <h2>{{localize 'WIZARD.attributeRequirements'}}</h2>
            <div class="row-section wrap">
                {{#each attributeRequirements as |item i|}}
                <div class="col two flexrow">
                    <input type="checkbox" id="attribute_{{item.name}}" data-cost="{{item.system.APValue.value}}" class="flex0 attributes" name="attribute_{{item.name}}" data-attribute="{{item.name}}" value="{{item.step}}" checked disabled>
                    <label for="attribute_{{item.name}}">{{item.name}} {{item.step}} ({{item.system.APValue.value}} AP)</label>
                </div>
                {{/each}}
            </div>
            {{/if}} 
            {{#if missingSpecialabiltiesToChose}}
            <h2>{{localize 'WIZARD.missingSpecialAbilities'}}</h2>
            <div class="row-section wrap">
                {{#each missingSpecialabilities as |item i|}}
                <div class="col two flexrow">
                    <input type="checkbox" id="missinspecialability_{{i}}" class="flex0 optional" data-cost="{{item.apCost}}" name="{{item.replaceName}}" data-step="{{item.step}}" value="{{item.uuid}}" disabled checked>
                    <label for="missinspecialability_{{i}}">{{item.replaceName}} {{roman item.step}} ({{item.apCost}} AP)</label>
                    <button type="button" class="icon fas fa-info show-item" data-uuid="{{item.uuid}}" data-tooltip="{{item.tooltip}}"></button>
                </div>
                {{/each}}
            </div>
            {{/if}}

            {{#if specAbChoices}} 
            <h2>{{localize 'TYPES.Item.specialability'}}</h2>
            {{#each specAbChoices as |item i|}}
            <p class="allowedCount_{{i}}" data-count="{{item.allowedCount}}">{{localize 'WIZARD.chose'}} {{item.allowedCount}}. </p>
            <div class="row-section wrap">
                {{#each item.choices as |choice j|}}
                <div class="col two flexrow">
                    <input type="checkbox" id="specialability_{{i}}_{{j}}" class="flex0 specialability exclusive exclusive_{{i}}" data-sel="{{i}}" name="specialability_{{i}}_{{j}}" value="{{choice}}">
                    <label for="specialability_{{i}}_{{j}}">{{choice}}</label>
                </div>
                {{/each}}
            </div>
            {{/each}}
            {{/if}}
        </div>
        {{/if}} 
        {{#if combatToChose}}
        <div class="tab {{tabs.combatToChose.cssClass}}" data-tab="combatToChose" data-group="{{tabs.combatToChose.group}}">
            <h2>{{localize 'TYPES.Item.combatskill'}}</h2>
            {{#each combatskillchoices as |item i|}}
            <p class="allowedCount_{{i}}" data-count="{{item.allowedCount}}">{{localize 'WIZARD.chose'}} {{item.allowedCount}}. </p>
            <div class="row-section wrap">
                {{#each item.choices as |choice j|}}
                <div class="col two flexrow">
                    <input type="checkbox" id="combatskill_{{i}}_{{j}}" class="flex0 combatskill exclusive exclusive_{{i}}" data-sel="{{i}}" name="combatskill_{{i}}_{{j}}" value="{{choice}}">
                    <label for="combatskill_{{i}}_{{j}}">{{choice}}</label>
                </div>
                {{/each}}
            </div>
            <hr /> 
            {{/each}}
        </div>
        {{/if}} 
        {{#if magicToChose}}
        <div class="tab {{tabs.magicToChose.cssClass}}" data-tab="magicToChose" data-group="{{tabs.magicToChose.group}}">
            <h2>{{localize 'magictricks'}}</h2>
            <p class="maxTricks" data-spelltricklimit="{{career.system.spelltrickCount.value}}">{{localize 'WIZARD.chose'}} {{career.system.spelltrickCount.value}}.</p>
            <div class="row-section wrap">
                {{#each spelltricks as |item i|}}
                <div class="col two flexrow">
                    <input type="checkbox" id="spelltrick_{{i}}" class="flex0 optional exclusiveTricks" data-cost="0" name="{{item.replaceName}}" data-step="{{item.step}}" value="{{item.uuid}}" {{#if item.disabled}}disabled{{/if}}>
                    <label for="spelltrick_{{i}}">{{item.replaceName}}</label>
                    <button type="button" class="icon fas fa-info show-item" data-uuid="{{item.uuid}}" data-tooltip="{{item.tooltip}}"></button>
                </div>
                {{/each}}
            </div>
            {{#if spellChoices}} 
            <h2>{{localize 'TYPES.Item.spell'}}</h2>
            {{#each spellChoices as |item i|}}
            <p class="allowedCount_{{i}}" data-count="{{item.allowedCount}}">{{localize 'WIZARD.chose'}} {{item.allowedCount}}. </p>
            <div class="row-section wrap">
                {{#each item.choices as |choice j|}}
                <div class="col two flexrow">
                    <input type="checkbox" id="spell_{{i}}_{{j}}" class="flex0 spell exclusive exclusive_{{i}}" data-sel="{{i}}" name="spell_{{i}}_{{j}}" value="{{choice}}">
                    <label for="spell_{{i}}_{{j}}">{{choice}}</label>
                </div>
                {{/each}}
            </div>
            {{/each}}
            {{/if}}
            
        </div>
        {{/if}} 
        {{#if religionToChose}}
        <div class="tab {{tabs.religionToChose.cssClass}}" data-tab="religionToChose" data-group="{{tabs.religionToChose.group}}">
            {{#if liturgyChoices}} 
            <h2>{{localize 'TYPES.Item.spell'}}</h2>
            {{#each liturgyChoices as |item i|}}
            <p class="allowedCount_{{i}}" data-count="{{item.allowedCount}}">{{localize 'WIZARD.chose'}} {{item.allowedCount}}. </p>
            <div class="row-section wrap">
                {{#each item.choices as |choice j|}}
                <div class="col two flexrow">
                    <input type="checkbox" id="liturgy_{{i}}_{{j}}" class="flex0 liturgy exclusive exclusive_{{i}}" data-sel="{{i}}" name="liturgy_{{i}}_{{j}}" value="{{choice}}">
                    <label for="liturgy_{{i}}_{{j}}">{{choice}}</label>
                </div>
                {{/each}}
            </div>
            {{/each}}
            {{/if}}
        </div>
        {{/if}}
    </section>
    <div class="dialog-buttons flexrow">
        <button class="dialog-button ok default" data-button="ok">
            <i class="fas fa-check"></i> {{localize 'ok'}}
        </button>
        <button class="dialog-button cancel default" data-button="cancel">
            <i class="fas fa-close"></i> {{localize 'cancel'}}
        </button>
    </div>
</div>