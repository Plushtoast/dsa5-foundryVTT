<article
  class="dsa-icon-card breedcard open{{name}} position-relative"
  tabindex="0"
  role="button"
  aria-label="{{localize title}}. {{localize desc}}"
  data-tooltip="{{localize desc}}"
>
  <div class="dsa-icon-card__media">
    <img src="{{icon}}" alt="" loading="lazy" />
  </div>
  <div class="dsa-icon-card__body">
    <h3 class="dsa-icon-card__title">{{localize title}}</h3>
    <span class="dsa-icon-card__hint"><i class="fas fa-wand-magic-sparkles"></i> {{localize 'MASTER.randomGenOpen'}}</span>
  </div>
</article>
