{{#if showWizardToggle}}
<nav class="flexrow flexAlignEnd">
    <button type="button" class="icon fas fa-wand-magic-sparkles noBorder dsadesignbutton" data-action="toggleWizardMode" data-tooltip="ActiveEffects.wizardSimpleMode"></button>
</nav>
{{/if}}
<header class="row-section">
    <div class="col third">{{localize "EFFECT.FIELDS.changes.element.key.label"}}</div>
    <div class="col fifteen center">{{localize "EFFECT.FIELDS.changes.element.type.label"}}</div>
    <div class="col third center">{{localize "EFFECT.FIELDS.changes.element.value.label"}}</div>
    <div class="col ten center">{{localize "EFFECT.FIELDS.changes.element.phase.label"}}</div>
    <div class="col ten center">{{localize "EFFECT.FIELDS.changes.element.priority.label"}}</div>
    <div class="col zerofive flexrow center">
        <button type="button" class="icon fa-regular fa-square-plus noBorder dsadesignbutton" data-action="{{#if addAction}}{{addAction}}{{else}}addChange{{/if}}"></button>
    </div>
</header>

<ul class="ol" data-changes>
    {{#each changes as |change i|}}
    <li class="row-section" data-index="{{i}}">
        <div class="col third key">
            {{formInput ../changeFields.key name=(concat ../changePath "." i ".key") value=change.key}}
        </div>
        <div class="col fifteen center type">
            {{formInput ../changeFields.type name=(concat ../changePath "." i ".type") value=change.type choices=../changeTypes}}
        </div>
        <div class="col third center value">
            {{formInput ../changeFields.value name=(concat ../changePath "." i ".value") value=change.value elementType="input"}}
        </div>
        <div class="col ten center phase">
            {{formInput ../changeFields.phase name=(concat ../changePath "." i ".phase") value=change.phase choices=../changePhases}}
        </div>
        <div class="col ten center priority">
            {{formInput ../changeFields.priority name=(concat ../changePath "." i ".priority") value=change.priority placeholder=(lookup ../changePriorities change.type)}}
        </div>
        <div class="col zerofive flexrow center controls">
            <button type="button" class="icon fas fa-trash noBorder dsadesignbutton" data-action="{{#if deleteAction}}{{deleteAction}}{{else}}deleteChange{{/if}}"></button>
        </div>
    </li>
    {{/each}}
</ul>
