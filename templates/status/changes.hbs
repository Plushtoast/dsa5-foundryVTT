<section class="tab scrollable changes{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
    {{#if wizardMode}}
    <nav class="wizardCategoryBar flexrow wrap">
        <div class="split-button flexrow wrap">
            <button type="button" class="ui-control icon fa-solid fa-border-all" data-action="filterWizardCategory" {{{ifThen (not wizardCategory) 'aria-pressed="true"' ''}}} data-category="" data-tooltip="ActiveEffects.wizardAllCategories"></button>
            {{#each wizardCategories}}
            <button type="button" class="ui-control icon {{this.icon}}" data-action="filterWizardCategory" {{{ifThen (eq this.key @root.wizardCategory) 'aria-pressed="true"' ''}}} data-category="{{this.key}}" data-tooltip="{{this.label}}"></button>
            {{/each}}
        </div>
        <button type="button" class="icon fas fa-code noBorder dsadesignbutton" data-action="toggleWizardMode" data-tooltip="ActiveEffects.wizardExpertMode"></button>
    </nav>
    <header class="row-section">
        <div class="col sixty">{{localize "ActiveEffects.wizardEffect"}}</div>
        <div class="col thirtyfive center">{{localize "EFFECT.FIELDS.changes.element.value.label"}}</div>
        <div class="col zerofive flexrow center">
            <button type="button" class="icon fa-regular fa-square-plus noBorder dsadesignbutton" data-action="addChange"></button>
        </div>
    </header>
    
    <ul class="ol" data-changes>
        {{#each source.system.changes as |change i|}}
        {{#with @root.changeFields as |changeFields|}}
        <li class="row-section" data-index="{{i}}">
            <div class="col sixty key wizardKey">
                <input type="hidden" name="system.changes.{{i}}.key" value="{{change.key}}">
            </div>
            <div class="col thirtyfive center value">
                {{formInput changeFields.value name=(concat "system.changes." i ".value") value=change.value elementType="input"}}
            </div>
            <div class="col zerofive flexrow center controls">
                <input type="hidden" name="system.changes.{{i}}.type" value="{{change.type}}">
                <input type="hidden" name="system.changes.{{i}}.phase" value="{{change.phase}}">
                <input type="hidden" name="system.changes.{{i}}.priority" value="{{change.priority}}">
                <button type="button" class="icon fas fa-trash noBorder dsadesignbutton" data-action="deleteChange"></button>
            </div>
        </li>
        {{/with}}
        {{/each}}
    </ul>
    {{else}}
    {{> systems/dsa5/templates/status/parts/change-list-advanced.hbs changes=source.system.changes changePath="system.changes" showWizardToggle=true}}
    {{/if}}
</section>
