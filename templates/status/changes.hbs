<section class="tab scrollable changes{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
    {{#if wizardMode}}
    <nav class="wizardCategoryBar flexrow wrap split-button">
        <button type="button" class="ui-control icon fa-solid fa-border-all" data-action="filterWizardCategory" {{{ifThen (not wizardCategory) 'aria-pressed="true"' ''}}} data-category="" data-tooltip="ActiveEffects.wizardAllCategories"></button>
        {{#each wizardCategories}}
        <button type="button" class="ui-control icon {{this.icon}}" data-action="filterWizardCategory" {{{ifThen (eq this.key @root.wizardCategory) 'aria-pressed="true"' ''}}} data-category="{{this.key}}" data-tooltip="{{this.label}}"></button>
        {{/each}}
    </nav>
    {{/if}}
    <header class="row-section">
        {{#if wizardMode}}
        <div class="col seventy">{{localize "ActiveEffects.wizardEffect"}}</div>
        <div class="col third center">{{localize "EFFECT.FIELDS.changes.element.value.label"}}</div>
        {{else}}
        <div class="col fourty">{{localize "EFFECT.FIELDS.changes.element.key.label"}}</div>
        <div class="col five center">{{localize "EFFECT.FIELDS.changes.element.type.label"}}</div>
        <div class="col third center">{{localize "EFFECT.FIELDS.changes.element.value.label"}}</div>
        <div class="col ten center">{{localize "EFFECT.FIELDS.changes.element.phase.label"}}</div>
        <div class="col ten center">{{localize "EFFECT.FIELDS.changes.element.priority.label"}}</div>
        {{/if}}
        <div class="col ten center">
            <a data-action="toggleWizardMode" data-tooltip="{{#if wizardMode}}ActiveEffects.wizardExpertMode{{else}}ActiveEffects.wizardSimpleMode{{/if}}">
                <i class="fa-solid {{#if wizardMode}}fa-code{{else}}fa-wand-magic-sparkles{{/if}}"></i>
            </a>
            <a data-action="addChange"><i class="fa-regular fa-square-plus"></i></a>
        </div>
    </header>
    
    <ul class="ol" data-changes>
        {{#each source.system.changes as |change i|}}
        {{#with @root.changeFields as |changeFields|}}
        <li class="row-section" data-index="{{i}}">
            {{#if @root.wizardMode}}
            <div class="col seventy key wizardKey">
                <input type="hidden" name="system.changes.{{i}}.key" value="{{change.key}}">
            </div>
            <div class="col third center value">
                {{formInput changeFields.value name=(concat "system.changes." i ".value") value=change.value classes="inlineCodeMirror"}}
            </div>
            <div class="col ten flexrow center controls">
                <input type="hidden" name="system.changes.{{i}}.type" value="{{change.type}}">
                <input type="hidden" name="system.changes.{{i}}.phase" value="{{change.phase}}">
                <input type="hidden" name="system.changes.{{i}}.priority" value="{{change.priority}}">
                <a data-action="deleteChange"><i class="fa-solid fa-trash"></i></a>
            </div>
            {{else}}
            <div class="col fourty key">
                {{formInput changeFields.key name=(concat "system.changes." i ".key") value=change.key}}
            </div>
            <div class="col five center type">
                {{formInput changeFields.type name=(concat "system.changes." i ".type") value=change.type choices=@root.changeTypes}}
            </div>
            <div class="col third center value">
                {{formInput changeFields.value name=(concat "system.changes." i ".value") value=change.value classes="inlineCodeMirror"}}
            </div>
            <div class="col ten center phase">
                {{formInput changeFields.phase name=(concat "system.changes." i ".phase") value=change.phase choices=@root.changePhases}}
            </div>
            <div class="col ten center priority">
                {{formInput changeFields.priority name=(concat "system.changes." i ".priority") value=change.priority
                    placeholder=(lookup @root.changePriorities change.type)}}
            </div>
            <div class="col ten flexrow center controls"><a data-action="deleteChange"><i class="fa-solid fa-trash"></i></a></div>
            {{/if}}
        </li>
        {{/with}}
        {{/each}}
    </ul>
</section>
