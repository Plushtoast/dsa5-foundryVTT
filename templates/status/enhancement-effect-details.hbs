<section class="tab standard-form scrollable{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
    {{formGroup document.system.schema.fields.targetType value=document.system.targetType
    choices=targetTypes localize=true}}
    {{formGroup document.system.schema.fields.enhancementType value=document.system.enhancementType
    choices=enhancementTypes localize=true}}
    <div class="form-group">
        <label data-tooltip="Enhancement.hints.slotCost">{{localize "Enhancement.slotCost"}}</label>
        <div class="form-fields">
            <input type="number" name="system.slotCost" value="{{source.system.slotCost}}" min="1" step="1" />
            {{#with (lookup @root.slotLimits @root.source.system.enhancementType)}}
            <span class="sep center">/</span>
            <span class="center" data-tooltip="max">{{this}}</span>
            {{/with}}
        </div>
    </div>
    {{#if (eq document.system.enhancementType 'powersource')}}
    {{> systems/dsa5/templates/status/parts/enhancement-effect-powersource-fields.hbs}}
    {{else if (eq document.system.enhancementType 'treatment')}}
    {{> systems/dsa5/templates/status/parts/enhancement-effect-treatment-fields.hbs}}
    {{else}}
    {{> systems/dsa5/templates/status/parts/enhancement-effect-crafting-fields.hbs}}
    {{/if}}
    {{formGroup fields.disabled value=source.disabled rootId=rootId}}
</section>
