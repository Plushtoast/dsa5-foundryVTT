<section class="tab scrollable" data-group="sheet" data-tab="advanced" data-application-part="advanced">
    <div class="form-group">
        <label>{{localize 'ActiveEffects.hideOnToken'}}</label>
        <div class="form-fields">
            <input type="checkbox" name="system.visibility.hideOnToken" {{checked document.system.visibility.hideOnToken}} />
        </div>
    </div>
    <div class="form-group">
        <label>{{localize 'ActiveEffects.hidePlayers'}}</label>
        <div class="form-fields">
            <input type="checkbox" name="system.visibility.hidePlayers" {{checked document.system.visibility.hidePlayers}}/>
        </div>        
    </div>
    {{#if effectConfigs.hasSuccessEffects}}
    <div class="form-group">
        <label>{{localize "ActiveEffects.apply"}}</label>
        <div class="form-fields">
            <select name="system.successEffect">
                {{selectOptions applySuccessConditions selected=document.system.successEffect localize=true blank="ActiveEffects.always"}}
            </select>
        </div>
    </div>
    <div class="form-group">
        <label>{{localize 'ActiveEffects.onDelayed'}} ({{localize 'ActiveEffects.dialog.seconds'}})</label>
        <div class="form-fields">
            <input type="text" name="system.macroArgs.onDelayed" value="{{document.system.macroArgs.onDelayed}}" />
        </div>
    </div>
    {{/if}}
    <div class="auraBox paddingBox{{#if document.system.aura.isAura}} groupbox{{/if}}">
        <div class="form-group">
            <label>{{localize 'ActiveEffects.isAura'}}</label>
            
            <div class="form-fields">
                <input type="checkbox" class="auraSelector" name="system.aura.isAura" {{checked document.system.aura.isAura}}/>
            </div>
        </div>
        
        <div class="auraDetails{{#unless document.system.aura.isAura}} dsahidden{{/unless}}">
            <div class="form-group">
                <label>{{localize "ActiveEffects.disposition"}}</label>
                <div class="form-fields">
                    <select name="system.aura.disposition">
                        {{selectOptions dispositions selected=document.system.aura.disposition localize=true}}
                    </select>
                </div>
            </div>
            <div class="form-group">
                <label>{{localize 'ActiveEffects.radius'}}</label>
                <div class="form-fields">
                    <input type="text" name="system.aura.auraRadius" value="{{document.system.aura.auraRadius}}" />
                </div>
            </div>
            <div class="form-group">
                <label>{{ localize "TEMPLATE.FIELDS.BorderColor.label" }}</label>
                <div class="form-fields">
                    <color-picker name="system.aura.borderColor" value="{{document.system.aura.borderColor}}"></color-picker>
                </div>
            </div>
            <div class="form-group">
                <label>{{ localize "TEMPLATE.BorderThickness" }}</label>
                <div class="form-fields">
                    <input type="number" name="system.aura.borderThickness" value="{{document.system.aura.borderThickness}}" />
                </div>
            </div>
        </div>
    </div>
    {{#if isWeapon}}
    <div class="form-group" data-tooltip="ActiveEffects.applyToOwnerHint">
        <label>{{localize 'ActiveEffects.applyToOwner'}}</label>
        <div class="form-fields">
            <input type="checkbox" name="system.applyToOwner" {{checked document.system.applyToOwner}}/>
        </div>
    </div>
    {{/if}}
    {{#if canWeaponAdvantages}}
    <div class="form-group">
        <label>{{localize "DSASETTINGS.enableWeaponAdvantages"}}</label>
        <div class="form-fields">
            <select name="system.equipmentAdvantage">
                {{selectOptions equipmentAdvantageOptions selected=document.system.equipmentAdvantage blank="-"}}
            </select>
        </div>
    </div>
    {{/if}}
    <div class="form-group">
        <label>{{localize "DSASETTINGS.notifyOnFadingEffects"}}</label>
        <div class="form-fields">
            <select class="advancedSelector" name="system.removeMessage">
                {{selectOptions messageReceivers selected=document.system.removeMessage blank="-"}}
            </select>
        </div>        
    </div>
    <div class="form-group">
        <label>{{localize 'Description'}}</label>
        <div class="form-fields">
            <input type="text" name="system.description" value="{{document.system.description}}" />
        </div>
    </div>

    <div class="form-group">
        <label>{{localize 'charges'}}</label>
        <div class="form-fields">
            <input type="number" name="system.charges.value" value="{{document.system.charges.value}}" min="0" step="1" />
            <span class="sep">/</span>
            <input type="number" name="system.charges.max" value="{{document.system.charges.max}}" min="0" step="1" placeholder="{{localize 'max'}}" />
        </div>
    </div>
    {{#if advancedFunctions}}
    <div class="form-group">
        <label>{{localize 'duration'}}</label>
        <div class="form-fields">
            <input type="text" name="system.customDuration" value="{{document.system.customDuration}}" />
        </div>
    </div>
    <div class="form-group">
        <label>{{localize "ActiveEffects.custom"}}</label>
        <div class="form-fields">
            <select class="advancedSelector" name="system.advancedFunction">
                {{selectOptions advancedFunctions selected=document.system.advancedFunction valueAttr="index" labelAttr="name" localize=true}}            
            </select>
        </div>
    </div>
    <div class="form-group">
        <label>{{localize 'ActiveEffects.resistRoll'}}</label>
        <div class="form-fields">
            <input type="text" name="system.resistRoll" value="{{document.system.resistRoll}}" placeholder="{{localize 'LocalizedIDs.perception'}} -2" />
        </div>
    </div>
    <div class="advancedFunctions">
        {{> systems/dsa5/templates/status/advanced_functions.hbs}}
    </div>
    {{/if}}
    <div class="form-group full-height">
        <label>{{localize 'ActiveEffects.advancedFunctions.onRemove'}}</label>
        <div class="form-fields height100">
            {{#if config.canEditMacros}}
                <code-mirror language="javascript" indent="2" name="system.macroArgs.onRemove" data-tooltip="ActiveEffects.placeholder.onRemove">{{~document.system.macroArgs.onRemove~}}</code-mirror>
            {{else}}
                <p class="input-text">{{#if document.system.macroArgs.onRemove}}{{document.system.macroArgs.onRemove}}{{else}} - {{/if}}</p>
            {{/if}}
        </div>        
    </div>
</section>