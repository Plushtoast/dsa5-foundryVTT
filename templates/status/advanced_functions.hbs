{{#if (eq document.system.advancedFunction 1)}}
  <div class='form-group'>
    <label>{{localize 'effect'}}</label>
    <div class='form-fields'>
      <select name='system.macroArgs.args0'>
        {{selectOptions config.systemEffects selected=document.system.macroArgs.args0 valueAttr='id' labelAttr='name'}}
      </select>
    </div>
  </div>
  <div class='form-group'>
    <label>{{localize 'stepValue'}}</label>
    <div class='form-fields'>
      <input type='text' name='system.macroArgs.args1' value='{{document.system.macroArgs.args1}}' />
    </div>
  </div>
{{/if}}
{{#if (hasElem macroIndexes document.system.advancedFunction)}}
  <div class='form-group full-height'>
    <label>{{localize 'ActiveEffects.advancedFunctions.macro'}}</label>
    <div class='form-fields height100'>
      {{#if config.canEditMacros}}
        <code-mirror language="javascript" indent="2" name="system.macroArgs.args3" data-tooltip="ActiveEffects.placeholder.macros">{{~document.system.macroArgs.args3~}}</code-mirror>
      {{else}}
        <p class='input-text'>{{#if document.system.macroArgs.args3}}{{document.system.macroArgs.args3}}{{else}} - {{/if}}</p>
      {{/if}}
    </div>

  </div>
{{/if}}
{{#if (eq document.system.advancedFunction 3)}}
  <div class='form-group'>
    <label>{{localize 'ActiveEffects.creature'}}</label>
    <div class='form-fields'>
      <input type='text' name='system.macroArgs.args4' value='{{document.system.macroArgs.args4}}' />
    </div>

  </div>
{{/if}}
{{#if (eq document.system.advancedFunction 4)}}
