{{#if (eq document.system.advancedFunction 1)}}
  {{formGroup document.system.schema.fields.macroArgs.fields.conditionId value=document.system.macroArgs.conditionId label="effect" localize=true choices=config.systemEffects valueAttr="id" labelAttr="name"}}
  {{formGroup document.system.schema.fields.macroArgs.fields.conditionValue value=document.system.macroArgs.conditionValue label="stepValue" localize=true}}
{{/if}}
{{#if (hasElem macroIndexes document.system.advancedFunction)}}
  <div class='form-group full-height'>
    <label>{{localize 'ActiveEffects.advancedFunctions.macro'}}</label>
    <div class='form-fields height100'>
      {{#if config.canEditMacros}}
        <code-mirror language="javascript" indent="2" name="system.macroArgs.macro" data-tooltip="ActiveEffects.placeholder.macros">{{~document.system.macroArgs.macro~}}</code-mirror>
      {{else}}
        <p class='input-text'>{{#if document.system.macroArgs.macro}}{{document.system.macroArgs.macro}}{{else}} - {{/if}}</p>
      {{/if}}
    </div>
    <p class='hint'>{{localize document.system.schema.fields.macroArgs.fields.macro.hint}}</p>
  </div>
{{/if}}
{{#if (eq document.system.advancedFunction 3)}}
  {{formGroup document.system.schema.fields.macroArgs.fields.creatureLinks value=document.system.macroArgs.creatureLinks label="ActiveEffects.creature" localize=true}}
{{/if}}
