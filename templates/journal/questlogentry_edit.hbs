<div>
  <div class='personae-two-column'>
    <div class='personae-list-column'>
      <div class='personae-list-header'>
        <div class='flexrow'>
          <div class='list-search flex1'>
            <input type='search' class='search-input actorsearch' placeholder='{{localize "Book.search"}}' value='{{search}}' />
            <i class='fas fa-search'></i>
          </div>

          <button type='button' data-action='addEntry' class='fas icon fa-plus'></button>
        </div>
        {{#if isGM}}
          <div class='form-group' data-tooltip='DSAQUESTLOG.showInQuestlogHint'>
            <label>{{localize 'DSAQUESTLOG.showInQuestlog'}}</label>
            <input type='checkbox' class='showInCalendar' {{checked isRegistered}} />
          </div>
        {{/if}}
      </div>

      <div class='personae-list questlog-list eventscontainer scrollable'>
        {{#each sortedEntries as |quest key|}}
          <div class='persona-list-item{{ifThen quest.visible '' ' invisible'}} {{ifThen (eq ../currentKey key) 'selected' ''}}' data-key='{{key}}' data-action='selectEntry'>
            <div class='persona-list-image center flexAlignCenter'>
              <i class='fas {{ifThen quest.pinToTop "fa-star" "fa-scroll"}}'></i>
            </div>
            <div class='persona-list-info'>
              <h5 class='persona-list-name'>{{quest.title}}</h5>
              <div class='persona-list-meta'>
                <span class='persona-type'>{{quest.statusName}}</span>
                {{#if quest.chapter}}
                  <span class='persona-type'>{{quest.chapter}}</span>
                {{/if}}
                {{#if quest.totalObjectives}}
                  <span class='persona-type'>{{quest.progressText}}</span>
                {{/if}}
                {{#unless quest.visible}}
                  <span class='persona-type persona-hidden'><i class='fas fa-eye-slash'></i></span>
                {{/unless}}
              </div>
              {{#if quest.preparedSummary}}
                <div class='questlog-summary small'>{{quest.preparedSummary}}</div>
              {{/if}}
            </div>
          </div>
        {{/each}}
      </div>
    </div>

    <div class='personae-details-column'>
      <div class='persona-details-container scrollable'>
        {{#if detailHTML}}
          {{{detailHTML}}}
        {{else}}
          <div class='no-selection'>
            <div class='no-selection-content'>
              <i class='fas fa-scroll'></i>
              <h3>{{localize 'DSAQUESTLOG.SelectQuest'}}</h3>
              <p>{{localize 'DSAQUESTLOG.SelectQuestHint'}}</p>
            </div>
          </div>
        {{/if}}
      </div>
    </div>
  </div>
</div>