<div class="scrollable dark-theme persona-container">
    <div class="personae-two-column">
        <div class="personae-list-column">
            <div class="personae-list-header">
                {{> "systems/dsa5/templates/journal/parts/list-toolbar.hbs"}}
                {{#if isGM}}
                <div class="form-group" data-tooltip="dsacalendar.showInCalendarHint">
                    <label>{{localize "dsacalendar.showInCalendar"}}</label>
                    <input type="checkbox" class="showInCalendar" {{checked isRegistered}} />
                </div>
                {{/if}}
            </div>

            <div class="personae-list eventscontainer scrollable">
                {{#each entryGroups}}
                {{#> "systems/dsa5/templates/journal/parts/list-group.hbs"}}
                {{#each entries as |calendarEntry|}}
                <div class="persona-list-item event-card {{ifThen (eq @root.currentKey calendarEntry.key) 'selected' ''}}" data-key="{{calendarEntry.key}}" data-category="{{calendarEntry.category}}" data-search-text="{{calendarEntry.title}} {{calendarEntry.location}} {{calendarEntry.content}}" data-action='selectEntry'>
                    <div class="event-card__date" aria-hidden="true" style="--gradient-color:{{calendarEntry.color}}" data-tooltip="{{calendarEntry.categoryName}}">
                        <div class="month">{{calendarEntry.monthShort}}</div>
                        <div class="day">{{calendarEntry.from.dayOfMonth}}</div>
                        <div class="weekday" data-tooltip="{{calendarEntry.weekDayLong}}">{{calendarEntry.weekdayShort}}</div>
                    </div>
                    <div class="persona-list-info">
                        <h5 class="persona-list-name">{{calendarEntry.title}}</h5>
                        <div class="persona-list-meta">
                            <span class="persona-type">
                                <i class="far fa-clock"></i>
                                <span>{{calendarEntry.from.dayOfMonth}}.</span>
                                {{#if calendarEntry.to.dayOfMonth}}
                                <span aria-hidden="true">–</span>
                                <span>{{calendarEntry.to.dayOfMonth}}.</span>
                                {{/if}}
                                <span>{{calendarEntry.from.monthLong}} {{calendarEntry.from.year}} {{calendarEntry.yearSuffix}}</span>
                            </span>
                            {{#if calendarEntry.location}}
                            <span class="persona-type">
                                <i class="fas fa-location-pin"></i>
                                <span class="eventlocation">{{calendarEntry.location}}</span>
                            </span>
                            {{/if}}
                            <span class="persona-type">
                                {{#if calendarEntry.visible}}
                                <i class="fas fa-eye"></i>
                                {{else}}
                                <i class="fas fa-eye-slash"></i>
                                {{/if}}
                            </span>
                        </div>
                    </div>
                </div>
                {{/each}}
                {{/"systems/dsa5/templates/journal/parts/list-group.hbs"}}
                {{/each}}
            </div>
        </div>

        <div class="personae-details-column">
            <div class="persona-details-container">
                {{#if detailHTML}}
                {{{detailHTML}}}
                {{else}}
                <div class="no-selection">
                    <div class="no-selection-content">
                        <i class="fas fa-user-circle"></i>
                        <h3>{{localize "dsacalendar.SelectEntry"}}</h3>
                        <p>{{localize "dsacalendar.SelectEntryHint"}}</p>
                    </div>
                </div>
                {{/if}}
            </div>
        </div>
    </div>
</div>
