<div class="scrollable">
    {{#if isGM}}
        <div class="flexrow">
            <label>{{localize "dsacalendar.showInCalendar"}}</label>
            <input type="checkbox" class="showInCalendar"{{checked isRegistered}}/>
        </div>
    {{/if}}
    <div class="flexrow">
        <input type="search" placeholder="{{localize 'Library.search'}}" value="{{search}}">
        <button type="button" data-action="addCalendarEntry" class="fas icon fa-plus"></button>       
    </div>
    
    <div class="eventscontainer">
        {{#each sortedEntries as |elem key|}}
        <fieldset data-id="{{key}}">
            <legend class="flexrow">{{formInput ../document.system.schema.fields.calendarentries.element.fields.title value=elem.title
                name=(concat 'system.calendarentries.' key '.title')}}<button type="button" data-action="removeCalendarEntry" data-key="{{key}}" class="fas icon fa-trash"></button></legend>
            <div class="form-group">
                <label>{{localize "dsacalendar.FIELDS.calendarentries.label"}}</label>

                <div class="flexcol form-fields">
                    <div class="flexrow gap5px">
                        <div class="flex0">{{localize "dsacalendar.FIELDS.calendarentries.from.label"}}</div>
                        <input type="number" style="max-width:40px" min="1" max="{{elem.from.max}}" step="1" value="{{elem.from.dayOfMonth}}" name="{{concat 'system.calendarentries.' key '.from.dayOfMonth'}}"/>
                        <div class="flex0">{{localize "dsacalendar.FIELDS.calendarentries.to.label"}}</div>
                        <input type="number" style="max-width:40px" min="1" max="{{elem.from.max}}" step="1" value="{{elem.to.dayOfMonth}}" name="{{concat 'system.calendarentries.' key '.to.dayOfMonth'}}"/>
                        {{formInput ../document.system.schema.fields.calendarentries.element.fields.from.fields.month value=elem.from.month
                        name=(concat 'system.calendarentries.' key '.from.month') choices=../availableMonths }}
                        {{formInput ../document.system.schema.fields.calendarentries.element.fields.from.fields.year value=elem.from.year
                        name=(concat 'system.calendarentries.' key '.from.year')}}
                        <div class="flex0">{{../yearSuffix}}</div>
                    </div>
                </div>
            </div>
            {{formGroup ../document.system.schema.fields.calendarentries.element.fields.content value=elem.content
            localize=true classes='full-height' elementType='textarea' name=(concat 'system.calendarentries.' key
            '.content')}}
            {{formGroup ../document.system.schema.fields.calendarentries.element.fields.location value=elem.location
            localize=true name=(concat 'system.calendarentries.' key '.location')}}
            {{formGroup ../document.system.schema.fields.calendarentries.element.fields.category value=elem.category
            localize=true name=(concat 'system.calendarentries.' key '.category') localize=true}}
            {{formGroup ../document.system.schema.fields.calendarentries.element.fields.recurring value=elem.recurring
            localize=true name=(concat 'system.calendarentries.' key '.recurring') localize=true}}
            
            {{#if ../isGM}}
            {{formGroup ../document.system.schema.fields.calendarentries.element.fields.visible value=elem.visible
            localize=true name=(concat 'system.calendarentries.' key '.visible') localize=true}}
            {{/if}}
            
        </fieldset>
        {{/each}}
    </div>
</div>