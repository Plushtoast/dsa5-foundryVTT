<div class="scrollable dark-theme persona-container">
    <div class="personae-two-column">
        <div class="personae-list-column">
            <div class="personae-list-header">
                <div class="flexrow">
                    <div class="list-search flex1">
                        <input type="search" class="search-input actorsearch" placeholder="{{localize 'Book.search'}}"
                            value="{{search}}" />
                        <i class="fas fa-search"></i>
                    </div>

                    <button type="button" data-action="addEntry" class="fas icon fa-plus"></button>
                </div>
                {{#if isGM}}
                <div class="form-group" data-tooltip="dsacalendar.showInCalendarHint">
                    <label>{{localize "dsacalendar.showInCalendar"}}</label>
                    <input type="checkbox" class="showInCalendar" {{checked isRegistered}} />
                </div>
                {{/if}}
            </div>

            <div class="personae-list eventscontainer scrollable">
                {{#each sortedEntries as |calendarEntry key|}}
                <div class="persona-list-item event-card {{ifThen (eq ../currentKey key) 'selected' ''}}" data-key="{{key}}" data-action='selectEntry'>
                    <div class="event-card__date" aria-hidden="true" style="--gradient-color:{{color}}" data-tooltip="{{categoryName}}">
                        <div class="month">{{monthShort}}</div>
                        <div class="day">{{from.dayOfMonth}}</div>
                        <div class="weekday" data-tooltip="{{weekDayLong}}">{{weekdayShort}}</div>
                    </div>
                    <div class="persona-list-info">
                        <h5 class="persona-list-name">{{title}}</h5>
                        <div class="persona-list-meta">
                            <span class="persona-type">
                                <i class="far fa-clock"></i>
                                <span>{{from.dayOfMonth}}.</span>
                                {{#if to.dayOfMonth}}
                                <span aria-hidden="true">–</span>
                                <span>{{to.dayOfMonth}}.</span>
                                {{/if}}
                                <span>{{from.monthLong}} {{from.year}} {{yearSuffix}}</span>
                            </span>
                            {{#if location}}
                            <span class="persona-type">
                                <i class="fas fa-location-pin"></i>
                                <span class="eventlocation">{{location}}</span>
                            </span>
                            {{/if}}
                            <span class="persona-type">
                                {{#if visible}}
                                <i class="fas fa-eye"></i>
                                {{else}}
                                <i class="fas fa-eye-slash"></i>
                                {{/if}}
                            </span>
                        </div>
                    </div>
                </div>
                {{/each}}
            </div>
        </div>

        <div class="personae-details-column">
            <div class="persona-details-container">
                {{#if detailHTML}}
                {{{detailHTML}}}
                {{else}}
                <div class="no-selection">
                    <div class="no-selection-content">
                        <i class="fas fa-user-circle"></i>
                        <h3>{{localize "dsacalendar.SelectEntry"}}</h3>
                        <p>{{localize "dsacalendar.SelectEntryHint"}}</p>
                    </div>
                </div>
                {{/if}}
            </div>
        </div>
    </div>
</div>