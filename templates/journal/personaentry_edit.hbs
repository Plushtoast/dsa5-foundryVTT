<div class="scrollable">
    {{#if isGM}}
    <div class="form-group">
        <label>{{localize "dsacalendar.showInCalendar"}}</label>
        <input type="checkbox" class="showInCalendar" {{checked isRegistered}} />
        <span class="hint">{{localize "dsacalendar.showInCalendarHint"}}</span>
    </div>
    {{/if}}
    <div class="flexrow">
        <input type="search" placeholder="{{localize 'Library.search'}}" value="{{search}}">
        <button type="button" data-action="addPersonaEntry" class="fas icon fa-plus"></button>
    </div>

    <div class="eventscontainer flexcol gap10px">
        {{#each sortedEntries as |elem key|}}
        <fieldset data-id="{{key}}">
            <legend class="flexrow">{{formInput ../document.system.schema.fields.personae.element.fields.name
                value=elem.name name=(concat 'system.personae.' key '.name')}}<button type="button" 
                    data-action="removePersonaEntry" data-key="{{key}}" class="fas icon fa-trash"></button></legend>

            {{formGroup ../document.system.schema.fields.personae.element.fields.type value=elem.type
            localize=true name=(concat 'system.personae.' key '.type')}}

            {{formGroup ../document.system.schema.fields.personae.element.fields.faction value=elem.faction
            localize=true name=(concat 'system.personae.' key '.faction')}}

            {{formGroup ../document.system.schema.fields.personae.element.fields.actor_uuid value=elem.actor_uuid
            localize=true name=(concat 'system.personae.' key '.actor_uuid')}}
            {{formGroup ../document.system.schema.fields.personae.element.fields.tags value=elem.tags
            localize=true name=(concat 'system.personae.' key '.tags')}}

            <div class="form-group">
                <label>{{localize ../document.system.schema.fields.personae.element.fields.showSpecies.label}}</label>
                {{formInput ../document.system.schema.fields.personae.element.fields.showSpecies value=elem.showSpecies name=(concat 'system.personae.' key '.showSpecies')}}
            </div>

            {{#if (eq elem.type 0)}}
            <div class="form-group">
                <label>{{localize ../document.system.schema.fields.personae.element.fields.showCulture.label}}</label>
                {{formInput ../document.system.schema.fields.personae.element.fields.showCulture value=elem.showCulture name=(concat 'system.personae.' key '.showCulture')}}
            </div>
            <div class="form-group">
                <label>{{localize ../document.system.schema.fields.personae.element.fields.showProfession.label}}</label>
                {{formInput ../document.system.schema.fields.personae.element.fields.showProfession value=elem.showProfession name=(concat 'system.personae.' key '.showProfession')}}
            </div>
            {{/if}}
            <div class="form-group">
                <label>{{localize ../document.system.schema.fields.personae.element.fields.showActorDescription.label}}</label>
                {{formInput ../document.system.schema.fields.personae.element.fields.showActorDescription value=elem.showActorDescription name=(concat 'system.personae.' key '.showActorDescription')}}
                <span class="hint">{{localize ../document.system.schema.fields.personae.element.fields.showActorDescription.hint}}</span>
            </div>
            <div class="form-group">
                <label>{{localize ../document.system.schema.fields.personae.element.fields.showActorPersonalNotes.label}}</label>
                {{formInput ../document.system.schema.fields.personae.element.fields.showActorPersonalNotes value=elem.showActorPersonalNotes name=(concat 'system.personae.' key '.showActorPersonalNotes')}}
                <span class="hint">{{localize ../document.system.schema.fields.personae.element.fields.showActorPersonalNotes.hint}}</span>
            </div>
            {{#if ../isGM}}
            {{formGroup ../document.system.schema.fields.personae.element.fields.visible value=elem.visible
            localize=true name=(concat 'system.personae.' key '.visible')}}
            {{/if}}

            {{#unless elem.showActorDescription}}
            {{formGroup ../document.system.schema.fields.personae.element.fields.description value=elem.description
            localize=true classes='full-height' name=(concat 'system.personae.' key '.description')}}
            {{/unless}}

            {{#unless elem.showActorPersonalNotes}}
            {{formGroup ../document.system.schema.fields.personae.element.fields.notes value=elem.notes
            localize=true classes='full-height' name=(concat 'system.personae.' key '.notes')}}
            {{/unless}}

        </fieldset>
        {{/each}}
    </div>
</div>