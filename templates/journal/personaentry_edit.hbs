<div>
  <div class='personae-two-column'>
    <div class='personae-list-column'>
      <div class='personae-list-header'>
        <div class='flexrow'>
          <div class='list-search'>
            <input type='search' class='search-input actorsearch' placeholder='{{localize "Book.search"}}' value='{{search}}' />
            <i class='fas fa-search'></i>
          </div>

          <button type='button' data-action='addEntry' class='fas icon fa-plus'></button>
        </div>
        {{#if isGM}}
          <div class='form-group' data-tooltip='dsacalendar.showInCalendarHint'>
            <label>{{localize 'dsacalendar.showInCalendar'}}</label>
            <input type='checkbox' class='showInCalendar' {{checked isRegistered}} />
          </div>
        {{/if}}
      </div>

      <div class='personae-list eventscontainer scrollable'>
        {{#each sortedEntries as |persona key|}}
          <div class='persona-list-item {{ifThen (eq ../currentKey key) 'selected' ''}}' data-persona-uuid='{{uuid}}' data-persona-juuid='{{juuid}}' data-key='{{key}}' data-action='selectEntry'>
            <div class='persona-list-image'>
              <img src='{{img}}' alt='{{name}}' />
              {{#if garadanClass}}
              <div class='persona-status garjourn {{garadanClass}}' data-tooltip="GARADAN.{{garadan}}"></div>
              {{/if}}
            </div>
            <div class='persona-list-info'>
              <h5 class='persona-list-name'>{{name}}</h5>
              {{#if subtitle}}
                <div class='persona-list-meta'>
                  <span class='persona-type'>{{subtitle}}</span>
                </div>
              {{/if}}
            </div>
            <div class='persona-list-status'>
              <i class='fas fa-chevron-right'></i>
            </div>
          </div>
        {{/each}}
        {{#unless sortedEntries.length}}
         <div class="no-personae-list">
          <div class="empty-state-small">
              <i class="fas fa-users"></i>
              <p>{{localize "PERSONAE.dragPersons"}}</p>
              {{#if ../isGM}}
              <button type="button" class="flexrow add-persona-small">
                  <div class="flex0"><i class="fas fa-plus"></i></div><div>{{localize "PERSONAE.Add"}}</div>
              </button>
              {{/if}}
          </div>
        </div>
        {{/unless}}
      </div>
    </div>

    <div class='personae-details-column'>
      <div class='persona-details-container scrollable'>
        {{#if detailHTML}}
          {{{detailHTML}}}
        {{else}}
          <div class='no-selection'>
            <div class='no-selection-content'>
              <i class='fas fa-user-circle'></i>
              <h3>{{localize 'PERSONAE.SelectPersona'}}</h3>
              <p>{{localize 'PERSONAE.SelectPersonaHint'}}</p>
            </div>
          </div>
        {{/if}}
      </div>
    </div>
  </div>
</div>