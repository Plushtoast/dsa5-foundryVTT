<div>
  <div class='personae-two-column'>
    <div class='personae-list-column'>
      <div class='personae-list-header'>
        {{> "systems/dsa5/templates/journal/parts/list-toolbar.hbs"}}
        {{#if isGM}}
          <div class='form-group' data-tooltip='dsacalendar.showInCalendarHint'>
            <label>{{localize 'dsacalendar.showInCalendar'}}</label>
            <input type='checkbox' class='showInCalendar' {{checked isRegistered}} />
          </div>
        {{/if}}
      </div>

      <div class='personae-list eventscontainer scrollable'>
        {{#each entryGroups}}
          {{#> "systems/dsa5/templates/journal/parts/list-group.hbs"}}
            {{#each entries as |persona|}}
              <div class='persona-list-item{{ifThen persona.visible '' ' invisible'}} {{ifThen (eq @root.currentKey persona.key) 'selected' ''}}' data-persona-uuid='{{persona.uuid}}' data-key='{{persona.key}}' data-persona-factions='{{persona.faction}}' data-persona-tags='{{persona.tags}}' data-persona-important='{{persona.important}}' data-persona-visible='{{persona.visible}}' data-actor-uuid='{{persona.actor_uuid}}' data-action='selectEntry'>
                <div class='persona-list-image'>
                  <img src='{{persona.img}}' alt='{{persona.name}}' />
                  {{#if persona.garadanClass}}
                  <div class='persona-status garjourn {{persona.garadanClass}}' data-tooltip="GARADAN.{{persona.garadan}}"></div>
                  {{/if}}
                </div>
                <div class='persona-list-info'>
                  <h5 class='persona-list-name'>{{persona.name}}</h5>
                  {{#if persona.subtitle}}
                    <div class='persona-list-meta'>
                      <span class='persona-type'>{{persona.subtitle}}</span>
                      {{#unless persona.visible}}
                      <span class='persona-type persona-hidden'><i class='fas fa-eye-slash'></i></span>
                      {{/unless}}
                    </div>
                  {{else}}
                    {{#unless persona.visible}}
                    <div class='persona-list-meta'>
                      <span class='persona-type persona-hidden'><i class='fas fa-eye-slash'></i></span>
                    </div>
                    {{/unless}}
                  {{/if}}
                </div>
                <div class='persona-list-status'>
                  <i class='fas fa-chevron-right'></i>
                </div>
              </div>
            {{/each}}
          {{/"systems/dsa5/templates/journal/parts/list-group.hbs"}}
        {{/each}}
        {{#unless sortedEntries.length}}
         <div class="no-personae-list">
          <div class="empty-state-small">
              <i class="fas fa-users"></i>
              <p>{{localize "PERSONAE.dragPersons"}}</p>
          </div>
        </div>
        {{/unless}}
      </div>
    </div>

    <div class='personae-details-column'>
      <div class='persona-details-container scrollable'>
        {{#if detailHTML}}
          {{{detailHTML}}}
        {{else}}
          <div class='no-selection'>
            <div class='no-selection-content'>
              <i class='fas fa-user-circle'></i>
              <h3>{{localize 'PERSONAE.SelectPersona'}}</h3>
              <p>{{localize 'PERSONAE.SelectPersonaHint'}}</p>
            </div>
          </div>
        {{/if}}
      </div>
    </div>
  </div>
</div>
