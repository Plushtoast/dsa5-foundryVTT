<form id="document-create" autocomplete="off">
    <div class="flexcol gap10px">
        <div class="flex0 flexcol gap10px">
            <div class="flexrow flexAlignCenter gap5px">
                <i class="fas fa-font flex0" data-tooltip="{{localize 'Name'}}" aria-hidden="true"></i>
                <div class="flex1">
                    <input type="text" name="name" placeholder="{{defaultName}}" value="{{ name }}" aria-label="{{localize 'Name'}}" autofocus>
                </div>
            </div>
            {{#if hasFolders}}
            <div class="flexrow flexAlignCenter gap5px">
                <i class="fas fa-folder flex0" data-tooltip="{{localize 'DOCUMENT.Folder'}}" aria-hidden="true"></i>
                <div class="flex1">
                    <select name="folder" aria-label="{{localize 'DOCUMENT.Folder'}}">
                        {{selectOptions folders selected=folder blank="" valueAttr="id" labelAttr="name"}}
                    </select>
                </div>
            </div>
            {{/if}}
            <div class="flexrow gap5px">            
                <button type="submit" class="default">{{title}}</button>
                <button type="button" data-action="cancel">{{localize "Cancel"}}</button>
            </div>
            {{#if hasTypes}}
            <div class="flexrow flexAlignCenter gap5px">
                <i class="fas fa-search flex0" data-tooltip="{{searchPlaceholder}}" aria-hidden="true"></i>
                <div class="flex1">
                    <input type="search" class="search-input item-create-dialog__search" placeholder="{{searchPlaceholder}}" aria-label="{{searchPlaceholder}}">
                    
                </div>
                <button type="button" class="fas {{#if iconView}}fa-list{{else}}fa-th-large{{/if}} ui-control icon item-create-dialog__view-toggle" data-action="toggle-type-view" data-tooltip="{{viewToggleTooltip}}" aria-label="{{viewToggleTooltip}}">
                    </button>
            </div>
            {{/if}}
        </div>
        <div class="flex1 scrollable dsa-card-list item-create-dialog__type-list {{#if iconView}}icon-view{{/if}}" style="max-height: 330px;">
            {{#if hasTypes}}
            <ul>
                {{#each types}}
                <li class="item-create-dialog__type" data-search="{{searchText}}" data-tooltip="{{tooltip}}">
                    <label>
                        <img src="{{ img }}" alt="{{ label }}" width="36" height="36">
                        <span class="ellipsis">{{ label }}</span>
                        <input type="radio" name="type" value="{{ value }}" required {{checked selected}} {{disabled disabled}}>
                    </label>
                </li>
                {{/each}}
            </ul>
            <p class="hint item-create-dialog__empty" hidden>...</p>
            {{/if}}
        </div>
        <div class="flex0">
            {{{content}}}
        </div>
    </div>
</form>