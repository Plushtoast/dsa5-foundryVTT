<div class='form-group tripple'>
  <label data-tooltip='ABBR.AoE'>{{localize 'AoE'}}</label>
  <div class="form-fields">
    {{formInput systemFields.target.fields.value value=document.system.target.value}}
    {{formInput systemFields.target.fields.type value=document.system.target.type localize=true blank='-'}}
  </div>
</div>
{{formGroup systemFields.target.fields.showZone value=document.system.target.showZone localize=true}}
{{#if (eq document.system.target.type 'line')}}
  {{formGroup systemFields.target.fields.width value=document.system.target.width localize=true}}
{{/if}}
{{#if (eq document.system.target.type 'cone')}}
  {{formGroup systemFields.target.fields.angle value=document.system.target.angle localize=true}}
{{/if}}