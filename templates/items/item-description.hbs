<div class="tab standard-form scrollable {{tabs.description.cssClass}}" data-tab="description" data-group="{{tabs.description.group}}" class="tab">
    <div>
        <div class="row-section">
            <div class="col {{#unless document.system.description.value}}item-box{{/unless}}">
                {{formInput systemFields.description.fields.value value=document.system.description.value toggled=true enriched=enrichedDescription}}
            </div>
        </div>
        {{#if enableWeaponAdvantages}}
            {{#each conditions as |item i|}}
                {{#if (and item.description item.system.equipmentAdvantage)}}
                <div class="row-section">
                    <div class="col third">
                        <p><b>{{localize (concat 'AdvantageRuleItems.' ...item.type '.' item.system.equipmentAdvantage)}}</b>:</p>
                    </div>
                    <div class="col seventy">
                        {{{item.description}}}
                    </div>             
                </div>
                {{/if}}
            {{/each}}
        {{/if}}
    </div>
    {{#if isGM}}
    <div class="row-section" style="margin-top:20px">
        <div class="col maskfield">
            <div class="row-section" data-tooltip="TT.onlyGM">
                <div class="col {{#unless document.system.gmdescription.value}}item-box{{/unless}}">
                    {{formInput systemFields.gmdescription.fields.value value=document.system.gmdescription.value toggled=true enriched=enrichedGmdescription}}
                </div>
            </div>
        </div>
    </div>
    {{/if}}
</div>