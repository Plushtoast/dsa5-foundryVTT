<div class='tab standard-form scrollable {{tabs.details.cssClass}}' data-tab='details' data-group='{{tabs.details.group}}' class='tab details' data-tab='details'>

  {{formGroup systemFields.APValue.fields.value value=document.system.APValue.value localize=true}}
  {{formGroup systemFields.requirements.fields.value value=document.system.requirements.value localize=true}}
  {{formGroup systemFields.category.fields.value value=document.system.category.value localize=true choices=categories sort=true valueAttr='valueAttr' labelAttr='labelAttr'}}
  {{formGroup systemFields.rule.fields.value value=document.system.rule.value localize=true classes='full-height' elementType='textarea'}}
  {{formGroup systemFields.maxRank.fields.value value=document.system.maxRank.value localize=true}} 
  {{formGroup systemFields.effect.fields.value value=document.system.effect.value localize=true}}  

  {{#if (eq document.system.category.value 'pact')}}

    {{formGroup systemFields.distribution value=document.system.distribution localize=true}}  
    {{formGroup systemFields.step.fields.circle value=document.system.step.circle localize=true}}  

  {{else if (eq document.system.category.value 'staff')}}

    {{formGroup systemFields.artifact value=document.system.artifact localize=true sort=true blank='-'}}  
    {{formGroup systemFields.permanentEffects value=document.system.permanentEffects localize=true tooltip='permanentEffectsHint' rootId=rootId}}  
    {{formGroup systemFields.volume value=document.system.volume localize=true}}  
    {{formGroup systemFields.AsPCost value=document.system.AsPCost localize=true}}
    {{formGroup systemFields.feature value=document.system.feature localize=true}}

  {{else if (eq document.system.category.value 'Combat')}}

    {{formGroup systemFields.effect.fields.value2 value=document.system.effect.value2 localize=true label=(localize 'effectVariant' num='B') tooltip='TT.effectVariant'}}
    {{formGroup systemFields.effect.fields.value3 value=document.system.effect.value3 localize=true label=(localize 'effectVariant' num='C') tooltip='TT.effectVariant'}}
    {{formGroup systemFields.list.fields.value value=document.system.list.value localize=true}}
    {{formGroup systemFields.category.fields.sub value=document.system.category.sub localize=true}}

  {{else if (eq document.system.category.value 'homunculus')}}
    
    {{formGroup systemFields.AsPCost value=document.system.AsPCost localize=true}}
    {{formGroup systemFields.feature value=document.system.feature localize=true}}
    {{formGroup systemFields.duration.fields.value value=document.system.duration.value localize=true}} 

  {{/if}}
  {{#if isOwned}}
    <div class='form-group'>
      <label>
        {{#if canAdvance}}
          <a class='refund-step'><i class='fas fa-minus'></i></a>
          {{localize 'stepValue'}}
          <a class='advance-step'><i class='fas fa-plus'></i></a>
        {{else}}
          {{localize 'stepValue'}}
        {{/if}}
      </label>
      <div class="form-fields">
        {{formInput systemFields.step.fields.value value=document.system.step.value}}
      </div>
    </div>
  {{/if}}

</div>