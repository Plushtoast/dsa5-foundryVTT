<div class="tab standard-form scrollable {{tabs.details.cssClass}}" data-tab="details" data-group="{{tabs.details.group}}" class="tab">

    {{formGroup systemFields.characteristic1.fields.value value=document.system.characteristic1.value localize=true}}
    {{formGroup systemFields.characteristic2.fields.value value=document.system.characteristic2.value localize=true}}
    {{formGroup systemFields.characteristic3.fields.value value=document.system.characteristic3.value localize=true}}

    <div class="form-group tripple">
        <label data-tooltip="{{localize 'reach'}} ({{localize 'modifyable'}})">{{localize "reach"}} ({{localize 'CHAR.modifyable'}})</label>
        <div class="form-fields">
            {{formInput systemFields.range.fields.value value=document.system.range.value}}
            {{formInput systemFields.canChangeRange.fields.value value=document.system.canChangeRange.value localize=true tooltip='modifyable'}}
        </div>
    </div>
    {{formGroup systemFields.duration.fields.value value=document.system.duration.value localize=true}}
    {{formGroup systemFields.targetCategory.fields.value value=document.system.targetCategory.value localize=true}}

    <div class="form-group tripple">
        <label data-tooltip="{{localize 'castingTime'}} ({{localize 'modifyable'}})">{{localize "castingTime"}} ({{localize "CHAR.modifyable"}})</label>
        <div class="form-fields">
            {{formInput systemFields.castingTime.fields.value value=document.system.castingTime.value}}
            {{formInput systemFields.canChangeCastingTime.fields.value value=document.system.canChangeCastingTime.value localize=true tooltip='modifyable'}}
        </div>
    </div>

    <div class="form-group tripple">
        <label data-tooltip="{{localize 'KaPCost'}} ({{localize 'modifyable'}})">{{localize "CHAR.KaPCost"}} ({{localize "CHAR.modifyable"}})</label>
        <div class="form-fields">
            {{formInput systemFields.AsPCost.fields.value value=document.system.AsPCost.value}}
            {{formInput systemFields.canChangeCost.fields.value value=document.system.canChangeCost.value localize=true tooltip='modifyable'}}
        </div>
    </div>
    {{formGroup systemFields.permanentCost.fields.value value=document.system.permanentCost.value localize=true}}
    {{formGroup systemFields.AsPCostDetail.fields.value value=document.system.AsPCostDetail.value localize=true label='KaPCostDetail'}}
    {{formGroup systemFields.maintainCost.fields.value value=document.system.maintainCost.value localize=true}}
    {{formGroup systemFields.variableBaseCost value=document.system.variableBaseCost localize=true tooltip='modifyable' rootId=rootId}}
    {{formGroup systemFields.effect.fields.value value=document.system.effect.value localize=true classes='full-height' elementType='textarea'}}
    {{formGroup systemFields.effectFormula.fields.value value=document.system.effectFormula.value localize=true}}
    {{formGroup systemFields.distribution.fields.value value=document.system.distribution.value localize=true}}
    {{formGroup systemFields.resistanceModifier.fields.value value=document.system.resistanceModifier.value localize=true}}
    {{formGroup systemFields.StF.fields.value value=document.system.StF.value localize=true}}

    {{> systems/dsa5/templates/items/item-aoe.hbs}}
</div>