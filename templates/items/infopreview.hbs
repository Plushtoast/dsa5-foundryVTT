<table class='infoTable'>
  <tr>
    <td colspan='2'>
      <div class="flexrow lineheight">
        {{#if sheetEmbed}}
        <a class='roll-button' data-action='infoPost' data-tooltip="{{localize 'TT.enricherInfoPost'}}" data-uuid='{{uuid}}'{{#if parentUuid}} data-parent-uuid='{{parentUuid}}'{{/if}}><em class='fas fa-comment'></em>
          {{document.name}}</a>
        {{#if uuid}}
        <button type='button' class='dsadesignbutton noBorder icon fas fa-info flex0' data-action='infoShow' data-uuid='{{uuid}}'{{#if parentUuid}} data-parent-uuid='{{parentUuid}}'{{/if}}></button>
        {{/if}}
        {{else}}
        <a class='roll-button postInfo' data-tooltip="{{localize 'TT.enricherInfoPost'}}" data-uuid='{{uuid}}'{{#if parentUuid}} data-parent-uuid='{{parentUuid}}'{{/if}}><em class='fas fa-comment'></em>
          {{document.name}}</a>
        {{#if uuid}}
        <button type='button' class='dsadesignbutton noBorder icon fas fa-info show-item flex0' data-type='Item' data-uuid='{{uuid}}'{{#if parentUuid}} data-parent-uuid='{{parentUuid}}'{{/if}}></button>
        {{/if}}
        {{/if}}
      </div>
    </td>
  </tr>
  {{#if document.system.qs1}}
  <tr>
    <td>{{localize 'CHARAbbrev.QS'}} 1</td>
    <td>{{{enriched.enrichedqs1}}}</td>
  </tr>
  {{/if}}
  {{#if document.system.qs2}}
  <tr>
    <td>{{localize 'CHARAbbrev.QS'}} 2</td>
    <td>{{{enriched.enrichedqs2}}}</td>
  </tr>
  {{/if}}
  {{#if document.system.qs3}}
  <tr>
    <td>{{localize 'CHARAbbrev.QS'}} 3</td>
    <td>{{{enriched.enrichedqs3}}}</td>
  </tr>
  {{/if}}
  {{#if document.system.qs4}}
  <tr>
    <td>{{localize 'CHARAbbrev.QS'}} 4</td>
    <td>{{{enriched.enrichedqs4}}}</td>
  </tr>
  {{/if}}
  {{#if document.system.qs5}}
  <tr>
    <td>{{localize 'CHARAbbrev.QS'}} 5</td>
    <td>{{{enriched.enrichedqs5}}}</td>
  </tr>
  {{/if}}
  {{#if document.system.qs6}}
  <tr>
    <td>{{localize 'CHARAbbrev.QS'}} 6</td>
    <td>{{{enriched.enrichedqs6}}}</td>
  </tr>
  {{/if}}
  {{#if document.system.fail}}
  <tr>
    <td>{{localize 'Failure'}}</td>
    <td>{{{enriched.enrichedfail}}}</td>
  </tr>
  {{/if}}
  {{#if document.system.botch}}
  <tr>
    <td>{{localize 'CriticalFailure'}}</td>
    <td>{{{enriched.enrichedbotch}}}</td>
  </tr>
  {{/if}}
  {{#if document.system.crit}}
  <tr>
    <td>{{localize 'CriticalSuccess'}}</td>
    <td>{{{enriched.enrichedcrit}}}</td>
  </tr>
  {{/if}}
</table>