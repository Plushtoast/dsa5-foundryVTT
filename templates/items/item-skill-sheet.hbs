<div class='tab standard-form scrollable {{tabs.details.cssClass}} gap5px' data-tab='details' data-group='{{tabs.details.group}}'>

  {{formGroup systemFields.characteristic1.fields.value value=document.system.characteristic1.value localize=true}}
  {{formGroup systemFields.characteristic2.fields.value value=document.system.characteristic2.value localize=true}}
  {{formGroup systemFields.characteristic3.fields.value value=document.system.characteristic3.value localize=true}}
  {{formGroup systemFields.group.fields.value value=document.system.group.value localize=true}}
  {{formGroup systemFields.burden.fields.value value=document.system.burden.value localize=true}}
  {{formGroup systemFields.StF.fields.value value=document.system.StF.value localize=true}}

  {{#if showLoyaltyOwner}}
  <div class="form-group">
    <label>{{localize "COMPANIONS.Loyalty.owner"}}</label>
    <div class="form-fields">
      <select class="select2 loyalty-owner-select" style="width:100%;">
        {{#each loyaltyOwnerChoices}}
        <option value="{{uuid}}" {{#if (eq uuid ../loyaltyOwnerUuid)}}selected{{/if}}>{{name}}</option>
        {{/each}}
      </select>
    </div>
  </div>
  {{/if}}

</div>