<div
  class='tab standard-form scrollable {{tabs.description.cssClass}}'
  data-tab='description'
  data-group='{{tabs.description.group}}'
  class='tab description'
  data-tab='description'
>
  <div class='row-section'>
    <div class='col two'>
      {{editor enrichedDescription target='system.description.value' button=true owner=owner editable=editable engine='prosemirror'}}
    </div>
    <div class='col two'>
      <img src='{{document.img}}' class='fullImg' data-action='editImage' />
      {{editor enrichedClothing target='system.clothing.value' button=true owner=owner editable=editable engine='prosemirror'}}
    </div>
  </div>
</div>