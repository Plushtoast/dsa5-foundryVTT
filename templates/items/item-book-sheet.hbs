<div class="tab standard-form scrollable {{tabs.details.cssClass}} gap5px" data-tab="details" data-group="{{tabs.details.group}}">
    {{formGroup systemFields.otherNames value=document.system.otherNames localize=true}}
    {{formGroup systemFields.category value=document.system.category localize=true}}
    {{formGroup systemFields.author value=document.system.author localize=true}}
    {{formGroup systemFields.format value=document.system.format localize=true}}
    {{formGroup systemFields.pages value=document.system.pages localize=true}}
    {{formGroup systemFields.releaseDate value=document.system.releaseDate localize=true}}
    {{formGroup systemFields.exemplar value=document.system.exemplar localize=true}}
    {{formGroup systemFields.exemplarType value=document.system.exemplarType localize=true}}
    {{formGroup systemFields.storage value=document.system.storage localize=true}}
    {{formGroup systemFields.language value=document.system.language localize=true}}
    {{formGroup systemFields.quality value=document.system.quality localize=true}}
    {{formGroup systemFields.rule value=document.system.rule localize=true elementType='textarea' classes='full-height'}}
    {{formGroup systemFields.legality value=document.system.legality localize=true}}
    {{formGroup systemFields.availability value=document.system.availability localize=true}}
    {{formGroup systemFields.special value=document.system.special localize=true elementType='textarea' classes='full-height'}}
</div>