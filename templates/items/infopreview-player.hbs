{{#if (eq document.system.subType 'magicalAnalysis')}}
<a class="roll-button magicAnalysisEnricherRoll" data-tooltip="{{localize 'TT.enricherInfoRoll'}}" data-uuid="{{uuid}}" data-subtype="magicalAnalysis">
  <em class="fas fa-comment"></em> {{document.name}} ({{localize 'MAGICANALYSIS.title'}})
</a>
{{else}}
<a class="roll-button informationEnricherRoll" data-tooltip="{{localize 'TT.enricherInfoRoll'}}" data-uuid="{{uuid}}" data-skill="{{document.system.skill}}" data-mod="{{document.system.modifier}}">
  <em class="fas fa-comment"></em> {{document.name}} ({{document.system.modifier}})
</a>
{{/if}}
