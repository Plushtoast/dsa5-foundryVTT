<div class='tab standard-form scrollable {{tabs.details.cssClass}}' data-tab='details' data-group='{{tabs.details.group}}' class='tab'>

  {{formGroup systemFields.allowedTestCount.fields.value value=document.system.allowedTestCount.value localize=true}}
  {{formGroup systemFields.usedTestCount.fields.value value=document.system.usedTestCount.value localize=true}}
  {{formGroup systemFields.interval.fields.value value=document.system.interval.value localize=true}}
  {{formGroup systemFields.cummulatedQS.fields.value value=document.system.cummulatedQS.value localize=true}}
  {{formGroup systemFields.previousFailedTests.fields.value value=document.system.previousFailedTests.value localize=true}}
  {{formGroup systemFields.baseModifier value=document.system.baseModifier localize=true}}
  {{formGroup systemFields.talent.fields.value value=document.system.talent.value localize=true choices=(selfObj allSkills) blank='-'}}
  {{formGroup systemFields.talent.fields.value2 value=document.system.talent.value2 localize=true choices=(selfObj allSkills) blank='-'}}
  {{formGroup systemFields.talent.fields.value3 value=document.system.talent.value3 localize=true choices=(selfObj allSkills) blank='-'}}

  {{#if (or isGM (gt document.system.cummulatedQS.value 5))}}
    <div class='form-group full-height'>
      <label>{{localize 'PartSuccess'}}</label>
      <div class="form-fields">
        {{editor enrichedpartsuccess target='system.partsuccess' button=true owner=owner editable=editable engine='prosemirror'}}
      </div>
    </div>
  {{/if}}
  {{#if (or isGM (gt document.system.cummulatedQS.value 9))}}
    <div class='form-group full-height'>
      <label>{{localize 'Success'}}</label>
      <div class="form-fields">
        {{editor enrichedsuccess target='system.success' button=true owner=owner editable=editable engine='prosemirror'}}
      </div>
    </div>
  {{/if}}
</div>