<div class='tab standard-form scrollable {{tabs.details.cssClass}}' data-tab='details' data-group='{{tabs.details.group}}'>
  <div class="navWrapper">
    <div class="left-btn"><i class="fas fa-angle-left"></i></div>
    <div class="right-btn"><i class="fas fa-angle-right"></i></div>
    <nav class="sheet-tabs tabs" aria-roledescription="Form Tab Navigation">
      <a class="tabelement {{trapSheet.setupCss}}" data-action="tab" data-group="trap-sheet" data-tab="setup">
        <label>{{localize 'Details'}}</label>
      </a>
      <a class="tabelement {{trapSheet.flowCss}}" data-action="tab" data-group="trap-sheet" data-tab="flow">
        <label>{{localize 'REGIONBEHAVIOR_DSATrap.TABS.flow'}}</label>
      </a>
    </nav>
  </div>

  <div class="tab scrollable flexcol gap2px {{trapSheet.setupCss}}" data-group="trap-sheet" data-tab="setup">
    <div class="flexrow flexAlignEnd">
      <button type="button" class="icon noBorder dsadesignbutton flex0 fas fa-circle-info" data-tooltip-html="{{{localize 'REGIONBEHAVIOR_DSATrap.sheetHelpTooltip'}}}"></button>
    </div>

    {{formGroup systemFields.trapType value=document.system.trapType localize=true}}
    {{formGroup systemFields.complexity value=document.system.complexity localize=true}}

    {{formGroup systemFields.stealth value=document.system.stealth localize=true}}
    {{formGroup systemFields.difficulty value=document.system.difficulty localize=true}}
    {{formGroup systemFields.tools value=document.system.tools localize=true}}

    {{formGroup systemFields.trigger value=document.system.trigger localize=true}}
    {{formGroup systemFields.charges value=document.system.charges localize=true}}
    {{> systems/dsa5/templates/items/item-aoe.hbs}}

    {{formGroup systemFields.passwordRequired value=document.system.passwordRequired localize=true}}

    {{formGroup systemFields.autoPause value=document.system.autoPause localize=true}}
    {{formGroup systemFields.sound value=document.system.sound localize=true}}
    {{formGroup systemFields.events value=document.system.events localize=true}}
  </div>

  <div class="tab scrollable flexcol gap2px {{trapSheet.flowCss}}" data-group="trap-sheet" data-tab="flow">
    {{> systems/dsa5/templates/items/trap-flow-part.hbs kind="defenses" legend="REGIONBEHAVIOR_DSATrap.FIELDS.defenses.label" addTooltip="REGIONBEHAVIOR_DSATrap.FLOW.addDefense" addHelp="REGIONBEHAVIOR_DSATrap.FLOW.sectionHelp.defenses" types=defenseTypes rows=trapDefenses prefix="system.defenses." allSkills=allSkills}}
    {{> systems/dsa5/templates/items/trap-flow-part.hbs kind="damages" legend="REGIONBEHAVIOR_DSATrap.FIELDS.damages.label" addTooltip="REGIONBEHAVIOR_DSATrap.FLOW.addDamage" addHelp="REGIONBEHAVIOR_DSATrap.FLOW.sectionHelp.damages" types=damageTypes rows=trapDamages prefix="system.damages." whenChoices=damageWhenChoices whenBlank="REGIONBEHAVIOR_DSATrap.FLOW.whenImmediate" allSkills=allSkills}}
  </div>
</div>
