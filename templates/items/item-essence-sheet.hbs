<div class='tab standard-form scrollable {{tabs.details.cssClass}}' data-tab='details' data-group='{{tabs.details.group}}' class='tab details' data-tab='details'>
  <div class='form-group'>
    <label class='label-text'>{{localize 'APValue'}}</label>
    <input class='input-text' type='text' name='system.APValue.value' value='{{document.system.APValue.value}}' data-dtype='String' />
  </div>
  <div class='form-group'>
    <label class='label-text'>{{localize 'level'}}</label>
    <input class='input-text' type='number' name='system.level' value='{{document.system.level}}' data-dtype='Number' />
  </div>
  <div class='form-group'>
    <label class='label-text'>{{localize 'combinationWith'}}</label>
    <input class='input-text' type='text' name='system.requirements' value='{{document.system.requirements}}' />
  </div>

</div>