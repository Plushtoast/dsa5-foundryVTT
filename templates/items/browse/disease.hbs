<div>
    <h3>{{document.name}}</h3>
    <div class="row-section">
        {{#unless skipHeader}}
        <div class="col sixty">
            {{{enrichedDescription}}}
            {{#if (and isGM enrichedGmdescription)}}
            <div class="maskfield">
                {{{enrichedGmdescription}}}
            </div>
            {{/if}}
        </div>
        <div class="col zerofive"></div>
        <div class="col fourty">
        {{else}}
        <div class="col row-section">
        {{/unless}}
            <div class="row-section wrap col third">
                <div class="col center">
                    <img src="{{document.img}}" style="width:100%;border:none;" >
                </div>
                <div class="col compendium">
                    <small>{{document.pack}}</small>
                </div>  
            </div>
            <div class="col browseSpacer ten"></div>
            <div class="row-section col sixty browseElement">
                <div class="col groupbox">
                    <div class="row-section wrap">
                        <div class="col table-title noBorder flexrow">
                            <div>
                                {{localize "stepValue"}}
                            </div>
                            <div class="flex0">
                                {{#if document.uuid}}
                                <button type="button" class="dsadesignbutton noBorder icon fas fa-info show-item" data-type="Item"
                                data-uuid="{{document.uuid}}"></i></button>
                                {{/if}}
                            </div>
                        </div>
                        <div class="col">
                            {{document.system.step.value}}
                        </div>
                        <div class="col table-title noBorder">
                            {{localize "incubation"}}
                        </div>
                        <div class="col">
                            {{document.system.incubation.value}}
                        </div>
                        <div class="col table-title noBorder">
                            {{localize "effect"}}
                        </div>
                        <div class="col">
                            {{document.system.damage.value}}
                        </div>

                        <div class="col table-title noBorder">
                            {{localize "duration"}}
                        </div>
                        <div class="col">
                            {{document.system.duration.value}}
                        </div>
                        <div class="col table-title noBorder">
                            {{localize "source"}}
                        </div>
                        <div class="col">
                            {{document.system.source.value}}
                        </div>
                        <div class="col table-title noBorder">
                            {{localize "treatment"}}
                        </div>
                        <div class="col">
                            {{document.system.treatment.value}}
                        </div>
                        <div class="col table-title noBorder">
                            {{localize "antidot"}}
                        </div>
                        <div class="col">
                            {{document.system.antidot.value}}
                        </div>
                        <div class="col table-title noBorder">
                            {{localize "resistanceModifier"}}
                        </div>
                        <div class="col">
                            {{document.system.resistance.value}}
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>