<div>
    <h3>{{document.name}}</h3>
    <div class="row-section">
        {{#unless skipHeader}}
        <div class="col sixty">
            {{{enrichedDescription}}}
            <div>
                <br/><b>{{localize "effect"}}</b>: {{document.system.effect.value}}
            </div>
            {{#if (and isGM enrichedGmdescription)}}
            <div class="maskfield">
                {{{enrichedGmdescription}}}
            </div>
            {{/if  }}
        </div>
        <div class="col zerofive"></div>
        <div class="col fourty">
        {{else}}
        <div class="col row-section">
        {{/unless}}
            <div class="row-section wrap col third">
                <div class="col center">
                    <img src="{{document.img}}" style="width:100%;border:none;" >
                </div>
                <div class="col compendium">
                    <small>{{document.pack}}</small>
                </div>  
            </div>
            <div class="col browseSpacer ten"></div>
            <div class="row-section col sixty browseElement">
                <div class="col groupbox">
                        <div class="row-section wrap">
                            <div class="col table-title noBorder flexrow">
                                <div>
                                    {{localize "attributes"}}
                                </div>
                                <div class="flex0">
                                    {{#if document.uuid}}
                                    <button type="button" class="dsadesignbutton noBorder icon fas fa-info show-item" data-type="Item"
                                    data-uuid="{{document.uuid}}"></i></button>
                                    {{/if}}
                                </div>
                            </div>
                            <div class="col skills">
                                <span class="d20 diet-{{document.system.characteristic1.value}}">{{localize (concatUp "CHARAbbrev." document.system.characteristic1.value)}}</span>
                                <span class="d20 diet-{{document.system.characteristic2.value}}">{{localize (concatUp "CHARAbbrev." document.system.characteristic2.value)}}</span>
                                <span class="d20 diet-{{document.system.characteristic3.value}}">{{localize (concatUp "CHARAbbrev." document.system.characteristic3.value)}}</span>
                            </div>
                            <div class="col table-title noBorder">
                                {{localize "reach"}}
                            </div>
                            <div class="col">
                                {{document.system.range.value}}
                            </div>
                            <div class="col table-title noBorder">
                                {{localize "duration"}}
                            </div>
                            <div class="col">
                                {{document.system.duration.value}}
                            </div>
                            <div class="col table-title noBorder">
                                {{localize "targetCategory"}}
                            </div>
                            <div class="col">
                                {{document.system.targetCategory.value}}
                            </div>
                            <div class="col table-title noBorder">
                                {{localize "castingTime"}}
                            </div>
                            <div class="col">
                                {{document.system.castingTime.value}}
                            </div>
                            <div class="col table-title noBorder">
                                {{localize "KaPCostDetail"}}
                            </div>
                            <div class="col">
                                {{document.system.AsPCostDetail.value}}
                            </div>
                            {{#unless document.parent}}
                            <div class="col table-title noBorder">
                                {{localize "distribution"}}
                            </div>
                            <div class="col">
                                {{document.system.distribution.value}}
                            </div>
                            {{/unless}}
                            <div class="col table-title noBorder">
                                {{localize "resistanceModifier"}}
                            </div>
                            <div class="col">
                                {{localize document.system.resistanceModifier.value}}
                            </div>
                            {{#unless document.parent}}
                            <div class="col table-title noBorder">
                                {{localize "StF"}}
                            </div>
                            <div class="col">
                                {{document.system.StF.value}}
                            </div>
                            {{/unless}}
                        </div>

                </div>
            </div>
            
        </div>
    </div>
</div>