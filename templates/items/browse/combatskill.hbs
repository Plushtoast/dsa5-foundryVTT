<div>
    <h3>{{document.name}}</h3>
    <div class="row-section">
        {{#unless skipHeader}}
        <div class="col sixty">
            {{{hasLocalization (concat "Combatskilldescr." document.name) document.system.description.value}}}
        </div>
        <div class="col zerofive"></div>
        <div class="col fourty">
        {{else}}
        <div class="col row-section">
        {{/unless}}
            <div class="row-section wrap col third">
                <div class="col center">
                    <img src="{{document.img}}" style="width:100%;border:none;" >
                </div>
                <div class="col compendium">
                    <small>{{document.pack}}</small>
                </div>  
            </div>
            <div class="col browseSpacer ten"></div>
            <div class="row-section col sixty browseElement">
                <div class="col groupbox">
                        <div class="row-section wrap">
                            <div class="col table-title noBorder flexrow">
                                <div>
                                    {{localize "StF"}}
                                </div>
                                <div class="flex0">
                                    {{#if document.uuid}}
                                    <button type="button" class="dsadesignbutton noBorder icon fas fa-info show-item" data-type="Item"
                                    data-uuid="{{document.uuid}}"></i></button>
                                    {{/if}}
                                </div>
                            </div>
                            <div class="col">
                                {{localize document.system.StF.value}}
                            </div>
                            <div class="col table-title noBorder">
                                {{localize "guidevalue"}}
                            </div>
                            <div class="col">
                                {{localize (concatUp "CHAR." document.system.guidevalue.value)}}
                            </div>
                            <div class="col table-title noBorder">
                                {{localize "weapontype"}}
                            </div>
                            <div class="col">
                                {{#if (eq document.system.weapontype.value 0)}}
                                {{localize 'TYPES.Item.rangeweapon'}}
                                {{else}}
                                {{localize 'TYPES.Item.meleeweapon'}}
                                {{/if}}
                            </div>
                        </div>

                </div>
            </div>
            
        </div>
    </div>
</div>