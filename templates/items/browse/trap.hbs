<div></div>
    <h3>{{document.name}}</h3>

    <div class="row-section">
        {{#unless skipHeader}}
        <div class="col sixty">
            {{{enrichedDescription}}}
            {{#if (and isGM enrichedGmdescription)}}
            <div class="maskfield">
                {{{enrichedGmdescription}}}
            </div>
            {{/if}}
        </div>
        <div class="col zerofive"></div>
        <div class="col fourty">
        {{else}}
        <div class="col row-section">
        {{/unless}}
            <div class="row-section wrap col third">
                <div class="col center">
                    <img src="{{document.img}}" style="width:100%;border:none;" >
                </div>
                <div class="col compendium">
                    <small>{{document.pack}}</small>
                </div>  
            </div>
            <div class="col browseSpacer ten"></div>
            <div class="row-section col sixty browseElement">
                <div class="col groupbox">
                    <div class="row-section wrap">
                        
                        <div class="col table-title noBorder row-section">
                            <div class="col ninety">
                                {{localize "BOOKITEM.category"}}
                            </div>
                            <div class="col ten center">
                                {{#if document.uuid}}<a class="show-item" data-type="Item" data-uuid="{{document.uuid}}"><i class="fas fa-info"></i></a>{{/if}}
                            </div>                            
                        </div>
                        <div class="col">
                            {{document.system.category}}
                        </div>
                        {{#if document.stealth}}
                        <div class="col table-title noBorder">
                            {{localize "REGIONBEHAVIOR_DSATrap.FIELDS.stealth.label"}}
                        </div>
                        <div class="col">
                            {{document.stealth}}
                        </div>
                        {{/if}}
                        {{#if document.trigger}}
                        <div class="col table-title noBorder">
                            {{localize "REGIONBEHAVIOR_DSATrap.FIELDS.trigger.label"}}
                        </div>
                        <div class="col">
                            {{localize (concat 'REGIONBEHAVIOR_DSATrap.TRIGGERS.' document.trigger)}}
                        </div>
                        {{/if}}
                        {{#if document.tools}}
                        <div class="col table-title noBorder">
                            {{localize "REGIONBEHAVIOR_DSATrap.FIELDS.tools.label"}}
                        </div>
                        <div class="col">
                            {{document.tools}}
                        </div>
                        {{/if}}
                        {{#if document.difficulty}}
                        <div class="col table-title noBorder">
                            {{localize "REGIONBEHAVIOR_DSATrap.FIELDS.difficulty.label"}}
                        </div>
                        <div class="col">
                            {{document.difficulty}}
                        </div>
                        {{/if}}
                        {{#if document.damageFormula}}
                        <div class="col table-title noBorder">
                            {{localize "REGIONBEHAVIOR_DSATrap.FIELDS.damageFormula.label"}}
                        </div>
                        <div class="col">
                            {{document.damageFormula}}
                        </div>
                        {{/if}}  
                    
                    </div>
                </div>
            </div>
            
        </div>
    </div>
</div>