                        <div class="image center" style="flex: 0 0 70px; border-right: 1px solid #7a7971; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 1.1em; background: rgba(0,0,0,0.03);">1</div>
                        <div class="name-icon" style="flex: 1; padding: 8px 10px; display: flex; align-items: center; line-height: 1.3;">{{localize 'PLANT.spoiledRows.R1'}}</div>
                    </li>

