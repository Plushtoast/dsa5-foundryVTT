<div class="plant-spoiled-v2-frame standard-form" data-application-part="main" style="display: flex; flex-direction: column; height: 100%;">
    
    <style>
        .plant-spoiled-v2-frame .browser-item { transition: all 0.2s ease; margin-bottom: 4px; }
        .plant-spoiled-v2-frame .browser-item:hover { background: rgba(0,0,0,0.1) !important; }
        .plant-spoiled-v2-frame .browser-item.selected { 
            background: rgba(83, 41, 2, 0.15) !important; 
            border-color: #532902 !important; 
            box-shadow: inset 0 0 4px rgba(83, 41, 2, 0.3); 
        }
        .plant-spoiled-v2-frame .browser-item.selected .image { 
            background: rgba(83, 41, 2, 0.1) !important; 
            color: #532902; 
        }
        .plant-spoiled-v2-frame .info-icon-container {
            flex: 0 0 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-left: 1px solid rgba(0,0,0,0.1);
            cursor: pointer;
        }
        .plant-spoiled-v2-frame .info-icon-container:hover {
            color: #a01010;
        }
    </style>

    <section class="content" style="display: flex; flex-direction: column; height: 100%; padding-bottom: 5px;">
        
        <div class="processing-group">
            <div style="display: flex; gap: 15px; align-items: center; background: rgba(0,0,0,0.05); border-radius: 5px; padding: 10px 15px; margin-bottom: 15px; border: 1px solid rgba(0,0,0,0.1);">
                <p class="plant-info-text" style="flex: 1; margin: 0; line-height: 1.2;">
                    {{localize 'PLANT.spoiledDescription'}}
                </p>
            </div>
        </div>

        <div style="flex: 1; display: flex; flex-direction: column; overflow: hidden;">
            
            <div class="header-grid" style="display: flex; border: 1px solid #7a7971; border-bottom: 2px solid #532902; background: rgba(0,0,0,0.1); font-weight: bold; margin-bottom: 8px; border-radius: 4px 4px 0 0; min-height: 35px;">
                <div class="header-cell" style="flex: 0 0 70px; border-right: 1px solid #7a7971; display: flex; align-items: center; justify-content: center; gap: 6px;">
                    <i class="fas fa-dice-d20" data-action="rollTable" data-tooltip="{{localize 'PLANT.rollEffectTooltip'}}" style="cursor: pointer; color: #532902; font-size: 1.2em;"></i>
                </div>
                <div class="header-cell" style="flex: 1; display: flex; align-items: center; justify-content: flex-start; padding-left: 15px;">
                    {{localize 'PLANT.spoiledEffect'}}
                </div>
            </div>

            <div class="spoiled-list" style="flex: 1; overflow-y: auto; padding-right: 5px;">
