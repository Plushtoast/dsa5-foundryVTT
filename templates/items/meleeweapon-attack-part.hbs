<div class='row-section'>
  <div class='col eighty'></div>
  <div class='col ten center'>
    {{#if scope}}
      <a data-action='attackDelete' data-key='{{scopeKey}}' data-tooltip='SHEET.DeleteItem'><i class='fa fa-minus'></i></a>
    {{/if}}
  </div>
  <div class='col ten center'>
    <a data-action='attackAdd' data-tooltip='SHEET.alternateAttack'><i class='fa fa-plus'></i></a>
  </div>
</div>
{{#if scope}}
  <div class='form-group'>
    <label>{{localize 'Name'}}</label>
    <div class='form-fields'>
      <input type='text' name='{{scope}}name' value='{{name}}' />
    </div>
  </div>
{{/if}}

{{formGroup systemFields.damage.fields.value value=document.system.damage.value localize=true scope=scope}}

{{#if twoHanded}}

  {{formGroup systemFields.atmod.fields.value value=document.system.atmod.value localize=true scope=scope}}
  {{formGroup systemFields.pamod.fields.value value=document.system.pamod.value localize=true scope=scope}}

{{else}}

  <div class='form-group doubleInput'>
    <label>{{localize 'atmod'}}</label>
    <div class='form-fields'>
      {{formInput systemFields.atmod.fields.value value=document.system.atmod.value localize=true scope=scope}}
      {{formInput systemFields.atmod.fields.offhandMod value=document.system.atmod.offhandMod localize=true scope=scope tooltip='ITEMSHEET.offHandMod'}}
    </div>
  </div>

  <div class='form-group doubleInput'>
    <label>{{localize 'pamod'}}</label>
    <div class='form-fields'>
      {{formInput systemFields.pamod.fields.value value=document.system.pamod.value localize=true scope=scope}}
      {{formInput systemFields.pamod.fields.offhandMod value=document.system.pamod.offhandMod localize=true scope=scope tooltip='ITEMSHEET.offHandMod'}}
    </div>
  </div>
{{/if}}

{{formGroup systemFields.damageThreshold.fields.value value=document.system.damageThreshold.value localize=true scope=scope}}
{{formGroup systemFields.guidevalue.fields.value value=document.system.guidevalue.value localize=true scope=scope}}
{{formGroup systemFields.combatskill.fields.value value=document.system.combatskill.value scope=scope choices=(selfObj combatskills) localize=true}}
{{formGroup systemFields.reach.fields.value value=document.system.reach.value localize=true scope=scope}}

<div class='form-group doubleInput'>
  <label>{{localize 'critBotch'}}</label>
  <div class='form-fields'>
    {{formInput systemFields.crit value=document.system.crit scope=scope tooltip='CriticalSuccess'}}
    {{formInput systemFields.botch value=document.system.botch scope=scope tooltip='CriticalFailure'}}
  </div>
</div>

{{#if isShield}}

  {{formGroup systemFields.reach.fields.shieldSize value=document.system.reach.shieldSize localize=true scope=scope}}

{{/if}}

{{formGroup systemFields.effect.fields.value value=document.system.effect.value localize=true scope=scope}}

<div class='form-group autoHeight'>
  <label>{{localize 'domains'}}</label>
  <div class='form-fields'>
    {{#if domains}}
      <div class='domainsPretty'>
        <ul>{{{domains}}}</ul>
      </div>
    {{/if}}
    <input
      class='{{ifThen domains "domainToggle"}}'
      placeholder='{{localize "WEAPON.clerical"}}, {{localize "WEAPON.magical"}}, {{localize "WEAPON.silverPlated"}}'
      type='text'
      name='{{scope}}system.effect.attributes'
      value='{{document.system.effect.attributes}}'
    />
  </div>
</div>

{{#unless scope}}

  <div class='form-group double'>
    <label>{{localize 'structure'}}</label>
    <div class='form-fields'>
      {{formInput systemFields.structure.fields.value value=document.system.structure.value}}
      <span> / </span>
      {{formInput systemFields.structure.fields.max value=document.system.structure.max}}
    </div>
  </div>

  {{#if armorAndWeaponDamage}}

    {{formGroup systemFields.structure.fields.breakPointRating value=document.system.structure.breakPointRating localize=true}}

  {{/if}}

{{/unless}}

{{#if isOwned}}
  {{#if canBeOffHand}}

    {{formGroup systemFields.worn.fields.offHand value=document.system.worn.offHand localize=true scope=scope}}

  {{/if}}

  {{#if canBeWrongGrip}}

    {{formGroup systemFields.worn.fields.wrongGrip value=document.system.worn.wrongGrip label=(localize wrongGripLabel) localize=true scope=scope tooltip=wrongGripHint}}

  {{/if}}

{{/if}}

{{#unless scope}}

  {{formGroup systemFields.region value=document.system.region localize=true}}

  {{> systems/dsa5/templates/items/traditionArtifact.hbs systemFields=systemFields}}

{{/unless}}