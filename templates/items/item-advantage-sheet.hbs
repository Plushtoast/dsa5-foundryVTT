<div class='tab standard-form scrollable {{tabs.details.cssClass}}' data-tab='details' data-group='{{tabs.details.group}}' class='tab details' data-tab='details'>

  {{formGroup systemFields.APValue.fields.value value=document.system.APValue.value localize=true}}
  {{formGroup systemFields.max.fields.value value=document.system.max.value localize=true}}
  {{formGroup systemFields.requirements.fields.value value=document.system.requirements.value localize=true elementType='textarea' classes='full-height'}}
  {{formGroup systemFields.effect.fields.value value=document.system.effect.value localize=true}}

  {{#if isOwned}}
    <div class='form-group'>
      <label>{{#if canAdvance}}<a data-action='_refundStep'><i class='fas fa-minus'></i></a> {{/if}}{{localize 'stepValue'}}{{#if canAdvance}} <a data-action='_advanceStep'><i class='fas fa-plus'></i></a>{{/if}}</label>
      <div class="form-fields">
          {{formInput systemFields.step.fields.value value=document.system.step.value}}
      </div>      
    </div>
  {{/if}}
</div>