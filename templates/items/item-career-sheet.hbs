<div class='tab standard-form scrollable {{tabs.details.cssClass}}' data-tab='details' data-group='{{tabs.details.group}}' class='tab details' data-tab='details'>

  {{formGroup systemFields.APValue.fields.value value=document.system.APValue.value localize=true}}
  {{formGroup systemFields.languagePoints.fields.value value=document.system.languagePoints.value localize=true}}
  {{formGroup systemFields.requirements.fields.value value=document.system.requirements.value localize=true classes='full-height' elementType='textarea' tooltip='TT.commaSeparated'}}
  {{formGroup systemFields.recommendedAdvantages.fields.value value=document.system.recommendedAdvantages.value localize=true classes='full-height' elementType='textarea' tooltip='TT.commaSeparated'}}
  {{formGroup systemFields.recommendedDisadvantages.fields.value value=document.system.recommendedDisadvantages.value localize=true classes='full-height' elementType='textarea' tooltip='TT.commaSeparated'}}
  {{formGroup systemFields.notsuitableAdvantages.fields.value value=document.system.notsuitableAdvantages.value localize=true classes='full-height' elementType='textarea' tooltip='TT.commaSeparated'}}
  {{formGroup systemFields.notsuitableDisadvantages.fields.value value=document.system.notsuitableDisadvantages.value localize=true classes='full-height' elementType='textarea' tooltip='TT.commaSeparated'}}
  {{formGroup systemFields.skills.fields.value value=document.system.skills.value localize=true classes='full-height' elementType='textarea' tooltip='TT.careerSkills'}}
  {{formGroup systemFields.combatSkills.fields.value value=document.system.combatSkills.value localize=true classes='full-height' elementType='textarea' tooltip='TT.careerSkills'}}
  {{formGroup systemFields.specialAbilities.fields.value value=document.system.specialAbilities.value localize=true classes='full-height' elementType='textarea' tooltip='TT.careerSkills'}}
  {{formGroup systemFields.mageLevel.fields.value value=document.system.mageLevel.value localize=true}}

  {{#if (ne document.system.mageLevel.value 'mundane')}}
    {{formGroup systemFields.guidevalue.fields.value value=document.system.guidevalue.value localize=true}}
    {{formGroup systemFields.guidevalue.fields.factor value=document.system.guidevalue.factor localize=true}}
    {{formGroup systemFields.tradition.fields.value value=document.system.tradition.value localize=true}}

    <div class='form-group'>
      <label>{{#if (eq document.system.mageLevel.value 'clerical')}}{{localize 'aspect'}}{{else}}{{localize 'feature'}}{{/if}}</label>
      <div class="form-fields">
        {{formInput systemFields.feature.fields.value value=document.system.feature.value}}
      </div>
    </div>

    {{#if (eq document.system.mageLevel.value 'clerical')}}
      {{formGroup systemFields.happyTalents.fields.value value=document.system.happyTalents.value localize=true elementType='textarea' classes='full-height'}}
      {{formGroup systemFields.liturgies.fields.value value=document.system.liturgies.value localize=true elementType='textarea' classes='full-height'}}
      {{formGroup systemFields.blessings.fields.value value=document.system.blessings.value localize=true elementType='textarea' classes='full-height'}}
    {{/if}}

    {{#if (eq document.system.mageLevel.value 'magical')}}
      {{formGroup systemFields.spells.fields.value value=document.system.spells.value localize=true elementType='textarea' classes='full-height'}}
      {{formGroup systemFields.spelltricks.fields.value value=document.system.spelltricks.value localize=true elementType='textarea' classes='full-height'}}
      {{formGroup systemFields.spelltrickCount.fields.value value=document.system.spelltrickCount.value localize=true}}
    {{/if}}

  {{/if}}

</div>