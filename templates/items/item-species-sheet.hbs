<div class='tab standard-form scrollable {{tabs.details.cssClass}}' data-tab='details' data-group='{{tabs.details.group}}'>

  {{formGroup systemFields.APValue.fields.value value=document.system.APValue.value localize=true}}
  
  <fieldset>
    <legend>{{localize 'baseValue'}}</legend>
    {{formGroup systemFields.baseValues.fields.wounds.fields.value value=document.system.baseValues.wounds.value localize=true}}
    {{formGroup systemFields.baseValues.fields.soulpower.fields.value value=document.system.baseValues.soulpower.value localize=true}}
    {{formGroup systemFields.baseValues.fields.toughness.fields.value value=document.system.baseValues.toughness.value localize=true}}
    {{formGroup systemFields.baseValues.fields.speed.fields.value value=document.system.baseValues.speed.value localize=true}}
  </fieldset>
  
  {{formGroup systemFields.attributeChange.fields.value value=document.system.attributeChange.value localize=true}}
  {{formGroup systemFields.notsuitableAdvantages.fields.value value=document.system.notsuitableAdvantages.value localize=true classes='full-height' elementType='textarea' tooltip='TT.commaSeparated'}}
  {{formGroup systemFields.notsuitableDisadvantages.fields.value value=document.system.notsuitableDisadvantages.value localize=true classes='full-height' elementType='textarea' tooltip='TT.commaSeparated'}}
  {{formGroup systemFields.recommendedAdvantages.fields.value value=document.system.recommendedAdvantages.value localize=true classes='full-height' elementType='textarea' tooltip='TT.commaSeparated'}}
  {{formGroup systemFields.recommendedDisadvantages.fields.value value=document.system.recommendedDisadvantages.value localize=true classes='full-height' elementType='textarea' tooltip='TT.commaSeparated'}}
  {{formGroup systemFields.requirements.fields.value value=document.system.requirements.value localize=true classes='full-height' elementType='textarea' tooltip='TT.commaSeparated'}}
  {{formGroup systemFields.recommendedCultures.fields.value value=document.system.recommendedCultures.value localize=true classes='full-height' elementType='textarea' tooltip='TT.commaSeparated'}}

  {{#each generatorFields as |generator|}}
    <fieldset>
      <legend class='row-section flexrow'>
        <span>{{generator.label}}</span>
        <button
          type='button'
          class='button icons fas fa-plus dsadesignbutton noBorder flex0'
          data-action='addGeneratorEntry'
          data-field='{{generator.field}}'
          data-tooltip='DOCUMENT.Create'
        ></button>
      </legend>

      {{#if generator.entries.length}}
        <div class='row-section'>
          <label class='col third'>{{localize 'Name'}}</label>
          <label class='col'>{{localize 'Description'}}</label>
          <div class='flex0 row-section'></div>
        </div>

        {{#each generator.entries as |entry|}}
          <div class='row-section' data-key='{{entry.id}}'>
            <div class='col third'>
              <div class='form-fields'>
                <input
                  type='text'
                  name='{{concat "system.generators." generator.field "." entry.id ".name"}}'
                  value='{{entry.rawName}}'
                  placeholder='{{@root.document.name}}'
                />
              </div>
            </div>
            <div class='col'>
              <div class='form-fields'>
                {{#if generator.isTextarea}}
                  <textarea
                    name='{{concat "system.generators." generator.field "." entry.id ".value"}}'
                    rows='4'
                    placeholder='{{generator.placeholder}}'
                  >{{entry.value}}</textarea>
                {{else}}
                  <input
                    type='text'
                    name='{{concat "system.generators." generator.field "." entry.id ".value"}}'
                    value='{{entry.value}}'
                    placeholder='{{generator.placeholder}}'
                  />
                {{/if}}
              </div>
              {{#unless entry.rollable}}
                <small>{{entry.error}}</small>
              {{/unless}}
            </div>
            <div class='flex0 row-section'>
              {{#if entry.rollable}}
                <button
                  type='button'
                  class='icon dsadesignbutton noBorder fas fa-dice-d20 flex0'
                  data-action='rollGeneratorEntry'
                  data-field='{{generator.field}}'
                  data-key='{{entry.id}}'
                  data-tooltip='SHEET.RollEffect'
                ></button>
              {{else}}
                <button
                  type='button'
                  class='icon dsadesignbutton noBorder fas fa-exclamation-triangle flex0'
                  data-tooltip='{{entry.error}}'
                ></button>
              {{/if}}
              <button
                type='button'
                class='icon dsadesignbutton noBorder fas fa-trash flex0'
                data-action='deleteGeneratorEntry'
                data-field='{{generator.field}}'
                data-key='{{entry.id}}'
                data-tooltip='delete'
              ></button>
            </div>
          </div>
        {{/each}}
      {{else}}
        <p>{{localize 'SPECIES_GENERATOR.empty'}}</p>
      {{/if}}
    </fieldset>
  {{/each}}

</div>