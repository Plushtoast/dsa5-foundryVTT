<div class="tab standard-form scrollable {{tabs.details.cssClass}}" data-tab="details" data-group="{{tabs.details.group}}" class="tab">

    <div class="form-group">
        <label class="label-text">{{localize "circle"}}</label>
        <input class="input-text" type="number" name="system.circle" value="{{document.system.circle}}" data-dtype="Number" />
    </div>
    <div class="form-group">
        <label class="label-text">{{localize "domains"}}</label>
        <input class="input-text" type="text" name="system.domain" value="{{document.system.domain}}" data-dtype="String" />
    </div>
    <div class="form-group">
        <label class="label-text">{{localize "attributes"}}</label>
        <input class="input-text" type="text" name="system.attribute" value="{{document.system.attribute}}" data-dtype="String" />
    </div>
    <div class="form-group full-height">
        <label class="label-text">{{localize "skills"}}</label>
        <textarea class="input-text" type="text" name="system.skills" data-dtype="String">{{document.system.skills}}</textarea>
    </div>

</div>