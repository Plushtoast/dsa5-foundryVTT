<div class='tab standard-form scrollable {{tabs.details.cssClass}} gap5px' data-tab='details' data-group='{{tabs.details.group}}'>
  
  {{formGroup systemFields.step.fields.value value=document.system.step.value localize=true}}
  {{formGroup systemFields.poisonType.fields.value value=document.system.poisonType.value localize=true}}
  {{formGroup systemFields.effect.fields.value value=document.system.effect.value localize=true}}
  {{formGroup systemFields.start.fields.value value=document.system.start.value localize=true}}
  {{formGroup systemFields.duration.fields.value value=document.system.duration.value localize=true}}
  {{formGroup systemFields.resistance.fields.value value=document.system.resistance.value localize=true}}
  {{formGroup systemFields.subcategory value=document.system.subcategory localize=true}}

  {{#if (eq document.system.subcategory 3)}}
    {{formGroup systemFields.sucht value=document.system.sucht localize=true}}
  {{/if}}

  {{#if (eq document.system.subcategory 2)}}
    {{formGroup systemFields.region value=document.system.region localize=true}}
    {{formGroup systemFields.ql value=document.system.ql localize=true}}
  {{/if}}
</div>