<div class='tab standard-form scrollable {{tabs.details.cssClass}}' data-tab='details' data-group='{{tabs.details.group}}' class='tab details' data-tab='details'>
  <div class='form-group'>
    <label class='label-text'>{{localize 'stepValue'}}</label>
    <input class='input-text' type='number' name='system.step.value' value='{{document.system.step.value}}' data-dtype='Number' />
  </div>
  <div class='form-group'>
    <label class='label-text'>{{localize 'poisonType'}}</label>
    <input class='input-text' type='text' name='system.poisonType.value' value='{{document.system.poisonType.value}}' data-dtype='String' />
  </div>
  <div class='form-group'>
    <label class='label-text'>{{localize 'effect'}}</label>
    <input class='input-text' type='text' name='system.effect.value' value='{{document.system.effect.value}}' data-dtype='String' />
  </div>
  <div class='form-group'>
    <label class='label-text'>{{localize 'start'}}</label>
    <input class='input-text' type='text' name='system.start.value' value='{{document.system.start.value}}' data-dtype='String' />
  </div>
  <div class='form-group'>
    <label class='label-text'>{{localize 'duration'}}</label>
    <input class='input-text' type='text' name='system.duration.value' value='{{document.system.duration.value}}' data-dtype='String' />
  </div>

  <div class='form-group'>
    <label class='label-text'>{{localize 'resistanceModifier'}}</label>
    <select name='system.resistance.value' data-dtype='String'>
      {{selectOptions resistances selected=document.system.resistance.value localize=true}}
    </select>
  </div>
  <div class='form-group'>
    <label class='label-text'>{{localize 'COMBATSKILLCATEGORY.subcategory'}}</label>
    <select name='system.subcategory' data-dtype='Number'>
      {{selectOptions poisonCategories selected=document.system.subcategory localize=true}}
    </select>
  </div>
  {{#if (eq document.system.subcategory 3)}}
    <div class='form-group'>
      <label class='label-text'>{{localize 'poisonCategory.3'}}</label>
      <input class='input-text' type='text' name='system.sucht' value='{{document.system.sucht}}' data-dtype='String' />
    </div>
  {{/if}}
  {{#if (eq document.system.subcategory 2)}}
    <div class='form-group'>
      <label class='label-text'>{{localize 'PLANT.region'}}</label>
      <input class='input-text' type='text' name='system.region' value='{{document.system.region}}' data-dtype='String' />
    </div>
    <div class='form-group'>
      <label class='label-text'>{{localize 'POISON.ql'}}</label>
      <input class='input-text' type='text' name='system.ql' value='{{document.system.ql}}' data-dtype='String' />
    </div>
  {{/if}}
</div>