<div class='tab standard-form scrollable {{tabs.details.cssClass}}' data-tab='details' data-group='{{tabs.details.group}}'>

  {{formGroup systemFields.subType value=document.system.subType localize=true choices=systemFields.subType.choices}}
  {{formGroup systemFields.skill value=document.system.skill localize=true choices=(selfObj allSkills) blank='-'}}
  {{formGroup systemFields.modifier value=document.system.modifier localize=true}}
  <div class='form-group full-height'>
    <label>{{localize 'CHARAbbrev.QS'}} 1</label>
    <div class='form-fields'>
      {{formInput systemFields.qs1 value=document.system.qs1 toggled=true enriched=enrichedqs1 placeholder=placeholderQs1}}
    </div>
  </div>
  <div class='form-group full-height'>
    <label>{{localize 'CHARAbbrev.QS'}} 2</label>
    <div class='form-fields'>
      {{formInput systemFields.qs2 value=document.system.qs2 toggled=true enriched=enrichedqs2 placeholder=placeholderQs2}}
    </div>
  </div>
  <div class='form-group full-height'>
    <label>{{localize 'CHARAbbrev.QS'}} 3</label>
    <div class='form-fields'>
      {{formInput systemFields.qs3 value=document.system.qs3 toggled=true enriched=enrichedqs3 placeholder=placeholderQs3}}
    </div>
  </div>
  <div class='form-group full-height'>
    <label>{{localize 'CHARAbbrev.QS'}} 4</label>
    <div class='form-fields'>
      {{formInput systemFields.qs4 value=document.system.qs4 toggled=true enriched=enrichedqs4 placeholder=placeholderQs4}}
    </div>
  </div>
  <div class='form-group full-height'>
    <label>{{localize 'CHARAbbrev.QS'}} 5</label>
    <div class='form-fields'>
      {{formInput systemFields.qs5 value=document.system.qs5 toggled=true enriched=enrichedqs5 placeholder=placeholderQs5}}
    </div>
  </div>
  <div class='form-group full-height'>
    <label>{{localize 'CHARAbbrev.QS'}} 6</label>
    <div class='form-fields'>
      {{formInput systemFields.qs6 value=document.system.qs6 toggled=true enriched=enrichedqs6 placeholder=placeholderQs6}}
    </div>
  </div>
  <hr style='margin:20px 0px;' />
  <div class='form-group full-height'>
    <label>{{localize 'Failure'}}</label>
    <div class='form-fields'>
      {{formInput systemFields.fail value=document.system.fail toggled=true enriched=enrichedfail placeholder=placeholderFail}}
    </div>
  </div>
  <div class='form-group full-height'>
    <label>{{localize 'CriticalFailure'}}</label>
    <div class='form-fields'>
      {{formInput systemFields.botch value=document.system.botch toggled=true enriched=enrichedbotch placeholder=placeholderBotch}}
    </div>
  </div>
  <div class='form-group full-height'>
    <label>{{localize 'CriticalSuccess'}}</label>
    <div class='form-fields'>
      {{formInput systemFields.crit value=document.system.crit toggled=true enriched=enrichedcrit placeholder=placeholderCrit}}
    </div>
  </div>
</div>
