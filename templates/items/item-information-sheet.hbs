<div class='tab standard-form scrollable {{tabs.details.cssClass}} gap5px' data-tab='details' data-group='{{tabs.details.group}}'>

  {{formGroup systemFields.subType value=document.system.subType localize=true choices=systemFields.subType.choices}}

  {{#if isMagicalAnalysis}}
    <p class='hint'>{{localize 'MAGICANALYSIS.sheetSkillNote'}}</p>
    {{formGroup systemFields.modifier value=document.system.modifier localize=true}}
  {{else}}
    {{formGroup systemFields.skill value=document.system.skill localize=true choices=(selfObj allSkills) blank='-'}}
    {{formGroup systemFields.modifier value=document.system.modifier localize=true}}
  {{/if}}

  <div class='form-group full-height'>
    <label>{{localize 'CHARAbbrev.QS'}} 1</label>
    <div class='form-fields'>
      {{formInput systemFields.qs1 value=document.system.qs1 toggled=true enriched=enrichedqs1}}
    </div>
    {{#if isMagicalAnalysis}}{{#if defaultQs1}}<p class='hint'>{{defaultQs1}}</p>{{/if}}{{/if}}
  </div>
  <div class='form-group full-height'>
    <label>{{localize 'CHARAbbrev.QS'}} 2</label>
    <div class='form-fields'>
      {{formInput systemFields.qs2 value=document.system.qs2 toggled=true enriched=enrichedqs2}}
    </div>
    {{#if isMagicalAnalysis}}{{#if defaultQs2}}<p class='hint'>{{defaultQs2}}</p>{{/if}}{{/if}}
  </div>
  <div class='form-group full-height'>
    <label>{{localize 'CHARAbbrev.QS'}} 3</label>
    <div class='form-fields'>
      {{formInput systemFields.qs3 value=document.system.qs3 toggled=true enriched=enrichedqs3}}
    </div>
    {{#if isMagicalAnalysis}}{{#if defaultQs3}}<p class='hint'>{{defaultQs3}}</p>{{/if}}{{/if}}
  </div>
  <div class='form-group full-height'>
    <label>{{localize 'CHARAbbrev.QS'}} 4</label>
    <div class='form-fields'>
      {{formInput systemFields.qs4 value=document.system.qs4 toggled=true enriched=enrichedqs4}}
    </div>
    {{#if isMagicalAnalysis}}{{#if defaultQs4}}<p class='hint'>{{defaultQs4}}</p>{{/if}}{{/if}}
  </div>
  <div class='form-group full-height'>
    <label>{{localize 'CHARAbbrev.QS'}} 5</label>
    <div class='form-fields'>
      {{formInput systemFields.qs5 value=document.system.qs5 toggled=true enriched=enrichedqs5}}
    </div>
    {{#if isMagicalAnalysis}}{{#if defaultQs5}}<p class='hint'>{{defaultQs5}}</p>{{/if}}{{/if}}
  </div>
  <div class='form-group full-height'>
    <label>{{localize 'CHARAbbrev.QS'}} 6</label>
    <div class='form-fields'>
      {{formInput systemFields.qs6 value=document.system.qs6 toggled=true enriched=enrichedqs6}}
    </div>
    {{#if isMagicalAnalysis}}{{#if defaultQs6}}<p class='hint'>{{defaultQs6}}</p>{{/if}}{{/if}}
  </div>
  <hr style='margin:20px 0px;' />
  <div class='form-group full-height'>
    <label>{{localize 'Failure'}}</label>
    <div class='form-fields'>
      {{formInput systemFields.fail value=document.system.fail toggled=true enriched=enrichedfail}}
    </div>
    {{#if isMagicalAnalysis}}{{#if defaultFail}}<p class='hint'>{{defaultFail}}</p>{{/if}}{{/if}}
  </div>
  <div class='form-group full-height'>
    <label>{{localize 'CriticalFailure'}}</label>
    <div class='form-fields'>
      {{formInput systemFields.botch value=document.system.botch toggled=true enriched=enrichedbotch}}
    </div>
    {{#if isMagicalAnalysis}}{{#if defaultBotch}}<p class='hint'>{{defaultBotch}}</p>{{/if}}{{/if}}
  </div>
  <div class='form-group full-height'>
    <label>{{localize 'CriticalSuccess'}}</label>
    <div class='form-fields'>
      {{formInput systemFields.crit value=document.system.crit toggled=true enriched=enrichedcrit}}
    </div>
    {{#if isMagicalAnalysis}}{{#if defaultCrit}}<p class='hint'>{{defaultCrit}}</p>{{/if}}{{/if}}
  </div>
</div>
