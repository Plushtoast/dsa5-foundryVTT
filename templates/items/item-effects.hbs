<div class="tab standard-form scrollable {{tabs.effects.cssClass}}" data-tab="effects" data-group="{{tabs.effects.group}}">
    {{#unless noActiveEffects}}
    <div class="row-section wrap margin-top">

        <div class="col row-section skills table-title lineheight">
            <div class="col ten">

            </div>
            <div class="col eighty">
                {{localize "effect"}}
            </div>
            <div class="col ten flexrow">
                <button type="button" class="icon noBorder dsadesignbutton fa fa-plus" data-action="statusAdd" data-tooltip="CONDITION.add"></button>
            </div>
        </div>
        {{#each conditions as |item i|}}
        <div class="row-section col skills statusEffect" data-id="{{item._id}}">
            <div class="col ten">
                <img {{ifThen item.disabled 'style="opacity:0.5;"' ''}} src="{{item.img}}" />
            </div>
            <div class="col seventy">
                <a data-action="conditionShow" class="condition-show" data-id="{{item._id}}">{{localize item.name}}{{successEffect item ../document}}</a>
            </div>

            <div class="col five right">
                <a data-action="conditionEdit" class="condition-edit" data-tooltip="SHEET.EditItem" data-id="{{item._id}}"><i class="fa fa-edit"></i></a> 
                {{#if item.disabled}}
                <a data-action="conditionToggle" class="condition-toggle" data-tooltip="SHEET.activate"><i class="far fa-circle"></i></a>
                {{else}}
                <a data-action="conditionToggle" class="condition-toggle" data-tooltip="SHEET.deactivate"><i class="far fa-check-circle"></i></a>
                {{/if}}
            </div>
        </div>
        {{/each}} 
        {{#each transferedConditions as |item i|}}
        <div class="row-section col skills statusEffect" data-id="{{item._id}}">
            <div class="col ten">
                <img {{ifThen item.disabled 'style="opacity:0.5;"' ''}} src="{{item.img}}" />
            </div>
            <div class="col seventy">
                <a data-action="conditionShow" class="condition-show" data-id="{{item._id}}">{{localize item.name}}</a>
            </div>
            <div class="col five right">
                <a data-action="conditionEdit" class="condition-edit" data-tooltip="SHEET.EditItem" data-id="{{item._id}}"><i class="fa fa-edit"></i></a> {{#if item.disabled}}
                <a data-action="conditionToggle" class="condition-toggle" data-tooltip="SHEET.activate"><i class="far fa-circle"></i></a> {{else}}
                <a data-action="conditionToggle" class="condition-toggle" data-tooltip="SHEET.deactivate"><i class="far fa-check-circle"></i></a> {{/if}}
            </div>
        </div>
        {{/each}}
    </div>
    {{/unless}}
    {{#if canOnUseEffect}}
    <div class="form-group full-height" style="margin-top:40px;">
        <label>{{localize 'ActiveEffects.advancedFunctions.onUseEffect'}}</label>
        <div class="form-fields height100">
            <code-mirror language="javascript" indent="2" name="flags.dsa5.onUseEffect" data-tooltip="ActiveEffects.placeholder.onUseEffect">{{~document.flags.dsa5.onUseEffect~}}</code-mirror>
        </div>        
    </div>
    {{/if}}
</div>