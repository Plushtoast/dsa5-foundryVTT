<div class="tab standard-form scrollable {{tabs.details.cssClass}} gap5px" data-tab="details" data-group="{{tabs.details.group}}">
    
    {{#if hasAlternateAttacks}}
        <nav class="sheet-tabs tabs">
            <a class="tabelement lineheight {{ifThen (eq alternateAttackTab 'baseAttack') 'active' ''}}" data-action="tab" data-tab="baseAttack" data-group="alternateAttacks" >{{localize 'CHAR.ATTACK'}}</a>
            {{#each alternateAttacks as |item key|}}
                <a class="tabelement lineheight {{ifThen (eq ../alternateAttackTab key) 'active' ''}}" data-action="tab" data-group="alternateAttacks" data-tab="{{key}}">{{item.name}}</a>
            {{/each}}
        </nav>
        <section class="content2">
            <div class="tab {{ifThen (eq alternateAttackTab 'baseAttack') 'active' ''}}" data-group="alternateAttacks" class="tab" data-tab="baseAttack">
                {{> systems/dsa5/templates/items/meleeweapon-attack-part.hbs}}
            </div>
            {{#each alternateAttacks as |item key|}}
            <div class="tab {{ifThen (eq ../alternateAttackTab key) 'active' ''}}" data-tab="{{key}}" data-group="alternateAttacks">
                {{> systems/dsa5/templates/items/meleeweapon-attack-part.hbs document=item systemFields=../systemFields combatskills=../combatskills showImprovisedToggle=item.showImprovisedToggle scope=(concat 'flags.dsa5.alternateAttacks.' key '.') scopeKey=key}}
            </div>
            {{/each}}
        </section>
    {{else}}
        {{> systems/dsa5/templates/items/meleeweapon-attack-part.hbs}}
    {{/if}}
</div>