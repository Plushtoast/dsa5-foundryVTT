<div
  class='tab standard-form scrollable {{tabs.description.cssClass}}'
  data-tab='description'
  data-group='{{tabs.description.group}}'
  class='tab description'
  data-tab='description'
>
  {{#if hasLocalization}} 
    {{{localize (concat localizerPrefix document.name)}}}
  {{else}}
    {{formInput systemFields.description.fields.value value=document.system.description.value toggled=true enriched=enrichedDescription}}
  {{/if}}
</div>