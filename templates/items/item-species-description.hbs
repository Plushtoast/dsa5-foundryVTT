<div
  class='tab standard-form scrollable {{tabs.description.cssClass}}'
  data-tab='description'
  data-group='{{tabs.description.group}}'
  class='tab description'
  data-tab='description'
>
  <div>
    {{#if hasLocalization}}
      <img src='{{document.img}}' style='max-width:50%; max-height: 100%;float:right;' data-action='editImage' />
      {{{localize (concat 'Racedescr.' document.name)}}}
    {{else}}
      <div class='row-section'>
        <div class='col two'>
          {{editor enrichedDescription target='system.description.value' button=true owner=owner editable=editable engine='prosemirror'}}
        </div>
        <div class='col two'>
          <img src='{{document.img}}' style='max-width:100%; max-height: 100%;' data-action='editImage' />
        </div>
      </div>
    {{/if}}
  </div>
</div>