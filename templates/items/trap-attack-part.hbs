<div class='flexcol gap5px'>
  <div class='flexrow flexAlignEnd'>
    {{#if scopeKey}}
      <button type='button' class='icon fa fa-minus noBorder dsadesignbutton' data-action='deleteTrapAttack' data-key='{{scopeKey}}' data-tooltip='SHEET.DeleteItem'></button>
    {{/if}}
    <button type='button' class='icon fa fa-plus noBorder dsadesignbutton' data-action='addTrapAttack' data-tooltip='SHEET.alternateAttack'></button>
  </div>
  {{#if scopeKey}}
    {{formGroup systemFields.attacks.element.fields.name name=(concat 'system.attacks.' scopeKey '.name') value=attack.name localize=true}}
    {{formGroup systemFields.attacks.element.fields.damageFormula name=(concat 'system.attacks.' scopeKey '.damageFormula') value=attack.damageFormula localize=true}}
    {{#if trapSheet.showAttack}}
      {{formGroup systemFields.attacks.element.fields.weaponType name=(concat 'system.attacks.' scopeKey '.weaponType') value=attack.weaponType localize=true}}
      {{formGroup systemFields.attacks.element.fields.at name=(concat 'system.attacks.' scopeKey '.at') value=attack.at localize=true}}
      {{formGroup systemFields.attacks.element.fields.traits name=(concat 'system.attacks.' scopeKey '.traits') value=attack.traits localize=true}}
    {{/if}}
  {{else}}
    {{formGroup systemFields.damageFormula value=document.system.damageFormula localize=true}}
    {{#if trapSheet.showAttack}}
      {{formGroup systemFields.attack.fields.weaponType name='system.attack.weaponType' value=document.system.attack.weaponType localize=true}}
      {{formGroup systemFields.attack.fields.at name='system.attack.at' value=document.system.attack.at localize=true}}
      {{formGroup systemFields.attack.fields.traits name='system.attack.traits' value=document.system.attack.traits localize=true}}
    {{/if}}
    {{#if trapFlow.defenses}}
    <div class="dsa-info-box">
      <p class="dsa-info-text small"><b>{{localize "REGIONBEHAVIOR_DSATrap.responses"}}</b></p>
      {{#each trapFlow.defenses as |entry|}}
      <p class="dsa-info-text">{{entry.label}} <span class="dsa-pip">{{entry.type}}</span></p>
      {{/each}}
      {{#each trapFlow.damages as |entry|}}
      <p class="dsa-info-text">{{entry.label}} <span class="dsa-pip">{{entry.type}}</span>{{#if entry.formula}} {{entry.formula}}{{/if}}</p>
      {{/each}}
    </div>
    {{/if}}
  {{/if}}
</div>
