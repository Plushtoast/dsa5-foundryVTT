<header class="item-header">
    <h1>
        {{formInput document.schema.fields.name value=document.name placeholder="Item Name" classes="item-name dsahidden" placeholder="{{localize 'Name'}}"}}
        <svg viewBox="0 0 320 40" width="320" height="40" xmlns="http://www.w3.org/2000/svg">
            <text text-anchor="start" dominant-baseline="hanging" font-size="20">
                {{document.system.detail_name}}
            </text>
        </svg>
    </h1>
</header>