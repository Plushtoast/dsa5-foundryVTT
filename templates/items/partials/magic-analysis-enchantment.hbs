{{#if showMagicAnalysis}}
  <hr />
  <div class='magic-analysis-section'>
    <h3>{{localize 'MAGICANALYSIS.title'}}</h3>

    {{#if isGM}}
      <div class='form-group'>
        <label>{{localize 'MAGICANALYSIS.mode'}}</label>
        <select class='magic-analysis-mode'>
          <option value='default' {{#if (eq magicAnalysis.mode 'default')}}selected{{/if}}>{{localize 'MAGICANALYSIS.modeDefault'}}</option>
          <option value='custom' {{#if (eq magicAnalysis.mode 'custom')}}selected{{/if}}>{{localize 'MAGICANALYSIS.modeCustom'}}</option>
          <option value='linked' {{#if (eq magicAnalysis.mode 'linked')}}selected{{/if}}>{{localize 'MAGICANALYSIS.modeLinked'}}</option>
        </select>
      </div>

      {{#if (eq magicAnalysis.mode 'linked')}}
        <div class='form-group'>
          <label>{{localize 'MAGICANALYSIS.linkedItem'}}</label>
          <input type='text' class='magic-analysis-linked' value='{{magicAnalysis.linkedUuid}}' placeholder='@UUID[...]' />
        </div>
      {{/if}}

      {{#if (eq magicAnalysis.mode 'custom')}}
        {{#each magicAnalysisQsFields as |field|}}
          <div class='form-group full-height'>
            <label>{{field.label}}</label>
            <div class='form-fields'>
              <textarea class='magic-analysis-custom' data-field='{{field.key}}'>{{field.value}}</textarea>
            </div>
          </div>
        {{/each}}
      {{else if (eq magicAnalysis.mode 'default')}}
        <div class='magic-analysis-preview'>
          {{#each magicAnalysisPreview as |entry|}}
            <div class='form-group'>
              <label>{{entry.label}}</label>
              <div class='form-fields'>{{{entry.html}}}</div>
            </div>
          {{/each}}
        </div>
      {{/if}}
    {{/if}}

    <button type='button' data-action='magicAnalysisStart'>
      {{localize 'MAGICANALYSIS.start'}}
    </button>
  </div>
{{/if}}
