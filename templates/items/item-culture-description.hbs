<div
  class='tab standard-form scrollable {{tabs.description.cssClass}}'
  data-tab='description'
  data-group='{{tabs.description.group}}'
  class='tab description'
  data-tab='description'
>
  <div class='row-section'>
    <div class='col sixty'>
      {{formInput systemFields.description.fields.value value=document.system.description.value toggled=true enriched=enrichedDescription}}
    </div>
    <div class='col fourty'>
      <img src='{{document.img}}' style='max-width:100%; max-height: 100%;float: left;' data-action='editImage' />
      {{formInput systemFields.clothing.fields.value value=document.system.clothing.value toggled=true enriched=enrichedClothing}}
    </div>
  </div>
</div>