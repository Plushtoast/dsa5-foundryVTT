<div class='tab standard-form scrollable {{tabs.details.cssClass}}' data-tab='details' data-group='{{tabs.details.group}}' class='tab details' data-tab='details'>
  <div class='form-group'>
    <label class='label-text'>{{localize 'APValue'}}</label>
    <input class='input-text' type='number' name='system.APValue.value' value='{{document.system.APValue.value}}' data-dtype='Number' />
  </div>
  <div class='form-group'>
    <label class='label-text'>{{localize 'requiredFW'}}</label>
    <input class='input-text' type='number' name='system.talentValue' value='{{document.system.talentValue}}' data-dtype='Number' />
  </div>
  <div class='form-group'>
    <label class='label-text'>{{localize (concat 'TYPES.Item.' document.system.category)}}</label>
    <input class='input-text' type='text' name='system.source' value='{{document.system.source}}' data-dtype='String' {{ifThen isOwned 'disabled'}} />
  </div>
  <div class='form-group'>
    <label class='label-text'>{{localize 'Category'}}</label>
    <select name='system.category' data-dtype='String' {{ifThen isOwned 'disabled'}}>
      {{selectOptions categories selected=document.system.category localize=true}}
    </select>
  </div>
</div>