<div class="tab standard-form scrollable {{tabs.details.cssClass}}" data-tab="details" data-group="{{tabs.details.group}}" class="tab">
    <div class="form-group">
        <label class="label-text">{{localize "equipmentType"}}</label>
        <select name="system.equipmentType.value" data-dtype="String">
            {{selectOptions equipmentTypes selected=document.system.equipmentType.value localize=true}}
        </select>
    </div>

    <div class="form-group double">
        <label class="label-text">{{localize "structure"}}</label>
        <input class="input-text" type="number" name="system.structure.value" value="{{document.system.structure.value}}" data-dtype="Number" /><span> / </span>
        <input class="input-text" type="number" name="system.structure.max" value="{{document.system.structure.max}}" data-dtype="Number" />
    </div>
    
    <div class="form-group">
        <label class="label-text">{{localize "wearable"}}</label>
        <input type="checkbox" name="system.worn.wearable" value="{{document.system.worn.wearable}}" data-dtype="Boolean" {{checked document.system.worn.wearable}}/>
    </div>

    {{#if (eq document.system.equipmentType.value 'bags')}}
    <div class="form-group">
        <label class="label-text">{{localize "carrycapacity"}}</label>
        <input class="input-text" type="number" name="system.capacity" value="{{document.system.capacity}}" data-dtype="Number" />
    </div>
    {{/if}}

    <div class="form-group">
        <label class="label-text">{{localize "effect"}}</label>
        <input class="input-text" type="text" name="system.effect.value" value="{{document.system.effect.value}}" data-dtype="String" />
    </div>
    <div class="form-group autoHeight">
        <label class="label-text">{{localize "domains"}}</label>
        {{#if domains}}
        <div class="input-text domainsPretty">
            <ul>{{{domains}}}</ul>
        </div>
        {{/if}}
        <input class="input-text {{ifThen domains 'domainToggle'}}" placeholder="{{localize 'WEAPON.clerical'}}, {{localize 'WEAPON.magical'}}" type="text" name="system.effect.attributes" value="{{document.system.effect.attributes}}" data-dtype="String" />
    </div>
    <div class="form-group">
        <label class="label-text">{{localize "PLANT.region"}}</label>
        <input class="input-text" type="text" name="system.region" value="{{document.system.region}}" data-dtype="String" />
    </div>
    {{> systems/dsa5/templates/items/traditionArtifact.hbs}}
</div>