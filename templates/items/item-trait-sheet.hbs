<div class='tab standard-form scrollable {{tabs.details.cssClass}}' data-tab='details' data-group='{{tabs.details.group}}' class='tab details' data-tab='details'>

  {{formGroup systemFields.traitType.fields.value value=document.system.traitType.value localize=true}}

  {{#if (eq document.system.traitType.value 'rangeAttack')}}

    {{formGroup systemFields.at.fields.value value=document.system.at.value label='CHAR.ATTACK' localize=true}}
    {{formGroup systemFields.damage.fields.value value=document.system.damage.value localize=true}}
    {{formGroup systemFields.reach.fields.value value=document.system.reach.value localize=true}}
    {{formGroup systemFields.reloadTime.fields.value value=document.system.reloadTime.value localize=true}}
    {{formGroup systemFields.effect.fields.value value=document.system.effect.value localize=true}}

  {{else if (eq document.system.traitType.value 'meleeAttack')}}

    {{formGroup systemFields.at.fields.value value=document.system.at.value label='CHAR.ATTACK' localize=true}}
    {{formGroup systemFields.pa value=document.system.pa localize=true}}
    {{formGroup systemFields.damage.fields.value value=document.system.damage.value localize=true}}
    {{formGroup systemFields.reach.fields.value value=document.system.reach.value localize=true choices=ranges blank=false}}
    {{formGroup systemFields.effect.fields.value value=document.system.effect.value localize=true}}

    <div class='form-group autoHeight'>
      <label>{{localize 'domains'}}</label>
      <div class='form-fields'>
        {{#if domains}}
          <div class='domainsPretty'>
            <ul>{{{domains}}}</ul>
          </div>
        {{/if}}
        <input
          class='{{ifThen domains "domainToggle"}}'
          placeholder='{{localize "WEAPON.clerical"}}, {{localize "WEAPON.magical"}}, {{localize "WEAPON.silverPlated"}}'
          type='text'
          name='system.effect.attributes'
          value='{{document.system.effect.attributes}}'
        />
      </div>
    </div>

  {{else if (eq document.system.traitType.value 'armor')}}

    {{formGroup systemFields.at.fields.value value=document.system.at.value label='protection' localize=true}}

  {{else if (eq document.system.traitType.value 'familiar')}}
    
    {{formGroup systemFields.APValue.fields.value value=document.system.APValue.value localize=true}}
    {{formGroup systemFields.AsPCost.fields.value value=document.system.AsPCost.value label='AsPCost' localize=true}}
    {{formGroup systemFields.duration.fields.value value=document.system.duration.value localize=true}}
    {{formGroup systemFields.aspect.fields.value value=document.system.aspect.value label='aspect' localize=true}}

  {{else if (eq document.system.traitType.value 'trick')}}

    {{formGroup systemFields.APValue.fields.value value=document.system.APValue.value localize=true}}
    {{formGroup systemFields.aspect.fields.value value=document.system.aspect.value label='requirements' localize=true}}

  {{else if (eq document.system.traitType.value 'entity')}}

    {{formGroup systemFields.distribution value=document.system.distribution localize=true}}
    {{formGroup systemFields.AsPCost.fields.value value=document.system.AsPCost.value label='CHARAbbrev.QS' localize=true}}
    {{formGroup systemFields.at.fields.value value=document.system.at.value label='maxlevel' localize=true}}

    {{#if isOwned}}

      {{formGroup systemFields.step.fields.value value=document.system.step.value localize=true}}
      
    {{/if}}
  {{else if (eq document.system.traitType.value 'summoning')}}

    {{formGroup systemFields.distribution value=document.system.distribution localize=true}}
    {{formGroup systemFields.at.fields.value value=document.system.at.value localize=true label='conjuringDifficulty'}}

  {{/if}}

</div>