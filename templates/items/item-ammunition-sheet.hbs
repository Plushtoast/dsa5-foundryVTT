<div class='tab standard-form scrollable {{tabs.details.cssClass}}' data-tab='details' data-group='{{tabs.details.group}}' class='tab'>

  {{formGroup systemFields.ammunitiongroup.fields.value value=document.system.ammunitiongroup.value localize=true}}

  {{#if (eq document.system.ammunitiongroup.value 'mag')}}
    <div class='form-group double'>
      <label>{{localize 'mag'}}</label>
      <div class="form-fields">
        {{formInput systemFields.mag.fields.value value=document.system.mag.value}}
        <span> / </span>
        {{formInput systemFields.mag.fields.max value=document.system.mag.max}}
      </div>
    </div>
  {{/if}}
  {{formGroup systemFields.atmod value=document.system.atmod localize=true}}
  {{formGroup systemFields.damageMod value=document.system.damageMod localize=true}}
  {{formGroup systemFields.rangeMultiplier value=document.system.rangeMultiplier localize=true}}
  {{formGroup systemFields.armorMod value=document.system.armorMod localize=true}}
  <div class='form-group autoHeight'>
    <label>{{localize 'domains'}}</label>
    <div class='form-fields'>
      {{#if domains}}
        <div class='domainsPretty'>
          <ul>{{{domains}}}</ul>
        </div>
      {{/if}}
      <input
        class='{{ifThen domains "domainToggle"}}'
        placeholder='{{localize "WEAPON.clerical"}}, {{localize "WEAPON.magical"}}, {{localize "WEAPON.silverPlated"}}'
        type='text'
        name='system.effect.attributes'
        value='{{document.system.effect.attributes}}'
      />
    </div>
  </div>
  
</div>