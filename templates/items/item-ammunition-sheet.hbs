<div class='tab standard-form scrollable {{tabs.details.cssClass}}' data-tab='details' data-group='{{tabs.details.group}}' class='tab'>
  <div class='form-group'>
    <label class='label-text'>{{localize 'ammunitiongroup'}}</label>
    <select name='system.ammunitiongroup.value' data-dtype='String'>
      {{selectOptions ammunitiongroups selected=document.system.ammunitiongroup.value localize=true}}
    </select>
  </div>
  {{#if (eq document.system.ammunitiongroup.value 'mag')}}
    <div class='form-group double'>
      <label class='label-text'>{{localize 'mag'}}</label>
      <input class='input-text' type='number' name='system.mag.value' value='{{document.system.mag.value}}' data-dtype='Number' /><span> / </span>
      <input class='input-text' type='number' name='system.mag.max' value='{{document.system.mag.max}}' data-dtype='Number' />
    </div>
  {{/if}}
  <div class='form-group'>
    <label class='label-text'>{{localize 'atmod'}}</label>
    <input class='input-text' type='number' name='system.atmod' value='{{document.system.atmod}}' data-dtype='Number' />
  </div>
  <div class='form-group'>
    <label class='label-text'>{{localize 'MODS.damage'}}</label>
    <input class='input-text' type='text' name='system.damageMod' value='{{document.system.damageMod}}' data-dtype='String' />
  </div>
  <div class='form-group'>
    <label class='label-text'>{{localize 'MODS.range'}}</label>
    <input class='input-text' type='number' step='0.1' name='system.rangeMultiplier' value='{{document.system.rangeMultiplier}}' data-dtype='Number' />
  </div>
  <div class='form-group'>
    <label class='label-text'>{{localize 'MODS.armor'}}</label>
    <input class='input-text' type='text' name='system.armorMod' value='{{document.system.armorMod}}' data-dtype='String' />
  </div>
  <div class='form-group autoHeight'>
    <label class='label-text'>{{localize 'domains'}}</label>
    {{#if domains}}
      <div class='input-text domainsPretty'>
        <ul>{{{domains}}}</ul>
      </div>
    {{/if}}
    <input
      class='input-text {{ifThen domains "domainToggle"}}'
      placeholder='{{localize "WEAPON.clerical"}}, {{localize "WEAPON.magical"}}, {{localize "WEAPON.silverPlated"}}'
      type='text'
      name='system.effect.attributes'
      value='{{document.system.effect.attributes}}'
      data-dtype='String'
    />
  </div>
</div>