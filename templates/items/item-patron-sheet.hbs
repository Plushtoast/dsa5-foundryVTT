<div class="tab standard-form scrollable {{tabs.details.cssClass}}" data-tab="details" data-group="{{tabs.details.group}}" class="tab">

    <div class="form-group">
        <label class="label-text">{{localize "skills"}}</label>
        <input class="input-text" type="text" name="system.talents" value="{{document.system.talents}}" data-dtype="String" />
    </div>
    <div class="form-group">
        <label class="label-text">{{localize "TYPES.Item.culture"}}</label>
        <input class="input-text" type="text" name="system.culture" value="{{document.system.culture}}" data-dtype="String" />
    </div>

    <div class="form-group">
        <label class="label-text">{{localize "Category"}}</label>
        <select name="system.category" data-dtype="Number">
            {{selectOptions patronCategories selected=document.system.category valueAttr="val" labelAttr="name" localize=true}}
        </select>
    </div>
    <div class="form-group">
        <label class="label-text">{{localize "PATRON.priority"}}</label>
        <select name="system.priority" data-dtype="Number">
            {{selectOptions priorities selected=document.system.priority localize=true}}
        </select>
    </div>


</div>